{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command '$p='\"'src/core/narrative.ts'; \"'$n=0; Get-Content $p | ForEach-Object { $n++; if($n -le 295){'\"'{0}: {1}' -f \"'$n,$_} }'","aggregated_output":"1: import type {\r\n2:   Character, GameData, NarrativeProgress, NarrativeScene, NarrativeStage,\r\n3: } from './types'\r\n4: import { CHAPTERS } from './data/story'\r\n5: import { DREAM_EPISODES } from './data/dreams'\r\n6: import { REGIONS } from './data/regions'\r\n7: \r\n8: export type NarrativeChannel = 'ambient' | 'discovery' | 'scene'\r\n9: export type NarrativeTrigger =\r\n10:   | { kind: 'home' }\r\n11:   | { kind: 'depart'; regionId: string }\r\n12:   | { kind: 'dungeonEnter'; regionId: string; firstVisit: boolean }\r\n13:   | { kind: 'monument'; regionId: string; fragment: number }\r\n14:   | { kind: 'boss'; regionId: string; phase: 'before' | 'victory' }\r\n15:   | { kind: 'return'; regionId: string; bossDown: boolean }\r\n16:   | { kind: 'villageTalk'; villagerId: string }\r\n17:   | { kind: 'inherit'; generation: number }\r\n18: \r\n19: export interface NarrativeBeat {\r\n20:   id: string\r\n21:   stage: NarrativeStage\r\n22:   channel: NarrativeChannel\r\n23:   trigger: NarrativeTrigger\r\n24:   text: string\r\n25:   speaker?: string\r\n26:   once?: boolean\r\n27:   priority: number\r\n28:   requires?: string[]\r\n29:   blocks?: string[]\r\n30:   recap?: string\r\n31: }\r\n32: \r\n33: const EMPTY_RESONANCE = { cut: 0, save: 0, inherit: 0 }\r\n34: const EMPTY_METRICS = {\r\n35:   scenesOpened: 0,\r\n36:   scenesCompleted: 0,\r\n37:   scenesSkipped: 0,\r\n38:   scenesDeferred: 0,\r\n39:   totalSceneMs: 0,\r\n40:   maxDeferred: 0,\r\n41:   monthsAdvanced: 0,\r\n42:   interruptedAfterMonth: 0,\r\n43: }\r\n44: \r\n45: export function narrativeSceneId(scene: NarrativeScene): string {\r\n46:   switch (scene.kind) {\r\n47:     case 'birth': return `birth:${scene.charId}`\r\n48:     case 'death': return `death:${scene.charId}`\r\n49:     case 'ceremony': return `ceremony:${scene.charId}`\r\n50:     case 'jobrite': return `jobrite:${scene.charId}`\r\n51:     case 'dream': return 'dream:intro'\r\n52:     case 'dreamEp': return `dream:${scene.epId}`\r\n53:     case 'life': return scene.narrativeId ?? `life:${scene.title}`\r\n54:   }\r\n55: }\r\n56: \r\n57: export function narrativeScenePriority(scene: NarrativeScene): number {\r\n58:   if (scene.kind === 'death') return 0\r\n59:   if (scene.kind === 'birth' || scene.kind === 'ceremony' || scene.kind === 'jobrite') return 1\r\n60:   if (scene.kind === 'life' && scene.narrativeId?.startsWith('ch')) return 2\r\n61:   if (scene.kind === 'dream' || scene.kind === 'dreamEp') return 3\r\n62:   return 4\r\n63: }\r\n64: \r\n65: export function narrativeStageOf(data: Pick<GameData, 'flags'>): NarrativeStage {\r\n66:   const f = data.flags\r\n67:   if (f.ch5_completed || f.dreamEp_yume_itadaki) return 'summit'\r\n68:   if (f.ch4_completed || f.dreamEp_yume_maki) return 'fire_vow'\r\n69:   if (f.ch3_completed || f.dreamEp_yume_futari || f.dreamEp_yume_ue || f.dreamEp_yume_taiyou) return 'duet_hunger'\r\n70:   if (f.ch2_completed || f.dreamEp_yume_tabibito || f.dreamEp_yume_sora_no_ko) return 'name'\r\n71:   return 'one_light'\r\n72: }\r\n73: \r\n74: function completedFromFlags(data: GameData, legacy: boolean): string[] {\r\n75:   const ids: string[] = []\r\n76:   for (const chapter of CHAPTERS) {\r\n77:     if (data.flags[`${chapter.id}_completed`] || (legacy && data.flags[chapter.id])) ids.push(chapter.id)\r\n78:   }\r\n79:   if (data.flags.dreamSeen) ids.push('dream:intro')\r\n80:   for (const ep of DREAM_EPISODES) {\r\n81:     if (data.flags[`dreamEp_${ep.id}`]) ids.push(`dream:${ep.id}`)\r\n82:   }\r\n83:   return ids\r\n84: }\r\n85: \r\n86: function replayableSceneForId(id: string): NarrativeScene | undefined {\r\n87:   if (id === 'dream:intro') return { kind: 'dream' }\r\n88:   if (id.startsWith('dream:')) {\r\n89:     const epId = id.slice('dream:'.length)\r\n90:     return DREAM_EPISODES.some((episode) => episode.id === epId) ? { kind: 'dreamEp', epId } : undefined\r\n91:   }\r\n92:   const chapter = CHAPTERS.find((candidate) => candidate.id === id)\r\n93:   return chapter\r\n94:     ? { kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: chapter.lines }\r\n95:     : undefined\r\n96: }\r\n97: \r\n98: export function isReplayableNarrativeScene(scene: NarrativeScene): boolean {\r\n99:   return scene.kind === 'dream' || scene.kind === 'dreamEp' || (scene.kind === 'life' && !!scene.narrativeId?.startsWith('ch'))\r\n100: }\r\n101: \r\n102: /**\r\n103:  * M34 save migration. Sentinelが無い旧saveだけ実名開示を保守的に導出する。\r\n104:  * 現行saveへlegacy ORを再適用しないことが、ch4途中reloadの必須条件。\r\n105:  */\r\n106: export function migrateM34Narrative(data: GameData): GameData {\r\n107:   const legacy = data.flags?.m34_narrative_schema !== 1\r\n108:   const flags = { ...(data.flags ?? {}) }\r\n109:   if (legacy) {\r\n110:     const legacyReveal = Boolean(\r\n111:       flags.ch4 ||\r\n112:       (data.gossipIndex ?? 0) >= 12 ||\r\n113:       flags.shioriPhase ||\r\n114:       flags.endingType !== undefined ||\r\n115:       flags.cleared,\r\n116:     )\r\n117:     flags.m34_narrative_schema = 1\r\n118:     flags.reveal_shiori_name = legacyReveal\r\n119:     flags.legacy_shiori_recap_pending = legacyReveal\r\n120:     if (legacyReveal) flags.ch4_completed = true\r\n121:   }\r\n122: \r\n123:   const completed = [...new Set([\r\n124:     ...(data.narrative?.completed ?? []),\r\n125:     ...completedFromFlags({ ...data, flags }, legacy),\r\n126:   ])]\r\n127:   const seen = [...new Set([...(data.narrative?.seen ?? []), ...completed])]\r\n128:   const archive = uniqueScenes([\r\n129:     ...(data.narrative?.archive ?? []),\r\n130:     ...completed.map(replayableSceneForId).filter((scene): scene is NarrativeScene => !!scene),\r\n131:   ]).filter(isReplayableNarrativeScene)\r\n132:   const deferred = [...(data.narrative?.deferred ?? [])]\r\n133:   const fallbackDeferredAt = data.lastPlayedAt ?? Date.now()\r\n134:   const deferredSince = Object.fromEntries(deferred.map((scene) => {\r\n135:     const id = narrativeSceneId(scene)\r\n136:     return [id, data.narrative?.deferredSince?.[id] ?? fallbackDeferredAt]\r\n137:   }))\r\n138:   const narrative: NarrativeProgress = {\r\n139:     stage: narrativeStageOf({ flags }),\r\n140:     seen,\r\n141:     queued: [...new Set(data.narrative?.queued ?? [])],\r\n142:     completed,\r\n143:     deferred,\r\n144:     archive,\r\n145:     deferredSince,\r\n146:     deferredReminderShown: [...new Set(data.narrative?.deferredReminderShown ?? [])],\r\n147:     active: data.narrative?.active,\r\n148:     activeOpenedAt: data.narrative?.activeOpenedAt,\r\n149:     activeReplay: data.narrative?.activeReplay,\r\n150:     monthTransitionPending: data.narrative?.monthTransitionPending,\r\n151:     resonance: { ...EMPTY_RESONANCE, ...(data.narrative?.resonance ?? {}) },\r\n152:     metrics: { ...EMPTY_METRICS, ...(data.narrative?.metrics ?? {}) },\r\n153:     generationQuestion: data.narrative?.generationQuestion,\r\n154:     lastReturn: data.narrative?.lastReturn,\r\n155:   }\r\n156:   return { ...data, flags, narrative }\r\n157: }\r\n158: \r\n159: /** crash/閉じるで表示中だった場面は読了にせず「灯の余白」へ戻す。 */\r\n160: export function recoverNarrativeOnLoad(data: GameData): GameData {\r\n161:   const migrated = migrateM34Narrative(data)\r\n162:   const n = migrated.narrative!\r\n163:   const deferred = [...n.deferred]\r\n164:   if (n.active && !n.activeReplay) deferred.unshift(n.active)\r\n165:   const interrupted = !!n.monthTransitionPending\r\n166: \r\n167:   // post-M34のch4 queue済みsaveを、legacy扱いせず匿名のまま再開可能にする。\r\n168:   const ch4Pending = migrated.flags.ch4 && !migrated.flags.ch4_completed\r\n169:   if (ch4Pending && !deferred.some((s) => narrativeSceneId(s) === 'ch4')) {\r\n170:     const ch4 = CHAPTERS.find((c) => c.id === 'ch4')\r\n171:     if (ch4) deferred.unshift({ kind: 'life', narrativeId: ch4.id, title: ch4.title, lines: ch4.lines })\r\n172:   }\r\n173:   const recoveredAt = Date.now()\r\n174:   const deferredSince = Object.fromEntries(uniqueScenes(deferred).map((scene) => {\r\n175:     const id = narrativeSceneId(scene)\r\n176:     return [id, n.deferredSince[id] ?? (n.active && narrativeSceneId(n.active) === id ? n.activeOpenedAt : undefined) ?? recoveredAt]\r\n177:   }))\r\n178:   return {\r\n179:     ...migrated,\r\n180:     narrative: {\r\n181:       ...n,\r\n182:       active: undefined,\r\n183:       activeOpenedAt: undefined,\r\n184:       activeReplay: undefined,\r\n185:       monthTransitionPending: false,\r\n186:       deferred: uniqueScenes(deferred),\r\n187:       deferredSince,\r\n188:       metrics: {\r\n189:         ...n.metrics,\r\n190:         interruptedAfterMonth: n.metrics.interruptedAfterMonth + (interrupted ? 1 : 0),\r\n191:         maxDeferred: Math.max(n.metrics.maxDeferred, deferred.length),\r\n192:       },\r\n193:     },\r\n194:   }\r\n195: }\r\n196: \r\n197: export function narrativeMetricSummary(data: GameData): {\r\n198:   averageSceneMs: number\r\n199:   skipRate: number\r\n200:   maxDeferred: number\r\n201:   interruptedAfterMonth: number\r\n202: } {\r\n203:   const metrics = migrateM34Narrative(data).narrative!.metrics\r\n204:   const closed = metrics.scenesCompleted + metrics.scenesSkipped + metrics.scenesDeferred\r\n205:   const resolved = metrics.scenesCompleted + metrics.scenesSkipped\r\n206:   return {\r\n207:     averageSceneMs: closed > 0 ? Math.round(metrics.totalSceneMs / closed) : 0,\r\n208:     skipRate: resolved > 0 ? metrics.scenesSkipped / resolved : 0,\r\n209:     maxDeferred: metrics.maxDeferred,\r\n210:     interruptedAfterMonth: metrics.interruptedAfterMonth,\r\n211:   }\r\n212: }\r\n213: \r\n214: export function uniqueScenes(scenes: NarrativeScene[]): NarrativeScene[] {\r\n215:   const ids = new Set<string>()\r\n216:   return scenes.filter((scene) => {\r\n217:     const id = narrativeSceneId(scene)\r\n218:     if (ids.has(id)) return false\r\n219:     ids.add(id)\r\n220:     return true\r\n221:   })\r\n222: }\r\n223: \r\n224: export function partitionNarrativeScenes(\r\n225:   progress: NarrativeProgress,\r\n226:   candidates: NarrativeScene[],\r\n227: ): { primary: NarrativeScene | null; deferred: NarrativeScene[]; queued: string[] } {\r\n228:   const existing = new Set([\r\n229:     ...progress.completed,\r\n230:     ...progress.deferred.map(narrativeSceneId),\r\n231:     ...(progress.active ? [narrativeSceneId(progress.active)] : []),\r\n232:   ])\r\n233:   const fresh = uniqueScenes(candidates)\r\n234:     .filter((scene) => !existing.has(narrativeSceneId(scene)))\r\n235:     .sort((a, b) => narrativeScenePriority(a) - narrativeScenePriority(b))\r\n236:   return {\r\n237:     primary: fresh[0] ?? null,\r\n238:     deferred: uniqueScenes([...progress.deferred, ...fresh.slice(1)]),\r\n239:     queued: [...new Set([...progress.queued, ...fresh.map(narrativeSceneId)])],\r\n240:   }\r\n241: }\r\n242: \r\n243: export function chapterIdByTitle(title: string): string | undefined {\r\n244:   return CHAPTERS.find((chapter) => chapter.title === title)?.id\r\n245: }\r\n246: \r\n247: export function generationQuestion(data: GameData): string {\r\n248:   const items = [\r\n249:     ...data.inventory,\r\n250:     ...data.family.flatMap((c) => Object.values(c.equipment).filter((x): x is NonNullable<typeof x> => !!x)),\r\n251:   ]\r\n252:   const inherited = items.some((item) => item.generation >= 2)\r\n253:   const completedLore = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n254:   const pacts = Object.values(data.godAffinity).filter((n) => n > 0).length\r\n255:   const bossDeeds = data.family.flatMap((c) => c.deeds).filter((x) => x.includes('討った')).length\r\n256:   if (inherited) return '受け継ぐことは、持ち主の役目まで背負うことか。'\r\n257:   if (completedLore >= 3) return '事情を知った刃は、知らぬ刃より優しいか。'\r\n258:   if (bossDeeds >= 2) return '終わらせることで救えるものは、本当にあるか。'\r\n259:   if (pacts >= 3) return '血を繋ぐことは、誰の願いなのか。'\r\n260:   return '短い命を誰かと分けるとき、何を次代へ残したいか。'\r\n261: }\r\n262: \r\n263: export function addResonance(\r\n264:   data: GameData,\r\n265:   kind: keyof NarrativeProgress['resonance'],\r\n266:   amount = 1,\r\n267: ): GameData {\r\n268:   const migrated = migrateM34Narrative(data)\r\n269:   const n = migrated.narrative!\r\n270:   return {\r\n271:     ...migrated,\r\n272:     narrative: {\r\n273:       ...n,\r\n274:       resonance: { ...n.resonance, [kind]: n.resonance[kind] + Math.max(0, amount) },\r\n275:     },\r\n276:   }\r\n277: }\r\n278: \r\n279: export function resonanceLine(data: GameData): string {\r\n280:   const r = migrateM34Narrative(data).narrative!.resonance\r\n281:   const max = Math.max(r.cut, r.save, r.inherit)\r\n282:   if (max <= 0) return 'この家は、答えを決めつけず、ここまで灯を運んできた。'\r\n283:   const leaders = (['cut', 'save', 'inherit'] as const).filter((key) => r[key] === max)\r\n284:   if (leaders.length !== 1) return 'この家は、終えることも、分けることも、継ぐことも重ねてきた。'\r\n285:   if (r.cut === max) return 'この家は、終われぬ主へ何度も幕を引いてきた。'\r\n286:   if (r.save === max) return 'この家は、傷ついた者を置いて行かない夜を重ねてきた。'\r\n287:   return 'この家は、名と道具と役目を、形を変えて渡してきた。'\r\n288: }\r\n289: \r\n290: export interface FamilyEcho {\r\n291:   label: string\r\n292:   text: string\r\n293: }\r\n294: \r\n295: export function familyFinaleEchoes(data: GameData): FamilyEcho[] {\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command '$p='\"'src/core/data/dreams.ts'; \"'$n=0; Get-Content $p | ForEach-Object { $n++; if($n -ge 125){'\"'{0}: {1}' -f \"'$n,$_} }; Get-Content evidence/*'","aggregated_output":"125:       '——ひとつが、ふたつになった。ふたつが、十になった。',\r\n126:       '郷の年寄りだけが気づいた。「北の空の、あの星がない」——子どもらは、はじめから無かった顔で笑っていた。',\r\n127:       '飢えは、食べるほどに深くなった。星の光では、もう足りない。地の唄を知った体は、もっとあたたかいものを欲しがった。',\r\n128:       '「あの子は、泣きながら食べていたわ。泣きながら食べるものを、どうやって責めればいいの」',\r\n129:       'そしてあの朝——玄冬は、いちばん大きな星に、手を伸ばした。',\r\n130:       '太陽が、欠けていく。真昼の郷に夜が落ちる。鳥が鳴きやみ、井戸の水が凍りはじめる。',\r\n131:       '人々の悲鳴の中で、楽士はひとり空を見上げて、悟った。',\r\n132:       '「あの子を地上に引き留めたのは、私の唄。飢えさせたのも、私の唄。——常夜はね、私が招いたのよ」',\r\n133:       '「郷の誰も、それを知らない。夢は、頂に立つべき血にしか渡れないの。……綴にも、内緒よ」',\r\n134:       '世界から、朝が消えた。千年の夜の、最初の夜だった。',\r\n135:     ],\r\n136:   },\r\n137:   {\r\n138:     id: 'yume_maki',\r\n139:     title: '夢渡り・漆 — 薪の契り',\r\n140:     unlock: { deaths: 16, gen: 5 },\r\n141:     requiresPrevious: 'yume_taiyou',\r\n142:     visualId: 'STORY-DREAM-07',\r\n143:     bg: 'cg_dream_07.jpg',\r\n144:     visualDescription: '面を着けた玄冬を楽士が環の内側から抱き止め、傍らに琵琶を置く。胸から流れた金の寿命の火が山を明るく下り、大燈籠へ初めて灯る。',\r\n145:     beats: [\r\n146:       'ここまで灯を見送って、ようやく届く夢がある。',\r\n147:       '「……今夜で、昔語りはおしまい。最後は、私の罪と、あなたたちの呪いの話」',\r\n148:       '——郷人たちは楽士に縋った。あなたの唄は魔性さえ鎮める。どうか、あの星喰いを殺してくれ、と。',\r\n149:       '楽士は頂に登った。琵琶を、構えた。玄冬は逃げもせず、泣き腫らした顔で、そこにいた。',\r\n150:       '「殺せなかったわ。……当たり前でしょう。あの子は、私の唄を、星より明るいと言った子よ」',\r\n151:       'だから楽士は、第三の道を選んだ。',\r\n152:       '己の寿命を薪にして、大燈籠に千年の火を灯す。郷を、常夜の凍えから守る火を。',\r\n153:       'そして玄冬に面をかぶせ、その体ごと、頂で抱きしめた。飢えが二度と星に届かぬように。内側から、千年、抱き続けるために。',\r\n154:       '「寿命を薪にした報いは、血に残った。私の血を継ぐ子は、八つの季節しか生きられない。人と結ばれて、血を薄めることも、できない」',\r\n155:       '「だからあなたたちは、星と契って生まれてくる。……ごめんなさい、とは言わないわ。あなたたちは、私の誇りだもの」',\r\n156:       '「憎んでくれても、いいのよ。それでも私は——千年前のあの夜に戻っても、同じことをする」',\r\n157:     ],\r\n158:   },\r\n159:   {\r\n160:     id: 'yum