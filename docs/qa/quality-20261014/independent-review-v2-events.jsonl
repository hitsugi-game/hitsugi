{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command '$paths='\"'src/ui/Title.tsx','src/ui/Chronicle.tsx'; foreach(\"'$p in $paths){Write-Output \"FILE $p\"; $n=0; Get-Content $p | ForEach-Object { $n++; '\"'{0}: {1}' -f \"'$n,$_ }}'","aggregated_output":"FILE src/ui/Title.tsx\r\n1: import { useEffect, useRef, useState } from 'react'\r\n2: import { APP_BUILD_LABEL } from '../core/version'\r\n3: import { emitToast } from './toast'\r\n4: import './vc2_entry.css'\r\n5: \r\n6: type SaveStatus = 'checking' | 'ready' | 'recoverable' | 'damaged' | 'unavailable' | 'none'\r\n7: \r\n8: function IntroSceneBg({ file }: { file: string }) {\r\n9:   const [ok, setOk] = useState(true)\r\n10:   if (!ok) return null\r\n11:   return (\r\n12:     <img\r\n13:       className=\"scene-bg\"\r\n14:       src={`${import.meta.env.BASE_URL}img/${file.replace(/\\.png$/, '.jpg')}`}\r\n15:       alt=\"\"\r\n16:       aria-hidden\r\n17:       onError={() => setOk(false)}\r\n18:     />\r\n19:   )\r\n20: }\r\n21: \r\n22: export function TitleScreen({ onRuntimeReady }: { onRuntimeReady?: () => void } = {}) {\r\n23:   const [mode, setMode] = useState<'normal' | 'narrative' | 'data' | null>(null)\r\n24:   const [confirmNew, setConfirmNew] = useState(false)\r\n25:   const [saveStatus, setSaveStatus] = useState<SaveStatus>('checking')\r\n26:   const fileRef = useRef<HTMLInputElement>(null)\r\n27:   const saveExists = saveStatus === 'ready' || saveStatus === 'recoverable' || saveStatus === 'damaged'\r\n28:   const canContinue = saveStatus === 'ready' || saveStatus === 'recoverable'\r\n29:   const canExport = canContinue\r\n30: \r\n31:   const refreshSaveStatus = () => {\r\n32:     void import('../core/save')\r\n33:       .then(({ inspectSaveSlot }) => setSaveStatus(inspectSaveSlot()))\r\n34:       .catch(() => setSaveStatus('unavailable'))\r\n35:   }\r\n36:   useEffect(refreshSaveStatus, [])\r\n37: \r\n38:   // 「はじめから」— 既存セーブがあれば上書き確認を挟む\r\n39:   const onNewGame = () => { if (saveExists) setConfirmNew(true); else setMode('normal') }\r\n40:   const onImportFile = (file: File) => {\r\n41:     const reader = new FileReader()\r\n42:     reader.onload = () => {\r\n43:       void import('../core/save').then(({ importSaveStringResult }) => {\r\n44:         const result = importSaveStringResult(String(reader.result))\r\n45:         const failure = result.ok ? '' : result.previousSavePreserved\r\n46:           ? '読み込めなかった。既存の記は保持した。ファイルまたは端末の保存設定を確認してください。'\r\n47:           : '読み込みの検証に失敗した。再読込せず、復旧頁から控えを書き出してください。'\r\n48:         emitToast(result.ok ? 'セーブを読み込んだ。「つづきから」で再開できる。' : failure, result.ok ? 'info' : 'error')\r\n49:         refreshSaveStatus()\r\n50:       }).catch(() => emitToast('セーブ検証部を読み込めなかった。再読込してください。', 'error'))\r\n51:     }\r\n52:     reader.readAsText(file)\r\n53:   }\r\n54:   const startGame = (narrative: boolean) => {\r\n55:     void import('../core/store').then(({ useGame }) => {\r\n56:       useGame.getState().newGame(narrative)\r\n57:       onRuntimeReady?.()\r\n58:     }).catch(() => emitToast('ゲーム本体を読み込めなかった。回線を確認して再読込してください。', 'error'))\r\n59:   }\r\n60:   const continueGame = () => {\r\n61:     void import('../core/store').then(({ useGame }) => {\r\n62:       useGame.getState().continueGame()\r\n63:       onRuntimeReady?.()\r\n64:     }).catch(() => emitToast('一族の記を開けなかった。回線を確認して再読込してください。', 'error'))\r\n65:   }\r\n66: \r\n67:   return (\r\n68:     <div className=\"screen title-screen\">\r\n69:       <img\r\n70:         className=\"title-art-img\"\r\n71:         src={`${import.meta.env.BASE_URL}img/title_key.jpg`}\r\n72:         alt=\"\"\r\n73:         aria-hidden\r\n74:       />\r\n75:       <div className=\"embers\" aria-hidden>\r\n76:         {Array.from({ length: 14 }, (_, i) => (\r\n77:           <span key={i} className=\"ember\" style={{ left: `${(i * 7.3) % 100}%`, animationDelay: `${i * 0.9}s` }} />\r\n78:         ))}\r\n79:       </div>\r\n80:       <div className=\"title-main\">\r\n81:         <p className=\"title-kicker\">常夜千年・一族継承譚</p>\r\n82:         <h1 className=\"game-title\">\r\n83:           <span className=\"title-hi\">灯</span>\r\n84:           <span className=\"title-tsugi\">継ぎ</span>\r\n85:         </h1>\r\n86:         <p className=\"title-sub\">- HITSUGI -</p>\r\n87:         <p className=\"title-copy\">八季の命を、継いでゆけ。</p>\r\n88:       </div>\r\n89: \r\n90:       {confirmNew ? (\r\n91:         <div className=\"title-menu\">\r\n92:           <p className=\"mode-ask\">既に一族の記がある。新たに始めれば、それは失われる。よいか?</p>\r\n93:           <button className=\"btn btn-main\" onClick={() => { setConfirmNew(false); setMode('normal') }}>\r\n94:             承知の上で、始める\r\n95:           </button>\r\n96:           <button className=\"btn btn-ghost\" onClick={() => setConfirmNew(false)}>\r\n97:             やめておく\r\n98:           </button>\r\n99:         </div>\r\n100:       ) : mode === 'data' ? (\r\n101:         <div className=\"title-menu\">\r\n102:           <p className=\"mode-ask\">セーブの管理</p>\r\n103:           <p className=\"title-save-state\" data-state={saveStatus}>\r\n104:             {saveStatus === 'ready' && <>端末の記 <strong>読取可能</strong></>}\r\n105:             {saveStatus === 'recoverable' && <>端末の記 <strong>控えから復旧可能</strong></>}\r\n106:             {saveStatus === 'damaged' && <>端末の記 <strong>破損を検出</strong><span>ファイルから正常な控えを読み込むか、この記を消してください。</span></>}\r\n107:             {saveStatus === 'unavailable' && <>端末の記 <strong>保存できない</strong><span>ブラウザの保存許可を確認してください。許可がなくても、この場では遊べます。</span></>}\r\n108:             {saveStatus === 'none' && <>端末の記 <strong>まだない</strong></>}\r\n109:             {saveStatus === 'checking' && <>端末の記 <strong>確認中</strong></>}\r\n110:           </p>\r\n111:           <button className=\"btn\" disabled={!canExport} onClick={() => {\r\n112:             void import('../core/save').then(({ downloadSave }) => {\r\n113:               if (!downloadSave()) emitToast('書き出せる正常なセーブが無い。', 'error')\r\n114:             })\r\n115:           }}>\r\n116:             セーブを書き出す(バックアップ)\r\n117:           </button>\r\n118:           <button className=\"btn\" onClick={() => fileRef.current?.click()}>\r\n119:             セーブを読み込む(ファイルから)\r\n120:           </button>\r\n121:           <button className=\"btn btn-ghost\" disabled={!saveExists} onClick={() => {\r\n122:             if (!confirm('この端末のセーブを完全に消す。取り消せない。よいか?')) return\r\n123:             void import('../core/save').then(({ clearSave }) => {\r\n124:               clearSave()\r\n125:               refreshSaveStatus()\r\n126:               emitToast('セーブを消した。', 'info')\r\n127:               setMode(null)\r\n128:             })\r\n129:           }}>\r\n130:             セーブを消す\r\n131:           </button>\r\n132:           <button className=\"btn btn-ghost\" onClick={() => setMode(null)}>\r\n133:             戻る\r\n134:           </button>\r\n135:           <input ref={fileRef} type=\"file\" accept=\"application/json,.json\" style={{ display: 'none' }}\r\n136:             onChange={(e) => { const f = e.target.files?.[0]; if (f) onImportFile(f); e.target.value = '' }} />\r\n137:         </div>\r\n138:       ) : mode === null ? (\r\n139:         <div className=\"title-menu\">\r\n140:           <p className=\"title-save-state\" data-state={saveStatus} aria-live=\"polite\">\r\n141:             {saveStatus === 'ready' && <>端末の記 <strong>続きあり</strong></>}\r\n142:             {saveStatus === 'recoverable' && <>端末の記 <strong>控えから復せる</strong></>}\r\n143:             {saveStatus === 'damaged' && <>端末の記 <strong>読めない</strong><span>「セーブの管理」で復旧してください。</span></>}\r\n144:             {saveStatus === 'unavailable' && <>端末の記 <strong>保存できない</strong><span>この場では遊べますが、再読込すると進行は残りません。</span></>}\r\n145:             {saveStatus === 'none' && <>端末の記 <strong>まだない</strong></>}\r\n146:             {saveStatus === 'checking' && <>端末の記 <strong>確認中</strong></>}\r\n147:           </p>\r\n148:           <button className=\"btn btn-main\" onClick={onNewGame}>\r\n149:             はじめから\r\n150:           </button>\r\n151:           {canContinue && (\r\n152:             <button className=\"btn\" onClick={() => continueGame()}>\r\n153:               {saveStatus === 'recoverable' ? '控えからつづける' : 'つづきから'}\r\n154:             </button>\r\n155:           )}\r\n156:           <button className=\"btn btn-ghost\" onClick={() => setMode('data')}>\r\n157:             セーブの管理\r\n158:           </button>\r\n159:         </div>\r\n160:       ) : (\r\n161:         <div className=\"title-menu\">\r\n162:           <p className=\"mode-ask\">語り部の問い — いかに歩む?</p>\r\n163:           <button className=\"btn btn-main\" onClick={() => startGame(false)}>\r\n164:             宿命(標準) — 夜は深く、灯は重い\r\n165:           </button>\r\n166:           <button className=\"btn\" onClick={() => startGame(true)}>\r\n167:             語り部(易しめ) — 物語を味わう歩み\r\n168:           </button>\r\n169:           <button className=\"btn btn-ghost\" onClick={() => setMode(null)}>\r\n170:             戻る\r\n171:           </button>\r\n172:         </div>\r\n173:       )}\r\n174:       <p className=\"title-ver\">ver {APP_BUILD_LABEL} — 燈ノ郷にて</p>\r\n175:     </div>\r\n176:   )\r\n177: }\r\n178: \r\n179: const INTRO_BEATS = [\r\n180:   '千年前、この郷から太陽が消えた。',\r\n181:   '星喰いの神・玄冬(げんとう)が、空を喰らったのだ。',\r\n182:   '旅の楽士は、己の寿命を薪として大燈籠に火を点し、郷を常夜から守った。',\r\n183:   'だが火は完全ではなかった。その楽士の血族には、二つの呪いが残った。',\r\n184:   '一つ。生まれて八つの季節で、体の内の灯が燃え尽きること — 「八季の命」。',\r\n185:   '一つ。人と子を成せぬこと — 「結ばれぬ身」。',\r\n186:   'ゆえに一族は、夜空の星神と契りて子を授かり、代を継いで戦い続けてきた。',\r\n187:   '目指すは夜藪の最深部、灯ノ御山の頂。玄冬の御座。',\r\n188:   '……さて。千年目の当主よ。あんたの名は燈吾。残る命は、五季。',\r\n189:   '筆は持った。あんたら一族の生き様、この綴(つづり)が一字も漏らさず書き残す。',\r\n190:   '— ゆけ。灯を、継いでゆけ。',\r\n191: ]\r\n192: \r\n193: export function IntroScreen({ onFinish }: { onFinish: () => void }) {\r\n194:   const [beat, setBeat] = useState(0)\r\n195:   const currentRef = useRef<HTMLParagraphElement>(null)\r\n196:   const done = beat >= INTRO_BEATS.length\r\n197: \r\n198:   useEffect(() => {\r\n199:     const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches\r\n200:     currentRef.current?.scrollIntoView({ block: 'center', behavior: reducedMotion ? 'auto' : 'smooth' })\r\n201:   }, [beat])\r\n202: \r\n203:   const advance = () => {\r\n204:     if (done) return\r\n205:     if (beat === INTRO_BEATS.length - 1) {\r\n206:       onFinish()\r\n207:     } else {\r\n208:       setBeat(beat + 1)\r\n209:     }\r\n210:   }\r\n211: \r\n212:   return (\r\n213:     <div className=\"screen intro-screen\" onClick={advance} data-beat={beat + 1}>\r\n214:       <IntroSceneBg file=\"cg_prologue.png\" />\r\n215:       <div className=\"intro-spine\" aria-hidden><span>千年目の綴り</span></div>\r\n216:       <div className=\"intro-text\">\r\n217:         {INTRO_BEATS.slice(0, beat + 1).map((t, i) => (\r\n218:           <p key={i} ref={i === beat ? currentRef : undefined} className={i === beat ? 'intro-current' : 'intro-past'}>\r\n219:             {t}\r\n220:           </p>\r\n221:         ))}\r\n222:       </div>\r\n223:       <div className=\"scene-pager\" onClick={(e) => e.stopPropagation()}>\r\n224:         <span className=\"scene-page-mark\">頁 {beat + 1}／{INTRO_BEATS.length}</span>\r\n225:         <button className=\"btn scene-next\" onClick={advance}>{beat === INTRO_BEATS.length - 1 ? '郷へ進む' : '次の頁へ'}</button>\r\n226:       </div>\r\n227:       <button\r\n228:         className=\"btn btn-ghost intro-skip\"\r\n229:         onClick={(e) => {\r\n230:           e.stopPropagation()\r\n231:           onFinish()\r\n232:         }}\r\n233:       >\r\n234:         物語を飛ばす\r\n235:       </button>\r\n236:     </div>\r\n237:   )\r\n238: }\r\nFILE src/ui/Chronicle.tsx\r\n1: // M18 P5: 家譜 — 独立作業画面(UI_UX_REDESIGN_PLAN §5.10)\r\n2: // 概要/称号/故人/年代記の4タブ。表示ロジック(computeRecords/ACHIEVEMENTS)は移動のみ・計算変更なし。\r\n3: // 契約: docs/UI_SHELL_API.md。store/core の変更はしない(表示専用の定数・絞り込みのみ追加)。\r\n4: import { useState } from 'react'\r\n5: import { useGame } from '../core/store'\r\n6: import { seasonLabel } from '../core/types'\r\n7: import type { ChronicleEntry, GameData } from '../core/types'\r\n8: import { godById, GODS } from '../core/data/gods'\r\n9: import { ENEMIES } from '../core/data/enemies'\r\n10: import { REGIONS } from '../core/data/regions'\r\n11: import { REGION_LORE } from '../core/data/lore'\r\n12: import { ITEM_SERIES_MANIFEST } from '../core/data/items'\r\n13: import { collectionDiscoveredCount, popcount15 } from '../core/collection'\r\n14: import { downloadChronicleCard, copyShareText } from './shareCard'\r\n15: import { MaybeImg, Panel } from './components'\r\n16: import { faceImg } from './img'\r\n17: import { FamilyTree } from './FamilyTree'\r\n18: import { ScreenShell, WorkspaceTabs, ActionDock, LifeThread } from './layout/shell'\r\n19: import './chronicle_m18.css'\r\n20: \r\n21: // 一族の記録 — 既存のdataから純粋関数で集計(新規storeフィールド不要)\r\n22: function computeRecords(data: GameData) {\r\n23:   const fam = data.family\r\n24:   const gens = fam.length > 0 ? Math.max(...fam.map((c) => c.gen)) : 0\r\n25:   const alive = fam.filter((c) => c.alive).length\r\n26:   const fallenN = fam.length - alive\r\n27:   const kills = fam.reduce((s, c) => s + (c.kills ?? 0), 0)\r\n28:   const exped = fam.reduce((s, c) => s + (c.expeditions ?? 0), 0)\r\n29:   const years = Math.floor(data.seasonIndex / 12) + 1\r\n30:   const towerBest = typeof data.flags?.towerBest === 'number' ? data.flags.towerBest : 0\r\n31:   // 収集(Codexと同じ基準)\r\n32:   const seenEnemies = new Set((data.codex?.enemies ?? []).map((id) => id.replace(/_[wo]$/, '')))\r\n33:   const knownGods = new Set([...(data.codex?.gods ?? []), ...Object.entries(data.godAffinity).filter(([, v]) => v > 0).map(([k]) => k)])\r\n34:   const cleared = new Set(data.regionsCleared)\r\n35:   const frags = data.loreFrags ?? {}\r\n36:   const baseEnemies = ENEMIES.filter((e) => !/_[wo]$/.test(e.id))\r\n37:   const loreRegions = REGIONS.filter((r) => REGION_LORE[r.id])\r\n38:   const enemySeen = baseEnemies.filter((e) => seenEnemies.has(e.id)).length\r\n39:   const godSeen = GODS.filter((g) => knownGods.has(g.id)).length\r\n40:   const loreDone = loreRegions.filter((r) => cleared.has(r.id) && (frags[r.id] ?? 0) >= 3).length\r\n41:   const collTotal = baseEnemies.length + GODS.length + loreRegions.length\r\n42:   const collDone = enemySeen + godSeen + loreDone\r\n43:   // 四捨五入で未収集の項目が残るのに100%・全収集称号を出さない。\r\n44:   const collPct = collTotal > 0 ? Math.floor((collDone / collTotal) * 100) : 0\r\n45:   const itemSeen = collectionDiscoveredCount(data.collectionV2)\r\n46:   const itemSeriesStarted = ITEM_SERIES_MANIFEST.filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) > 0).length\r\n47:   const itemSeriesComplete = ITEM_SERIES_MANIFEST.filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) === 15).length\r\n48:   const itemAlmost = ITEM_SERIES_MANIFEST\r\n49:     .filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) === 14)\r\n50:     .slice(0, 3)\r\n51:     .map((series) => series.name)\r\n52:   return {\r\n53:     gens, alive, fallenN, kills, exped, years, towerBest, fame: data.fame,\r\n54:     godsPacted: knownGods.size, familiars: data.familiars?.length ?? 0,\r\n55:     regionsCleared: data.regionsCleared.length, regionsTotal: REGIONS.length,\r\n56:     enemySeen, enemyTotal: baseEnemies.length, godSeen, godTotal: GODS.length,\r\n57:     loreDone, loreTotal: loreRegions.length, collPct,\r\n58:     itemSeen, itemTotal: 810, itemSeriesStarted, itemSeriesComplete, itemAlmost,\r\n59:   }\r\n60: }\r\n61: \r\n62: // 称号 — 記録から純粋に導出(読み取り専用・コアループ非改変)。達成/未達を一覧表示。\r\n63: type RecordSummary = ReturnType<typeof computeRecords>\r\n64: const ACHIEVEMENTS: { name: string; hint: string; test: (r: RecordSummary) => boolean }[] = [\r\n65:   { name: '初めての看取り', hint: '一族の誰かを看取る', test: (r) => r.fallenN >= 1 },\r\n66:   { name: '五代の家', hint: '五代まで血を継ぐ', test: (r) => r.gens >= 5 },\r\n67:   { name: '十代の家', hint: '十代まで血を継ぐ', test: (r) => r.gens >= 10 },\r\n68:   { name: '長寿の一族', hint: '二十年を生き延びる', test: (r) => r.years >= 20 },\r\n69:   { name: '大家族', hint: '一族の総数が三十に至る', test: (r) => r.alive + r.fallenN >= 30 },\r\n70:   { name: '百の魔性を討つ', hint: '討伐数100', test: (r) => r.kills >= 100 },\r\n71:   // M19 B3: 図鑑コンプの節目称号 — 収集率に到達の褒美を与える\r\n72:   { name: '見聞の徒', hint: '魔性図鑑を半分(50%)まで埋める', test: (r) => r.enemyTotal > 0 && r.enemySeen / r.enemyTotal >= 0.5 },\r\n73:   { name: '夜藪の博士', hint: '魔性図鑑を全て(100%)埋める', test: (r) => r.enemyTotal > 0 && r.enemySeen >= r.enemyTotal },\r\n74:   { name: '星に親しむ家', hint: '星神の半分(50%)と契る', test: (r) => r.godTotal > 0 && r.godSeen / r.godTotal >= 0.5 },\r\n75:   { name: '星霊の盟家', hint: '全ての星神(100%)と契る', test: (r) => r.godTotal > 0 && r.godSeen >= r.godTotal },\r\n76:   { name: '千年の識者', hint: '総合収集率100%に至る', test: (r) => r.collPct >= 100 },\r\n77:   { name: '千の魔性を討つ', hint: '討伐数1000', test: (r) => r.kills >= 1000 },\r\n78:   { name: '千年の武', hint: '武功500', test: (r) => r.fame >= 500 },\r\n79:   { name: '眷属を率いる者', hint: '眷属を六体懐かせる', test: (r) => r.familiars >= 6 },\r\n80:   { name: '常夜百層・踏破', hint: '常夜百層を制す', test: (r) => r.towerBest >= 100 },\r\n81:   { name: '常夜を鎮む', hint: '全ての地の主を鎮める', test: (r) => r.regionsCleared >= r.regionsTotal && r.regionsTotal > 0 },\r\n82:   { name: '魔性図鑑・完', hint: '全ての魔性を見る', test: (r) => r.enemySeen >= r.enemyTotal && r.enemyTotal > 0 },\r\n83:   { name: '星神図鑑・完', hint: '全ての星神を識る', test: (r) => r.godSeen >= r.godTotal && r.godTotal > 0 },\r\n84:   { name: '土地の記・完', hint: '全ての土地の記を綴る', test: (r) => r.loreDone >= r.loreTotal && r.loreTotal > 0 },\r\n85:   { name: '総べてを蒐む', hint: '総合収集率100%', test: (r) => r.collPct >= 100 },\r\n86: ]\r\n87: \r\n88: // 年代記の種別絞り込み(M18 P5: 表示専用の定数・store/coreは変更しない)\r\n89: const KIND_LABEL: Record<ChronicleEntry['kind'], string> = {\r\n90:   birth: '誕生', death: '死', pact: '契り', triumph: '勝鬨', event: '出来事', era: '節目',\r\n91: }\r\n92: type KindFilter = 'all' | ChronicleEntry['kind']\r\n93: const KIND_FILTERS: KindFilter[] = ['all', 'birth', 'death', 'pact', 'triumph', 'event', 'era']\r\n94: const CHRON_PAGE = 200 // 大量一覧対策(§7契約): 直近200件+さらに繰る(200件刻み)\r\n95: \r\n96: type Tab = 'overview' | 'titles' | 'fallen' | 'chronicle'\r\n97: const TABS: { key: Tab; label: string }[] = [\r\n98:   { key: 'overview', label: '概要' },\r\n99:   { key: 'titles', label: '称号' },\r\n100:   { key: 'fallen', label: '故人' },\r\n101:   { key: 'chronicle', label: '年代記' },\r\n102: ]\r\n103: \r\n104: export function ChronicleScreen() {\r\n105:   const data = useGame((s) => s.data)!\r\n106:   const setScreen = useGame((s) => s.setScreen)\r\n107:   const [tab, setTab] = useState<Tab>('overview')\r\n108:   const [copied, setCopied] = useState(false)\r\n109:   const [showTree, setShowTree] = useState(false)\r\n110:   const [kindFilter, setKindFilter] = useState<KindFilter>('all')\r\n111:   const [chronShown, setChronShown] = useState(CHRON_PAGE)\r\n112: \r\n113:   const fallen = data.family.filter((c) => !c.alive)\r\n114:   const rec = computeRecords(data)\r\n115:   const achieved = ACHIEVEMENTS.filter((a) => a.test(rec))\r\n116:   const head = data.family.find((c) => c.isHead)\r\n117: \r\n118:   const chronAll = [...data.chronicle].reverse()\r\n119:   const chronFiltered = kindFilter === 'all' ? chronAll : chronAll.filter((e) => e.kind === kindFilter)\r\n120: \r\n121:   const changeKindFilter = (k: KindFilter) => {\r\n122:     setKindFilter(k)\r\n123:     setChronShown(CHRON_PAGE)\r\n124:   }\r\n125: \r\n126:   return (\r\n127:     <ScreenShell\r\n128:       title=\"家譜 — 燈守家千年紀\"\r\n129:       onBack={() => setScreen({ id: 'home' })}\r\n130:       resources={head ? <>当主 <b>{head.name}</b>(第{head.gen}代)</> : undefined}\r\n131:       tabs={<WorkspaceTabs tabs={TABS} active={tab} onChange={setTab} />}\r\n132:       activeTab={tab}\r\n133:       dock={\r\n134:         <ActionDock>\r\n135:           <button className=\"btn btn-main\" onClick={() => setShowTree(true)}>\r\n136:             家系図を見る\r\n137:           </button>\r\n138:           <span className=\"chron-keep-group\">\r\n139:             <span className=\"chron-keep-label\">残す</span>\r\n140:             <button className=\"btn\" onClick={() => downloadChronicleCard(data)}>\r\n141:               画像保存\r\n142:             </button>\r\n143:             <button\r\n144:               className=\"btn\"\r\n145:               onClick={async () => {\r\n146:                 const ok = await copyShareText(data)\r\n147:                 setCopied(ok)\r\n148:                 setTimeout(() => setCopied(false), 2000)\r\n149:               }}\r\n150:             >\r\n151:               {copied ? '写した!' : '共有文コピー'}\r\n152:             </button>\r\n153:           </span>\r\n154:         </ActionDock>\r\n155:       }\r\n156:     >\r\n157:       <section className={`chronicle-book chronicle-book--${tab}`} aria-label=\"燈守家の綴じた年代記\">\r\n158:         <span className=\"chronicle-book-spine\" aria-hidden=\"true\" />\r\n159:         <header className=\"chronicle-folio-head\">\r\n160:           <span className=\"chronicle-folio-mark\" aria-hidden=\"true\">燈</span>\r\n161:           <div>\r\n162:             <span className=\"chronicle-kicker\">燈守家・第{Math.max(1, rec.gens)}代蔵</span>\r\n163:             <p>{tab === 'overview' ? '継いだ歳月と、まだ継げる灯。' : tab === 'titles' ? '家に刻まれた呼び名。' : tab === 'fallen' ? '欠けた席と、遺された言葉。' : '季節の順に綴られた出来事。'}</p>\r\n164:           </div>\r\n165:           <span className=\"chronicle-page-no\">{TABS.findIndex((t) => t.key === tab) + 1} / {TABS.length}</span>\r\n166:         </header>\r\n167: \r\n168:       {tab === 'overview' && (\r\n169:         <Panel title={`一族の記録 — 総合収集率 ${rec.collPct}%`} className=\"chron-folio chron-overview-folio\">\r\n170:           {/* 命脈 — 継がれた世代を灯る節で、次代をまだ点らぬ節で結ぶ(A案署名要素) */}\r\n171:           <div className=\"chron-thread\" title={`第${rec.gens}代まで継承`}>\r\n172:             <LifeThread nodes={[...Array.from({ length: Math.max(1, rec.gens) }, () => ({ lit: true })), { lit: false }]} />\r\n173:           </div>\r\n174:           <div className=\"chronicle-hero-records\" aria-label=\"一族の主要な記録\">\r\n175:             <div><span>{rec.gens}</span><small>紡いだ世代</small></div>\r\n176:             <div><span>{rec.alive}</span><small>いま灯る命</small></div>\r\n177:             <div><span>{rec.collPct}<i>%</i></span><small>見聞の満ち</small></div>\r\n178:           </div>\r\n179:           <p className=\"chronicle-margin-note\">余白には、まだ名のない次代のための一行が残されている。</p>\r\n180:           <div className=\"collection-portals\" aria-label=\"収集の記録へ進む\">\r\n181:             <button className=\"btn collection-portal\" onClick={() => setScreen({ id: 'codex', tab: 'lore' })}>\r\n182:               <span>土地の記</span><b>{rec.loreDone}/{rec.loreTotal}</b><small>石碑と鎮魂を見返す</small>\r\n183:             </button>\r\n184:             <button className=\"btn collection-portal\" onClick={() => setScreen({ id: 'codex', tab: 'enemies' })}>\r\n185:               <span>魔性の拓影</span><b>{rec.enemySeen}/{rec.enemyTotal}</b><small>遭遇した姿を見返す</small>\r\n186:             </button>\r\n187:             <button className=\"btn collection-portal\" onClick={() => setScreen({ id: 'codex', tab: 'gods' })}>\r\n188:               <span>星神の御影</span><b>{rec.godSeen}/{rec.godTotal}</b><small>契った神を見返す</small>\r\n189:             </button>\r\n190:             <button className=\"btn collection-portal collection-portal-items\" onClick={() => setScreen({ id: 'forge', tab: 'collection' })}>\r\n191:               <span>宝具系譜録</span><b>{rec.itemSeen}/{rec.itemTotal}</b><small>{rec.itemSeriesStarted}系譜を開始・{rec.itemSeriesComplete}棚完成</small>\r\n192:             </button>\r\n193:           </div>\r\n194:           {rec.itemAlmost.length > 0 && (\r\n195:             <p className=\"collection-almost\"><b>あと一段で揃う棚</b>{rec.itemAlmost.join('・')}</p>\r\n196:           )}\r\n197:           <div className=\"records-grid\">\r\n198:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.years}</span><span className=\"rec-lbl\">歳月(年)</span></div>\r\n199:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.fame}</span><span className=\"rec-lbl\">武功</span></div>\r\n200:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.kills}</span><span className=\"rec-lbl\">討った魔性</span></div>\r\n201:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.exped}</span><span className=\"rec-lbl\">夜藪行</span></div>\r\n202:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.alive + rec.fallenN}</span><span className=\"rec-lbl\">記された一族</span></div>\r\n203:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.godsPacted}</span><span className=\"rec-lbl\">契った星神</span></div>\r\n204:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.familiars}</span><span className=\"rec-lbl\">懐いた眷属</span></div>\r\n205:             {rec.towerBest > 0 && <div className=\"rec-cell\"><span className=\"rec-num\">{rec.towerBest}<small>層</small></span><span className=\"rec-lbl\">常夜百層 最高</span></div>}\r\n206:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.regionsCleared}<small>/{rec.regionsTotal}</small></span><span className=\"rec-lbl\">鎮めた地</span></div>\r\n207:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.enemySeen}<small>/{rec.enemyTotal}</small></span><span className=\"rec-lbl\">見た魔性</span></div>\r\n208:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.godSeen}<small>/{rec.godTotal}</small></span><span className=\"rec-lbl\">識る星神</span></div>\r\n209:             <div className=\"rec-cell\"><span className=\"rec-num\">{rec.loreDone}<small>/{rec.loreTotal}</small></span><span className=\"rec-lbl\">土地の記</span></div>\r\n210:           </div>\r\n211:         </Panel>\r\n212:       )}\r\n213: \r\n214:       {tab === 'titles' && (\r\n215:         <Panel title={`称号 — ${achieved.length}/${ACHIEVEMENTS.length}`} className=\"chron-folio\">\r\n216:           <div className=\"titles-grid\">\r\n217:             {ACHIEVEMENTS.map((a) => {\r\n218:               const got = a.test(rec)\r\n219:               return (\r\n220:                 <div key={a.name} className={`title-badge ${got ? 'earned' : 'locked'}`} title={a.hint}>\r\n221:                   <span className=\"title-badge-mark\">{got ? '◉' : '○'}</span>\r\n222:                   <span className=\"title-badge-name\">{got ? a.name : '？？？'}</span>\r\n223:                   <span className=\"title-badge-hint\">{a.hint}</span>\r\n224:                 </div>\r\n225:               )\r\n226:             })}\r\n227:           </div>\r\n228:         </Panel>\r\n229:       )}\r\n230: \r\n231:       {tab === 'fallen' && (\r\n232:         <Panel title=\"逝きし者たち\" className=\"chron-folio\">\r\n233:           <div className=\"chronicle-scroll\">\r\n234:             {fallen.length === 0 && <p className=\"chronicle-empty\" role=\"status\">まだ誰も欠けていない。空いた頁は、いま灯る者たちの時間だ。</p>}\r\n235:             {fallen.map((c) => (\r\n236:               <div key={c.id} className=\"fallen-card\">\r\n237:                 <MaybeImg src={faceImg(c)} className=\"fallen-face\" />\r\n238:                 <div className=\"fallen-body\">\r\n239:                   <span className=\"fallen-name\">\r\n240:                     {c.name}(第{c.gen}代)\r\n241:                   </span>\r\n242:                   <span className=\"fallen-cause\">\r\n243:                     {c.deathCause} — {godById(c.godParentId).name}の子\r\n244:                   </span>\r\n245:                   {c.deeds.length > 0 && (\r\n246:                     <div style={{ fontSize: 12, color: 'var(--text-dim)', marginTop: 2 }}>\r\n247:                       {c.deeds.join('。')}。討った魔性{c.kills}、夜藪行{c.expeditions}度。\r\n248:                     </div>\r\n249:                   )}\r\n250:                   {c.epitaph && <div className=\"fallen-epitaph\">「{c.epitaph}」</div>}\r\n251:                 </div>\r\n252:               </div>\r\n253:             ))}\r\n254:           </div>\r\n255:         </Panel>\r\n256:       )}\r\n257: \r\n258:       {tab === 'chronicle' && (\r\n259:         <Panel title={`年代記 — ${chronFiltered.length}件`} className=\"chron-folio\">\r\n260:           <div className=\"chron-filter-row\">\r\n261:             {KIND_FILTERS.map((k) => (\r\n262:               <button\r\n263:                 key={k}\r\n264:                 className={`btn btn-ghost filter-tab ${kindFilter === k ? 'active' : ''}`}\r\n265:                 aria-pressed={kindFilter === k}\r\n266:                 onClick={() => changeKindFilter(k)}\r\n267:               >\r\n268:                 {k === 'all' ? '全て' : KIND_LABEL[k]}\r\n269:               </button>\r\n270:             ))}\r\n271:           </div>\r\n272:           <div className=\"chronicle-scroll\">\r\n273:             {chronFiltered.length === 0 && <p className=\"chronicle-empty\" role=\"status\">この印に当たる記録はない。別の印を選べば、他の頁を繰れる。</p>}\r\n274:             {chronFiltered.slice(0, chronShown).map((e, i) => {\r\n275:               const ch = e.charId ? data.family.find((c) => c.id === e.charId) : undefined\r\n276:               return (\r\n277:                 <div key={i} className={`chron-entry chron-kind-${e.kind}`}>\r\n278:                   {ch && <MaybeImg src={faceImg(ch)} className=\"chron-face\" />}\r\n279:                   <span className=\"chron-season\">{seasonLabel(e.season)}</span>\r\n280:                   <span className={`chron-${e.kind}`}>{e.text}</span>\r\n281:                 </div>\r\n282:               )\r\n283:             })}\r\n284:           </div>\r\n285:           {chronFiltered.length > chronShown && (\r\n286:             <button className=\"btn btn-ghost chron-more\" onClick={() => setChronShown(chronShown + CHRON_PAGE)}>\r\n287:               さらに繰る(残り{chronFiltered.length - chronShown}件)\r\n288:             </button>\r\n289:           )}\r\n290:         </Panel>\r\n291:       )}\r\n292:       </section>\r\n293: \r\n294:       {showTree && <F