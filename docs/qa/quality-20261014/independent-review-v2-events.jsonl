             { text: '玄冬の面が、割れて落ちる——', kind: 'info' },\r\n3037:             { text: '現れたのは、楽士の面影。千年、独りで星喰いを封じ続けた家祖・汐里。', kind: 'info' },\r\n3038:             { text: '「……ああ、来てくれたのね。私の、遠い遠い子どもたち」', kind: 'info' },\r\n3039:             { text: '汐里は楽を構えた。千年の最後の演目——看取ってやれ!', kind: 'info' },\r\n3040:           ]\r\n3041:           const nodes = { ...exp.nodes, [battleNodeId]: { ...node, enemyIds: ['boss_shiori'] } }\r\n3042:           const reward = planBattleRewards('node:boss_shiori', [shioriDef], { boss: true, nextPhase: 'finale' })\r\n3043:           set({\r\n3044:             data: { ...d, family, flags: { ...d.flags, shioriPhase: true, finalePending: false }, expedition: { ...exp, nodes } },\r\n3045:             battle: battle2,\r\n3046:             ...reward,\r\n3047:             battleLogQueue: [...battle2.log],\r\n3048:           })\r\n3049:           return\r\n3050:         }\r\n3051:         // 汐里を看取った勝利は通常の主討伐精算へ流さない。玄冬との二段戦は\r\n3052:         // planどおり携行報酬・経験・武功・討伐数・事績を増やさず結末へ直結する。\r\n3053:         if (node.enemyIds?.includes('boss_shiori')) {\r\n3054:           let nd: GameData = {\r\n3055:             ...d,\r\n3056:             family,\r\n3057:             expedition: undefined,\r\n3058:             regionsCleared: [...new Set([...d.regionsCleared, region.id])],\r\n3059:             flags: { ...d.flags, cleared: true, finalePending: true },\r\n3060:           }\r\n3061:           nd = chronicle(nd, 'era', '灯ノ御山の頂にて、家祖・汐里と相まみえる。千年の答えを、選ぶ時。')\r\n3062:           set({\r\n3063:             data: nd,\r\n3064:             battle: null,\r\n3065:             battleNodeId: null,\r\n3066:             pendingScenes: [],\r\n3067:             screen: { id: 'finale' },\r\n3068:           })\r\n3069:           saveGame(nd)\r\n3070:           return\r\n3071:         }\r\n3072:         const defs = (node.enemyIds ?? []).map((id) => enemyById(id))\r\n3073:         const activePlan = get().battleRewardSettlement?.plan\r\n3074:         const hoto = activePlan?.carried.hoto ??