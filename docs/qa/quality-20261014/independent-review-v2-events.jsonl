Since).filter(([sceneId]) => sceneId !== id)),\r\n408:         metrics: {\r\n409:           ...n.metrics,\r\n410:           totalSceneMs: n.metrics.totalSceneMs + elapsedSceneMs(n.activeOpenedAt),\r\n485:     const battleSequence = current.battleSequence + 1\r\n486:     const settlementId = `${encounterId}:${battleSequence}`\r\n487:     const plan = createBattleRewardPlan({\r\n488:       settlementId,\r\n489:       enemies,\r\n490:       ownedFamiliarEnemyIds: current.data?.familiars?.map((f) => f.enemyId) ?? [],\r\n491:       ...context,\r\n492:     })\r\n493:     return { battleSequence, battleRewardSettlement: { status: 'planned', plan } }\r\n494:   }\r\n495: \r\n496:   // 季節を進める — 誕生と死(寿命)をここで処理\r\n497:   const advanceSeason = (): void => {\r\n498:     const rng = get().rng\r\n499:     const scenes: PendingScene[] = [...get().pendingScenes]\r\n500:     let d = withNarrative(get().data!)\r\n501:     d = { ...d, seasonIndex: d.seasonIndex + 1 }\r\n502:     d = markJourneyMilestone(d, 'next_month')\r\n503: \r\n504:     // 誕生 — v3.1 M12: 縁の加護(下振れ緩和)/隔世遺伝/稀に双子\r\n505:     const due = d.pendingBirths.filter((b) => b.dueSeason <= d.seasonIndex)\r\n506:     d = { ...d, pendingBirths: d.pendingBirths.filter((b) => b.dueSeason > d.seasonIndex) }\r\n507:     for (const b of due) {\r\n508:       const god = godById(b.godId)\r\n509:       const parent = d.family.find((c) => c.id === b.parentId)\r\n510:       if (!parent) continue\r\n511:       const gen = parent.gen + 1\r\n512:       const affinity = d.godAffinity[b.godId] ?? 0\r\n513:       const twins = rng.chance(0.06)\r\n514:       const count = twins ? 2 : 1\r\n515:       for (let i = 0; i < count; i++) {\r\n516:         let child = conceiveChild(\r\n517:           parent, god, gen, d.seasonIndex, rng,\r\n518:           d.family.map((c) => c.name),\r\n519:           affinity, d.family,\r\n520:         )\r\n521:         // 書庫(M16-6): 先達の知恵が、子の血潮に僅かな伸びしろを残す(上限120は維持)\r\n522:         const shokoBonus = shokoPotentialBonus(facilityLevel(d.facilities, 'shoko'))\r\n523:         if (shokoBonus > 0) {\r\n524:           const boosted = { ...child.potential }\r\n525:           for (const k of Object.keys(boosted) as (keyof typeof boosted)[]) {\r\n526:             boosted[k] = Math.min(120, Math.round(boosted[k] * (1 + shokoBonus)))\r\n527:           }\r\n528:           const withStats = recalcStats({ ...child, potential: boosted }, d.seasonIndex)\r\n529:           child = { ...withStats, hp: withStats.maxHp, mp: withStats.maxMp }\r\n530:         }\r\n531:         d = { ...d, family: [...d.family, child] }\r\n532:         d = markJourneyMilestone(d, 'birth')\r\n533:         d = chronicle(d, 'birth', birthLine(child.name, god.name, rng), child.id)\r\n534:         if (child.deeds.some((x) => x.includes('隔世遺伝'))) {\r\n535:           d = chronicle(d, 'event', `${child.name}に、祖の血が強く顕れている。`, child.id)\r\n536:         }\r\n537:         if (child.deeds.some((x) => x.includes('神童'))) {\r\n538:           d = chronicle(d, 'era', `${child.name}、神童の相を持って生まれる — 郷がどよめいた。`, child.id)\r\n539:         }\r\n540:         scenes.push({ kind: 'birth', charId: child.id })\r\n541:       }\r\n542:       if (twins) d = chronicle(d, 'event', `${parent.name}に双子が生まれた — 郷は二重の産声に沸いた。`)\r\n543:     }\r\n544: \r\n545:     // 寿命 — 八季の命\r\n546:     for (const c of d.family) {\r\n547:       if (!c.alive) continue\r\n548:       if (ageOf(c, d.seasonIndex) >= LIFESPAN_MONTHS) {\r\n549:         const epitaph = generateEpitaph(c, 'lifespan', rng)\r\n550:         // 形見: 装備は継承品として蔵へ\r\n551:         const keepsakes: Item[] = []\r\n552:         for (const slot of ['weapon', 'armor', 'charm'] as const) {\r\n553:           const it = c.equipment[slot]\r\n554:           if (it) keepsakes.push(inheritItem(it, c.name, c.kills))\r\n555:         }\r\n556:         d = {\r\n557:           ...d,\r\n558:           inventory: [...d.inventory, ...keepsakes],\r\n559:           successionPending: c.isHead\r\n560:             ? { predecessorId: c.id, heirloomIds: keepsakes.map((item) => item.id) }\r\n561:             : d.successionPending,\r\n562:           family: d.family.map((x) =>\r\n563:             x.id === c.id\r\n564:               ? { ...x, alive: false, deathSeason: d.seasonIndex, deathCause: deathCauseLabel('lifespan'), epitaph, equipment: {}, isHead: false }\r\n565:               : x,\r\n566:           ),\r\n567:         }\r\n568:         d = chronicle(d, 'death', `${c.name}、${deathCauseLabel('lifespan')}。享年八季。「${epitaph}」`, c.id)\r\n569:         d = markJourneyMilestone(d, 'first_death')\r\n570:         d = tryUnlockGossip(d)\r\n650:         if (adults.length >= 2) {\r\n651:           const pair = rng.shuffle(adults).slice(0, 2)\r\n652:           scenes.push({ kind: 'life', ...kizunaScene(pair[0], pair[1], rng) })\r\n653:         }\r\n654:       }\r\n655:     }\r\n656: \r\n657:     // 本編の章(v3.1 M15-4) — 条件を満たした月に一度だけ語られる\r\n658:     const chapterDue = CHAPTERS.find((ch) => {\r\n659:       if (d.flags[ch.id]) return false\r\n660:       switch (ch.id) {\r\n661:         case 'ch1': return d.seasonIndex >= 2\r\n662:         case 'ch2': return d.regionsCleared.length >= 1\r\n663:         case 'ch3': return d.regionsCleared.length >= 5\r\n664:         case 'ch4': return (d.loreFrags?.['akashi_miyama'] ?? 0) >= 3 || d.regionsCleared.length >= 10\r\n665:         case 'ch5': return d.fame >= FAME_SEAL_THRESHOLD\r\n666:         default: return false\r\n667:       }\r\n668:     })\r\n669:     if (chapterDue) {\r\n670:       d = { ...d, flags: { ...d.flags, [chapterDue.id]: true } }\r\n671:       d = chronicle(d, 'era', `【${chapterDue.title}】語り継がれる千年の真実が、一つ明らかになった。`)\r\n672:       scenes.push({ kind: 'life', narrativeId: chapterDue.id, title: chapterDue.title, lines: chapterDue.lines })\r\n673:     }\r\n674: \r\n675:     // 灯座の深まり — 月齢で固有技が開く(10月・14月・18月=奥義)\r\n676:     d = {\r\n677:       ...d,\r\n678:       family: d.family.map((c) => {\r\n679:         if (!c.alive || !c.tomoshigata) return c\r\n680:         const toza = tozaOf(c.tomoshigata, c.element)\r\n681:         const age = ageOf(c, d.seasonIndex)\r\n682:         const learned = [...c.skills]\r\n683:         let awakened = false\r\n684:         if (age >= 10 && !learned.includes(toza.skills[1].id)) learned.push(toza.skills[1].id)\r\n685:         if (age >= 14 && !learned.includes(toza.skills[2].id)) learned.push(toza.skills[2].id)\r\n686:         if (age >= 18 && !learned.includes(toza.ougi.id)) {\r\n687:           learned.push(toza.ougi.id)\r\n688:           awakened = true\r\n689:         }\r\n690:         if (learned.length === c.skills.length) return c\r\n691:         if (awakened) {\r\n692:           d = chronicle(d, 'event', `${c.name}、灯座「${toza.name}」の奥義に開眼す。`)\r\n693:         }\r\n694:         return { ...c, skills: learned }\r\n695:       }),\r\n696:     }\r\n697: \r\n698:     // 家業の年季 — 月齢で家業技が開く(GDD_v3 §2)\r\n699:     d = {\r\n700:       ...d,\r\n701:       family: d.family.map((c) => {\r\n702:         if (!c.alive || !c.jobClass) return c\r\n703:         const job = jobById(c.jobClass)\r\n704:         const age = ageOf(c, d.seasonIndex)\r\n705:         const learned = [...c.skills]\r\n706:         job.skillIds.forEach((sid, i) => {\r\n707:           if (age >= JOB_SKILL_UNLOCK_AGES[i] && !learned.includes(sid)) learned.push(sid)\r\n708:         })\r\n709:         if (learned.length === c.skills.length) return c\r\n710:         return { ...c, skills: learned }\r\n711:       }),\r\n712:     }\r\n713: \r\n714:     // 成長(全員再計算)\r\n715:     d = { ...d, family: d.family.map((c) => (c.alive ? recalcStats(c, d.seasonIndex) : c)) }\r\n716: \r\n717:     // 郷の営み — 郷人たちが大燈籠に捧げる奉燈(月次・討伐が進むほど郷が潤う)\r\n718:     d = { ...d, hoto: d.hoto + 3 + d.regionsCleared.length * 2 }\r\n719: \r\n720:     // 社(M16-6): 月送りごと、既に契った星々(縁>0)への縁を篤くする\r\n721:     const yashiroGain = yashiroAffinityGain(facilityLevel(d.facilities, 'yashiro'))\r\n722:     if (yashiroGain > 0) {\r\n723:       d = {\r\n724:         ...d,\r\n725:         god