veScenes(n, normalized)\r\n322:     const deferredAt = Date.now()\r\n323:     const deferredSince = Object.fromEntries(partition.deferred.map((scene) => {\r\n324:       const id = narrativeSceneId(scene)\r\n325:       return [id, n.deferredSince[id] ?? deferredAt]\r\n326:     }))\r\n327:     d = {\r\n328:       ...d,\r\n329:       narrative: {\r\n330:         ...n,\r\n331:         queued: partition.queued,\r\n332:         deferred: partition.deferred,\r\n333:         deferredSince,\r\n334:         monthTransitionPending: true,\r\n335:         metrics: {\r\n336:           ...n.metrics,\r\n337:           monthsAdvanced: n.metrics.monthsAdvanced + 1,\r\n338:           maxDeferred: Math.max(n.metrics.maxDeferred, partition.deferred.length),\r\n339:         },\r\n340:       },\r\n341:     }\r\n342:     return { data: d, primary: partition.primary }\r\n343:   }\r\n344: \r\n345:   const markSceneResolved = (d0: GameData, scene: PendingScene, skipped: boolean): GameData => {\r\n346:     let d = withNarrative(d0)\r\n347:     const id = narrativeSceneId(scene)\r\n348:     const n = d.narrative!\r\n349:     if (n.completed.includes(id)) {\r\n350:       // ch4は最終頁へ入るtransactionで完了flagも原子的に立つため、直後の「読み終える」は\r\n351:       // completed済みに見える。それでも同じsceneがactiveな閉じ処理だけは一度計測する。\r\n352:       const closingActive = !!n.active && narrativeSceneId(n.active) === id\r\n353:       const closingReplay = closingActive && !!n.activeReplay\r\n354:       const deferredSince = { ...n.deferredSince }\r\n355:       delete deferredSince[id]\r\n356:       return {\r\n357:         ...d,\r\n358:         narrative: {\r\n359:           ...n,\r\n360:           active: undefined,\r\n361:           activeOpenedAt: undefined,\r\n362:           activeReplay: undefined,\r\n363:           monthTransitionPending: false,\r\n364:           seen: [...new Set([...n.seen, id])],\r\n365:           queued: n.queued.filter((x) => x !== id),\r\n366:           deferred: n.deferred.filter((x) => narrativeSceneId(x) !== id),