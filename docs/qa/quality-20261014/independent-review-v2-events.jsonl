{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command '$paths = '\"'src/core/data/story.ts','src/core/data/dreams.ts','src/core/narrative.ts','src/ui/Scenes.tsx'; foreach (\"'$p in $paths) { Write-Output \"FILE $p\"; $n=0; Get-Content $p | ForEach-Object { $n++; '\"'{0}: {1}' -f \"'$n,$_ } }'","aggregated_output":"FILE src/core/data/story.ts\r\n1: // 本編の章立てとマルチエンディング(v3.1 M15-4)\r\n2: // 章は条件を満たした月に一度だけ語られる(綴りや夢の声)。結末は最終決戦後の選択で分岐。\r\n3: export interface StoryChapter {\r\n4:   id: string // flagsに記録するキー\r\n5:   title: string\r\n6:   lines: { speaker: string; text: string }[]\r\n7: }\r\n8: \r\n9: export const CHAPTERS: StoryChapter[] = [\r\n10:   {\r\n11:     id: 'ch1',\r\n12:     title: '第一章 常夜',\r\n13:     lines: [\r\n14:       { speaker: '綴', text: '……なあ、当主どの。なぜ夜が明けぬか、一度でも考えたことはあるか。' },\r\n15:       { speaker: '綴', text: '千年前、空に「玄冬」が座った。星を喰らう神だ。太陽も、あれに呑まれたきり戻らぬ。' },\r\n16:       { speaker: '綴', text: 'それでも郷が息をしているのは、大燈籠の火と、あんたら燈守の血——その二つきりのおかげだ。' },\r\n17:       { speaker: '綴', text: 'あんたらの命は八季で燃え尽きる。短い。だがこの戦は、一代で勝つものではないのだ。' },\r\n18:       { speaker: '綴', text: '親が半歩、子がまた半歩。灯を継いで、じわりと頂へ寄る。それを千年、繰り返してきた。' },\r\n19:       { speaker: '', text: '——夜藪の奥で、何かが目を覚ます気配がした。' },\r\n20:       { speaker: '綴', text: '……妙だな。飢えた獣の気配じゃない。あれはもっと——途方に暮れて、誰かを待つ者の気配だ。' },\r\n21:     ],\r\n22:   },\r\n23:   {\r\n24:     id: 'ch2',\r\n25:     title: '第二章 主たちの無念',\r\n26:     lines: [\r\n27:       { speaker: '綴', text: '主を一つ、鎮めたな。……気づいたか? あれらは、ただの化け物ではない。' },\r\n28:       { speaker: '綴', text: '待ち続ける者。守り続ける者。呼び続ける者。常夜は、千年分の「終われなかった想い」で満ちている。' },\r\n29:       { speaker: '綴', text: '石碑を探せ。土地の縁起を知れば、なぜあれが終われぬのか——鎮め方も、見えてくる。' },\r\n30:       { speaker: '綴', text: '想いが凝れば、化けて主となる。……ならば、と俺はときどき恐ろしくなる。' },\r\n31:       { speaker: '綴', text: '頂に千年座す、あの「神」もまた——終われずにいる、ただの誰かではないのか、とな。' },\r\n32:       { speaker: '', text: 'その一言は、口にした端から夜に吸われて消えた。綴はそれを、黙って家譜の隅に書き留めた。' },\r\n33:     ],\r\n34:   },\r\n35:   {\r\n36:     id: 'ch3',\r\n37:     title: '第三章 星喰いの影',\r\n38:     lines: [\r\n39:       { speaker: '', text: '夢を見た。空の頂で、巨大な面が、ゆっくりとこちらを向く夢だ。' },\r\n40:       { speaker: '玄冬(?)', text: '『……クルナ。……コレ以上、チカヨルナ』' },\r\n41:       { speaker: '', text: '威嚇では、なかった。あれはむしろ——懇願に、聞こえた。' },\r\n42:       { speaker: '綴', text: '玄冬が「言葉」を持つなど、千年、誰ひとり聞いたことがない。……何かが、おかしい。' },\r\n43:       { speaker: '', text: '面の声の、さらに奥。糸のように細い楽の音がひとすじ。誰かが、宥めるように爪弾いていた。' },\r\n44:       { speaker: '綴', text: 'この夢を見たあんたは、頂に届く前に逝くかもしれん。だから書いておく。次の代が、続きを見るために。' },\r\n45:     ],\r\n46:   },\r\n47:   {\r\n48:     id: 'ch4',\r\n49:     title: '第四章 楽士の秘密',\r\n50:     lines: [\r\n51:       { speaker: '綴', text: '家譜の、いちばん最初の頁を開いた。名だけが擦れている。初代は、旅の楽士だったと、そこに在る。' },\r\n52:       { speaker: '綴', text: '千年前、その楽士は単身で御山に登った。そして——降りて、こなかった。' },\r\n53:       { speaker: '綴', text: 'ずっと解せなんだ。誰も止められぬ星喰いを前に、この郷はなぜ千年も保ったのか。' },\r\n54:       { speaker: '綴', text: '……答えは、単純で、むごい。面の下で誰かが、内側から星喰いを抱き止めている。千年、たった独りで。' },\r\n55:       { speaker: '', text: '御山の風が運ぶあの楽の音は——その、独りの音だ。' },\r\n56:       { speaker: '綴', text: 'あんたらの産声を、辞世を、俺はこの手で書き留めてきた。……だが、な。' },\r\n57:       { speaker: '綴', text: 'それを俺の肩ごしに、千年ずっと聴いていた者がいたとしたら。どんな心地で、聴いていたと思う。' },\r\n58:       { speaker: '', text: '擦れていた墨が、夜露のように滲む。——汐里。これが、初代の名だ。' },\r\n59:     ],\r\n60:   },\r\n61:   {\r\n62:     id: 'ch5',\r\n63:     title: '第五章 頂へ',\r\n64:     lines: [\r\n65:       { speaker: '綴', text: '武功は届いた。御山への道が、ついに開いている。' },\r\n66:       { speaker: '綴', text: '行けば、千年の答えに会う。それが救いになるか、別れになるかは——あんたら次第だ。' },\r\n67:       { speaker: '綴', text: '思えば、遠い道だった。数え切れぬ八季が、みな、この一歩のためにあったのだな。' },\r\n68:       { speaker: '綴', text: '一つも、無駄ではなかった。逝った者の分まで、あんたらの灯は重くなっている。' },\r\n69:       { speaker: '綴', text: '家譜は、ここまで俺が書いた。この先の頁を綴じるのは——生きている、あんたらだ。' },\r\n70:       { speaker: '', text: '山の方から風が吹く。「急がないで」と、聞き覚えのある声が微かに混じった気がした。' },\r\n71:       { speaker: '', text: '一族の灯を束ね、頂を目指す時が来た。' },\r\n72:     ],\r\n73:   },\r\n74: ]\r\n75: \r\n76: // 結末3種 — 最終決戦(汐里)後の選択で分岐\r\n77: export type EndingType = 'cut' | 'save' | 'inherit'\r\n78: \r\n79: export const FINALE_CHOICES: { id: EndingType; label: string; desc: string }[] = [\r\n80:   { id: 'cut', label: '送る — 千年を終わらせる', desc: '一族の名を読み上げ、汐里と玄冬を看取り、常夜を終える。' },\r\n81:   { id: 'save', label: '救う — 共に封じ直す', desc: '一族の灯を分かち、汐里と共に封印を編み直す。夜は残るが、独りにはさせない。' },\r\n82:   { id: 'inherit', label: '継ぐ — 錠前を代わる', desc: '当主が汐里の座を継ぎ、汐里を千年ぶりに解放する。' },\r\n83: ]\r\n84: \r\n85: export const ENDINGS: Record<EndingType, { title: string; beats: string[] }> = {\r\n86:   cut: {\r\n87:     title: '結 — 夜明け',\r\n88:     beats: [\r\n89:       '汐里は微笑んで、楽を置いた。「……ありがとう。もう、来てくれたのね。私の、遠い遠い子どもたち」',\r\n90:       '当主は刃を納め、代わりに家譜を開いた。千年分の名を、一人ずつ、声に出して読み上げていく。',\r\n91:       '汐里は聴いている。子守唄に耳を澄ますように、ひとつ頷くごとに、その身が透きとおってゆく。',\r\n92:       '最後の名が読み終えられたとき、千年の演目が、終わった。星喰いは——眠るように、消えた。',\r\n93:       '「もう、いいのね。もう、休んでいいのね」玄冬の面が砕け、空に、亀裂のような光が走った。',\r\n94:     ],\r\n95:   },\r\n96:   save: {\r\n97:     title: '結 — 二人の錠前',\r\n98:     beats: [\r\n99:       '「独りで千年は、長すぎた」当主はそう言って、汐里の隣に灯を置いた。',\r\n100:       '一族の灯が御山に環をなし、封印は千年ぶりに編み直された。今度は、誰も独りではない。',\r\n101:       '夜は残った。だが郷の者は言う——最近の夜は、どこか温かい、と。',\r\n102:       '御山の頂からは時折、二重奏の楽の音が降りてくる。',\r\n103:     ],\r\n104:   },\r\n105:   inherit: {\r\n106:     title: '結 — 灯継ぎ',\r\n107:     beats: [\r\n108:       '「千年、ようやった。……あとは、うちの家系に任せろ」',\r\n109:       '当主は面を受け取り、頂の座についた。汐里は千年ぶりに山を降りた。',\r\n110:       '郷に戻った汐里を、家族たちが迎える。彼女は泣きながら、初めて温かい飯を食べた。',\r\n111:       '頂の面の下で、新しい錠前が静かに歌っている。その歌は、代替わりのたびに引き継がれ、続いていく。',\r\n112:     ],\r\n113:   },\r\n114: }\r\nFILE src/core/data/dreams.ts\r\n1: import type { GameData } from '../types'\r\n2: \r\n3: // ============================================================\r\n4: // 夢渡りの連作 — 千年前の真実(汐里と玄冬の物語)を、看取りの数だけ深く見る\r\n5: // 設計: docs/STORY_dreams/BEATS.md(/story 2026-07-06)\r\n6: // 発火: 看取り(deathシーン)の直後、未読の解禁済み一篇だけを pendingScenes に積む。\r\n7: // 解禁: deaths(一族の累計死者数) / gen(到達世代) の OR — gossipと同型。\r\n8: // 既読: flags[`dreamEp_${id}`] = true(既存スキーマRecord<string,boolean|number>に適合)。\r\n9: // 夢1(既存DreamScene: 星骸の谷討伐で発火)は無改変 — 本連作はその「続き」。\r\n10: // ============================================================\r\n11: \r\n12: export interface DreamEpisode {\r\n13:   id: string\r\n14:   title: string\r\n15:   unlock: { deaths?: number; gen?: number } // ORで判定\r\n16:   requiresPrevious: 'dream:intro' | string\r\n17:   visualId?: string\r\n18:   bg?: string\r\n19:   visualDescription?: string\r\n20:   beats: string[]\r\n21: }\r\n22: \r\n23: export const DREAM_EPISODES: DreamEpisode[] = [\r\n24:   {\r\n25:     id: 'yume_tabibito',\r\n26:     title: '夢渡り・弐 — 旅の楽士',\r\n27:     unlock: { deaths: 1 },\r\n28:     requiresPrevious: 'dream:intro',\r\n29:     visualId: 'STORY-DREAM-02',\r\n30:     bg: 'cg_dream_02.jpg',\r\n31:     visualDescription: '千年前の薄暮、濃藍の旅装で琵琶を背負う若い楽士が、星の音に足を止め、まだ火のない大燈籠の基壇と燈ノ郷を静かに見下ろしている。',\r\n32:     beats: [\r\n33:       '灯を、ひとつ見送った夜。——どこかで、唄が聴こえる。',\r\n34:       '夢の頂。家譜の最初の頁と同じ顔をした楽士が、琵琶の絃を締め直しながら、こちらを見ずに言う。',\r\n35:       '「見送ってきたのね。いい顔よ。……悲しみはね、ちゃんと悲しむと、灯になるの」',\r\n36:       '「今夜は昔語りをしましょうか。千年前——私がまだ、ただの旅の楽士だったころの話」',\r\n37:       '記憶が、絃の音にほどけていく。',\r\n38:       '——若い楽士が、埃だらけの草鞋で峠を越えてくる。背には琵琶がひとつ。それが全財産。',\r\n39:       '村々を巡り、死者の出た家の前で唄う。無念を鎮める唄。誰に習ったのでもない、生まれつきの唄。',\r\n40:       '「報酬は一晩の飯と屋根。それで足りたわ。唄えば、死んだ人の顔がやわらぐ。……それが、好きだった」',\r\n41:       'ある夕暮れ、楽士は小さな郷に辿り着く。燈ノ郷。郷を囲む古い燈籠たちが、名の由来だという。',\r\n42:       '「あの郷はね、星がよく聴こえたの。……ええ、『聴こえた』のよ。星の音が」',\r\n43:       '楽士は郷はずれの山の頂で琵琶を弾いた。星々が、すこし近づいた気がした。',\r\n44:       '「それが、始まり。——続きは、また灯を見送った夜に」',\r\n45:     ],\r\n46:   },\r\n47:   {\r\n48:     id: 'yume_sora_no_ko',\r\n49:     title: '夢渡り・参 — 空の子',\r\n50:     unlock: { deaths: 3 },\r\n51:     requiresPrevious: 'yume_tabibito',\r\n52:     visualId: 'STORY-DREAM-03',\r\n53:     bg: 'cg_dream_03.jpg',\r\n54:     visualDescription: '星降る山頂で若い楽士が琵琶を奏で、名も面も持たない夜空の子が少し離れて聴く。二人の間の静かな空白に、最初の信頼が生まれる。',\r\n55:     beats: [\r\n56:       'また、ひとつ灯を見送った。……頂の夢が、近くなる。',\r\n57:       '「来たわね。今夜は——あの子の話をしましょう」',\r\n58:       '——楽士が頂で唄いはじめて、幾夜目か。ふと、気配がした。',\r\n59:       '星々の間から、するりと、何かが降りてきた。形は子どものよう。体は夜空を切り抜いたように昏く、その中で星屑がまたたいている。',\r\n60:       '声はなかった。ただ、じっと唄を聴いている。楽士も、弾く手を止めなかった。',\r\n61:       '「怖くなかったのか、ですって? ……怖いものですか。音楽を聴く顔に、悪いものはいないわ」',\r\n62:       '夜ごと、それは降りてきた。唄が終わると、名残惜しそうに空へ帰ってゆく。',\r\n63:       '「名前を訊いたら、首をかしげたの。星々の間に生まれて、名前をくれる人が、いなかったのね」',\r\n64:       '「だから私がつけたわ。——玄冬(げんとう)。冬の夜空がいちばん、透きとおって綺麗だから」',\r\n65:       '玄冬は、その名を何度も口の中で転がして——笑った、ように見えた。',\r\n66:       '「……ええ。あの子は、笑うのよ。あなたたちが討とうとしている、あの玄冬はね」',\r\n67:     ],\r\n68:   },\r\n69:   {\r\n70:     id: 'yume_futari',\r\n71:     title: '夢渡り・肆 — ふたりの演目',\r\n72:     unlock: { deaths: 5 },\r\n73:     requiresPrevious: 'yume_sora_no_ko',\r\n74:     visualId: 'STORY-DREAM-04',\r\n75:     bg: 'cg_dream_04.jpg',\r\n76:     visualDescription: '夢の中で季節を重ねて成長した玄冬が、楽士の琵琶へ星の明滅で拍子を返す。二人の手と金の星の弧が、秘密の二重奏を夜空へ広げる。',\r\n77:     beats: [\r\n78:       '灯がまた、ひとつ。……夢は、もう待っている。',\r\n79:       '「今夜はいちばん、いい話。いちばん短くて、いちばん、いい話よ」',\r\n80:       '夢の中で季節が巡る。玄冬は一夜で姿を変えたのではなく、唄を聴きに通った長い時の中で、少しずつ成長していた。',\r\n81:       '——玄冬は唄を覚えた。声ではなく、体の中の星屑を明滅させて、拍子をとることを。',\r\n82:       '楽士が弾き、玄冬が瞬き、夜空の星々がそれに和す。',\r\n83:       '頂だけの、誰も知らない演目。郷の人々は「近ごろ星がよく瞬く」と首をかしげるだけだった。',\r\n84:       '「贅沢な観客だったわ。空ぜんぶが、私の楽団だった」',\r\n85:       'ある夜、玄冬がはじめて声を出した。拙い、風の鳴るような声で、言った。',\r\n86:       '「——あなたの唄は、星より、明るい」',\r\n87:       '楽士は笑って、礼を言って、それから少しだけ、泣いた。',\r\n88:       '「旅の楽士はね、褒められ慣れていないの。……あの言葉だけは、千年経っても、灯みたいに消えないわ」',\r\n89:       '「覚えておいて。あの子は、私の唄を『明るい』と言った。——それが、ぜんぶの始まりで、ぜんぶの終わりの、種だった」',\r\n90:     ],\r\n91:   },\r\n92:   {\r\n93:     id: 'yume_ue',\r\n94:     title: '夢渡り・伍 — 飢え',\r\n95:     unlock: { deaths: 8 },\r\n96:     requiresPrevious: 'yume_futari',\r\n97:     visualId: 'STORY-DREAM-05',\r\n98:     bg: 'cg_dream_05.jpg',\r\n99:     visualDescription: '胸の星が薄れた玄冬は、小さな星を両手で抱いて震える。遅れて頂へ着いた楽士が遠くからその姿を見つめ、言えなかった飢えに気づく。',\r\n100:     beats: [\r\n101:       '見送った灯の数だけ、夢は深くなる。',\r\n102:       '「……今夜の話は、すこし、つらいわ。それでも聴く? ——聴くわよね。あなたは、私の子だもの」',\r\n103:       '——玄冬は、星の光を食べて生きるものだった。',\r\n104:       '空にいれば、困らない。星は無数にあり、光は満ちている。',\r\n105:       'けれど地上に降りて、唄を聴いている間——あの子は、何も食べていなかった。',\r\n106:       '「気づいてやれなかった。あの子は言わなかったし、私は、ただの人間だったから」',\r\n107:       '飢えは、静かに積もった。唄を愛するほど。地上にいる時間が、延びるほど。',\r\n108:       'ある夜、玄冬はふらりと空へ戻り——小さな星を、ひとつ、呑んだ。',\r\n109:       '頂へ戻ってきたあの子は、震えながら言った。「……ごめんなさい。でも、とても、あたたかかった」',\r\n110:       '「私は『いいのよ』と言ったわ。星なんて、数えきれないほどあるもの。……そう言ってしまったのよ。私が」',\r\n111:       '夜空の星が、ひとつ、欠けていた。誰も気づかない。私と、あの子のほかは。',\r\n112:     ],\r\n113:   },\r\n114:   {\r\n115:     id: 'yume_taiyou',\r\n116:     title: '夢渡り・陸 — 太陽の日',\r\n117:     unlock: { deaths: 12 },\r\n118:     requiresPrevious: 'yume_ue',\r\n119:     visualId: 'STORY-DREAM-06',\r\n120:     bg: 'cg_dream_06.jpg',\r\n121:     visualDescription: '藍夜へ沈む真昼、涙を流す玄冬が欠けゆく太陽へ手を伸ばす。凍る郷を背に、稜線の楽士は琵琶を下ろし、自分の唄が招いた破局を悟る。',\r\n122:     beats: [\r\n123:       '灯の数が、夢の深さになる。……もう、底が近い。',\r\n124:       '「今夜は——あの日の話。心して聴きなさい」',\r\n125:       '——ひとつが、ふたつになった。ふたつが、十になった。',\r\n126:       '郷の年寄りだけが気づいた。「北の空の、あの星がない」——子どもらは、はじめから無かった顔で笑っていた。',\r\n127:       '飢えは、食べるほどに深くなった。星の光では、もう足りない。地の唄を知った体は、もっとあたたかいものを欲しがった。',\r\n128:       '「あの子は、泣きながら食べていたわ。泣きながら食べるものを、どうやって責めればいいの」',\r\n129:       'そしてあの朝——玄冬は、いちばん大きな星に、手を伸ばした。',\r\n130:       '太陽が、欠けていく。真昼の郷に夜が落ちる。鳥が鳴きやみ、井戸の水が凍りはじめる。',\r\n131:       '人々の悲鳴の中で、楽士はひとり空を見上げて、悟った。',\r\n132:       '「あの子を地上に引き留めたのは、私の唄。飢えさせたのも、私の唄。——常夜はね、私が招いたのよ」',\r\n133:       '「郷の誰も、それを知らない。夢は、頂に立つべき血にしか渡れないの。……綴にも、内緒よ」',\r\n134:       '世界から、朝が消えた。千年の夜の、最初の夜だった。',\r\n135:     ],\r\n136:   },\r\n137:   {\r\n138:     id: 'yume_maki',\r\n139:     title: '夢渡り・漆 — 薪の契り',\r\n140:     unlock: { deaths: 16, gen: 5 },\r\n141:     requiresPrevious: 'yume_taiyou',\r\n142:     visualId: 'STORY-DREAM-07',\r\n143:     bg: 'cg_dream_07.jpg',\r\n144:     visualDescription: '面を着けた玄冬を楽士が環の内側から抱き止め、傍らに琵琶を置く。胸から流れた金の寿命の火が山を明るく下り、大燈籠へ初めて灯る。',\r\n145:     beats: [\r\n146:       'ここまで灯を見送って、ようやく届く夢がある。',\r\n147:       '「……今夜で、昔語りはおしまい。最後は、私の罪と、あなたたちの呪いの話」',\r\n148:       '——郷人たちは楽士に縋った。あなたの唄は魔性さえ鎮める。どうか、あの星喰いを殺してくれ、と。',\r\n149:       '楽士は頂に登った。琵琶を、構えた。玄冬は逃げもせず、泣き腫らした顔で、そこにいた。',\r\n150:       '「殺せなかったわ。……当たり前でしょう。あの子は、私の唄を、星より明るいと言った子よ」',\r\n151:       'だから楽士は、第三の道を選んだ。',\r\n152:       '己の寿命を薪にして、大燈籠に千年の火を灯す。郷を、常夜の凍えから守る火を。',\r\n153:       'そして玄冬に面をかぶせ、その体ごと、頂で抱きしめた。飢えが二度と星に届かぬように。内側から、千年、抱き続けるために。',\r\n154:       '「寿命を薪にした報いは、血に残った。私の血を継ぐ子は、八つの季節しか生きられない。人と結ばれて、血を薄めることも、できない」',\r\n155:       '「だからあなたたちは、星と契って生まれてくる。……ごめんなさい、とは言わないわ。あなたたちは、私の誇りだもの」',\r\n156:       '「憎んでくれても、いいのよ。それでも私は——千年前のあの夜に戻っても、同じことをする」',\r\n157:     ],\r\n158:   },\r\n159:   {\r\n160:     id: 'yume_itadaki',\r\n161:     title: '夢渡り・終 — 千年の頂で',\r\n162:     unlock: { deaths: 22, gen: 8 },\r\n163:     requiresPrevious: 'yume_maki',\r\n164:     visualId: 'STORY-DREAM-08',\r\n165:     bg: 'cg_dream_08.jpg',\r\n166:     visualDescription: '千年後、疲れた楽士が初めて琵琶を石へ置き、見えない子孫へ手を伸ばす。背後の面を着けた玄冬と、歴代の灯が連なる登山路が頂へ続く。',\r\n167:     beats: [\r\n168:       'すべての昔語りが終わった夢の頂は、静かだった。',\r\n169:       '楽士は琵琶を、そっと地面に置く。——はじめて見る仕草だった。',\r\n170:       '「千年、弾き続けたの。あの子が眠っていられるように。……でもね。そろそろ、腕が疲れたわ」',\r\n171:       '「面の下で、あの子はまだ飢えている。私の力が尽きれば、常夜は次の千年へ続く」',\r\n172:       '「だから——頂へいらっしゃい。あなたたちの代で、終わらせるの」',\r\n173:       '「着いたら、好きに選びなさい。二人を送るか、腕を貸すか、それとも——私の座を、継ぐか」',\r\n174:       '「どれを選んでも、恨まないわ。千年ぶんの家譜が、あなたたちに、選ぶ資格をくれる」',\r\n175:       '「ただ、ひとつだけ。どの道を選んでも——私たちを、看取って。憎んだままで、終わらせないで」',\r\n176:       '楽士は立ち上がり、こちらへ歩いてきて——額に、そっと指を置いた。',\r\n177:       '「あなたたちの灯は、私の唄より明るい。……あの子にも、聴かせてやりたいわ」',\r\n178:       '目が覚める。頬に、涙のあとがあった。誰のものかは、わからなかった。',\r\n179:     ],\r\n180:   },\r\n181: ]\r\n182: \r\n183: export function dreamEpisodeById(id: string): DreamEpisode | undefined {\r\n184:   return DREAM_EPISODES.find((e) => e.id === id)\r\n185: }\r\n186: \r\n187: // 未読かつ解禁済みの最初の一篇を返す(配列順=物語順に一篇ずつ)。\r\n188: // 夢1(既存DreamScene)の完読後だけ連作を解禁し、未読の先行篇を飛ばさない。\r\n189: export function nextDreamEpisode(data: GameData): DreamEpisode | null {\r\n190:   if (!data.flags.dreamSeen) return null\r\n191:   const deaths = data.family.filter((c) => !c.alive).length\r\n192:   const gen = data.family.length > 0 ? Math.max(...data.family.map((c) => c.gen)) : 0\r\n193:   const ep = DREAM_EPISODES.find((candidate) => !data.flags[`dreamEp_${candidate.id}`])\r\n194:   if (!ep) return null\r\n195:   const previousDone = ep.requiresPrevious === 'dream:intro'\r\n196:     ? !!data.flags.dreamSeen\r\n197:     : !!data.flags[`dreamEp_${ep.requiresPrevious}`]\r\n198:   if (!previousDone) return null\r\n199:   const byDeaths = ep.unlock.deaths !== undefined && deaths >= ep.unlock.deaths\r\n200:   const byGen = ep.unlock.gen !== undefined && gen >= ep.unlock.gen\r\n201:   return byDeaths || byGen ? ep : null\r\n202: }\r\nFILE src/core/narrative.ts\r\n1: import type {\r\n2:   Character, GameData, NarrativeProgress, NarrativeScene, NarrativeStage,\r\n3: } from './types'\r\n4: import { CHAPTERS } from './data/story'\r\n5: import { DREAM_EPISODES } from './data/dreams'\r\n6: import { REGIONS } from './data/regions'\r\n7: \r\n8: export type NarrativeChannel = 'ambient' | 'discovery' | 'scene'\r\n9: export type NarrativeTrigger =\r\n10:   | { kind: 'home' }\r\n11:   | { kind: 'depart'; regionId: string }\r\n12:   | { kind: 'dungeonEnter'; regionId: string; firstVisit: boolean }\r\n13:   | { kind: 'monument'; regionId: string; fragment: number }\r\n14:   | { kind: 'boss'; regionId: string; phase: 'before' | 'victory' }\r\n15:   | { kind: 'return'; regionId: string; bossDown: boolean }\r\n16:   | { kind: 'villageTalk'; villagerId: string }\r\n17:   | { kind: 'inherit'; generation: number }\r\n18: \r\n19: export interface NarrativeBeat {\r\n20:   id: string\r\n21:   stage: NarrativeStage\r\n22:   channel: NarrativeChannel\r\n23:   trigger: NarrativeTrigger\r\n24:   text: string\r\n25:   speaker?: string\r\n26:   once?: boolean\r\n27:   priority: number\r\n28:   requires?: string[]\r\n29:   blocks?: string[]\r\n30:   recap?: string\r\n31: }\r\n32: \r\n33: const EMPTY_RESONANCE = { cut: 0, save: 0, inherit: 0 }\r\n34: const EMPTY_METRICS = {\r\n35:   scenesOpened: 0,\r\n36:   scenesCompleted: 0,\r\n37:   scenesSkipped: 0,\r\n38:   scenesDeferred: 0,\r\n39:   totalSceneMs: 0,\r\n40:   maxDeferred: 0,\r\n41:   monthsAdvanced: 0,\r\n42:   interruptedAfterMonth: 0,\r\n43: }\r\n44: \r\n45: export function narrativeSceneId(scene: NarrativeScene): string {\r\n46:   switch (scene.kind) {\r\n47:     case 'birth': return `birth:${scene.charId}`\r\n48:     case 'death': return `death:${scene.charId}`\r\n49:     case 'ceremony': return `ceremony:${scene.charId}`\r\n50:     case 'jobrite': return `jobrite:${scene.charId}`\r\n51:     case 'dream': return 'dream:intro'\r\n52:     case 'dreamEp': return `dream:${scene.epId}`\r\n53:     case 'life': return scene.narrativeId ?? `life:${scene.title}`\r\n54:   }\r\n55: }\r\n56: \r\n57: export function narrativeScenePriority(scene: NarrativeScene): number {\r\n58:   if (scene.kind === 'death') return 0\r\n59:   if (scene.kind === 'birth' || scene.kind === 'ceremony' || scene.kind === 'jobrite') return 1\r\n60:   if (scene.kind === 'life' && scene.narrativeId?.startsWith('ch')) return 2\r\n61:   if (scene.kind === 'dream' || scene.kind === 'dreamEp') return 3\r\n62:   return 4\r\n63: }\r\n64: \r\n65: export function narrativeStageOf(data: Pick<GameData, 'flags'>): NarrativeStage {\r\n66:   const f = data.flags\r\n67:   if (f.ch5_completed || f.dreamEp_yume_itadaki) return 'summit'\r\n68:   if (f.ch4_completed || f.dreamEp_yume_maki) return 'fire_vow'\r\n69:   if (f.ch3_completed || f.dreamEp_yume_futari || f.dreamEp_yume_ue || f.dreamEp_yume_taiyou) return 'duet_hunger'\r\n70:   if (f.ch2_completed || f.dreamEp_yume_tabibito || f.dreamEp_yume_sora_no_ko) return 'name'\r\n71:   return 'one_light'\r\n72: }\r\n73: \r\n74: function completedFromFlags(data: GameData, legacy: boolean): string[] {\r\n75:   const ids: string[] = []\r\n76:   for (const chapter of CHAPTERS) {\r\n77:     if (data.flags[`${chapter.id}_completed`] || (legacy && data.flags[chapter.id])) ids.push(chapter.id)\r\n78:   }\r\n79:   if (data.flags.dreamSeen) ids.push('dream:i