Ids = data.codex?.gods ?? []\r\n87:   // M33: 当主の最強素質を伸ばす神を推奨★表示(灯型/家業と同文法)。当主未選択(parent=null)なら推奨なし。\r\n88:   const recommendStat = parent ? strongestPotential(parent.potential) : null\r\n89: \r\n90:   // 奉納点(cost)昇順 — 俺屍の神名リスト様式。費用内/未契約は表示の絞り込みのみ(選択可否には無関係)\r\n91:   const filteredGods = GODS.filter((g) => {\r\n92:     if (rankTab !== 0 && g.rank !== rankTab) return false\r\n93:     if (elemChip !== null && g.element !== elemChip) return false\r\n94:     if (onlyAffordable && data.hoto < pactCost(g, data.godAffinity[g.id] ?? 0)) return false\r\n95:     if (onlyUncontracted && contractedGodIds.includes(g.id)) return false\r\n96:     return true\r\n97:   }).sort((a, b) => a.cost - b.cost)\r\n98:   const recommendedGods = [...GODS]\r\n99:     .filter((candidate) => godUnlocked(candidate, data))\r\n100:     .sort((a, b) => {\r\n101:       const score = (candidate: God) => {\r\n102:         const effectiveCost = pactCost(candidate, data.godAffinity[candidate.id] ?? 0)\r\n103:         const statMatch = recommendStat != null && topBias(candidate.statBias)[0]?.[0] === recommendStat ? 500 : 0\r\n104:         const affordable = effectiveCost <= data.hoto ? 250 : 0\r\n105:         const newBond = contractedGodIds.includes(candidate.id) ? 0 : 30\r\n106:         return statMatch + affordable + newBond - effectiveCost\r\n107:       }\r\n108:       return score(b) - score(a) || a.cost - b.cost\r\n109:     })\r\n110:     .slice(0, 3)\r\n111:   const shownGods = showAllGods ? filteredGods : recommendedGods\r\n112: \r\n113:   const prediction = useMemo(\r\n114:     () => (parent && god ? predictChild(parent, god) : null),\r\n115:     [parent, god],\r\n116:   )\r\n117: \r\n118:   // 実ステップ(壱親/弐星/参見立て) — 選択状態から導出。ロジック非依存の表示専用(M18)\r\n119:   const pactStep: 1 | 2 | 3 = !parent ? 1 : !god ? 2 : 3\r\n120: \r\n121:   // M26 §9.5: 契るCTAは確認Sheetを開くだけ(M26-P0-01是正)。doPactは確認Sheetの実行CTAからのみ呼ぶ。\r\n122:   const openPactConfirm = () => {\r\n123:     if (!parent || !god || ritual || confirmOpen) return\r\n124:     setConfirmOpen(true)\r\n125:   }\r\n126: \r\n127:   // 確認Sheetの実行CTA(data-testid=\"pact-confirm\")専用。pactFiredRefで二重実行を防ぎ、\r\n128:   // 実行後は即Sheetを閉じて演出へ入る — 演出中はActionDockのCTAもritual状態で無効化される。\r\n129:   const confirmPact = () => {\r\n130:     if (!parent || !god || ritual || pactFiredRef.current) return\r\n131:     pactFiredRef.current = true\r\n132:     setConfirmOpen(false)\r\n133:     setRitual(true)\r\n134:     setTimeout(() => {\r\n135:       doPact(parent.id, god.id)\r\n136:       setRitual(false)\r\n137:       pactFiredRef.current = false\r\n138:     }, 1100)\r\n139:   }\r\n140: \r\n141:   // 画面下固定CTA(ActionDock)の状態 — 未達理由は1行のみ、優先順位: 親→星→奉燈(M18)\r\n142:   const dockCost = god ? pactCost(god, data.godAffinity[god.id] ?? 0) : 0\r\n143:   const dockShortfall = god ? Math.max(0, dockCost - data.hoto) : 0\r\n144:   const dockNote = !parent\r\n145:     ? '親を選べ'\r\n146:     : !god\r\n147:       ? '星神を選べ'\r\n148:       : dockShortfall > 0\r\n149:         ? `奉燈があと${dockShortfall}足りない`\r\n150:         : undefined\r\n151:   const dockReady = Boolean(parent && god && dockShortfall === 0 && !ritual)\r\n152:   const dockLabel = parent && god && dockShortfall === 0\r\n153:     ? `${parent.name} × ${god.name} ／ 奉燈${dockCost} ／ 契る`\r\n154:     : '契る'\r\n155: \r\n156:   return (\r\n157:     <div className=\"screen pact-screen pact-has-dock\">\r\n158:       <NightBackdrop bg={gameImg(HOME_BG)} />\r\n159:       <h1 className=\"season-label\" style={{ marginBottom: 14 }}>交神の儀</h1>\r\n160:       <TsuzuriLine text=\"星神と契れば、翌月に子が生まれる。血潮は親と神から流れ込む — 誰の血を、どの星に継がせる?\" />\r\n161: \r\n162:       <PactSteps step={pactStep} />\r\n163: \r\n164:       <Panel title=\"契る者を選ぶ\">\r\n165:         <div className=\"exp-party\">\r\n166:           {adults.map((c) => (\r\n167:             <CharCard\r\n168:               key={c.id}\r\n169:               char={c}\r\n170:               seasonIndex={data.seasonIndex}\r\n171:               compact\r\n172:               selected={parentId === c.id}\r\n173:               onClick={() => setParentId(c.id)}\r\n174:             />\r\n175:           ))}\r\n176:         </div>\r\n177:       </Panel>\r\n403: // M26 §9.5: 星契り最終確認 — 契るCTAはここでのみdoPactを呼ぶ(誤操作是正 M26-P0-01)。\r\n404: // 親の顔・名前・残り灯/神の立ち絵・名前・縁/奉燈の現在→残り/子が生まれる月/見立ての強み弱みを一望させ、\r\n405: // 「この月の行いとして確定し、月が進む」ことを最後に一文で示す。\r\n406: function PactConfirmSheet({\r\n407:   parent, god, data, prediction, cost, onClose, onConfirm,\r\n408: }: {\r\n409:   parent: Character\r\n410:   god: God\r\n411:   data: GameData\r\n412:   prediction: Record<StatKey, [number, number]>\r\n413:   cost: number\r\n414:   onClose: () => void\r\n415:   onConfirm: () => void\r\n416: }) {\r\n417:   const affinity = Math.floor(data.godAffinity[god.id] ?? 0)\r\n418:   const isMax = affinity >= GOD_MAX_AFFINITY\r\n419:   return (\r\n420:     <Sheet title=\"星契り、最後の確かめ\" onClose={onClose} closeLabel=\"やめる\">\r\n421:       <div className=\"pact-confirm-pair\">\r\n422:         <CharCard char={parent} seasonIndex={data.seasonIndex} compact />\r\n423:         <div className=\"pact-confirm-god\">\r\n424:           <MaybeImg\r\n425:             src={godPresentationImg(god.portrait, isMax)}\r\n426:             className=\"pact-confirm-god-img\"\r\n427:           />\r\n428:           <span className=\"pact-confirm-god-name\">{god.name}</span>\r\n429:           <span className=\"pact-confirm-god-aff\">縁 {affinity}</span>\r\n430:         </div>\r\n431:       </div>\r\n432:       <CompareRow label=\"奉燈\" before={data.hoto} after={data.hoto - cost} />\r\n433:       <p className=\"confirm-lead\">\r\n434:         子は{seasonLabel(data.seasonIndex + 1)}に生まれる。{predictionSummary(prediction)}\r\n435:       </p>\r\n436:       <p className=\"confirm-lead\">この月の行いとして確定し、月が進む。</p>\r\n437:       <div className=\"confirm-actions\">\r\n438:         <button className=\"btn btn-ghost\" onClick={onClose}>やめる</button>\r\n439:         <button className=\"btn btn-main\" data-testid=\"pact-confirm\" onClick={onConfirm}>契る</button>\r\n440:       </div>\r\n441:     </Sheet>\r\n442:   )\r\nexport interface PactAvailability {\r\n  inspectable: boolean\r\n  contractable: boolean\r\n  reason?: string\r\n}\r\n\r\n/**\r\n * 星神の閲覧権と契約権を分離する。\r\n * 封印だけが詳細閲覧を妨げ、奉燈不足は契約CTAだけを止める。\r\n */\r\nexport function pactAvailability(unlocked: boolean, hoto: number, cost: number): PactAvailability {\r\n  if (!unlocked) return { inspectable: false, contractable: false, reason: 'この星はまだ封印されている' }\r\n  const shortfall = Math.max(0, cost - hoto)\r\n  if (shortfall > 0) {\r\n    return {\r\n      inspectable: true,\r\n      contractable: false,\r\n      reason: `奉燈があと${shortfall}足りない`,\r\n    }\r\n  }\r\n  return { inspectable: true, contractable: true }\r\n}\r\nsrc/core/types.ts:131:  bornSeason: number // 絶対季節インデックス\r\nsrc/core/types.ts:307:export const LIFESPAN_MONTHS = 24 // 廿四月の命(旧: 八季)\r\nsrc/core/inheritance.ts:2:import { LIFESPAN_MONTHS, STAT_LABELS } from './types'\nsrc/core/inheritance.ts:19:export const ADULT_MONTHS = 6 // 成人(初陣が許される月齢)\nsrc/core/inheritance.ts:27:export function ageOf(c: Character, seasonIndex: number): number {\nsrc/core/inheritance.ts:28:  return seasonIndex - c.bornSeason\nsrc/core/inheritance.ts:32:  return c.alive && ageOf(c, seasonIndex) >= ADULT_MONTHS\nsrc/core/inheritance.ts:36:  return LIFESPAN_MONTHS - ageOf(c, seasonIndex)\nsrc/core/inheritance.ts:41:  const age = Math.min(Math.max(ageOf(c, seasonIndex), 0), LIFESPAN_MONTHS - 1)\nsrc/core/inheritance.ts:87:  bornSeason: number,\nsrc/core/inheritance.ts:144:    bornSeason,\nsrc/core/inheritance.ts:166:  const withStats = recalcStats(child, bornSeason)\nsrc/core/inheritance.ts:176:export function makeFounder(bornSeason: number, rng: Rng): Character {\nsrc/core/inheritance.ts:183:    bornSeason: bornSeason - 9, // 既に9ヶ月生きている(残り15ヶ月)\nsrc/core/inheritance.ts:202:  const withStats = recalcStats(founder, bornSeason)\nsrc/core/inheritance.ts:212:  return designated ?? [...living].sort((a, b) => a.bornSeason - b.bornSeason || a.id.