r\n127:   const seen = [...new Set([...(data.narrative?.seen ?? []), ...completed])]\r\n128:   const archive = uniqueScenes([\r\n129:     ...(data.narrative?.archive ?? []),\r\n130:     ...completed.map(replayableSceneForId).filter((scene): scene is NarrativeScene => !!scene),\r\n131:   ]).filter(isReplayableNarrativeScene)\r\n132:   const deferred = [...(data.narrative?.deferred ?? [])]\r\n133:   const fallbackDeferredAt = data.lastPlayedAt ?? Date.now()\r\n134:   const deferredSince = Object.fromEntries(deferred.map((scene) => {\r\n135:     const id = narrativeSceneId(scene)\r\n136:     return [id, data.narrative?.deferredSince?.[id] ?? fallbackDeferredAt]\r\n137:   }))\r\n138:   const narrative: NarrativeProgress = {\r\n139:     stage: narrativeStageOf({ flags }),\r\n140:     seen,\r\n141:     queued: [...new Set(data.narrative?.queued ?? [])],\r\n142:     completed,\r\n143:     deferred,\r\n144:     archive,\r\n145:     deferredSince,\r\n146:     deferredReminderShown: [...new Set(data.narrative?.deferredReminderShown ?? [])],\r\n147:     active: data.narrative?.active,\r\n148:     activeOpenedAt: data.narrative?.activeOpenedAt,\r\n149:     activeReplay: data.narrative?.activeReplay,\r\n150:     monthTransitionPending: data.narrative?.monthTransitionPending,\r\n151:     resonance: { ...EMPTY_RESONANCE, ...(data.narrative?.resonance ?? {}) },\r\n152:     metrics: { ...EMPTY_METRICS, ...(data.narrative?.metrics ?? {}) },\r\n153:     generationQuestion: data.narrative?.generationQuestion,\r\n154:     lastReturn: data.narrative?.lastReturn,\r\n155:   }\r\n156:   return { ...data, flags, narrative }\r\n157: }\r\n158: \r\n159: /** crash/閉じるで表示中だった場面は読了にせず「灯の余白」へ戻す。 */\r\n160: export function recoverNarrativeOnLoad(data: GameData): GameData {\r\n161:   const migrated = migrateM34Narrative(data)\r\n162:   const n = migrated.narrative!\r\n163:   const deferred = [...n.deferred]\r\n164:   if (n.active && !n.activeReplay) deferred.unshift(n.active)\r\n165:   const interrupted = !!n.monthTransitionPending\r\n166: \r\n167:   // post-M34のch4 queue済みsaveを、legacy扱いせず匿名のまま再開可能にする。\r\n168:   const ch4Pending = migrated.flags.ch4 && !migrated.flags.ch4_completed\r\n169:   if (ch4Pending && !deferred.some((s) => narrativeSceneId(s) === 'ch4')) {\r\n170:     const ch4 = CHAPTERS.find((c) => c.id === 'ch4')\r\n171:     if (ch4) deferred.unshift({ kind: 'life', narrativeId: ch4.id, title: ch4.title, lines: ch4.lines })\r\n172:   }\r\n173:   const recoveredAt = Date.now()\r\n174:   const deferredSince = Object.fromEntries(uniqueScenes(deferred).map((scene) => {\r\n175:     const id = narrativeSceneId(scene)\r\n176:     return [id, n.deferredSince[id] ?? (n.active && narrativeSceneId(n.active) === id ? n.activeOpenedAt : undefined) ?? recoveredAt]\r\n177:   }))\r\n178:   return {\r\n179:     ...migrated,\r\n180:     narrative: {\r\n181:       ...n,\r\n182:       active: undefined,\r\n183:       activeOpenedAt: undefined,\r\n184:       activeReplay: undefined,\r\n185:       monthTransitionPending: false,\r\n186:       deferred: uniqueScenes(deferred),\r\n187:       deferredSince,\r\n188:       metrics: {\r\n189:         ...n.metrics,\r\n190:         interruptedAfterMonth: n.metrics.interruptedAfterMonth + (interrupted ? 1 : 0),\r\n191:         maxDeferred: Math.max(n.metrics.maxDeferred, deferred.length),\r\n192:       },\r\n193:     },\r\n194:   }\r\n195: }\r\n196: \r\n197: export function narrativeMetricSummary(data: GameData): {\r\n198:   averageSceneMs: number\r\n199:   skipRate: number\r\n200:   maxDeferred: number\r\n201:   interruptedAfterMonth: number\r\n202: } {\r\n203:   const metrics = migrateM34Narrative(data).narrative!.metrics\r\n204:   const closed = metrics.scenesCompleted + metrics.scenesSkipped + metrics.scenesDeferred\r\n205:   const resolved = metrics.scenesCompleted + metrics.scenesSkipped\r\n206:   return {\r\n207:     averageSceneMs: closed > 0 ? Math.round(metrics.totalSceneMs / closed) : 0,\r\n208:     skipRate: resolved > 0 ? metrics.scenesSkipped / resolved : 0,\r\n209:     maxDeferred: metrics.maxDeferred,\r\n210:     interruptedAfterMonth: metrics.interruptedAfterMonth,\r\n211:   }\r\n212: }\r\n213: \r\n214: export function uniqueScenes(scenes: NarrativeScene[]): NarrativeScene[] {\r\n215:   const ids = new Set<string>()\r\n216:   return scenes.filter((scene) => {\r\n217:     const id = narrativeSceneId(scene)\r\n218:     if (ids.has(id)) return false\r\n219:     ids.add(id)\r\n220:     return true\r\n221:   })\r\n222: }\r\n223: \r\n224: export function partitionNarrativeScenes(\r\n225:   progress: NarrativeProgress,\r\n226:   candidates: NarrativeScene[],\r\n227: ): { primary: NarrativeScene | null; deferred: NarrativeScene[]; queued: string[] } {\r\n228:   const existing = new Set([\r\n229:     ...progress.completed,\r\n230:     ...progress.deferred.map(narrativeSceneId),\r\n231:     ...(progress.active ? [narrativeSceneId(progress.active)] : []),\r\n232:   ])\r\n233:   const fresh = uniqueScenes(candidates)\r\n234:     .filter((scene) => !existing.has(narrativeSceneId(scene)))\r\n235:     .sort((a, b) => narrativeScenePriority(a) - narrativeScenePriority(b))\r\n236:   return {\r\n237:     primary: fresh[0] ?? null,\r\n238:     deferred: uniqueScenes([...progress.deferred, ...fresh.slice(1)]),\r\n239:     queued: [...new Set([...progress.queued, ...fresh.map(narrativeSceneId)])],\r\n240:   }\r\n241: }\r\n242: \r\n243: export function chapterIdByTitle(title: string): string | undefined {\r\n244:   return CHAPTERS.find((chapter) => chapter.title === title)?.id\r\n245: }\r\n246: \r\n247: export function generationQuestion(data: GameData): string {\r\n248:   const items = [\r\n249:     ...data.inventory,\r\n250:     ...data.family.flatMap((c) => Object.values(c.equipment).filter((x): x is NonNullable<typeof x> => !!x)),\r\n251:   ]\r\n252:   const inherited = items.some((item) => item.generation >= 2)\r\n253:   const completedLore = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n254:   const pacts = Object.values(data.godAffinity).filter((n) => n > 0).length\r\n255:   const bossDeeds = data.family.flatMap((c) => c.deeds).filter((x) => x.includes('討った')).length\r\n256:   if (inherited) return '受け継ぐことは、持ち主の役目まで背負うことか。'\r\n257:   if (completedLore >= 3) return '事情を知った刃は、知らぬ刃より優しいか。'\r\n258:   if (bossDeeds >= 2) return '終わらせることで救えるものは、本当にあるか。'\r\n259:   if (pacts >= 3) return '血を繋ぐことは、誰の願いなのか。'\r\n260:   return '短い命を誰かと分けるとき、何を次代へ残したいか。'\r\n261: }\r\n262: \r\n263: export function addResonance(\r\n264:   data: GameData,\r\n265:   kind: keyof NarrativeProgress['resonance'],\r\n266:   amount = 1,\r\n267: ): GameData {\r\n268:   const migrated = migrateM34Narrative(data)\r\n269:   const n = migrated.narrative!\r\n270:   return {\r\n271:     ...migrated,\r\n272:     narrative: {\r\n273:       ...n,\r\n274:       resonance: { ...n.resonance, [kind]: n.resonance[kind] + Math.max(0, amount) },\r\n275:     },\r\n276:   }\r\n277: }\r\n278: \r\n279: export function resonanceLine(data: GameData): string {\r\n280:   const r = migrateM34Narrative(data).narrative!.resonance\r\n281:   const max = Math.max(r.cut, r.save, r.inherit)\r\n282:   if (max <= 0) return 'この家は、答えを決めつけず、ここまで灯を運んできた。'\r\n283:   const leaders = (['cut', 'save', 'inherit'] as const).filter((key) => r[key] === max)\r\n284:   if (leaders.length !== 1) return 'この家は、終えることも、分けることも、継ぐことも重ねてきた。'\r\n285:   if (r.cut === max) return 'この家は、終われぬ主へ何度も幕を引いてきた。'\r\n286:   if (r.save === max) return 'この家は、傷ついた者を置いて行かない夜を重ねてきた。'\r\n287:   return 'この家は、名と道具と役目を、形を変えて渡してきた。'\r\n288: }\r\n289: \r\n290: export interface FamilyEcho {\r\n291:   label: string\r\n292:   text: string\r\n293: }\r\n294: \r\n295: export function familyFinaleEchoes(data: GameData): FamilyEcho[] {\r\n296:   const out: FamilyEcho[] = []\r\n297:   const firstDead = data.family\r\n298:     .filter((c) => !c.alive)\r\n299:     .sort((a, b) => (a.deathSeason ?? Number.MAX_SAFE_INTEGER) - (b.deathSeason ?? Number.MAX_SAFE_INTEGER))[0]\r\n300:   if (firstDead) {\r\n301:     out.push({ label: '最初に見送った灯', text: `${firstDead.name}${firstDead.lastWords ? `「${firstDead.lastWords.slice(0, 24)}」` : ` — ${firstDead.epitaph}`}` })\r\n302:   }\r\n303: \r\n304:   const ownership = new Map<string, { item: GameData['inventory'][number]; owner?: Character }>()\r\n305:   for (const item of data.inventory) ownership.set(item.id, { item })\r\n306:   for (const char of data.family) {\r\n307:     for (const item of Object.values(char.equipment)) if (item) ownership.set(item.id, { item, owner: char })\r\n308:   }\r\n309:   const heirloom = [...ownership.values()].sort((a, b) => b.item.generation - a.item.generation)[0]\r\n310:   if (heirloom && heirloom.item.generation > 0) {\r\n311:     out.push({\r\n312:       label: '最も長く継いだ形見',\r\n313:       text: `${heirloom.item.name} — ${heirloom.item.legacyFirstOwner ? `${heirloom.item.legacyFirstOwner}から` : ''}${heirloom.item.generation}代${heirloom.owner ? `、${heirloom.owner.name}の手にある` : ''}`,\r\n314:     })\r\n315:   }\r\n316: \r\n317:   const completedLore = Object.entries(data.loreFrags ?? {}).filter(([, n]) => n >= 3)\r\n318:   const nemesis = [...(data.nemeses ?? [])].sort((a, b) => b.level - a.level)[0]\r\n319:   if (nemesis) out.push({ label: '因縁を結んだ名', text: `${nemesis.name} — ${nemesis.victim}の仇` })\r\n320:   else if (completedLore[0]) out.push({ label: '真相まで読んだ土地', text: `${completedLore.length}つの土地の縁起を、最後まで記した` })\r\n321: \r\n322:   if (out.length === 0) {\r\n323:     const head = data.family.find((c) => c.alive && c.isHead) ?? data.family[0]\r\n324:     out.push({ label: 'ここへ運んだ灯', text: `${head?.name ?? '名もなき当主'}が、家の最初の答えを選ぶ` })\r\n325:   }\r\n326:   return out.slice(0, 3)\r\n327: }\r\n328: \r\n329: export function personalizedEndingBeat(data: GameData, ending: 'cut' | 'save' | 'inherit'): string {\r\n330:   const names = familyFinaleEchoes(data).map((echo) => echo.text.split(/[「—]/)[0].trim()).filter(Boolean)\r\n331:   const anchor = names.slice(0, 2).join('と') || (data.family[0]?.name ?? '名もなき一族')\r\n332:   if (ending === 'cut') return `${anchor}から続く名を読み上げ、二人を独りにしないまま、千年の夜を送った。`\r\n333:   if (ending === 'save') return `${anchor}が運んだ灯も封印へ重なった。今度の錠前は、誰か一人の犠牲ではない。`\r\n334:   return `${anchor}が継いだ名と役目は、頂と郷を往き来する新しい家譜になった。`\r\n335: }\r\n336: \r\n337: export function regionQuestion(regionName: string, loreFragments: number, cleared: boolean): string {\r\n338:   if (cleared) return `${regionName}で終われた想いを、次の夜へどう渡す。`\r\n339:   if (loreFragments >= 3) return `事情を知った今、${regionName}の主へどんな終わりを渡す。`\r\n340:   if (loreFragments > 0) return `${regionName}に残る声は、何を守り続けている。`\r\n341:   return `${regionName}の闇で、終われずにいるのは誰だ。`\r\n342: }\r\n343: \r\n344: export function bossEmotion(regionName: string, loreFragments: number): string {\r\n345:   if (loreFragments >= 3) return `${regionName}の主は、忘れまいとして立ちはだかる。`\r\n346:   if (loreFragments > 0) return `${regionName}の主は、待ち焦がれるようにこちらを見る。`\r\n347:   return `${regionName}の主は、名もない願いを守り抜こうとしている。`\r\n348: }\r\n349: \r\n350: export interface ReturnTrace {\r\n351:   kind: 'human' | 'land' | 'myth'\r\n352:   text: string\r\n353: }\r\n354: \r\n355: export function returnTraces(data: GameData): ReturnTrace[] {\r\n356:   const last = data.narrative?.lastReturn\r\n357:   if (!last) return []\r\n358:   const region = REGIONS.find((candidate) => candidate.id === last.regionId)\r\n359:   const party = last.partyIds\r\n360:     .map((id) => data.family.find((character) => character.id === id)?.name)\r\n361:     .filter((name): name is string => !!name)\r\n362:   const injured = last.injuredIds\r\n363:     .map((id) => data.family.find((character) => character.id === id)?.name)\r\n364:     .filter((name): name is string => !!name)\r\n365:   return [\r\n366:     {\r\n367:       kind: 'human',\r\n368:       text: injured.length > 0\r\n369:         ? `${injured.join('、')}は傷を負ったが、全員で家へ戻った。`\r\n370:         : `${party.join('、') || '一族'}は灯を携え、家へ戻った。`,\r\n371:     },\r\n372:     { kind: 'land', text: `${region?.name ?? last.regionId}の土と夜の匂いが、装束に残っている。` },\r\n373:     {\r\n374:       kind: 'myth',\r\n375:       text: last.bossDown\r\n376:         ? '終われなかった主へ幕を渡した。その静けさが、家譜に一行増えた。'\r\n377:         : 'まだ終われない声を背にした。次に会う時、何を知っているだろう。',\r\n378:     },\r\n379:   ]\r\n380: }\r\n381: \r\n382: export function legacyShioriRecap(data: GameData): string | null {\r\n383:   return data.flags.legacy_shiori_recap_pending\r\n384:     ? '家譜の初代の名は、汐里。千年前に御山へ登った楽士である。'\r\n385:     : null\r\n386: }\r\nFILE src/ui/Scenes.tsx\r\n1: import { useCallback, useEffect, useRef, useState } from 'react'\r\n2: import type { MouseEvent as ReactMouseEvent } from 'react'\r\n3: import { useGame } from '../core/store'\r\n4: import { audio } from '../core/audio'\r\n5: \r\n6: // M26 §14.3: 場面送りの誤タップ防止。\r\n7: // - 250msデバウンス: 前の進行から250ms以内の入力を捨てる(誤連打・誤タップ)。\r\n8: // - 背景クリックのみ進行: 本文/選択/入力/CTA上のクリックは対象外(e.target===e.currentTargetで判定)。\r\n9: // - Space/Enterで進行、Escapeは進行に使わない。\r\n10: // 進行の順序・分岐ロジックは一切変えない — 入力の受理条件だけを安全化する。\r\n11: function useSceneAdvance(canAdvance: boolean, doAdvance: () => void) {\r\n12:   const lastRef = useRef(0)\r\n13:   const advance = useCallback(() => {\r\n14:     if (!canAdvance) return\r\n15:     const now = performance.now()\r\n16:     if (now - lastRef.current < 250) return\r\n17:     lastRef.current = now\r\n18:     audio.se('page')\r\n19:     doAdvance()\r\n20:   }, [canAdvance, doAdvance])\r\n21:   useEffect(() => {\r\n22:     const onKey = (e: KeyboardEvent) => {\r\n23:       if (e.key !== ' ' && e.key !== 'Enter') return // Escape等は進行に使わない(§14.3)\r\n24:       const el = e.target as HTMLElement | null\r\n25:       // 入力欄(辞世の言葉等)やbutton上のキーは奪わない — Space入力/ボタン既定動作を壊さない\r\n26:       if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'BUTTON' || el.isContentEditable)) return\r\n27:       if (!canAdvance) return\r\n28:       e.preventDefault()\r\n29:       advance()\r\n30:     }\r\n31:     window.addEventListener('keydown', onKey)\r\n32:     return () => window.removeEventListener('keydown', onKey)\r\n33:   }, [advance, canAdvance])\r\n34:   // 背景(bare screen)クリックのみ進行 — 子要素(本文/CTA/入力)は e.target !== currentTarget で除外\r\n35:   const onBgClick = (e: ReactMouseEvent) => { if (e.target === e.currentTarget) advance() }\r\n36:   return { advance, onBgClick }\r\n37: }\r\n38: import { STAT_LABELS, yearOfMonth } from '../core/types'\r\n39: import type { StatKey } from '../core/types'\r\n40: import { godById, MOURNING } from '../core/data/gods'\r\n41: import { personalityById } from '../core/data/personalities'\r\n42: import { TOMOSHIGATA, tozaOf } from '../core/data/toza'\r\n43: import type { Tomoshigata, JobClassId } from '../core/types'\r\n44: import { JOB_CLASSES, JOB_ROLE_LABELS, JOB_SCHOOL_LABELS, recommendJob, jobById } from '../core/data/jobs'\r\n45: import type { JobRole } from '../core/data/jobs'\r\n46: import { skillById } from '../core/data/skills'\r\n47: import { MALE_NAMES, FEMALE_NAMES } from '../core/data/names'\r\n48: import { ENDINGS, FINALE_CHOICES } from '../core/data/story'\r\n49: import { DREAM_EPISODES, dreamEpisodeById } from '../core/data/dreams'\r\n50: import type { DreamEpisode } from '../core/data/dreams'\r\n51: import { familyFinaleEchoes, generationQuestion, personalizedEndingBeat, resonanceLine } from '../core/narrative'\r\n52: import { clearSave } from '../core/save'\r\n53: import { downloadChronicleCard } from './shareCard'\r\n54: import { MaybeImg, SceneBg } from './components'\r\n55: import { dreamImg, gameImg, prefetchGameImg } from './img'\r\n56: import './m17_scenes.css'\r\n57: import './scenes_vc3b.css'\r\n58: \r\n59: type SceneSurface = 'life-thread' | 'dream-edge' | 'flame-crossroads'\r\n60: \r\n61: const SCENE_SURFACE_LABEL: Record<SceneSurface, string> = {\r\n62:   'life-thread': '命の綴り',\r\n63:   'dream-edge': '夢の縁',\r\n64:   'flame-crossroads': '灯の岐路',\r\n65: }\r\n66: \r\n67: function SceneSurfaceHeader({\r\n68:   surface,\r\n69:   route,\r\n70:   title,\r\n71:   context,\r\n72:   titleClassName = '',\r\n73: }: {\r\n74:   surface: SceneSurface\r\n75:   route: string\r\n76:   title: string\r\n77:   context: string\r\n78:   titleClassName?: string\r\n79: }) {\r\n80:   return (\r\n81:     <header className=\"vc3b-surface-header\" data-scene-group=\"identity\" data-zone=\"scene-hero\">\r\n82:       <div className=\"vc3b-surface-signature\" data-surface-mark={surface} aria-hidden=\"true\">\r\n83:         <i key=\"thread-a\" /><i key=\"thread-b\" /><i key=\"thread-c\" />\r\n84:       </div>\r\n85:       <p className=\"vc3b-surface-kicker\">{SCENE_SURFACE_LABEL[surface]}<span>{route}</span></p>\r\n86:       <h1 className={`scene-title ${titleClassName}`.trim()}>{title}</h1>\r\n87:       <p className=\"vc3b-surface-context\">{context}</p>\r\n88:     </header>\r\n89:   )\r\n90: }\r\n91: \r\n92: // 章タイトル→cg_ch{n}.png の対応(CHAPTERSのtitleは固定文字列 — data/story.tsのid順と一致)\r\n93: const CHAPTER_BG: Record<string, string> = {\r\n94:   '第一章 常夜': 'cg_ch1.png',\r\n95:   '第二章 主たちの無念': 'cg_ch2.png',\r\n96:   '第三章 星喰いの影': 'cg_ch3.png',\r\n97:   '第四章 楽士の秘密': 'cg_ch4.png',\r\n98:   '第五章 頂へ': 'cg_ch5.png',\r\n99: }\r\n100: \r\n101: // 同じ場面(タイトル+台詞)なら常に同じ life_daily_*.png を引く簡易ハッシュ\r\n102: function stableDailyIndex(title: string, lines: { speaker: string; text: string }[]): number {\r\n103:   const s = title + lines.map((l) => l.speaker + l.text).join('')\r\n104:   let sum = 0\r\n105:   for (let i = 0; i < s.length; i++) sum += s.charCodeAt(i)\r\n106:   return sum % 20\r\n107: }\r\n108: \r\n109: // statBias上位2ステータス(灯型/家業カードの選択材料)\r\n110: function topStatBias(bias: Partial<Record<StatKey, number>>): [StatKey, number][] {\r\n111:   return (Object.entries(bias) as [StatKey, number][])\r\n112:     .filter(([, v]) => v > 0)\r\n113:     .sort((a, b) => b[1] - a[1])\r\n114:     .slice(0, 2)\r\n115: }\r\n116: function StatBiasChips({ bias }: { bias: Partial<Record<StatKey, number>> }) {\r\n117:   const top = topStatBias(bias)\r\n118:   if (top.length === 0) return null\r\n119:   return (\r\n120:     <span className=\"card-bias\">\r\n121:       {top.map(([k, v]) => (\r\n122:         <span key={k} className=\"bias-chip\">{STAT_LABELS[k]}+{v}</span>\r\n123:       ))}\r\n124:     </span>\r\n125:   )\r\n126: }\r\n127: \r\n128: function RiteReturnControl({ onReturn }: { onReturn: () => void }) {\r\n129:   return (\r\n130:     <nav className=\"vc3b-rite-return\" data-zone=\"rite-return\" aria-label=\"儀を中断する\">\r\n131:       <button type=\"button\" className=\"btn btn-ghost\" onClick={onReturn}>← 郷へ戻る</button>\r\n132:       <span>未決定の儀は「灯の余白」に残り、後から再開できる</span>\r\n133:     </nav>\r\n134:   )\r\n135: }\r\n136: \r\n137: // 誕生の兆し — 神の属性ごとに、生まれた刹那の星のしるしを彩る(bornSeasonで選ぶ)。\r\n138: const BIRTH_OMENS: Record<string, string[]> = {\r\n139:   fire: [\r\n140:     '産声の刹那、郷の大燈籠がひときわ強く燃え上がったという。',\r\n141:     '囲炉裏の火が、招くように子のほうへ揺れた。熱を宿す血の子だ。',\r\n142:     '赤子の掌は、生まれながらに温かかった。灯を絶やさぬ者になろう。',\r\n143:   ],\r\n144:   water: [\r\n145:     '生まれた子の頬に、どこからか雫がひとつ落ちた。星の涙か、恵みか。',\r\n146:     '産湯はいらぬほど、その子は静かに濡れて生まれてきた。',\r\n147:     '遠くの涸れ沢に、その夜だけ水音が戻ったと、年寄りは言う。',\r\n148:   ],\r\n149:   wind: [\r\n150:     '夜藪を渡る風が、赤子の産声を遠くの峰まで運んでいった。',\r\n151:     '窓もないのに、産屋の灯がふわりと一度だけ揺れた。風の子の証。',\r\n152:     'その子が生まれた朝、郷に久方ぶりの涼風が吹いたという。',\r\n153:   ],\r\n154:   earth: [\r\n155:     '踏みしめた郷の土が、ほんの少し温もった。根を張る者が来た。',\r\n156:     '産声とともに、庭の枯れ石がひとつ、ことりと落ち着いた。',\r\n157:     'その子の生まれた年は、痩せた畑にも実がよく成ったと伝わる。',\r\n158:   ],\r\n159:   moon: [\r\n160:     '欠けた月が、雲間から一瞬だけ、その子を照らして去った。',\r\n161:     '常夜のはずの空に、うっすらと月の輪郭が滲んだ夜だった。',\r\n162:     '赤子は、闇のほうをじっと見て泣かなかった。夜目の子だ。',\r\n163:   ],\r\n164:   star: [\r\n165:     '空のどこかで、名もなき星がひとつ、静かに瞬いたという。',\r\n166:     '玄冬に喰われ残った星の光が、その子の額に一点、宿った気がした。',\r\n167:     '産声の瞬間、夜藪の露がいっせいに、星の色に光ったと語られる。',\r\n168:   ],\r\n169: }\r\n170: function birthOmen(element: string, bornSeason: number): string {\r\n171:   const bank = BIRTH_OMENS[element] ?? BIRTH_OMENS.star\r\n172:   return bank[Math.abs(bornSeason) % bank.length]\r\n173: }\r\n174: \r\n175: export function BirthScene({ charId }: { charId: string }) {\r\n176:   const data = useGame((s) => s.data)!\r\n177:   const processNextScene = useGame((s) => s.processNextScene)\r\n178:   const renameCharacter = useGame((s) => s.renameCharacter)\r\n179:   const char = data.family.find((c) => c.id === charId)\r\n180:   const [name, setName] = useState('')\r\n181:   const [candidates, setCandidates] = useState<string[]>([])\r\n182:   useEffect(() => {\r\n183:     audio.se('birth')\r\n184:   }, [])\r\n185:   // 命名候補(生まれた子の性別プールから、家中で未使用の名を3つ)\r\n186:   useEffect(() => {\r\n187:     if (!char) return\r\n188:     setName(char.name)\r\n189:     const pool = char.sex === 'm' ? MALE_NAMES : FEMALE_NAMES\r\n190:     const used = new Set(data.family.map((c) => c.name))\r\n191:     const free = pool.filter((n) => !used.has(n))\r\n192:     const picks: string[] = []\r\n193:     for (let i = 0; i < free.length && picks.length < 3; i++) {\r\n194:       // bornSeason は初代などで負になり得る。JS の負の剰余をそのまま配列添字へ\r\n195:       // 使うと undefined が候補へ混ざり、空の命名札と React key 警告を生む。\r\n196:       const index = ((i * 7 + char.bornSeason) % free.length + free.length) % free.length\r\n197:       const candidate = free[index]\r\n198:       if (candidate && !picks.includes(candidate)) picks.push(candidate)\r\n199:     }\r\n200:     setCandidates(picks)\r\n201:     // eslint-disable-next-line react-hooks/exhaustive-deps\r\n202:   }, [charId])\r\n203:   if (!char) return null\r\n204:   const god = godById(char.godParentId)\r\n205:   const parent = data.family.find((c) => c.id === char.humanParentId)\r\n206:   const p = personalityById(char.personalityId)\r\n207: \r\n208:   const confirm = () => {\r\n209:     if (name.trim() && name.trim() !== char.name) renameCharacter(char.id, name)\r\n210:     processNextScene()\r\n211:   }\r\n212: \r\n213:   return (\r\n214:     <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"birth\">\r\n215:       <SceneBg file=\"cg2_birth.png\" />\r\n216:       <SceneSurfaceHeader surface=\"life-thread\" route=\"名付け\" title=\"誕生\" context={`${char.name}の産声を、家譜の最初の一行へ。`} />\r\n217:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n218:         <p>\r\n219:           {parent?.name}と{god.name}の子、生まれる。\r\n220:         </p>\r\n221:         <p className=\"birth-omen\">{birthOmen(char.element, char.bornSeason)}</p>\r\n222:         {/* 命名(v3.1 M16-2): 候補から選ぶか、自由に授ける */}\r\n223:         <div className=\"naming-box\">\r\n224:           <input\r\n225:             className=\"naming-input\"\r\n226:             value={name}\r\n227:             maxLength={8}\r\n228:             onChange={(e) => setName(e.target.value)}\r\n229:             aria-label=\"子の名\"\r\n230:           />\r\n231:           <div className=\"naming-candidates\">\r\n232:             {[char.name, ...candidates].filter((n, i, a) => a.indexOf(n) === i).slice(0, 4).map((n) => (\r\n233:               <button key={n} className={`btn btn-ghost naming-pick ${name === n ? 'active' : ''}`} onClick={() => setName(n)}>\r\n234:                 {n}\r\n235:               </button>\r\n236:             ))}\r\n237:           </div>\r\n238:         </div>\r\n239:         <p style={{ color: 'var(--text-dim)' }}>\r\n240:           第{char.gen}代 — {p.label}な子。{p.desc}\r\n241:         </p>\r\n242:         <div className=\"stat-grid\" style={{ maxWidth: 360, margin: '14px auto' }}>\r\n243:           {(Object.keys(STAT_LABELS) as StatKey[]).map((k) => (\r\n244:             <span key={k} className=\"stat-cell\">\r\n245:               <em>{STAT_LABELS[k]}</em>\r\n246:               {char.potential[k]}\r\n247:             </span>\r\n248:           ))}\r\n249:         </div>\r\n250:         <p style={{ fontSize: 13, color: 'var(--text-dim)' }}>\r\n251:           与えられた命は八季(廿四月)。六月で成人し、隊に加われる。\r\n252:         </p>\r\n253:       </div>\r\n254:       <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={confirm} disabled={!name.trim()}>\r\n255:         名を家譜に記す\r\n256:       </button>\r\n257:     </div>\r\n258:   )\r\n259: }\r\n260: \r\n261: export function DeathScene({ charId }: { charId: string }) {\r\n262:   const data = useGame((s) => s.data)!\r\n263:   const processNextScene = useGame((s) => s.processNextScene)\r\n264:   const setLastWords = useGame((s) => s.setLastWords)\r\n265:   const char = data.family.find((c) => c.id === charId)\r\n266:   const [beat, setBeat] = useState(0) // 生涯の巻物を一行ずつ手繰る(M15-2)\r\n267:   const [words, setWords] = useState('')\r\n268:   useEffect(() => {\r\n269:     audio.se('death')\r\n270:   }, [])\r\n271:   // 生涯ダイジェスト(M15-2): この人の八季を、巻物のように振り返る\r\n272:   const digest = (() => {\r\n273:     if (!char) return []\r\n274:     const lines: string[] = []\r\n275:     const born = data.chronicle.find((e) => e.kind === 'birth' && e.charId === char.id)\r\n276:     if (born) lines.push(born.text)\r\n277:     if (char.expeditions > 0) lines.push(`夜藪への遠征、${char.expeditions}たび。`)\r\n278:     if (char.kills > 0) lines.push(`討った魔性、${char.kills}。`)\r\n279:     const children = data.family.filter((c) => c.humanParentId === char.id)\r\n280:     if (children.length > 0) lines.push(`残した子、${children.length}人 — ${children.map((c) => c.name).join('、')}。`)\r\n281:     for (const d of char.deeds.slice(0, 3)) lines.push(`${d}。`)\r\n282:     return lines\r\n283:   })()\r\n284:   const digestDone = beat >= digest.length\r\n285:   // フックは早期return前に無条件呼び出し(Rules of Hooks)\r\n286:   const { advance, onBgClick } = useSceneAdvance(!digestDone, () => setBeat((b) => b + 1))\r\n287:   if (!char) return null\r\n288: \r\n289:   const confirm = () => {\r\n290:     if (words.trim()) setLastWords(char.id, words)\r\n291:     processNextScene()\r\n292:   }\r\n293: \r\n294:   return (\r\n295:     <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"death\" onClick={onBgClick}>\r\n296:       <SceneBg file=\"cg2_mitori.png\" />\r\n297:       <SceneSurfaceHeader surface=\"life-thread\" route=\"看取り\" title=\"看取り\" context={`${char.name}が遺す灯を、次の頁へ。`} />\r\n298:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n299:         <p>\r\n300:           {char.name}、第{char.gen}代。八つの季節を生き、灯が尽きた。\r\n301:         </p>\r\n302:         {digest.length > 0 && (\r\n303:           <div className=\"life-scroll\">\r\n304:             {digest.slice(0, Math.max(1, beat)).map((l, i) => (\r\n305:               <p key={i} className=\"life-scroll-line\">{l}</p>\r\n306:             ))}\r\n307:             {!digestDone && <ScenePager page={Math.min(beat + 1, digest.length)} total={digest.length} onNext={advance} />}\r\n308:           </div>\r\n309:         )}\r\n310:         {digestDone && (\r\n311:           <div className=\"naming-box\" onClick={(e) => e.stopPropagation()}>\r\n312:             <p style={{ fontSize: 12, color: 'var(--text-dim)', marginBottom: 4 }}>最期に、遺す言葉があれば(任意)</p>\r\n313:             <input\r\n314:               className=\"naming-input\"\r\n315:               style={{ fontSize: 16, letterSpacing: '0.1em' }}\r\n316:               value={words}\r\n317:               maxLength={40}\r\n318:               placeholder=\"……\"\r\n319:               onChange={(e) => setWords(e.target.value)}\r\n320:             />\r\n321:           </div>\r\n322:         )}\r\n323:         <div className=\"scene-epitaph\">「{char.epitaph}」</div>\r\n324:         {MOURNING[char.godParentId] && (\r\n325:           <div style={{ margin: '4px 0 16px', padding: '10px 14px', borderLeft: '3px solid var(--el-star)', textAlign: 'left' }}>\r\n326:             <p style={{ fontSize: 12, color: 'var(--text-dim)', marginBottom: 4 }}>\r\n327:               星より、文が届いている — {godById(char.godParentId).name}\r\n328:             </p>\r\n329:             <p style={{ fontSize: 14, color: 'var(--el-star)' }}>{MOURNING[char.godParentId]}</p>\r\n330:           </div>\r\n331:         )}\r\n332:         <p style={{ fontSize: 14, color: 'var(--text-dim)' }}>\r\n333:           綴「……よう生きた。あんたの八季、確かに書き留めたぞ」\r\n334:         </p>\r\n335:       </div>\r\n336:       {digestDone && (\r\n337:         <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={(e) => { e.stopPropagation(); confirm() }}>\r\n338:           灯を、継ぐ\r\n339:         </button>\r\n340:       )}\r\n341:     </div>\r\n342:   )\r\n343: }\r\n344: \r\n345: // ライフイベント — 家族の人生の一場面(初陣・絆・灯細りの夜・本編の章・日常)\r\n346: // bgが payload から来ていれば最優先(初陣=cg_hatsujin/灯細り=cg_hosori)。\r\n347: // 章語りは bg 無しで来るため title(固定文字列)から cg_ch{n}.png を引く。\r\n348: // それ以外(絆・日常)は bg 無しなので、場面文からの安定ハッシュで life_daily_* を割り当てる。\r\n349: export function LifeScene({ title, lines, bg, narrativeId }: { title: string; lines: { speaker: string; text: string }[]; bg?: string; narrativeId?: string }) {\r\n350:   const processNextScene = useGame((s) => s.processNextScene)\r\n351:   const skipCurrentScene = useGame((s) => s.skipCurrentScene)\r\n352:   const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n353:   const revealShioriName = useGame((s) => s.revealShioriName)\r\n354:   const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\r\n355:   const [beat, setBeat] = useState(0)\r\n356:   const done = beat >= lines.length - 1\r\n357:   // SceneBg はファイル名(拡張子付き)を受け取り内部でgameImg()解決するため、\r\n358:   // dailyIndexは素のファイル名(life_daily_NN.png)として組み立てる(dailyImg()は使わない)。\r\n359:   const resolvedBg = bg ?? CHAPTER_BG[title] ?? `life_daily_${String(stableDailyIndex(title, lines)).padStart(2, '0')}.png`\r\n360:   const advanceBeat = useCallback(() => {\r\n361:     const next = Math.min(lines.length - 1, beat + 1)\r\n362:     if (narrativeId === 'ch4' && next === lines.length - 1) revealShioriName(false)\r\n363:     setBeat(next)\r\n364:   }, [beat, lines.length, narrativeId, revealShioriName])\r\n365:   const { advance, onBgClick } = useSceneAdvance(!done, advanceBeat)\r\n366:   return (\r\n367:     <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"life\" onClick={onBgClick}>\r\n368:       <SceneBg file={resolvedBg} />\r\n369:       <SceneSurfaceHeader surface=\"life-thread\" route={narrativeId ? '章語り' : '生涯'} title={title} context=\"この夜の一行を、家の記憶へ綴じる。\" />\r\n370:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\" style={{ textAlign: 'left' }}>\r\n371:         {lines.slice(0, beat + 1).map((l, i) => (\r\n372:           <p key={i} className={i === beat ? 'intro-current' : 'intro-past'}>\r\n373:             {l.speaker ? (\r\n374:               <>\r\n375:                 <b style={{ color: 'var(--amber)' }}>{l.speaker}</b>\r\n376:                 <span style={{ color: 'var(--text-dim)' }}> — </span>\r\n377:                 {l.text}\r\n378:               </>\r\n379:             ) : (\r\n380:               <span style={{ color: 'var(--text-dim)' }}>{l.text}</span>\r\n381:             )}\r\n382:           </p>\r\n383:         ))}\r\n384:       </div>\r\n385:       {done ? (\r\n386:         <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\r\n387:           この夜を憶えておく\r\n388:         </button>\r\n389:       ) : (\r\n390:         <ScenePager page={beat + 1} total={lines.length} onNext={advance} />\r\n391:       )}\r\n392:       {narrativeId && !done && !replaying && (\r\n393:         <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />\r\n394:       )}\r\n395:     </div>\r\n396:   )\r\n397: }\r\n398: \r\n399: // 成人の儀 — 生後六月、灯型を授ける。血潮から推奨を示す\r\n400: export function CeremonyScene({ charId }: { charId: string }) {\r\n401:   const data = useGame((s) => s.data)!\r\n402:   const assignTomoshigata = useGame((s) => s.assignTomoshigata)\r\n403:   const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n404:   const [chosen, setChosen] = useState<Tomoshigata | null>(null)\r\n405:   const char = data.family.find((c) => c.id === charId)\r\n406:   if (!char) return null\r\n407:   const p = personalityById(char.personalityId)\r\n408: \r\n409:   // 血潮による推奨灯型\r\n410:   const rec: Tomoshigata =\r\n411:     char.potential.mnd >= Math.max(char.potential.str, char.potential.vit, char.potential.agi)\r\n412:       ? 'sumi'\r\n413:       : char.potential.vit >= Math.max(char.potential.str, char.potential.agi)\r\n414:         ? 'iwao'\r\n415:         : char.potential.agi >= char.potential.str\r\n416:           ? 'nagi'\r\n417:           : 'homura'\r\n418: \r\n419:   if (chosen) {\r\n420:     const gataDef = TOMOSHIGATA.find((t) => t.id === chosen)!\r\n421:     const toza = tozaOf(chosen, char.element)\r\n422:     return (\r\n423:       <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"ceremony-result\">\r\n424:         <SceneBg file=\"cg2_seijin.png\" />\r\n425:         <RiteReturnControl onReturn={deferCurrentScene} />\r\n426:         <SceneSurfaceHeader surface=\"life-thread\" route=\"灯型\" title=\"成人の儀\" context={`${char.name}が選んだ灯を、身体へ結ぶ。`} />\r\n427:         <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n428:           <p style={{ fontSize: 18, color: 'var(--amber)' }}>{gataDef.ritual}</p>\r\n429:           <p style={{ margin: '18px 0' }}>\r\n430:             {char.name}は灯を受け取り、静かに頷いた。\r\n431:           </p>\r\n432:           <p style={{ fontSize: 24, fontWeight: 700, letterSpacing: '0.2em' }}>\r\n433:             灯座「{toza.name}」— {toza.title}\r\n434:           </p>\r\n435:           <p style={{ fontSize: 13, color: 'var(--text-dim)', marginTop: 10 }}>\r\n436:             初伝「{toza.skills[0].name}」を習得。灯は月齢とともに深まり、やがて奥義に至る。\r\n437:           </p>\r\n438:         </div>\r\n439:         <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => assignTomoshigata(char.id, chosen)}>\r\n440:           家譜に記す\r\n441:         </button>\r\n442:       </div>\r\n443:     )\r\n444:   }\r\n445: \r\n446:   return (\r\n447:     <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"ceremony\">\r\n448:       <RiteReturnControl onReturn={deferCurrentScene} />\r\n449:       <SceneSurfaceHeader surface=\"life-thread\" route=\"灯型\" title=\"成人の儀\" context={`${char.name}の血潮に、ひとつの灯型を結ぶ。`} />\r\n450:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"context\">\r\n451:         <p>\r\n452:           {char.name}(第{char.gen}代・{p.label})、生後六月。大燈籠の前に立ち、灯型を授かる時が来た。\r\n453:         </p>\r\n454:         <p style={{ fontSize: 13, color: 'var(--text-dim)' }}>\r\n455:           灯型×星脈({char.element === 'fire' ? '火' : char.element === 'water' ? '水' : char.element === 'wind' ? '風' : char.element === 'earth' ? '土' : char.element === 'moon' ? '月' : '星'}\r\n456:           の脈)で、この子だけの灯座が決まる。\r\n457:         </p>\r\n458:       </div>\r\n459:       <div className=\"god-grid vc3b-choice-ledger\" data-scene-group=\"decision\" aria-label=\"灯型の候補\" style={{ maxWidth: 720, marginTop: 16 }}>\r\n460:         {TOMOSHIGATA.map((t) => {\r\n461:           const toza = tozaOf(t.id, char.element)\r\n462:           return (\r\n463:             <div\r\n464:               key={t.id}\r\n465:               className={`god-card ${t.id === rec ? 'recommended' : ''}`}\r\n466:               role=\"button\"\r\n467:               tabIndex={0}\r\n468:               aria-label={`灯型「${t.label}」を選ぶ${t.id === rec ? '(血潮の勧め)' : ''}`}\r\n469:               onClick={() => setChosen(t.id)}\r\n470:               onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setChosen(t.id) } }}\r\n471:             >\r\n472:               <MaybeImg src={gameImg(`emb_${t.id}_${char.element}.png`)} className=\"card-emblem\" />\r\n473:               <div className=\"god-name\">\r\n474:                 {t.label}({t.kana}){t.id === rec ? ' ★血潮の勧め' : ''}\r\n475:               </div>\r\n476:               <div className=\"god-person\">→ 灯座「{toza.name}」{toza.title}</div>\r\n477:               <StatBiasChips bias={t.statBias} />\r\n478:               <div className=\"god-desc\">{t.desc}</div>\r\n479:             </div>\r\n480:           )\r\n481:         })}\r\n482:       </div>\r\n483:     </div>\r\n484:   )\r\n485: }\r\n486: \r\n487: // 生業の儀 — 生後十二月、郷の生業から家業を選ぶ(GDD_v3 §2)\r\n488: // 灯座=星から継いだ「術」、家業=郷で修める「技」。二段目の成人。\r\n489: export function JobRiteScene({ charId }: { charId: string }) {\r\n490:   const data = useGame((s) => s.data)!\r\n491:   const assignJobClass = useGame((s) => s.assignJobClass)\r\n492:   const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n493:   const [chosen, setChosen] = useState<JobClassId | null>(null)\r\n494:   const char = data.family.find((c) => c.id === charId)\r\n495:   if (!char) return null\r\n496: \r\n497:   const rec = recommendJob(char.potential)\r\n498:   const roles: JobRole[] = ['atk', 'tank', 'swift', 'heal', 'hex', 'sup']\r\n499: \r\n500:   if (chosen) {\r\n501:     const job = jobById(chosen)\r\n502:     return (\r\n503:       <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"jobrite-result\">\r\n504:         <SceneBg file=\"cg2_nariwai.png\" />\r\n505:         <RiteReturnControl onReturn={deferCurrentScene} />\r\n506:         <SceneSurfaceHeader surface=\"life-thread\" route=\"家業\" title=\"生業の儀\" context={`${char.name}が選んだ技を、暮らしへ結ぶ。`} />\r\n507:         <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n508:           <p style={{ fontSize: 18, color: 'var(--amber)' }}>{job.ritual}</p>\r\n509:           <p style={{ margin: '18px 0' }}>\r\n510:             {char.name}は道具を受け取り、深く頭を下げた。今日から{job.name}の見習いである。\r\n511:           </p>\r\n512:           <p style={{ fontSize: 24, fontWeight: 700, letterSpacing: '0.2em' }}>\r\n513:             家業「{job.name}」— {JOB_SCHOOL_LABELS[job.school]}の{JOB_ROLE_LABELS[job.role]}\r\n514:           </p>\r\n515:           <p style={{ fontSize: 13, color: 'var(--text-dim)', marginTop: 10 }}>\r\n516:             初伝「{skillById(job.skillIds[0]).name}」を習得。技は年季とともに深まり、八段の奥伝に至る。\r\n517:           </p>\r\n518:         </div>\r\n519:         <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => assignJobClass(char.id, chosen)}>\r\n520:           家譜に記す\r\n521:         </button>\r\n522:       </div>\r\n523:     )\r\n524:   }\r\n525: \r\n526:   return (\r\n527:     <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"jobrite\">\r\n528:       <RiteReturnControl onReturn={deferCurrentScene} />\r\n529:       <SceneSurfaceHeader surface=\"life-thread\" route=\"家業\" title=\"生業の儀\" context={`${char.name}の手に、郷で生きる技をひとつ。`} />\r\n530:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"context\">\r\n531:         <p>\r\n532:           {char.name}(第{char.gen}代)、生後十二月。郷の親方衆が居並ぶ前で、家業を選ぶ時が来た。\r\n533:         </p>\r\n534:         <p style={{ fontSize: 13, color: 'var(--text-dim)' }}>\r\n535:           灯座は星から継いだ術、家業は郷で修める技。夜藪の外にも、この子の生きる場所ができる。\r\n536:         </p>\r\n537:       </div>\r\n538:       <div className=\"vc3b-choice-ledger vc3b-job-ledger\" data-scene-group=\"decision\" aria-label=\"家業の候補\" style={{ maxWidth: 860, width: '100%', textAlign: 'left', maxHeight: '52vh', overflowY: 'auto', padding: '0 4px' }}>\r\n539:         {roles.map((role) => (\r\n540:           <div key={role} style={{ marginBottom: 10 }}>\r\n541:             <div style={{ fontSize: 13, color: 'var(--gold)', letterSpacing: '0.3em', margin: '8px 0 6px' }}>\r\n542:               {JOB_ROLE_LABELS[role]}の生業{role === rec ? ' ★血潮の勧め' : ''}\r\n543:             </div>\r\n544:             <div className=\"god-grid\">\r\n545:               {JOB_CLASSES.filter((j) => j.role === role).map((j) => (\r\n546:                 <div\r\n547:                   key={j.id}\r\n548:                   className={`god-card ${role === rec ? 'recommended' : ''}`}\r\n549:                   role=\"button\"\r\n550:                   tabIndex={0}\r\n551:                   aria-label={`家業「${j.name}」を選ぶ${role === rec ? '(血潮の勧め)' : ''}`}\r\n552:                   onClick={() => setChosen(j.id)}\r\n553:                   onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setChosen(j.id) } }}\r\n554:                 >\r\n555:                   <MaybeImg src={gameImg(`job_${j.id}.png`)} className=\"card-emblem\" />\r\n556:                   <div className=\"god-name\">\r\n557:                     {j.name}({j.kana}){role === rec ? ' ★' : ''}\r\n558:                   </div>\r\n559:                   <div className=\"god-person\">{JOB_SCHOOL_LABELS[j.school]} / {JOB_ROLE_LABELS[j.role]}</div>\r\n560:                   <StatBiasChips bias={j.statBias} />\r\n561:                   <div className=\"god-desc\">{j.desc}</div>\r\n562:                 </div>\r\n563:               ))}\r\n564:             </div>\r\n565:           </div>\r\n566:         ))}\r\n567:       </div>\r\n568:     </div>\r\n569:   )\r\n570: }\r\n571: \r\n572: const DREAM_BEATS = [\r\n573:   '……唄が、聴こえる。',\r\n574:   '夢の中。見知らぬ山の頂に、楽士がひとり座っている。黒い月を背に、琵琶を抱いて。',\r\n575:   '「あら。夢を渡って来たのね。……血は争えないわ」',\r\n576:   '彼女の顔は、名の擦れた家譜の最初の頁に描かれた似姿と同じだった。家祖らしき、名のない楽士。',\r\n577:   '「名乗らなくていいの。あなたたちの名は、全部、風に聞いてる。産声も、辞世も、ぜんぶ」',\r\n578:   '「山頂で待ってるわ。……ああ、でも、急がないで」',\r\n579:   '「あなたたちの季節は短いのだから。道草も、お食べなさい。祭も、恋も、昼寝もね」',\r\n580:   '「それでいつか、ここへ届いたら——そのときは」',\r\n581:   '唄が途切れた。彼女は少しだけ笑って、囁いた。「……看取って、ちょうだいね」',\r\n582:   '目が覚める。頬に涙の痕。綴は何も聞かず、黙って墨を磨っていた。',\r\n583: ]\r\n584: \r\n585: // M19 A4: 頁印+明示的「次へ」— 画面全体クリック進行は維持しつつ、確実な操作面を下部に置く。\r\n586: // stopPropagationで背景クリックと二重発火しない。選択UI表示後は各シーンのguard(!done)が背景進行を止める。\r\n587: function ScenePager({ page, total, onNext }: { page: number; total: number; onNext: () => void }) {\r\n588:   return (\r\n589:     <div className=\"scene-pager\" onClick={(e) => e.stopPropagation()}>\r\n590:       <span className=\"scene-page-mark\">頁 {page}／{total}</span>\r\n591:       <button className=\"btn scene-next vc3b-primary-action\" data-scene-primary=\"true\" onClick={onNext}>次へ ▸</button>\r\n592:     </div>\r\n593:   )\r\n594: }\r\n595: \r\n596: function SceneComfortControls({ onDefer, onSkip }: { onDefer: () => void; onSkip: () => void }) {\r\n597:   return (\r\n598:     <div className=\"scene-comfort-controls\" data-zone=\"scene-comfort-controls\">\r\n599:       <button className=\"btn btn-ghost\" onClick={(e) => { e.stopPropagation(); onDefer() }}>後で読む</button>\r\n600:       <button className=\"btn btn-ghost\" onClick={(e) => { e.stopPropagation(); onSkip() }}>要約して飛ばす</button>\r\n601:     </div>\r\n602:   )\r\n603: }\r\n604: \r\n605: function DreamVisual({ episode }: { episode: DreamEpisode }) {\r\n606:   const primarySrc = dreamImg(episode.bg)\r\n607:   const fallbackSrc = dreamImg()\r\n608:   const [src, setSrc] = useState(primarySrc)\r\n609:   const [unavailable, setUnavailable] = useState(false)\r\n610:   const description = episode.visualDescription ?? '夢の頂で、名のない楽士が琵琶を抱き、子孫へ千年前の記憶を語っている。'\r\n611: \r\n612:   useEffect(() => {\r\n613:     setSrc(primarySrc)\r\n614:     setUnavailable(false)\r\n615:   }, [primarySrc])\r\n616: \r\n617:   return (\r\n618:     <div className=\"dream-visual-block\">\r\n619:       <figure\r\n620:         className=\"dream-visual\"\r\n621:         data-zone=\"dream-visual\"\r\n622:         data-visual-id={episode.visualId ?? episode.id}\r\n623:       >\r\n624:         {!unavailable && (\r\n625:           <img\r\n626:             className=\"dream-visual-img\"\r\n627:             src={src}\r\n628:             alt={description}\r\n629:             loading=\"lazy\"\r\n630:             decoding=\"async\"\r\n631:             data-fallback={src === fallbackSrc ? 'true' : 'false'}\r\n632:             onError={() => {\r\n633:               if (src !== fallbackSrc) setSrc(fallbackSrc)\r\n634:               else setUnavailable(true)\r\n635:             }}\r\n636:           />\r\n637:         )}\r\n638:       </figure>\r\n639:       <p className=\"dream-visual-description\" aria-hidden=\"true\">\r\n640:         <span>夢に映る景色</span>{description}\r\n641:       </p>\r\n642:     </div>\r\n643:   )\r\n644: }\r\n645: \r\n646: export function DreamScene() {\r\n647:   const processNextScene = useGame((s) => s.processNextScene)\r\n648:   const skipCurrentScene = useGame((s) => s.skipCurrentScene)\r\n649:   const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n650:   const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\r\n651:   const [beat, setBeat] = useState(0)\r\n652:   const done = beat >= DREAM_BEATS.length - 1\r\n653:   const { advance, onBgClick } = useSceneAdvance(!done, () => setBeat((b) => b + 1))\r\n654:   return (\r\n655:     <div className=\"scene-screen screen vc3b-scene vc3b-dream-scene\" data-scene-surface=\"dream-edge\" data-scene-route=\"dream\" onClick={onBgClick}>\r\n656:       <SceneBg file=\"cg_kiro.png\" />\r\n657:       <SceneSurfaceHeader surface=\"dream-edge\" route=\"夢渡り\" title=\"夢渡り\" context=\"名のない楽士の声が、家譜の外から届く。\" />\r\n658:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n659:         {DREAM_BEATS.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\r\n660:           <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\r\n661:             {t}\r\n662:           </p>\r\n663:         ))}\r\n664:       </div>\r\n665:       {done ? (\r\n666:         <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\r\n667:           目を覚ます\r\n668:         </button>\r\n669:       ) : (\r\n670:         <ScenePager page={beat + 1} total={DREAM_BEATS.length} onNext={advance} />\r\n671:       )}\r\n672:       {!done && !replaying && <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />}\r\n673:     </div>\r\n674:   )\r\n675: }\r\n676: \r\n677: // 夢渡りの連作(data/dreams.ts) — 看取りの数だけ深く見る、千年前の記憶。\r\n678: // 横長CGは背景coverにせず前面の16:9全景として示し、台詞と操作を通常フローで分離する。\r\n679: export function DreamEpScene({ epId }: { epId: string }) {\r\n680:   const processNextScene = useGame((s) => s.processNextScene)\r\n681:   const skipCurrentScene = useGame((s) => s.skipCurrentScene)\r\n682:   const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n683:   const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\r\n684:   const [beat, setBeat] = useState(0)\r\n685:   const [lastEp, setLastEp] = useState(epId)\r\n686:   if (epId !== lastEp) {\r\n687:     setLastEp(epId)\r\n688:     setBeat(0)\r\n689:   }\r\n690:   const ep = dreamEpisodeById(epId)\r\n691:   const epIndex = ep ? DREAM_EPISODES.indexOf(ep) : -1\r\n692:   const nextVisual = epIndex >= 0 ? DREAM_EPISODES[epIndex + 1]?.bg : undefined\r\n693:   const done = !ep || beat >= ep.beats.length - 1\r\n694:   const { advance, onBgClick } = useSceneAdvance(!done, () => setBeat((b) => b + 1))\r\n695:   useEffect(() => {\r\n696:     if (!ep) processNextScene()\r\n697:   }, [ep, processNextScene])\r\n698:   useEffect(() => {\r\n699:     if (!nextVisual) return\r\n700:     return prefetchGameImg(nextVisual)\r\n701:   }, [nextVisual])\r\n702:   if (!ep) {\r\n703:     // 未知のepId(将来のセーブ互換等) — 詰まらせず静かに次へ\r\n704:     return null\r\n705:   }\r\n706:   return (\r\n707:     <div className=\"scene-screen screen dream-episode-screen vc3b-scene vc3b-dream-scene\" data-scene-surface=\"dream-edge\" data-scene-route=\"dreamEp\" onClick={onBgClick}>\r\n708:       <div className=\"dream-episode-shell\">\r\n709:         <SceneSurfaceHeader surface=\"dream-edge\" route={`夢渡り ${epIndex + 2}`} title={ep.title} context=\"千年前の記憶を、今代の夢の縁で受け取る。\" titleClassName=\"dream-episode-title\" />\r\n710:         <DreamVisual episode={ep} />\r\n711:         <div className=\"scene-body dream-episode-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n712:           {ep.beats.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\r\n713:             <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\r\n714:               {t}\r\n715:             </p>\r\n716:           ))}\r\n717:         </div>\r\n718:         <div className=\"dream-episode-controls\" data-zone=\"dream-episode-controls\">\r\n719:           {done ? (\r\n720:             <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\r\n721:               目を覚ます\r\n722:             </button>\r\n723:           ) : (\r\n724:             <ScenePager page={beat + 1} total={ep.beats.length} onNext={advance} />\r\n725:           )}\r\n726:           {!done && !replaying && <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />}\r\n727:         </div>\r\n728:       </div>\r\n729:     </div>\r\n730:   )\r\n731: }\r\n732: \r\n733: // cut(送る=夜明け)の後日談。クライマックス(ENDINGS.cut.beats=看取り・面砕け)と重複させず、\r\n734: // その「あと」だけを描く — 夜が明け、太陽が昇り、八季で死なぬ子が生まれ、家譜が閉じられる。\r\n735: const ENDING_CLEARED = [\r\n736:   '夜が、明けてゆく。最初の朝日が大燈籠の天辺に触れ、郷中の灯が一斉に消えた——もう、要らないから。',\r\n737:   '細っていた大燈籠の火は、朝焼けの色に染まった。千年ぶりの太陽が、燈ノ郷に昇る。',\r\n738:   'その春、燈守家に子が生まれた。八季では死なない、初めての子が。',\r\n739:   '一族の家譜の、最後の頁に、こう記された。「我ら、夜を継ぎ、朝を残す」',\r\n740:   '汝の屍を越え、灯は継がれた。',\r\n741:   '— 完 —',\r\n742: ]\r\n743: \r\n744: const ENDING_EXTINCT = [\r\n745:   '最後の灯が、消えた。',\r\n746:   '燈守家の血脈は、ここに絶えた。',\r\n747:   '大燈籠の火は細り、常夜が郷を呑んでいく。',\r\n748:   '……だが、家譜だけは残った。',\r\n749:   '綴「いつか誰かが、この記を読む。ならばこれは敗北ではない。……中断だ」',\r\n750: ]\r\n751: \r\n752: // v3.2 M18: 結末別エピローグ。cut(送る=夜明け)は ENDING_CLEARED を流用。\r\n753: // save(救う)/inherit(継ぐ)は「夜は残る」帰結のため、太陽・夜明けを断言しない専用の結びを用意する。\r\n754: const ENDING_SAVE = [\r\n755:   '当主は家譜を開き、千年分の名を、汐里と二人で読み上げていく。',\r\n756:   '一つ、また一つ。産声と、辞世と。汐里は初めて、独りでなくその名を聴いた。',\r\n757:   '「……ぜんぶ、憶えてる。あなたたちのこと、ぜんぶ」汐里は泣いて、そして、笑った。',\r\n758:   '夜は、明けない。それでも大燈籠の火は、もう二度と消えぬだろう。支え合う錠前が、二つになったのだから。',\r\n759:   '汝の屍を越え、灯は継がれた。次は誰が、あの頂の隣に、座るのだろうか。',\r\n760:   '— 完 —',\r\n761: ]\r\n762: \r\n763: const ENDING_INHERIT = [\r\n764:   '山を降りた汐里は、綴の隣で、家譜の続きを綴る側になった。今度は、頂に座る者を、憶えておくために。',\r\n765:   '綴は筆を渡しながら言った。「錠前は代わる。だが家譜は続く。名を書き継ぐ者がいる限り、頂の誰も、独りにはならん」',\r\n766:   '汐里はときおり、頂へ文を送る。産声を、祭を、恋を、昼寝を——山の下の、短くて眩しい日々を。',\r\n767:   '夜は、明けない。だが頂の座は、もう永遠の牢ではない。八季ごとに、次の灯が、交代しに登ってゆく。',\r\n768:   '汝の屍を越え、灯は継がれた。頂へ、頂へと。今度は、誰も独りにはさせずに。',\r\n769:   '— 完 —',\r\n770: ]\r\n771: \r\n772: // 最終決戦後の選択(v3.1 M15-4) — 千年の結末を、一族が選ぶ\r\n773: export function FinaleScene() {\r\n774:   const data = useGame((s) => s.data)!\r\n775:   const resolveFinale = useGame((s) => s.resolveFinale)\r\n776:   const [pendingChoice, setPendingChoice] = useState<number | null>(null)\r\n777:   const memories = familyFinaleEchoes(data)\r\n778:   return (\r\n779:     <div className=\"scene-screen screen finale-screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"finale\">\r\n780:       <SceneBg file=\"cg_kiro.png\" />\r\n781:       <SceneSurfaceHeader surface=\"flame-crossroads\" route=\"千年の答え\" title=\"千年の岐路\" context=\"三つの灯は同格。一族が遺す答えだけを選ぶ。\" />\r\n782:       <section className=\"finale-memory\" data-scene-group=\"context\" aria-label=\"一族がここまで運んだもの\">\r\n783:         <div className=\"scene-body finale-intro\">\r\n784:           <p>汐里は楽を置き、静かにこちらを見ている。</p>\r\n785:           <p>「……ここから先は、生きている者が決めることよ」</p>\r\n786:         </div>\r\n787:         <p className=\"finale-question\">今代の問い<span>{data.narrative?.generationQuestion ?? generationQuestion(data)}</span></p>\r\n788:         <div className=\"finale-echoes\">\r\n789:           {memories.map((memory) => (\r\n790:             <p key={`${memory.label}:${memory.text}`}>\r\n791:               <span>{memory.label}</span>{memory.text}\r\n792:             </p>\r\n793:           ))}\r\n794:         </div>\r\n795:         <p className=\"finale-resonance\">{resonanceLine(data)}</p>\r\n796:       </section>\r\n797:       <p className=\"finale-prompt\">この選択が、一族の千年の答えになる。</p>\r\n798:       <div className=\"finale-choices\" data-zone=\"finale-choices\" data-scene-group=\"decision\">\r\n799:         {FINALE_CHOICES.map((c, i) => (\r\n800:           <button\r\n801:             key={c.id}\r\n802:             className={`btn finale-choice${pendingChoice === i ? ' selected' : ''}`}\r\n803:             aria-pressed={pendingChoice === i}\r\n804:             onClick={() => setPendingChoice(i)}\r\n805:           >\r\n806:             <b>{c.label}</b>\r\n807:             <span>{c.desc}</span>\r\n808:           </button>\r\n809:         ))}\r\n810:         {pendingChoice !== null && (\r\n811:           <div className=\"finale-confirm\" role=\"group\" aria-label={`${FINALE_CHOICES[pendingChoice].label}の確認`}>\r\n812:             <p>「{FINALE_CHOICES[pendingChoice].label}」を、一族の答えとして家譜に閉じますか。</p>\r\n813:             <div>\r\n814:               <button className=\"btn btn-ghost\" onClick={() => setPendingChoice(null)}>選び直す</button>\r\n815:               <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => resolveFinale(pendingChoice)}>\r\n816:                 この答えを綴じる\r\n817:               </button>\r\n818:             </div>\r\n819:           </div>\r\n820:         )}\r\n821:       </div>\r\n822:     </div>\r\n823:   )\r\n824: }\r\n825: \r\n826: export function EndingScene() {\r\n827:   const data = useGame((s) => s.data)!\r\n828:   const setScreen = useGame((s) => s.setScreen)\r\n829:   const newLegacyGame = useGame((s) => s.newLegacyGame)\r\n830:   const [beat, setBeat] = useState(0)\r\n831:   const cleared = !!data.flags.cleared\r\n832:   // v3.1 M15-4: 最終選択に応じた結末分岐(選択がなければ従来の夜明け)\r\n833:   const endType = (typeof data.flags.endingType === 'number'\r\n834:     ? (['cut', 'save', 'inherit'] as const)[data.flags.endingType]\r\n835:     : 'cut')\r\n836:   const climaxBeats = ENDINGS[endType].beats\r\n837:   // v3.2 M18: 結末別エピローグ。cut=夜明け(ENDING_CLEARED)、save/inherit=夜が残る帰結へ整合。\r\n838:   const epilogue = endType === 'save' ? ENDING_SAVE : endType === 'inherit' ? ENDING_INHERIT : ENDING_CLEARED\r\n839:   // M34: 山場の直後に、このsaveの固有名・形見・土地から導いた一文だけを差し込む。\r\n840:   const beats = cleared ? [...climaxBeats, personalizedEndingBeat(data, endType), ...epilogue] : ENDING_EXTINCT\r\n841:   const done = beat >= beats.length - 1\r\n842:   // 山場(cut/save/inherit別)→_a、その後の共通エピローグ(ENDING_CLEARED)→_b。断絶(未clear)は画無し。\r\n843:   const endingBg = cleared ? (beat < climaxBeats.length ? `cg_end_${endType}_a.png` : `cg_end_${endType}_b.png`) : null\r\n844: \r\n845:   const gens = Math.max(...data.family.map((c) => c.gen))\r\n846:   const fallenCount = data.family.filter((c) => !c.alive).length\r\n847:   const years = yearOfMonth(data.seasonIndex)\r\n848: \r\n849:   return (\r\n850:     <div className=\"scene-screen screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"ending\" onClick={() => { if (!done) { audio.se('page'); setBeat(beat + 1) } }}>\r\n851:       {endingBg && <SceneBg file={endingBg} />}\r\n852:       <SceneSurfaceHeader surface=\"flame-crossroads\" route={cleared ? ENDINGS[endType].title : '断絶'} title={cleared ? '灯継ぎ' : '断絶'} context={cleared ? '選んだ灯の行方を見届け、次の家譜へ。' : '途切れた家譜にも、読まれる日を待つ頁が残る。'} />\r\n853:       <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"context\">\r\n854:         {beats.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\r\n855:           <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\r\n856:             {t}\r\n857:           </p>\r\n858:         ))}\r\n859:       </div>\r\n860:       {done && (\r\n861:         <div className=\"ending-actions\" data-scene-group=\"decision\">\r\n862:           <div className=\"ending-stats\">\r\n863:             紡がれた世代<b>{gens}</b>代 / 逝った者<b>{fallenCount}</b>人 / 費やした歳月<b>{years}</b>年\r\n864:           </div>\r\n865:           <button className=\"btn\" onClick={() => downloadChronicleCard(data)}>\r\n866:             この千年紀を一枚絵に残す(画像保存)\r\n867:           </button>\r\n868:           {cleared && (\r\n869:             <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => newLegacyGame()}>\r\n870:               新たな千年紀へ — 継承新周回(形見と血の濃さを持ち越す)\r\n871:             </button>\r\n872:           )}\r\n873:           <button\r\n874:             className={`btn ${cleared ? 'btn-ghost' : 'btn-main vc3b-primary-action'}`}\r\n875:             data-scene-primary={cleared ? undefined : 'true'}\r\n876:             onClick={() => {\r\n877:               if (!cleared) clearSave()\r\n878:               setScreen({ id: 'title' })\r\n879:             }}\r\n880:           >\r\n881:             題目へ戻る\r\n882:           </button>\r\n883:         </div>\r\n884:       )}\r\n885:       {!done && <ScenePager page={beat + 1} total={beats.length} onNext={() => { audio.se('page'); setBeat(beat + 1) }} />}\r\n886:     </div>\r\n887:   )\r\n888: }\r\n","exit_code":0,"status":"completed"}}
