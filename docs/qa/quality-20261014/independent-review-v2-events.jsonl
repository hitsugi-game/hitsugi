ys(before.stats) as Array<keyof Stats>)\r\n2573:               .map((key) => [key, updated.stats[key] - before.stats[key]])\r\n2574:               .filter(([, delta]) => delta !== 0),\r\n2575:           ) as Partial<Stats>\r\n2576:           growth.push({\r\n2577:             charId: character.id,\r\n2578:             beforeLevel: before.level,\r\n2579:             afterLevel: updated.level,\r\n2580:             beforeExp: before.exp,\r\n2581:             afterExp: updated.exp,\r\n2582:             statDelta,\r\n2583:             maxHpDelta: updated.maxHp - before.maxHp,\r\n2584:             maxMpDelta: updated.maxMp - before.maxMp,\r\n2585:           })\r\n2586:           return updated\r\n2587:         })\r\n2588: \r\n2589:         let nd: GameData = { ...data, family }\r\n2590:         const recruited: Array<{ enemyId: string; name: string }> = []\r\n2591:         const owned = new Set((nd.familiars ?? []).map((familiar) => familiar.enemyId))\r\n2592:         for (const candidate of plan.familiarCandidates) {\r\n2593:           // One draw per planned candidate, in enemy-definition order. Multiple successes\r\n2594:           // are retained; owned/boss/nemesis/rare exclusions already live in the plan.\r\n2595:           if (!state.rng.chance(candidate.probability) || owned.has(candidate.enemyId)) continue\r\n2596:           const enemy = enemyById(candidate.enemyId)\r\n2597:           const name = `${candidate.enemyName}の眷属`\r\n2598:           nd = {\r\n2599:             ...nd,\r\n2600:             familiars: [...(nd.familiars ?? []), { enemyId: candidate.enemyId, name, element: enemy.element }],\r\n2601:             activeFamiliar: nd.activeFamiliar ?? candidate.enemyId,\r\n2602:           }\r\n2603:           nd = chronicle(nd, 'event', `${candidate.enemyName}が懐いた — 眷属となった。`)\r\n2604:           owned.add(candidate.enemyId)\r\n2605:           recruited.push({ enemyId: candidate.enemyId, name })\r\n2606:         }\r\n2607: \r\n2608:         const beforeInventoryIds = new Set(original.data!.inventory.map((item) => item.id))\r\n2609:         const memorials = nd.inventory.filter((item) => !beforeInventoryIds.has(item.id) && item.source === 'boss')\r\n2610:         return {\r\n2611:           data: nd,\r\n2612:           battleRewardSettlement: {\r\n2613:             ...current,\r\n2614:             result: {\r\n2615:               settlementId: plan.settlementId,\r\n2616:               carried: {\r\n2617:                 hoto: plan.carried.hoto,\r\n2618:                 ketsu: plan.carried.ketsu,\r\n2619:                 items: plan.carried.rareDrop ? [plan.carried.rareDrop] : [],\r\n2620:               },\r\n2621:               immediate: {\r\n2622:                 partyXp: plan.immediate.partyXp,\r\n2623:                 fame: plan.immediate.fame ?? 0,\r\n2624:                 memorials,\r\n2625:                 loreHoto: plan.immediate.loreCompletionHoto ?? 0,\r\n2626:                 familiars: recruited,\r\n2627:               },\r\n2628:               growth,\r\n2629:             },\r\n2630:           },\r\n20:import './codex_m18.css'\n74:          <div className=\"codex-group\" key={g.key}>\n75:            <div className=\"codex-group-head\">{g.label}</div>\n76:            {visible.length > 0 && <div className=\"codex-grid\">{visible.map((it) => renderCard(it))}</div>}\n77:            {g.unknownCount > 0 && <div className=\"codex-unknown-row\">未知 あと{g.unknownCount}種</div>}\n82:        <button className=\"btn btn-ghost codex-more\" onClick={onMore}>さらに表示({totalKnown - shown}件)</button>\n92:    <div className=\"codex-detail-panel\">\n94:        <MaybeImg src={regionBgR(r.id)} className=\"codex-detail-banner\" />\n97:      <div className=\"codex-detail-name\">{r.name}</div>\n98:      <div className=\"codex-detail-meta\">\n101:      <div className=\"codex-detail-body\">\n114:    <div className=\"codex-detail-panel\">\n115:      <MaybeImg src={gameImg(e.sprite)} className=\"codex-detail-thumb\" />\n116:      <div className=\"codex-detail-name\">{e.name}</div>\n117:      <div className=\"codex-detail-meta\">{ELEMENT_LABELS[e.element]} / 剛{e.tier}</div>\n118:      <div className=\"codex-detail-body\"><p>{e.desc}</p></div>\n125:    <div className=\"codex-detail-panel\">\n126:      <GodImgOrFallback g={g} className=\"codex-detail-thumb\" compact />\n127:      <div className=\"codex-detail-name\">{g.name}</div>\n128:      <div className=\"codex-detail-meta\">{GOD_RANK_LABELS[g.rank]} / {ELEMENT_LABELS[g.element]}の星</div>\n129:      <div className=\"codex-detail-body\"><p>{g.desc}</p></div>\n136:    <div className=\"codex-detail-panel\">\n137:      {enemy && <MaybeImg src={gameImg(enemy.sprite)} className=\"codex-detail-thumb nemesis-thumb\" />}\n138:      <div className=\"codex-detail-name\">{n.name}</div>\n140:      <div className=\"codex-detail-body\">\n157:    const seenEn = new Set(data.codexSeenIds?.enemies ?? [])\n158:    const seenGd = new Set(data.codexSeenIds?.gods ?? [])\n159:    const enArr = (data.codex?.enemies ?? []).map(baseEnemyId)\n160:    const gdArr = data.codex?.gods ?? []\n181:  const seenEnemies = new Set((data.codex?.enemies ?? []).map(baseEnemyId))\n182:  const knownGods = new Set([\n183:    ...(data.codex?.gods ?? []),\n184:    ...Object.entries(data.godAffinity).filter(([, v]) => v > 0).map(([k]) => k),\n194:  const godSeen = GODS.filter((g) => knownGods.has(g.id)).length\n229:    (g) => knownGods.has(g.id),\n252:        ? GODS.filter((god) => knownGods.has(god.id) && (!freshOnly || fresh.gods.has(god.id))).map((god) => god.id)\n261:    <div className=\"codex-visual-focus\" data-visual-focus=\"primary\">\n279:      <section className={`codex-register codex-register--${tab}`} aria-label=\"採集と見聞の拓本帳\">\n280:        <span className=\"codex-register-binding\" aria-hidden=\"true\" />\n281:        <header className=\"codex-register-head\">\n282:          <div className=\"codex-rubbing-seal\" aria-hidden=\"true\">拓</div>\n284:            <span className=\"codex-register-kicker\">夜藪見聞・採集帖</span>\n287:          <span className=\"codex-register-count\">\n292:      <div className={`codex-layout ${hasSelection ? 'has-selection' : ''}`}>\n293:        <div className=\"codex-list\">\n295:            <div className=\"codex-fresh-row\">\n313:                  className={`btn codex-card codex-card-btn ${selectedId === r.id ? 'is-sel' : ''}`}\n317:                  <MaybeImg src={regionBgR(r.id)} className=\"codex-thumb\" />\n318:                  <span className=\"codex-name\">{r.name}</span>\n319:                  <span className=\"codex-meta\">\n337:                  className={`btn codex-card codex-card-btn ${selectedId === e.id ? 'is-sel' : ''}`}\n341:                  <MaybeImg src={gameImg(e.sprite)} className=\"codex-thumb\" />\n342:                  <span className=\"codex-name\">{e.name}</span>\n343:                  <span className=\"codex-meta\">{ELEMENT_LABELS[e.element]} / 剛{e.tier}</span>\n359:                  className={`btn codex-card codex-card-btn ${selectedId === g.id ? 'is-sel' : ''}`}\n363:                  <GodImgOrFallback g={g} className=\"codex-thumb codex-thumb-tall\" compact />\n364:                  <span className=\"codex-name\">{g.name}</span>\n365:                  <span className=\"codex-meta\">{GOD_RANK_LABELS[g.rank]} / {ELEMENT_LABELS[g.element]}の星</span>\n377:                  <div className=\"codex-grid\">\n383:                          className={`btn codex-card codex-card-btn nemesis-card ${selectedId === n.id ? 'is-sel' : ''}`}\n387:                          {e && <MaybeImg src={gameImg(e.sprite)} className=\"codex-thumb nemesis-thumb\" />}\n388:                          <span className=\"codex-name\">{n.name}</span>\n395:                    <button className=\"btn btn-ghost codex-more\" onClick={showMore}>さらに表示({nemeses.length - shown}体)</button>\n403:        {!isMobile && <div className=\"codex-detail\" role=\"region\" aria-label=\"選んだ記録の詳細\" tabIndex={-1}>\n405:          {!hasSelection && <div className=\"codex-detail-empty\">カードを選ぶと、ここに詳しく綴られる。</div>}\n411:          <div className=\"codex-mobile-detail\">{detailNode}</div>\n413:            <div className=\"codex-detail-nav\" aria-label=\"前後の記録へ移動\">\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command 'Get-Content src/core/data/gods.ts -TotalCount 90; Get-Content src/core/data/gods_low.ts -TotalCount 16; $p='\"'src/core/expedition.ts'; \"'$l=Get-Content $p;for($i=73;$i -le 110;$i++){'\"'{0}: {1}' -f \"'$i,$l[$i-1]}; $p='\"'src/core/store.ts'; \"'$l=Get-Content $p;for($i=2118;$i -le 2149;$i++){'\"'{0}: {1}' -f \"'$i,$l[$i-1]}'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command 'Get-Content src/core/data/gods.ts -TotalCount 90; Get-Content src/core/data/gods_low.ts -TotalCount 16; $p='\"'src/core/expedition.ts'; \"'$l=Get-Content $p;for($i=73;$i -le 110;$i++){'\"'{0}: {1}' -f \"'$i,$l[$i-1]}; $p='\"'src/core/store.ts'; \"'$l=Get-Content $p;for($i=2118;$i -le 2149;$i++){'\"'{0}: {1}' -f \"'$i,$l[$i-1]}'","aggregated_output":"import type { God, GameData } from '../types'\r\nimport { FAME_SEAL_THRESHOLD } from '../constants'\r\nimport { GODS_LOW, MOURNING_LOW } from './gods_low'\r\nimport { GODS_MID, MOURNING_MID } from './gods_mid'\r\nimport { GODS_HIGH, MOURNING_HIGH } from './gods_high'\r\nimport { GODS_APEX, MOURNING_APEX } from './gods_apex'\r\n\r\n// 星神 — 星契りの相手。位が高いほど強い血潮を授ける。\r\n// 初期24柱は本ファイル(FOUNDING_GODS)、増員分は位階別ファイル(gods_low/mid/high/apex)。\r\n// 結合エクスポートは末尾のGODS/MOURNING(GDD_v3 §5)。\r\nconst FOUNDING_GODS: God[] = [\r\n  {\r\n    id: 'ishiusu', name: '石臼翁', kana: 'いしうすのおきな', rank: 1, element: 'earth',\r\n    statBias: { vit: 22, str: 10 }, cost: 80, skillId: 'g_iwakura',\r\n    personality: '頑固一徹、孫には甘い',\r\n    desc: '郷の石臼に千年宿る星の翁。挽いた粉で作る団子は絶品。「儂の孫は転ばん。転んでも泣かん」',\r\n    pactLines: ['ふん、儂の血が欲しいか。……よかろう、丈夫な子になるぞ。', 'また来たか。……団子を食っていけ。子の話はそれからじゃ。'],\r\n    portrait: 'god_ishiusu.png',\r\n  },\r\n  {\r\n    id: 'tsubame', name: '燕颪', kana: 'つばめおろし', rank: 1, element: 'wind',\r\n    statBias: { agi: 22, dex: 10 }, cost: 80, skillId: 'g_tsubame',\r\n    personality: '義理堅い旅烏',\r\n    desc: '南から北へ、星の間を渡る燕の神。一宿一飯の恩は千年忘れない。「借りは返す。それが渡り者の流儀だ」',\r\n    pactLines: ['あんたの家系には昔、世話になった。この借り、子で返すぜ。', 'また会ったな。あんたの家の子は、みんな良い目をしてる。'],\r\n    portrait: 'god_tsubame.png',\r\n  },\r\n  {\r\n    id: 'shimihime', name: '紙魚姫', kana: 'しみひめ', rank: 1, element: 'moon',\r\n    statBias: { dex: 16, mnd: 16 }, cost: 90, skillId: 'g_kamifubuki',\r\n    personality: '本の虫、綴の幼馴染',\r\n    desc: '家譜の紙の間に棲む小さな女神。千年分の家譜を全て読んでいる。「あなたの曾祖母の辞世、私、大好きなの」',\r\n    pactLines: ['家譜の続き、私にも書かせてくれる? ……子という名の頁を。', '綴には内緒よ。あの人、私が頁を折ると怒るんだから。'],\r\n    portrait: 'god_shimihime.png',\r\n  },\r\n  {\r\n    id: 'chidori', name: '澪標千鳥', kana: 'みおつくしちどり', rank: 2, element: 'water',\r\n    statBias: { mnd: 20, vit: 12 }, cost: 200, skillId: 'g_miobiki',\r\n    personality: '迷い船の導き手、なのに方向音痴',\r\n    desc: '夜の海で迷う船を導く星。本人は郷への道をよく間違える。「導きの星が迷ってどこが悪いの」',\r\n    pactLines: ['迷わない子を産みましょう。私の分まで、まっすぐ歩ける子を。', 'あら、また迷ってここへ? ……ふふ、私たち似た者同士ね。'],\r\n    portrait: 'god_chidori.png',\r\n  },\r\n  {\r\n    id: 'kagaribi', name: '篝火乙女', kana: 'かがりびおとめ', rank: 2, element: 'fire',\r\n    statBias: { str: 18, dex: 14 }, cost: 220, skillId: 'g_ryougen',\r\n    personality: '照れると物理的に燃える',\r\n    desc: '祭の篝火に宿る乙女。想いが昂ぶると火柱が立つため、告白された回数だけ郷の火事がある。',\r\n    pactLines: ['ち、契り!? わ、私と!? ……火事になっても知らないから!', '……あなたの顔を見ると、灯が安らぐの。不思議ね。'],\r\n    portrait: 'god_kagaribi.png',\r\n  },\r\n  {\r\n    id: 'yoigumo', name: '宵蜘蛛御前', kana: 'よいぐもごぜん', rank: 2, element: 'moon',\r\n    statBias: { dex: 20, agi: 12 }, cost: 220, skillId: 'g_shibariito',\r\n    personality: '妖しい女怪、実は良妻賢母',\r\n    desc: '宵闇に糸を張る蜘蛛の女神。怖がられるが、その糸で郷の子らの破れた着物を夜な夜な繕っている。',\r\n    pactLines: ['私の糸は千年切れぬ。あなたとの縁も、そういうことよ。', '子らの着物、また破けていたわね。……直しておいたから。'],\r\n    portrait: 'god_yoigumo.png',\r\n  },\r\n  {\r\n    id: 'yukiango', name: '雪安居', kana: 'ゆきあんご', rank: 2, element: 'water',\r\n    statBias: { mnd: 18, dex: 14 }, cost: 240, skillId: 'g_yukiakatsuki',\r\n    personality: '無口な雪僧、字が美しい',\r\n    desc: '雪山で座禅を組み続ける僧形の星。喋らぬ代わりに雪面に字を書く。その筆跡は綴すら唸る。',\r\n    pactLines: ['(雪面に「良縁」と書いてある)', '(雪面に「子は宝」と書いてある。少し照れているようだ)'],\r\n    portrait: 'god_yukiango.png',\r\n  },\r\n  {\r\n    id: 'tsukiura', name: '月裏兎', kana: 'つきうらのうさぎ', rank: 2, element: 'moon',\r\n    statBias: { mnd: 22, luk: 10 }, cost: 260, skillId: 'g_hiyaku',\r\n    personality: '月の裏の薬師、皮肉屋',\r\n    desc: '月の裏側で薬を搗く兎の神。「不老不死の薬? 作れるけど、あんたらの八季が愛おしいのはそのせいでしょ」',\r\n    pactLines: ['薬より効くものを教えてあげる。……家族よ。癪だけど本当なの。', 'あんたの子に苦い薬は要らないわね。私の血が入るんだから。'],\r\n    portrait: 'god_tsukiura.png',\r\n  },\r\n  {\r\n    id: 'orihime', name: '織姫野分', kana: 'おりひめのわき', rank: 3, element: 'wind',\r\n    statBias: { dex: 24, agi: 18 }, cost: 450, skillId: 'g_tachinui',\r\n    personality: '風を織る姫、せっかち',\r\n    desc: '野分(台風)の風で錦を織る天の織り手。仕事が速すぎて暇を持て余し、暇すぎて夜藪の雲を千切って遊ぶ。',\r\n    pactLines: ['契る? いいわ、早くしましょ。私、待つのは嫌いなの。', 'あなたの一族の機の音、天まで聞こえてるのよ。良い音。'],\r\n    portrait: 'god_orihime.png',\r\n  },\r\n  {\r\n    id: 'ookuma', name: '大熊星辰', kana: 'おおくませいしん', rank: 3, element: 'earth',\r\n    statBias: { str: 26, vit: 16 }, cost: 500, skillId: 'g_fundogeki',\r\n    personality: '熊の荒神、子煩悩',\r\n    desc: '北天に座す大熊の星。怒れば山が割れるが、子熊(と一族の子ら)の前では地面に転がって腹を見せる。',\r\n    pactLines: ['ガハハ! 俺の子か! 良いぞ、山より強い子にしてやる!', 'おう、また来たか! 前の子は元気か? 爪は伸びてないか?'],\r\n    portrait: 'god_ookuma.png',\r\nimport type { God } from '../types'\r\n\r\n// ============================================================\r\n// 下つ星(rank1)増員分 — 小さき星々(GDD_v3 §1: 最終48柱)\r\n// 初期6柱(石臼翁・燕颪・紙魚姫・蓑虫親父・貝寄せ乙女・影法師)は gods.ts に残る。\r\n// 下つ星の流儀: 郷の暮らしのすぐ隣にいる、つつましい神々。\r\n// 神授技は共有の系統技 gs_{element}1(GDD_v3 §3)。\r\n// ============================================================\r\n\r\nexport const GODS_LOW: God[] = [\r\n  {\r\n    id: 'hiuchi', name: '火打婆', kana: 'ひうちばば', rank: 1, element: 'fire',\r\n    statBias: { str: 14, luk: 12 }, cost: 90, skillId: 'gs_fire1',\r\n    personality: '一発で火を点ける名人',\r\n    desc: '郷中の竈の火種を千年守ってきた婆星。どんな湿気た薪も、婆の火打石なら一発で点く。「湿気た心にも、点くよ」',\r\n    pactLines: ['あんたの家の火種、切らしたことないだろ? 婆の自慢だよ。……契り? 点けようじゃないか。', 'ほら、火花が良い音した。良い子が生まれる音だよ。'],\r\n73: }\r\n74: \r\n75: export function pickEnemies(region: Region, type: NodeType, depth: number, rng: Rng): string[] {\r\n76:   if (type === 'boss' && region.bossId) return [region.bossId, ...(BOSS_MINIONS[region.bossId] ?? [])]\r\n77:   const tierPool = ENEMIES.filter((e) => e.tier === region.tier)\r\n78:   const upperPool = ENEMIES.filter((e) => e.tier === region.tier && e.hoto >= 50)\r\n79:   if (type === 'elite') {\r\n80:     const elites = upperPool.length > 0 ? upperPool : tierPool\r\n81:     return [rng.pick(elites).id]\r\n82:   }\r\n83:   const count = depth < 3 ? rng.int(1, 2) : rng.int(2, 3)\r\n84:   return Array.from({ length: count }, () => rng.pick(tierPool).id)\r\n85: }\r\n86: \r\n87: // 灯の消費 — 深い場所ほど夜が重い\r\n88: export const LIGHT_COST = { move: 6, battle: 8, elite: 12, boss: 0 }\r\n89: \r\n90: // 灯が尽きた時の被ダメ倍率\r\n91: export function darknessPenalty(light: number): number {\r\n92:   if (light > 0) return 1\r\n93:   return 1.5\r\n94: }\r\n95: \r\n96: // 宝ノードの中身\r\n97: export function rollTreasure(region: Region, rng: Rng): { hoto: number; ketsu: number; item?: Item; text: string } {\r\n98:   const base = region.tier * 30\r\n99:   const r = rng.next()\r\n100:   if (r < 0.45) {\r\n101:     const hoto = Math.round(base * (1 + rng.next()))\r\n102:     return { hoto, ketsu: 0, text: `朽ちた祠に奉燈${hoto}が供えられていた。ありがたく頂く。` }\r\n103:   }\r\n104:   if (r < 0.75) {\r\n105:     const ketsu = region.tier + rng.int(0, 2)\r\n106:     return { hoto: 0, ketsu, text: `魔性の骸から血珠${ketsu}を拾い上げた。` }\r\n107:   }\r\n108:   const pool = ITEM_BASES.filter((b) => b.shopTier <= region.tier)\r\n109:   const item = makeItem(rng.pick(pool).baseId, 'chest')\r\n110:   return { hoto: 0, ketsu: 0, item, text: `行き倒れの荷から「${item.name}」を見つけた。供養を約束して受け取る。` }\r\n2118:           battleNodeId: null,\r\n2119:           goldenBattle: false,\r\n2120:           rareEncounter: null,\r\n2121:           nemesisBattleId: nem.id,\r\n2122:           screen: { id: 'battle' },\r\n2123:           battleLogQueue: [...battle.log],\r\n2124:         })\r\n2125:         return\r\n2126:       }\r\n2127:       const enemyIds = rareRoll\r\n2128:         ? [rareRoll.enemy.id]\r\n2129:         : boss\r\n2130:         ? [region.bossId ?? 'kubinashi_andon'] // 地域の主(未設定地域は首無し行灯が主代わり)\r\n2131:         : pickEnemies(region, 'battle', run.floor + 2, rng)\r\n2132:       const party = enrichAllies(\r\n2133:         d.family\r\n2134:           .filter((c) => run.partyIds.includes(c.id) && c.alive && c.hp > 0)\r\n2135:           .map((c, i) => combatantFromChar(c, i < 2 ? 'front' : 'back')),\r\n2136:         d.family,\r\n2137:         d.motto,\r\n2138:         run.boons,\r\n2139:         activeFamiliarElement(d),\r\n2140:       )\r\n2141:       // 主が未設定の地域はエリート級を主に見立てて強化する。真の主(tier5)は素の強さで十分\r\n2142:       const standInBoss = boss && !region.bossId\r\n2143:       const enemies = enemyIds.map((id, i) => {\r\n2144:         const def = rareRoll?.enemy.id === id ? rareRoll.enemy : enemyById(id)\r\n2145:         return combatantFromEnemy(scaleEncounterEnemy(def, {\r\n2146:           narrativeMode: d.narrativeMode,\r\n2147:           dark,\r\n2148:           standInBoss,\r\n2149:         }), i)\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"agent_message","text":"収集表示に2点の不整合が見つかりました。祭を一度開くと全星神を「契約済み」と数えることと、最終戦の第二相で汐里の遭遇記録が追加されないことです。また、入力マニフェストの188ファイルはすべてハッシュが一致しました。結末の生成文も、読み取り専用の確認で再現を詰めています。\n"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -NoProfile -Command \"@'\nconst fs = require('node:fs');\nconst vm = require('node:vm');\nconst { stripTypeScriptTypes } = require('node:module');\nconst read = p => fs.readFileSync(p, 'utf8');\nconst strip = source => stripTypeScriptTypes(source).replace(/\"'^export /gm, '\"'');\nconst context = vm.createContext({ CHAPTERS: [], DREAM_EPISODES: [], REGIONS: [] });\nvm.runInContext(strip(read('src/core/narrative.ts').split(/\\\\r?\\\\n/).slice(6).join('\\\\n')), context);\nconst base = {family:[{id:'head',name:'燈',alive:true,isHead:true,equipment:{},gen:1}], inventory:[], flags:{},godAffinity:{},loreFrags:{}};\nfor (const [label, data] of [\n ['fallback',base],\n ['dead_and_lore',{...base,family:[...base.family,{name:'燈吾',alive:false,deathSeason:15,epitaph:'灯は続く',equipment:{}}],loreFrags:{yoi_forest:3}}],\n ['nemesis',{...base,nemeses:[{name:'燈吾喰らい',victim:'燈吾',level:1}]}]\n]) {\n context.data=data;\n console.log(label, vm.runInContext(\\\"personalizedEndingBeat(data,'save')\\\",context));\n}\nconst godsContext = vm.createContext({FAME_SEAL_THRESHOLD:1800});\nfor (const p of ['gods_low','gods_mid','gods_high','gods_apex','gods']) {\n vm.runInContext(strip(read('src/core/data/'+p+'.ts').replace(/\"'^import .*'\"\\\\r?\\\\n/gm,'')),godsContext);\n}\nconst gods = vm.runInContext('GODS',godsContext);\nconst chronicle = read('src/ui/Chronicle.tsx');\nconst recordSource = chronicle.slice(chronicle.indexOf('function computeRecords'),chronicle.indexOf('// 年代記の種別'));\nconst recordContext=vm.createContext({GODS:gods,ENEMIES:[],REGIONS:[],REGION_LORE:{},ITEM_SERIES_MANIFEST:[],collectionDiscoveredCount:()=>0,popcount15:()=>0});\nvm.runInContext(strip(recordSource),recordContext);\nrecordContext.data={...base,family:[],seasonIndex:2,fame:0,regionsCleared:[],codex:{gods:[],enemies:[]},godAffinity:Object.fromEntries(gods.map(g=>[g.id,0.5]))};\nconsole.log('festival_collection',vm.runInContext('JSON.stringify({seen:computeRecords(data).godSeen,pacted:computeRecords(data).godsPacted,actualContracts:data.codex.gods.length,titles:ACHIEVEMENTS.filter(a=>a.test(computeRecords(data))).map(a=>a.name)})',recordContext));\n'@ | node --no-warnings\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
