: '参', label: '見立て', step: 3 },\r\n35:]\r\n36:\r\n37:function PactSteps({ step }: { step: 1 | 2 | 3 }) {\r\n38:  return (\r\n39:    <div className=\"pact-steps\" role=\"list\" aria-label=\"交神の儀の進み\">\r\n40:      {PACT_STEPS.map((s, i) => {\r\n41:        const state = s.step < step ? 'done' : s.step === step ? 'current' : 'future'\r\n42:        return (\r\n43:          <div key={s.numeral} className=\"pact-step-wrap\" role=\"listitem\">\r\n44:            <span className={`pact-step pact-step-${state}`}>\r\n45:              <span className=\"pact-step-numeral\">{s.numeral}</span>\r\n46:              <span className=\"pact-step-label\">{s.label}</span>\r\n47:              {state === 'current' && <span className=\"pact-step-mark\">▼現在</span>}\r\n48:            </span>\r\n49:            {i < PACT_STEPS.length - 1 && <span className=\"pact-step-sep\">/</span>}\r\n50:          </div>\r\n51:        )\r\n52:      })}\r\n53:    </div>\r\n54:  )\r\n55:}\r\n56:\r\n57:// 子の見立てレンジ(中央値)から「伸びる2能力・弱い1能力」を一言に(表示専用・予測ロジック不変)\r\n58:function predictionSummary(prediction: Record<StatKey, [number, number]>): string {\r\n59:  const mids = (Object.keys(STAT_LABELS) as StatKey[])\r\n60:    .map((k) => [k, (prediction[k][0] + prediction[k][1]) / 2] as [StatKey, number])\r\n61:    .sort((a, b) => b[1] - a[1])\r\n62:  const rising = mids.slice(0, 2).map(([k]) => STAT_LABELS[k]).join('・')\r\n63:  const weak = STAT_LABELS[mids[mids.length - 1][0]]\r\n64:  return `${rising}が伸びやすく、${weak}が弱点となりそうだ。`\r\n65:}\r\n66:\r\n67:export function PactScreen() {\n68:  const data = useGame((s) => s.data)!\n69:  const setScreen = useGame((s) => s.setScreen)\n70:  const doPact = useGame((s) => s.doPact)\n71:  const adults = data.family.filter((c) => c.alive && isAdult(c, data.seasonIndex))\n72:  const [parentId, setParentId] = useState<string | null>(() => adults.length === 1 ? adults[0].id : null)\n73:  const [godId, setGodId] = useState<string | null>(null)\n74:  const [showAllGods, setShowAllGods] = useState(false)\n75:  const [activeGodIndex, setActiveGodIndex] = useState(0)\n76:  const [rankTab, setRankTab] = useState<GodRank | 0>(0) // 0=全て\r\n77:  const [elemChip, setElemChip] = useState<Element | null>(null)\r\n78:  const [onlyAffordable, setOnlyAffordable] = useState(false) // 絞り込み: 費用内(M18)\r\n79:  const [onlyUncontracted, setOnlyUncontracted] = useState(false) // 絞り込み: 未契約(M18)\r\n80:  const [ritual, setRitual] = useState(false) // 炎輪カットイン中\r\n81:  const [confirmOpen, setConfirmOpen] = useState(false) // M26 §9.5: 契りの最終確認Sheet\r\n82:  const pactFiredRef = useRef(false) // 二重実行防止 — 確認Sheetの実行CTA以外からdoPactを呼ばせない呼び出し済みフラグ\r\n83:\r\n84:  const parent = adults.find((c) => c.id === parentId) ?? null\n85:  const god = GODS.find((g) => g.id === godId) ?? null\r\n86:  const contractedGodIds = data.codex?.gods ?? []\r\n87:  // M33: 当主の最強素質を伸ばす神を推奨★表示(灯型/家業と同文法)。当主未選択(parent=null)なら推奨なし。\r\n88:  const recommendStat = parent ? strongestPotential(parent.potential) : null\r\n89:\r\n90:  // 奉納点(cost)昇順 — 俺屍の神名リスト様式。費用内/未契約は表示の絞り込みのみ(選択可否には無関係)\r\n91:  const filteredGods = GODS.filter((g) => {\n92:    if (rankTab !== 0 && g.rank !== rankTab) return false\r\n93:    if (elemChip !== null && g.element !== elemChip) return false\r\n94:    if (onlyAffordable && data.hoto < pactCost(g, data.godAffinity[g.id] ?? 0)) return false\r\n95:    if (onlyUncontracted && contractedGodIds.includes(g.id)) return false\r\n96:    return true\r\n97:  }).sort((a, b) => a.cost - b.cost)\n98:  const recommendedGods = [...GODS]\n99:    .filter((candidate) => godUnlocked(candidate, data))\n100:    .sort((a, b) => {\n101:      const score = (candidate: God) => {\n102:        const effectiveCost = pactCost(candidate, data.godAffinity[candidate.id] ?? 0)\n103:        const statMatch = recommendStat != null && topBias(candidate.statBias)[0]?.[0] === recommendStat ? 500 : 0\n104:        const affordable = effectiveCost <= data.hoto ? 250 : 0\n105:        const newBond = contractedGodIds.includes(candidate.id) ? 0 : 30\n106:        return statMatch + affordable + newBond - effectiveCost\n107:      }\n108:      return score(b) - score(a) || a.cost - b.cost\n109:    })\n110:    .slice(0, 3)\n111:  const shownGods = showAllGods ? filteredGods : recommendedGods\n112:\r\n113:  const prediction = useMemo(\r\n114:    () => (parent && god ? predictChild(parent, god) : null),\r\n115:    [parent, god],\r\n116:  )\r\n117:\r\n118:  // 実ステップ(壱親/弐星/参見立て) — 選択状態から導出。ロジック非依存の表示専用(M18)\r\n119:  const pactStep: 1 | 2 | 3 = !parent ? 1 : !god ? 2 : 3\r\n120:\r\n121:  // M26 §9.5: 契るCTAは確認Sheetを開くだけ(M26-P0-01是正)。doPactは確認Sheetの実行CTAからのみ呼ぶ。\r\n122:  const openPactConfirm = () => {\r\n123:    if (!parent || !god || ritual || confirmOpen) return\r\n124:    setConfirmOpen(true)\r\n125:  }\r\n126:\r\n127:  // 確認Sheetの実行CTA(data-testid=\"pact-confirm\")専用。pactFiredRefで二重実行を防ぎ、\r\n128:  // 実行後は即Sheetを閉じて演出へ入る — 演出中はActionDockのCTAもritual状態で無効化される。\r\n129:  const confirmPact = () => {\r\n130:    if (!parent || !god || ritual || pactFiredRef.current) return\r\n131:    pactFiredRef.current = true\r\n132:    setConfirmOpen(false)\r\n133:    setRitual(true)\r\n134:    setTimeout(() => {\r\n135:      doPact(parent.id, god.id)\r\n136:      setRitual(false)\r\n137:      pactFiredRef.current = false\r\n138:    }, 1100)\r\n139:  }\r\n140:\r\n141:  // 画面下固定CTA(ActionDock)の状態 — 未達理由は1行のみ、優先順位: 親→星→奉燈(M18)\r\n142:  const dockCost = god ? pactCost(god, data.godAffinity[god.id] ?? 0) : 0\r\n143:  const dockShortfall = god ? Math.max(0, dockCost - data.hoto) : 0\r\n144:  const dockNote = !parent\r\n145:    ? '親を選べ'\r\n146:    : !god\r\n147:      ? '星神を選べ'\r\n148:      : dockShortfall > 0\r\n149:        ? `奉燈があと${dockShortfall}足りない`\r\n150:        : undefined\r\n151:  const dockReady = Boolean(parent && god && dockShortfall === 0 && !ritual)\r\n152:  const dockLabel = parent && god && dockShortfall === 0\r\n153:    ? `${parent.name} × ${god.name} ／ 奉燈${dockCost} ／ 契る`\r\n154:    : '契る'\r\n155:\r\n156:  return (\r\n157:    <div className=\"screen pact-screen pact-has-dock\">\r\n158:      <NightBackdrop bg={gameImg(HOME_BG)} />\r\n159:      <h1 className=\"season-label\" style={{ marginBottom: 14 }}>交神の儀</h1>\r\n160:      <TsuzuriLine text=\"星神と契れば、翌月に子が生まれる。血潮は親と神から流れ込む — 誰の血を、どの星に継がせる?\" />\r\n161:\r\n162:      <PactSteps step={pactStep} />\r\n163:\r\n164:      <Panel title=\"契る者を選ぶ\">\r\n165:        <div className=\"exp-party\">\r\n166:          {adults.map((c) => (\r\n167:            <CharCard\r\n168:              key={c.id}\r\n169:              char={c}\r\n170:              seasonIndex={data.seasonIndex}\r\n171:              compact\r\n172:              selected={parentId === c.id}\r\n173:              onClick={() => setParentId(c.id)}\r\n174:            />\r\n175:          ))}\r\n176:        </div>\r\n177:      </Panel>\n178:\n179:      <Panel title={`星神を選ぶ — 奉燈 ${data.hoto}`}>\n180:        <div className=\"pact-curation-head\">\n181:          <div>\n182:            <b>{showAllGods ? '全ての星' : '今夜、血に合う三柱'}</b>\n183:            <span>{showAllGods ? '位階・属性・費用から自由に探せる。' : parent ? `${parent.name}の強み・奉燈・未契約を読んだ薦め。どの星を選んでもよい。` : '先に親を選ぶと、血潮に合う理由を示す。'}</span>\n184:          </div>\n185:          <button\n186:            type=\"button\"\n187:            className=\"btn btn-ghost\"\n188:            aria-expanded={showAllGods}\n189:            onClick={() => { setShowAllGods((shown) => !shown); setActiveGodIndex(0) }}\n190:          >\n191:            {showAllGods ? '薦め三柱へ戻る' : '全ての星を見る'}\n192:          </button>\n193:        </div>\n194:        {showAllGods && <div className=\"god-filter\">\n195:          <div className=\"god-filter-row\">\r\n196:            {([0, 1, 2, 3, 4] as const).map((r) => (\r\n197:              <button\r\n198:                key={r}\r\n199:                className={`btn btn-ghost filter-tab ${rankTab === r ? 'active' : ''}`}\r\n200:                aria-pressed={rankTab === r}\r\n201:                onClick={() => setRankTab(r)}\r\n202:              >\r\n2