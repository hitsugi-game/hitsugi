{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$s=Get-Content src/core/store.ts; 287..416 + 492..590 + 650..771 + 885..928 | ForEach-Object { '\"'{0}: {1}' -f \"'$_, $s[$_-1] }'","aggregated_output":"287:   const withNarrative = (d: GameData): GameData => migrateM34Narrative(d)\r\n288: \r\n289:   const elapsedSceneMs = (startedAt: number | undefined): number =>\r\n290:     startedAt === undefined ? 0 : Math.min(30 * 60 * 1000, Math.max(0, Date.now() - startedAt))\r\n291: \r\n292:   const sceneToScreen = (scene: PendingScene): Screen =>\r\n293:     scene.kind === 'birth'\r\n294:       ? { id: 'birth', charId: scene.charId }\r\n295:       : scene.kind === 'death'\r\n296:         ? { id: 'death', charId: scene.charId }\r\n297:         : scene.kind === 'ceremony'\r\n298:           ? { id: 'ceremony', charId: scene.charId }\r\n299:           : scene.kind === 'jobrite'\r\n300:             ? { id: 'jobrite', charId: scene.charId }\r\n301:             : scene.kind === 'life'\r\n302:               ? { id: 'life', title: scene.title, lines: scene.lines, bg: scene.bg, narrativeId: scene.narrativeId }\r\n303:               : scene.kind === 'dreamEp'\r\n304:                 ? { id: 'dreamEp', epId: scene.epId }\r\n305:                 : { id: 'dream' }\r\n306: \r\n307:   const isResolvedScene = (d: GameData, scene: PendingScene): boolean => {\r\n308:     const nd = withNarrative(d)\r\n309:     const id = narrativeSceneId(scene)\r\n310:     return nd.narrative!.completed.includes(id)\r\n311:   }\r\n312: \r\n313:   // 同月の強制全画面は優先度順の1件だけ。残りは消さず「灯の余白」へ保存する。\r\n314:   const partitionScenes = (d0: GameData, candidates: PendingScene[]): { data: GameData; primary: PendingScene | null } => {\r\n315:     let d = withNarrative(d0)\r\n316:     const n = d.narrative!\r\n317:     const normalized = candidates.map((scene, index): PendingScene =>\r\n318:       scene.kind === 'life' && !scene.narrativeId\r\n319:         ? { ...scene, narrativeId: `life:${d.seasonIndex}:${index}:${scene.title}` }\r\n320:         : scene,\r\n321:     )\r\n322:     const partition = partitionNarrativeScenes(n, normalized)\r\n323:     const deferredAt = Date.now()\r\n324:     const deferredSince = Object.fromEntries(partition.deferred.map((scene) => {\r\n325:       const id = narrativeSceneId(scene)\r\n326:       return [id, n.deferredSince[id] ?? deferredAt]\r\n327:     }))\r\n328:     d = {\r\n329:       ...d,\r\n330:       narrative: {\r\n331:         ...n,\r\n332:         queued: partition.queued,\r\n333:         deferred: partition.deferred,\r\n334:         deferredSince,\r\n335:         monthTransitionPending: true,\r\n336:         metrics: {\r\n337:           ...n.metrics,\r\n338:           monthsAdvanced: n.metrics.monthsAdvanced + 1,\r\n339:           maxDeferred: Math.max(n.metrics.maxDeferred, partition.deferred.length),\r\n340:         },\r\n341:       },\r\n342:     }\r\n343:     return { data: d, primary: partition.primary }\r\n344:   }\r\n345: \r\n346:   const markSceneResolved = (d0: GameData, scene: PendingScene, skipped: boolean): GameData => {\r\n347:     let d = withNarrative(d0)\r\n348:     const id = narrativeSceneId(scene)\r\n349:     const n = d.narrative!\r\n350:     if (n.completed.includes(id)) {\r\n351:       // ch4は最終頁へ入るtransactionで完了flagも原子的に立つため、直後の「読み終える」は\r\n352:       // completed済みに見える。それでも同じsceneがactiveな閉じ処理だけは一度計測する。\r\n353:       const closingActive = !!n.active && narrativeSceneId(n.active) === id\r\n354:       const closingReplay = closingActive && !!n.activeReplay\r\n355:       const deferredSince = { ...n.deferredSince }\r\n356:       delete deferredSince[id]\r\n357:       return {\r\n358:         ...d,\r\n359:         narrative: {\r\n360:           ...n,\r\n361:           active: undefined,\r\n362:           activeOpenedAt: undefined,\r\n363:           activeReplay: undefined,\r\n364:           monthTransitionPending: false,\r\n365:           seen: [...new Set([...n.seen, id])],\r\n366:           queued: n.queued.filter((x) => x !== id),\r\n367:           deferred: n.deferred.filter((x) => narrativeSceneId(x) !== id),\r\n368:           deferredSince,\r\n369:           metrics: closingActive && !closingReplay\r\n370:             ? {\r\n371:                 ...n.metrics,\r\n372:                 totalSceneMs: n.metrics.totalSceneMs + elapsedSceneMs(n.activeOpenedAt),\r\n373:                 scenesSkipped: n.metrics.scenesSkipped + (skipped ? 1 : 0),\r\n374:                 scenesCompleted: n.metrics.scenesCompleted + (skipped ? 0 : 1),\r\n375:               }\r\n376:             : n.metrics,\r\n377:         },\r\n378:       }\r\n379:     }\r\n380:     const flags = { ...d.flags }\r\n381:     if (scene.kind === 'dream') {\r\n382:       flags.dreamSeen = true\r\n383:     } else if (scene.kind === 'dreamEp') {\r\n384:       flags[`dreamEp_${scene.epId}`] = true\r\n385:     } else if (scene.kind === 'life' && scene.narrativeId?.startsWith('ch')) {\r\n386:       flags[`${scene.narrativeId}_completed`] = true\r\n387:     }\r\n388:     d = {\r\n389:       ...d,\r\n390:       flags,\r\n391:       narrative: {\r\n392:         ...n,\r\n393:         stage: n.stage,\r\n394:         active: undefined,\r\n395:         activeOpenedAt: undefined,\r\n396:         activeReplay: undefined,\r\n397:         monthTransitionPending: false,\r\n398:         seen: [...new Set([...n.seen, id])],\r\n399:         completed: [...new Set([...n.completed, id])],\r\n400:         archive: isReplayableNarrativeScene(scene) ? uniqueScenes([scene, ...n.archive]) : n.archive,\r\n401:         queued: n.queued.filter((x) => x !== id),\r\n402:         deferred: n.deferred.filter((x) => narrativeSceneId(x) !== id),\r\n403:         deferredSince: Object.fromEntries(Object.entries(n.deferredSince).filter(([sceneId]) => sceneId !== id)),\r\n404:         metrics: {\r\n405:           ...n.metrics,\r\n406:           totalSceneMs: n.metrics.totalSceneMs + elapsedSceneMs(n.activeOpenedAt),\r\n407:           scenesSkipped: n.metrics.scenesSkipped + (skipped ? 1 : 0),\r\n408:           scenesCompleted: n.metrics.scenesCompleted + (skipped ? 0 : 1),\r\n409:         },\r\n410:       },\r\n411:     }\r\n412:     d = { ...d, narrative: { ...d.narrative!, stage: migrateM34Narrative(d).narrative!.stage } }\r\n413:     return d\r\n414:   }\r\n415: \r\n416:   // v3.1 M16-3: 郷の物語(会話キュー) — 死/代替わり/帰還のたび、一本だけ解禁を試みる\r\n492:   const advanceSeason = (): void => {\r\n493:     const rng = get().rng\r\n494:     const scenes: PendingScene[] = [...get().pendingScenes]\r\n495:     let d = withNarrative(get().data!)\r\n496:     d = { ...d, seasonIndex: d.seasonIndex + 1 }\r\n497:     d = markJourneyMilestone(d, 'next_month')\r\n498: \r\n499:     // 誕生 — v3.1 M12: 縁の加護(下振れ緩和)/隔世遺伝/稀に双子\r\n500:     const due = d.pendingBirths.filter((b) => b.dueSeason <= d.seasonIndex)\r\n501:     d = { ...d, pendingBirths: d.pendingBirths.filter((b) => b.dueSeason > d.seasonIndex) }\r\n502:     for (const b of due) {\r\n503:       const god = godById(b.godId)\r\n504:       const parent = d.family.find((c) => c.id === b.parentId)\r\n505:       if (!parent) continue\r\n506:       const gen = parent.gen + 1\r\n507:       const affinity = d.godAffinity[b.godId] ?? 0\r\n508:       const twins = rng.chance(0.06)\r\n509:       const count = twins ? 2 : 1\r\n510:       for (let i = 0; i < count; i++) {\r\n511:         let child = conceiveChild(\r\n512:           parent, god, gen, d.seasonIndex, rng,\r\n513:           d.family.map((c) => c.name),\r\n514:           affinity, d.family,\r\n515:         )\r\n516:         // 書庫(M16-6): 先達の知恵が、子の血潮に僅かな伸びしろを残す(上限120は維持)\r\n517:         const shokoBonus = shokoPotentialBonus(facilityLevel(d.facilities, 'shoko'))\r\n518:         if (shokoBonus > 0) {\r\n519:           const boosted = { ...child.potential }\r\n520:           for (const k of Object.keys(boosted) as (keyof typeof boosted)[]) {\r\n521:             boosted[k] = Math.min(120, Math.round(boosted[k] * (1 + shokoBonus)))\r\n522:           }\r\n523:           const withStats = recalcStats({ ...child, potential: boosted }, d.seasonIndex)\r\n524:           child = { ...withStats, hp: withStats.maxHp, mp: withStats.maxMp }\r\n525:         }\r\n526:         d = { ...d, family: [...d.family, child] }\r\n527:         d = markJourneyMilestone(d, 'birth')\r\n528:         d = chronicle(d, 'birth', birthLine(child.name, god.name, rng), child.id)\r\n529:         if (child.deeds.some((x) => x.includes('隔世遺伝'))) {\r\n530:           d = chronicle(d, 'event', `${child.name}に、祖の血が強く顕れている。`, child.id)\r\n531:         }\r\n532:         if (child.deeds.some((x) => x.includes('神童'))) {\r\n533:           d = chronicle(d, 'era', `${child.name}、神童の相を持って生まれる — 郷がどよめいた。`, child.id)\r\n534:         }\r\n535:         scenes.push({ kind: 'birth', charId: child.id })\r\n536:       }\r\n537:       if (twins) d = chronicle(d, 'event', `${parent.name}に双子が生まれた — 郷は二重の産声に沸いた。`)\r\n538:     }\r\n539: \r\n540:     // 寿命 — 八季の命\r\n541:     for (const c of d.family) {\r\n542:       if (!c.alive) continue\r\n543:       if (ageOf(c, d.seasonIndex) >= LIFESPAN_MONTHS) {\r\n544:         const epitaph = generateEpitaph(c, 'lifespan', rng)\r\n545:         // 形見: 装備は継承品として蔵へ\r\n546:         const keepsakes: Item[] = []\r\n547:         for (const slot of ['weapon', 'armor', 'charm'] as const) {\r\n548:           const it = c.equipment[slot]\r\n549:           if (it) keepsakes.push(inheritItem(it, c.name, c.kills))\r\n550:         }\r\n551:         d = {\r\n552:           ...d,\r\n553:           inventory: [...d.inventory, ...keepsakes],\r\n554:           successionPending: c.isHead\r\n555:             ? { predecessorId: c.id, heirloomIds: keepsakes.map((item) => item.id) }\r\n556:             : d.successionPending,\r\n557:           family: d.family.map((x) =>\r\n558:             x.id === c.id\r\n559:               ? { ...x, alive: false, deathSeason: d.seasonIndex, deathCause: deathCauseLabel('lifespan'), epitaph, equipment: {}, isHead: false }\r\n560:               : x,\r\n561:           ),\r\n562:         }\r\n563:         d = chronicle(d, 'death', `${c.name}、${deathCauseLabel('lifespan')}。享年八季。「${epitaph}」`, c.id)\r\n564:         d = markJourneyMilestone(d, 'first_death')\r\n565:         d = tryUnlockGossip(d)\r\n566:         scenes.push({ kind: 'death', charId: c.id })\r\n567:       }\r\n568:     }\r\n569: \r\n570:     // 当主継承\r\n571:     if (!d.family.some((c) => c.alive && c.isHead)) {\r\n572:       const successor = chooseSuccessor(d)\r\n573:       if (successor) {\r\n574:         const question = generationQuestion(d)\r\n575:         const predecessor = d.family.find((char) => char.id === d.successionPending?.predecessorId)\r\n576:           ?? [...d.family].filter((char) => !char.alive).sort((a, b) => (b.deathSeason ?? -1) - (a.deathSeason ?? -1))[0]\r\n577:         const keepsakes = (d.successionPending?.heirloomIds ?? [])\r\n578:           .map((id) => d.inventory.find((item) => item.id === id))\r\n579:           .filter((item): item is Item => !!item)\r\n580:         d = {\r\n581:           ...d,\r\n582:           family: d.family.map((x) => (x.id === successor.id ? { ...x, isHead: true, deeds: [...x.deeds, '当主を継いだ'] } : x)),\r\n583:         }\r\n584:         d = addResonance(d, 'inherit')\r\n585:         d = { ...d, narrative: { ...d.narrative!, generationQuestion: question } }\r\n586:         d = chronicle(d, 'era', `${successor.name}、第${successor.gen}代当主を継ぐ。`)\r\n587:         d = chronicle(d, 'era', `今代の問い — ${question}`)\r\n588:         d = tryUnlockGossip(d)\r\n589:         if (predecessor) {\r\n590:           const succession = buildSuccessionScene(d, predecessor, successor, keepsakes, question)\r\n650:     }\r\n651: \r\n652:     // 本編の章(v3.1 M15-4) — 条件を満たした月に一度だけ語られる\r\n653:     const chapterUnlocked = (id: string): boolean => Boolean(\r\n654:       d.flags[id] || d.flags[`${id}_completed`] || d.narrative?.completed.includes(id),\r\n655:     )\r\n656:     const chapterDue = CHAPTERS.find((ch, index) => {\r\n657:       if (chapterUnlocked(ch.id)) return false\r\n658:       if (CHAPTERS.slice(0, index).some((previous) => !chapterUnlocked(previous.id))) return false\r\n659:       switch (ch.id) {\r\n660:         case 'ch1': return d.seasonIndex >= 2\r\n661:         case 'ch2': return d.regionsCleared.length >= 1\r\n662:         case 'ch3': return d.regionsCleared.length >= 5\r\n663:         case 'ch4': return (d.loreFrags?.['akashi_miyama'] ?? 0) >= 3 || d.regionsCleared.length >= 10\r\n664:         case 'ch5': return d.fame >= FAME_SEAL_THRESHOLD\r\n665:         default: return false\r\n666:       }\r\n667:     })\r\n668:     if (chapterDue) {\r\n669:       d = { ...d, flags: { ...d.flags, [chapterDue.id]: true } }\r\n670:       d = chronicle(d, 'era', `【${chapterDue.title}】語り継がれる千年の真実が、一つ明らかになった。`)\r\n671:       scenes.push({ kind: 'life', narrativeId: chapterDue.id, title: chapterDue.title, lines: chapterDue.lines })\r\n672:     }\r\n673: \r\n674:     // 灯座の深まり — 月齢で固有技が開く(10月・14月・18月=奥義)\r\n675:     d = {\r\n676:       ...d,\r\n677:       family: d.family.map((c) => {\r\n678:         if (!c.alive || !c.tomoshigata) return c\r\n679:         const toza = tozaOf(c.tomoshigata, c.element)\r\n680:         const age = ageOf(c, d.seasonIndex)\r\n681:         const learned = [...c.skills]\r\n682:         let awakened = false\r\n683:         if (age >= 10 && !learned.includes(toza.skills[1].id)) learned.push(toza.skills[1].id)\r\n684:         if (age >= 14 && !learned.includes(toza.skills[2].id)) learned.push(toza.skills[2].id)\r\n685:         if (age >= 18 && !learned.includes(toza.ougi.id)) {\r\n686:           learned.push(toza.ougi.id)\r\n687:           awakened = true\r\n688:         }\r\n689:         if (learned.length === c.skills.length) return c\r\n690:         if (awakened) {\r\n691:           d = chronicle(d, 'event', `${c.name}、灯座「${toza.name}」の奥義に開眼す。`)\r\n692:         }\r\n693:         return { ...c, skills: learned }\r\n694:       }),\r\n695:     }\r\n696: \r\n697:     // 家業の年季 — 月齢で家業技が開く(GDD_v3 §2)\r\n698:     d = {\r\n699:       ...d,\r\n700:       family: d.family.map((c) => {\r\n701:         if (!c.alive || !c.jobClass) return c\r\n702:         const job = jobById(c.jobClass)\r\n703:         const age = ageOf(c, d.seasonIndex)\r\n704:         const learned = [...c.skills]\r\n705:         job.skillIds.forEach((sid, i) => {\r\n706:           if (age >= JOB_SKILL_UNLOCK_AGES[i] && !learned.includes(sid)) learned.push(sid)\r\n707:         })\r\n708:         if (learned.length === c.skills.length) return c\r\n709:         return { ...c, skills: learned }\r\n710:       }),\r\n711:     }\r\n712: \r\n713:     // 成長(全員再計算)\r\n714:     d = { ...d, family: d.family.map((c) => (c.alive ? recalcStats(c, d.seasonIndex) : c)) }\r\n715: \r\n716:     // 郷の営み — 郷人たちが大燈籠に捧げる奉燈(月次・討伐が進むほど郷が潤う)\r\n717:     d = { ...d, hoto: d.hoto + 3 + d.regionsCleared.length * 2 }\r\n718: \r\n719:     // 社(M16-6): 月送りごと、既に契った星々(縁>0)への縁を篤くする\r\n720:     const yashiroGain = yashiroAffinityGain(facilityLevel(d.facilities, 'yashiro'))\r\n721:     if (yashiroGain > 0) {\r\n722:       d = {\r\n723:         ...d,\r\n724:         godAffinity: Object.fromEntries(\r\n725:           Object.entries(d.godAffinity).map(([gid, aff]) => [gid, aff > 0 ? aff + yashiroGain : aff]),\r\n726:         ),\r\n727:       }\r\n728:     }\r\n729: \r\n730:     // 夢渡り — 最初の看取り、または星骸の谷を制した早い方で入口が開く。\r\n731:     // 既読flagはqueue時でなく完読/skip時に立てるため、途中離脱でも失わない。\r\n732:     const deaths = d.family.filter((c) => !c.alive).length\r\n733:     if ((deaths >= 1 || d.regionsCleared.includes('hoshimukuro_tani')) && !d.flags.dreamSeen) {\r\n734:       const intro: PendingScene = { kind: 'dream' }\r\n735:       if (!isResolvedScene(d, intro)) scenes.push(intro)\r\n736:     } else {\r\n737:       // 夢渡りの連作 — 看取りの数だけ、千年前の記憶へ深く招かれる(1季に一篇まで)\r\n738:       const ep = nextDreamEpisode(d)\r\n739:       if (ep) {\r\n740:         scenes.push({ kind: 'dreamEp', epId: ep.id })\r\n741:       }\r\n742:     }\r\n743: \r\n744:     // 血脈断絶チェック\r\n745:     const extinct = !d.family.some((c) => c.alive) && d.pendingBirths.length === 0\r\n746:     const partitioned = partitionScenes({ ...d, seed: rng.state() }, scenes)\r\n747:     d = partitioned.data\r\n748:     saveGame(d)\r\n749:     set({ data: d, pendingScenes: partitioned.primary ? [partitioned.primary] : [] })\r\n750: \r\n751:     if (extinct) {\r\n752:       const ended: GameData = {\r\n753:         ...d,\r\n754:         flags: { ...d.flags, extinct: true },\r\n755:         narrative: { ...d.narrative!, monthTransitionPending: false },\r\n756:       }\r\n757:       set({ screen: { id: 'ending' }, data: ended, pendingScenes: [] })\r\n758:       saveGame(ended)\r\n759:       return\r\n760:     }\r\n761:     get().processNextScene()\r\n762:   }\r\n763: \r\n764:   // finishBattle remains the simulator/test compatibility entry point. This flag lets the\r\n765:   // settlement actions reuse its established route-specific transition code without\r\n766:   // re-entering the public settle -> continue wrapper.\r\n767:   let internalFinishBattle = false\r\n768: \r\n769:   return {\r\n770:     screen: { id: 'title' },\r\n771:     data: null,\r\n885:       saveGame(get().data!)\r\n886:     },\r\n887: \r\n888:     continueGame: () => {\r\n889:       const d = loadGame()\r\n890:       if (!d) return false\r\n891:       const restoredRun = d.dungeonRun ?? null\r\n892:       // v3.1 M16-8: 留守番内職 — 離れていた実時間ぶん、家族が内職をしていた(1時間4燈・上限24時間)\r\n893:       let nd: GameData = recoverNarrativeOnLoad({ ...d, expedition: undefined })\r\n894:       // 結末をまだ選んでいない頂のsaveは、郷でなく同じ岐路へ戻す。\r\n895:       // 修正前saveは第二相勝利時の家譜から復旧する。shioriPhaseは開始記録であり勝利証拠ではない。\r\n896:       const finalePending = nd.flags.finalePending === true || (\r\n897:         nd.flags.finalePending === undefined && nd.flags.cleared === true && nd.flags.endingType === undefined &&\r\n898:         nd.chronicle.some((entry) => entry.kind === 'era' &&\r\n899:           entry.text === '灯ノ御山の頂にて、家祖・汐里と相まみえる。千年の答えを、選ぶ時。')\r\n900:       )\r\n901:       if (d.lastPlayedAt) {\r\n902:         const hours = Math.min(24, (Date.now() - d.lastPlayedAt) / 3_600_000)\r\n903:         if (hours >= 1) {\r\n904:           const earned = Math.floor(hours * 4)\r\n905:           const worker = d.family.filter((c) => c.alive)[0]\r\n906:           nd = { ...nd, hoto: nd.hoto + earned }\r\n907:           nd = {\r\n908:             ...nd,\r\n909:             chronicle: [...nd.chronicle, {\r\n910:               season: nd.seasonIndex, kind: 'event' as const,\r\n911:               text: `留守の間、${worker ? `${worker.name}たち` : '家の者'}が内職に励んでいた — 奉燈${earned}。文が添えてある。「おかえりなさい。夜は変わらずですが、家は息災です」`,\r\n912:             }],\r\n913:           }\r\n914:         }\r\n915:       }\r\n916:       set({\r\n917:         data: nd,\r\n918:         rng: new Rng(d.seed ^ (Date.now() >>> 0)),\r\n919:         screen: nd.flags.extinct || nd.flags.endingPending === true ? { id: 'ending' }\r\n920:           : finalePending ? { id: 'finale' } : restoredRun ? { id: 'dungeon' } : { id: 'home' },\r\n921:         pendingScenes: [], battle: null, battleNodeId: null, pendingEvent: null, battleLogQueue: [],\r\n922:         battleSequence: 0, battleRewardSettlement: null, battleDefeatContinuation: null,\r\n923:         dungeonRun: restoredRun, battleSource: 'node', goldenBattle: false, rareEncounter: null,\r\n924:         nemesisBattleId: null, boonDraft: restoredRun?.boonDraft ?? null,\r\n925:       })\r\n926:       return true\r\n927:     },\r\n928: \r\n","exit_code":0,"status":"completed"}}
