9: const STAT_KEYS: StatKey[] = ['str', 'vit', 'dex', 'agi', 'mnd', 'luk']\r\n10: \r\n11: // 成長曲線 — 生後nヶ月の血潮発現率。16〜20ヶ月が全盛、晩年は僅かに衰える\r\n12: export const AGE_CURVE = [\r\n13:   0.30, 0.34, 0.38, 0.42, 0.47, 0.52, // 0-5月: 幼子\r\n14:   0.60, 0.65, 0.70, 0.74, 0.78, 0.82, // 6-11月: 成人・伸び盛り\r\n15:   0.86, 0.90, 0.93, 0.96, 1.00, 1.00, // 12-17月: 充実\r\n16:   1.00, 1.00, 0.98, 0.96, 0.93, 0.90, // 18-23月: 全盛から灯細り\r\n17: ]\r\n18: \r\n19: export const ADULT_MONTHS = 6 // 成人(初陣が許される月齢)\r\n20: \r\n21: export const GENERATION_VOWS: Readonly<Record<GenerationVowId, { name: string; promise: string; nextStep: string }>> = {\r\n22:   guard_line: { name: '血脈を守る', promise: '誰も独りで夜へ置いていかない', nextStep: 'まず家族の傷と後継の備えを確かめる' },\r\n23:   break_night: { name: '常夜を破る', promise: '恐れを抱いたままでも、夜の奥へ進む', nextStep: '先代が届かなかった地へ出立する' },\r\n24:   keep_names: { name: '名を忘れない', promise: '生きた証を、勝敗より長く家譜へ残す', nextStep: '家譜を開き、先代の名と事績を読む' },\r\n25: }\r\n26: \r\n27: export function ageOf(c: Character, seasonIndex: number): number {\r\n28:   return seasonIndex - c.bornSeason\r\n29: }\r\n30: \r\n31: export function isAdult(c: Character, seasonIndex: number): boolean {\r\n32:   return c.alive && ageOf(c, seasonIndex) >= ADULT_MONTHS\r\n33: }\r\n34: \r\n35: export function seasonsLeft(c: Character, seasonIndex: number): number {\r\n36:   return LIFESPAN_MONTHS - ageOf(c, seasonIndex)\r\n37: }\r\n38: \r\n39: // 現在ステータスを血潮×年齢曲線から再計算(HP/MP割合は維持)\r\n40: export function recalcStats(c: Character, seasonIndex: number): Character {\r\n41:   const age = Math.min(Math.max(ageOf(c, seasonIndex), 0), LIFESPAN_MONTHS - 1)\r\n42:   const mult = AGE_CURVE[age]\r\n43:   const potentialWithMastery = effectivePotential(c)\r\n44:   const stats = Object.fromEntries(\r\n45:     STAT_KEYS.map((k) => [k, Math.max(1, Math.round(potentialWithMastery[k] * mult))]),\r\n46:   ) as unknown as Stats\r\n47:   const maxHp = Math.round(stats.vit * 2.6 + 30)\r\n48:   const maxMp = Math.round(stats.mnd * 1.3 + 12)\r\n145:     potential,\r\n146:     level: 1,\r\n147:     exp: 0,\r\n148:     stats: { ...potential },\r\n149:     hp: 1, maxHp: 1, mp: 1, maxMp: 1,\r\n150:     element,\r\n151:     personalityId: rng.pick(PERSONALITIES).id,\r\n152:     skills: [...skills],\r\n153:     equipment: {},\r\n154:     godParentId: god.id,\r\n155:     humanParentId: parent.id,\r\n156:     isHead: false,\r\n157:     alive: true,\r\n158:     kills: 0,\r\n159:     expeditions: 0,\r\n160:     deeds: [\r\n161:       ...(atavism && grand ? [`${grand.name}の血が強く顕れた(隔世遺伝)`] : []),\r\n162:       ...(prodigy ? ['生まれながらに星の寵を受けた(神童の相)'] : []),\r\n163:     ],\r\n164:     fatigue: 0,\r\n165:   }\r\n166:   const withStats = recalcStats(child, bornSeason)\r\n167:   return { ...withStats, hp: withStats.maxHp, mp: withStats.maxMp }\r\n168: }\r\n169: \r\n170: // 縁による奉納点の割引(v3.1 M12-2): 縁1につき4%引、上限20%\r\n171: export function pactCost(god: God, affinity: number): number {\r\n172:   return Math.ceil(god.cost * (1 - Math.min(0.2, Math.floor(affinity) * 0.04)))\r\n173: }\r\n174: \r\n175: // 初代当主の生成\r\n176: export function makeFounder(bornSeason: number, rng: Rng): Character {\r\n177:   const potential: Stats = { str: 52, vit: 55, dex: 48, agi: 46, mnd: 42, luk: 45 }\r\n178:   const founder: Character = {\r\n179:     id: uid('chr'),\r\n180:     name: '燈吾',\r\n181:     gen: 1,\r\n182:     sex: 'm',\r\n183:     bornSeason: bornSeason - 9, // 既に9ヶ月生きている(残り15ヶ月)\r\n184:     potential,\r\n185:     level: 1,\r\n186:     exp: 0,\r\n187:     stats: { ...potential },\r\n188:     hp: 1, maxHp: 1, mp: 1, maxMp: 1,\r\n189:     element: 'fire',\r\n190:     personalityId: 'brave',\r\n191:     skills: ['homura_giri', 'kien'],\r\n192:     equipment: {},\r\n193:     godParentId: 'kagaribi',\r\n194:     isHead: true,\r\n195:     alive: true,\r\n196:     kills: 0,\r\n197:     expeditions: 0,\r\n198:     deeds: ['大燈籠の前で当主を継いだ'],\r\n199:     fatigue: 0,\r\n200:   }\r\n","exit_code":0,"status":"completed"}}
