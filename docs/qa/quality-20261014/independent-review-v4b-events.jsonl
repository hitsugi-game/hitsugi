 {\ntests/narrative_m34.test.ts:28:  it('ch4の最終beatだけが実名を含む', () => {\ntests/narrative_m34.test.ts:30:    const hits = ch4.lines.map((line, index) => ({ index, text: line.text })).filter((line) => line.text.includes('汐里'))\ntests/narrative_m34.test.ts:31:    expect(hits).toEqual([{ index: ch4.lines.length - 1, text: '擦れていた墨が、夜露のように滲む。——汐里。これが、初代の名だ。' }])\ntests/narrative_m34.test.ts:34:  it('gsp12以降は開示前に止まり、開示後は指定の余韻から続く', () => {\ntests/narrative_m34.test.ts:43:  it('夢2〜8の本文はch4前でも実名を先に言わない', () => {\ntests/narrative_m34.test.ts:44:    expect(DREAM_EPISODES.flatMap((ep) => ep.beats).some((beat) => beat.includes('汐里'))).toBe(false)\ntests/narrative_m34.test.ts:47:  it('legacy migrationはendingType=0も実名既知として扱う', () => {\ntests/narrative_m34.test.ts:53:describe('M34 scene queueの安定規則', () => {\ntests/narrative_m34.test.ts:62:  it('death > rite > chapter > dream > dailyの優先度を固定する', () => {\ntests/narrative_m34.test.ts:68:  it('安定IDで重複scene payloadを除く', () => {\ntests/narrative_m34.test.ts:72:  it('同月の強制表示は最高優先1件だけで残りを灯の余白へ送る', () => {\ntests/narrative_m34.test.ts:81:describe('M34 家族史と三結末', () => {\ntests/narrative_m34.test.ts:82:  it('内部ID順を維持しつつcutだけ表示を送るへ合わせる', () => {\ntests/narrative_m34.test.ts:89:  it('極端なresonanceでも表示文に留まり選択肢自体を変えない', () => {\ntests/narrative_m34.test.ts:92:    expect(resonanceLine(d)).toContain('幕を引いて')\ntests/narrative_m34.test.ts:96:  it('resonance同率は特定結末を勧めず中立文にする', () => {\ntests/narrative_m34.test.ts:102:  it('死者や形見が無くても実saveの名を最低1件返す', () => {\ntests/narrative_m34.test.ts:108:  it('地域の問いは進捗に応じて短く変わる', () => {\ntests/narrative_m34.test.ts:114:  it('帰還三痕は人・土地・千年を各1件、最大3件返す', () => {\ntests/narrative_m34.test.ts:124:  it('形見を再継承しても最初の持ち主は変わらない', () => {\ntests/narrative_m34.test.ts:132:  it('三結末の個人化beatが同じ家族史から異なる帰結を返す', () => {\ntests/narrative_m34.test.ts:139:  it('gossip正典18件を維持する', () => {\ntests/narrative_m34.test.ts:144:describe('M34 N4 匿名体験計測', () => {\ntests/narrative_m34.test.ts:145:  it('旧saveは外部送信を要しない0初期値へ移行する', () => {\ntests/narra