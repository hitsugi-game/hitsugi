wnGods.map((g, index) => {\n247:              const sealed = !godUnlocked(g, data)\n248:              const affinity = Math.floor(data.godAffinity[g.id] ?? 0)\r\n249:              const eff = pactCost(g, data.godAffinity[g.id] ?? 0) // 縁の割引(M12-2)\r\n250:              const availability = pactAvailability(!sealed, data.hoto, eff)\n251:              const canInspect = Boolean(parent && availability.inspectable)\n252:              const recommended = !sealed && recommendStat != null && topBias(g.statBias)[0]?.[0] === recommendStat\n253:              return (\n254:                <button\n255:                  key={g.id}\n256:                  data-god-index={index}\n257:                  className={`god-row ${godId === g.id ? 'selected' : ''} ${sealed ? 'locked' : ''} ${!availability.contractable && availability.inspectable ? 'unaffordable' : ''} ${recommended ? 'recommended' : ''}`}\n258:                  aria-pressed={godId === g.id}\n259:                  aria-disabled={!canInspect}\n260:                  tabIndex={canInspect && index === Math.min(activeGodIndex, shownGods.length - 1) ? 0 : -1}\n261:                  title={!parent ? '先に契る親を選ぶ' : availability.reason ?? ''}\n262:                  onClick={() => { if (canInspect) { setGodId(g.id); setActiveGodIndex(index) } }}\n263:                  onKeyDown={(event) => {\n264:                    if (!canInspect || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return\n265:                    event.preventDefault()\n266:                    const next = event.key === 'Home' ? 0\n267:                      : event.key === 'End' ? shownGods.length - 1\n268:                        : (index + (event.key === 'ArrowDown' ? 1 : -1) + shownGods.length) % shownGods.length\n269:                    setActiveGodIndex(next)\n270:                    event.currentTarget.parentElement?.querySelector<HTMLButtonElement>(`[data-god-index=\"${next}\"]`)?.focus()\n271:                  }}\n272:                >\n273:                  <span className={`element-badge el-${g.element} god-row-el`}>{ELEMENT_LABELS[g.element]}</span>\r\n274:                  <span className=\"god-row-name\">\r\n275:                    {sealed ? '???' : g.name}\r\n276:                    {recommended && <span className=\"god-row-rec\" title=\"血潮の勧め\" aria-label=\"血潮の勧め\">★</span>}\r\n277:                    {sealed && <span className=\"god-row-hint\">{sealHint(g)}</span>}\r\n278:                  </span>\r\n279:                  {!sealed && (\r\n280:                    <span className=\"god-row-bias\">\r\n281:                      {topBias(g.statBias).map(([k]) => (\r\n282:                        <span key={k} className=\"bias-chip\">{STAT_LABELS[k]}</span>\r\n283:                      ))}\r\n284:                    </span>\r\n285:                  )}\r\n286:                  {affinity > 0 && !sealed && <span className=\"god-row-affinity\">縁{affinity}</span>}\r\n287:                  <span className=\"god-row-cost\">\n288:                    {sealed ? '—' : eff}\n289:                    {!sealed && eff < g.cost && <span className=\"god-row-base\">{g.cost}</span>}\n290:                    {!availability.contractable && availability.inspectable && <span className=\"god-row-short\">不足</span>}\n291:                  </span>\n292:                  {!showAllGods && (\n293:                    <span className=\"god-row-why\" data-testid=\"pact-recommendation-reason\">\n294:                      {recommended ? '親の強みを伸ばす' : eff <= data.hoto ? '今の奉燈で契れる' : '次に目指す星'}\n295:                    </span>\n296:                  )}\n297:                </button>\n298:              )\r\n299:            })}\r\n300:          </div>\r\n301:\r\n302:          {/* 右: 大立ち絵+情報札 */}\r\n303:          <div className=\"god-stage\">\r\n304:            {god ? (\r\n305:              <GodPortraitPane godId={god.id} sealedHint={null} affinity={Math.floor(data.godAffinity[god.id] ?? 0)} />\r\n306:            ) : (\r\n307:              <div className=\"god-stage-empty\">\r\n308:                <span className=\"god-stage-star\">✦</span>\r\n309:                <p>星名を選ぶと、その姿が顕れる</p>\r\n310:              </div>\r\n311:            )}\r\n312:          </div>\r\n313:        </div>\r\n314:      </Panel>\r\n315:\r\n316:      {parent && god && prediction && (\r\n317:        <Panel title={`遺伝子の見立て — ${parent.name} × ${god.name}`}>\r\n318:          <div className=\"gene-grid\">\r\n319:            <div className=\"gene-col\">\r\n320:              <div className=\"gene-col-title\">親の血潮(人系)</div>\r\n321:              {(Object.keys(STAT_LABELS) as StatKey[]).map((k) => (\r\n322:                <GeneBar key={k} label={STAT_LABELS[k]} value={parent.potential[k]} tone=\"human\" />\r\n323:              ))}\r\n324:            </div>\r\n325:            <div className=\"gene-col\">\r\n326:              <div className=\"gene-col-title\">神の血潮(星系)</div>\r\n327:              {(Object.keys(STAT_LABELS) as StatKey[]).map((k) => (\r\n328:                <GeneBar key={k} label={STAT_LABELS[k]} value={godStatValue(god, k)} tone=\"god\" />\r\n329:              ))}\r\n330:            </div>\r\n331:            <div className=\"gene-col gene-col-wide\">\r\n332:              <div className=\"gene-col-title\">子の見立て(範囲)</div>\r\n333:              {(Object.keys(STAT_LABELS) as StatKey[]).map((k) => {\r\n334:                const [lo, hi] = prediction[k]\r\n335:                return (\r\n336:                  <div key={k} className=\"predict-row\">\r\n337:                    <span className=\"predict-label\">{STAT_LABELS[k]}</span>\r\n338:                    <span className=\"predict-track\">\r\n339:                      <span\r\n340:                        className=\"predict-range\"\r\n341:                        style={{ left: `${(lo / 120) * 100}%`, width: `${((hi - lo) / 120) * 100}%` }}\r\n342:                      />\r\n343:                    </span>\r\n344:                    <span className=\"predict-num\">{lo}〜{hi}</span>\r\n345:                  </div>\r\n346:                )\r\n347:              })}\r\n348:              <p className=\"gene-note\">\r\n349:                期待値: 親の脈×0.48+星の脈×0.55(上限120)。星脈は{ELEMENT_LABELS[god.element]}(七割)/\r\n350:                {ELEMENT_LABELS[parent.element]}(三割)で子の灯座の軸となる。\r\n351:              </p>\r\n352:              <p className=\"gene-predict-summary\">{predictionSummary(prediction)}</p>\r\n353:            </div>\r\n354:          </div>\r\n355:          {Math.floor(data.godAffinity[god.id] ?? 0) >= GOD_MAX_AFFINITY && (\r\n356:            <StatusCallout kind=\"boon\" title=\"縁が極まった\">\r\n357:              この星とはもはや相思相愛。契りは彩りを増すだろう。\r\n358:            </StatusCallout>\r\n359:          )}\r\n360:          <div className=\"pact-quote\">\r\n361:            「{god.pactLines[Math.min(Math.floor(data.godAffinity[god.id] ?? 0), god.pactLines.length - 1)]}」\r\n362:          </div>\r\n363:        </Panel>\r\n364:      )}\r\n365:\r\n366:      <button className=\"btn btn-ghost\" onClick={() => setScreen({ id: 'home' })}>\r\n367:        郷へ戻る\r\n368:      </button>\r\n369:\r\n370:      <ActionDock note={dockNote}>\r\n371:        <button className=\"btn btn-main\" onClick={openPactConfirm} disabled={!dockReady}>\r\n372:          {dockLabel}\r\n373:        </button>\r\n374:      </ActionDock>\r\n375:\r\n376:      {confirmOpen && parent && god && prediction && (\r\n377:        <PactConfirmSheet\r\n378:          parent={parent}\r\n379:          god={god}\r\n380:          data={data}\r\n381:          prediction={prediction}\r\n382:          cost={dockCost}\r\n383:          onClose={() => setConfirmOpen(false)}\r\n384:          onConfirm={confirmPact}\r\n385:        />\r\n386:      )}\r\n387:\r\n388:      {ritual && god && (\r\n389:        <div className=\"ritual-overlay\">\r\n390:          <div className=\"ritual-ring\" />\r\n391:          <div className=\"ritual-ring ritual-ring2\" />\r\n392:          <MaybeImg\r\n393:            src={godPresentationImg(god.portrait, (data.godAffinity[god.id] ?? 0) >= GOD_MAX_AFFINITY)}\n394:            className=\"ritual-cutin\"\r\n395:          />\r\n396:          <p className=\"ritual-text\">{god.name}との契り、結ばれる——</p>\r\n397:        </div>\r\n398:      )}\r\n399:    </div>\r\n400:  )\r\n401:}\r\n402:\r\n403:// M26 §9.5: 星契り最終確認 — 契るCTAはここでのみdoPactを呼ぶ(誤操作是正 M26-P0-01)。\r\n404:// 親の顔・名前・残り灯/神の立ち絵・名前・縁/奉燈の現在→残り/子が生まれる月/見立ての強み弱みを一望させ、\r\n405:// 「この月の行いとして確定し、月が進む」ことを最後に一文で示す。\r\n406:function PactConfirmSheet({\r\n407:  parent, god, data, prediction, cost, onClose, onConfirm,\r\n408:}: {\r\n409:  parent: Character\r\n410:  god: God\r\n411:  data: GameData\r\n412:  prediction: Record<StatKey, [number, number]>\r\n413:  cost: number\r\n414:  onClose: () => void\r\n415:  onConfirm: () => void\r\n416:}) {\r\n417:  const affinity = Math.floor(data.godAffinity[god.id] ?? 0)\r\n418:  const isMax = affinity >= GOD_MAX_AFFINITY\r\n419:  return (\r\n420:    <Sheet title=\"星契り、最後の確かめ\" onClose={onClose} closeLabel=\"やめる\">\r\n421:      <div className=\"pact-confirm-pair\">\r\n422:        <CharCard char={parent} seasonIndex={data.seasonIndex} compact />\r\n423:        <div className=\"pact-confirm-god\">\r\n424:          <MaybeImg\r\n425:            src={godPresentationImg(god.portrait, isMax)}\n426:            className=\"pact-confirm-god-img\"\r\n427:          />\r\n428:          <span className=\"pact-confirm-god-name\">{god.name}</span>\r\n429:          <span className=\"pact-confirm-god-aff\">縁 {affinity}</span>\r\n430:        </div>\r\n431:      </div>\r\n432:      <CompareRow label=\"奉燈\" before={data.hoto} after={data.hoto - cost} />\r\n433:      <p className=\"confirm-lead\">\r\n434:        子は{seasonLabel(data.seasonIndex + 1)}に生まれる。{predictionSummary(prediction)}\r\n435:      </p>\r\n436:      <p className=\"confirm-lead\">この月の行いとして確定し、月が進む。</p>\r\n437:      <div className=\"confirm-actions\">\r\n438:        <button className=\"btn btn-ghost\" onClick={onClose}>やめる</button>\r\n439:        <button className=\"btn btn-main\" data-testid=\"pact-confirm\" onClick={onConfirm}>契る</button>\r\n440:      </div>\r\n441:    </Sheet>\r\n442:  )\r\n443:}\r\n444:\r\n445:// 神の血潮の得意分野・上位2ステータス(神選びの比較材料)\r\n446:function topBias(statBias: Partial<Record<StatKey, number>>): [StatKey, number][] {\r\n447:  return (Object.entries(statBias) as [StatKey, number][])\r\n448:    .filter(([, v]) => v > 0)\r\n449:    .sort((a, b) => b[1] - a[1])\r\n450:    .slice(0, 2)\r\n451:}\r\n452:\r\n453:// M33: 当主の最も高い素質キー。交神の推奨★判定に使う — 成人の儀(灯型)/生業の儀(家業)と同じ\r\n454:// 「血潮の強みを伸ばす」思想で、神の得意(topBias先頭)が当主の最強素質と一致する神を勧める。\r\n455:function strongestPotential(potential: Partial<Record<StatKey, number>>): StatKey | null {\r\n456:  const entries = (Object.entries(potential) as [StatKey, number][]).filter(([, v]) => typeof v === 'number')\r\n457:  if (entries.length === 0) return null\r\n458:  return entries.sort((a, b) => b[1] - a[1])[0][0]\r\n459:}\r\n460:\r\n461:// 大立ち絵パネル — 縁MAXは同一性確認済みの第二立ち絵だけを採用する。\n462:// 未確認MAX候補は通常像＋runtimeの縁極frameへ退避し、別人化や疑似文字を表へ出さない。\n463:const GOD_MAX_AFFINITY = 5\n464:\r\n465:function GodPortraitPane({ godId, affinity }: { godId: string; sealedHint: string | null; affinity: number }) {\r\n466:  const g = GODS.find((x) => x.id === godId)!\r\n467:  const maxRite = affinity >= GOD_MAX_AFFINITY\n468:  // 退避連鎖: reviewed MAXまたは通常立ち絵 → (全滅)属性オーラ。\n469:  const candidates = [godPresentationImg(g.portrait, maxRite)]\n470:  const [idx, setIdx] = useState(0)\n471:  const artKey = `${godId}:${maxRite ? 'max' : 'normal'}`\n472:  const [lastArtKey, setLastArtKey] = useState(artKey)\n473:  if (artKey !== lastArtKey) {\n474:    setLastArtKey(artKey)\n475:    setIdx(0)\n476:  }\n477:  const src = idx < candidates.length ? candidates[idx] : null\n478:  return (\n479:    <div className=\"god-pane\" data-art-state={maxRite ? 'max-rite' : 'normal'}>\n480:      <div className={`god-pane-art el-bg-${g.element} ${maxRite ? 'max-rite' : ''}`}>\n481:        {src ? (\n482:          <img\n483:            className={`god-pane-img ${maxRite ? 'god-max' : ''}`}\n484:            src={src}\r\n485:            alt=\"\"\r\n486:            onError={() => setIdx((i) => i + 1)}\r\n487:          />\r\n488:        ) : (\r\n489:          // M22 §3: 共通✦を出さない — 属性別御影+神名焼き込み+「絵姿準備中」\r\n490:          <GodArtFallback g={g} />\r\n491:        )}\r\n492:      </div>\n493:      <div className=\"god-pane-info\">\n494:        <div className=\"god-pane-eyebrow\">{maxRite ? '縁極の御影' : '契りの御影'}</div>\n495:        <div className=\"god-pane-rank\">{GOD_RANK_LABELS[g.rank]} / {ELEMENT_LABELS[g.element]}の星</div>\n496:        <div className=\"god-pane-name\">{g.name}</div>\r\n497:        <div className=\"god-pane-kana\">{g.kana}</div>\r\n498:        <div className=\"god-pane-cost\">\r\n499:          奉納 <b>{g.cost}</b>\r\n500:          {affinity > 0 && <span className=\"god-pane-aff\"> ・縁 {affinity}</span>}\r\n501:        </div>\r\n502:        <div className=\"god-pane-person\">{g.personality}</div>\r\n503:        <p className=\"god-pane-desc\">{g.desc}</p>\r\n504:      </div>\r\n505:    </div>\r\n506:  )\r\n507:}\r\n508:\r\n509:function GeneBar({ label, value, tone }: { label: string; value: number; tone: 'human' | 'god' }) {\r\n510:  return (\r\n511:    <div className=\"gene-bar-row\">\r\n512:      <span className=\"gene-bar-label\">{label}</span>\r\n513:      <span className=\"gene-bar-track\">\r\n514:        <span className={`gene-bar-fill gene-${tone}`} style={{ width: `${Math.min(100, (value / 120) * 100)}%` }} />\r\n515:      </span>\r\n516:      <span className=\"gene-bar-num\">{value}</span>\r\n517:    </div>\r\n518:  )\r\n519:}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'rg -n \"''^|$\" '\"'src/ui/Title.tsx'\"","aggregated_output":"1:import { useEffect, useRef, useState } from 'react'\n2:import { APP_BUILD_LABEL } from '../core/version'\n3:import { emitToast } from './toast'\n4:import './vc2_entry.css'\n5:\n6:type SaveStatus = 'checking' | 'ready' | 'recoverable' | 'damaged' | 'unavailable' | 'none'\n7:\n8:function IntroSceneBg({ file }: { file: string }) {\n9:  const [ok, setOk] = useState(true)\n10:  if (!ok) return null\n11:  return (\n12:    <img\n13:      className=\"scene-bg\"\n14:      src={`${import.meta.env.BASE_URL}img/${file.replace(/\\.png$/, '.jpg')}`}\n15:      alt=\"\"\n16:      aria-hidden\n17:      onError={() => setOk(false)}\n18:    />\n19:  )\n20:}\n21:\n22:export function TitleScreen({ onRuntimeReady }: { onRuntimeReady?: () => void } = {}) {\n23:  const [mode, setMode] = useState<'normal' | 'narrative' | 'data' | null>(null)\n24:  const [confirmNew, setConfirmNew] = useState(false)\n25:  const [saveStatus, setSaveStatus] = useState<SaveStatus>('checking')\n26:  const fileRef = useRef<HTMLInputElement>(null)\n27:  const saveExists = saveStatus === 'ready' || saveStatus === 'recoverable' || saveStatus === 'damaged'\n28:  const canContinue = saveStatus === 'ready' || saveStatus === 'recoverable'\n29:  const canExport = canContinue\n30:\n31:  const refreshSaveStatus = () => {\n32:    void import('../core/save')\n33:      .then(({ inspectSaveSlot }) => setSaveStatus(inspectSaveSlot()))\n34:      .catch(() => setSaveStatus('unavailable'))\n35:  }\n36:  useEffect(refreshSaveStatus, [])\n37:\n38:  // 「はじめから」— 既存セーブがあれば上書き確認を挟む\n39:  const onNewGame = () => {\n40:    if (saveStatus === 'checking') return\n41:    if (saveExists) setConfirmNew(true)\n42:    else setMode('normal')\n43:  }\n44:  const onImportFile = (file: File) => {\n45:    const reader = new FileReader()\n46:    reader.onload = () => {\n47:      void import('../core/save').then(({ importSaveStringResult }) => {\n48:        const result = importSaveStringResult(String(reader.result))\n49:        const failure = result.ok ? '' : result.previousSavePreserved\n50:          ? '読み込めなかった。既存の記は保持した。ファイルまたは端末の保存設定を確認してください。'\n51:          : '読み込みの検証に失敗した。再読込せず、復旧頁から控えを書き出してください。'\n52:        emitToast(result.ok ? 'セーブを読み込んだ。「つづきから」で再開できる。' : failure, result.ok ? 'info' : 'error')\n53:        refreshSaveStatus()\n54:      }).catch(() => emitToast('セーブ検証部を読み込めなかった。再読込してください。', 'error'))\n55:    }\n56:    reader.readAsText(file)\n57:  }\n58:  const startGame = (narrative: boolean) => {\n59:    void import('../core/store').then(({ useGame }) => {\n60:      useGame.getState().newGame(narrative)\n61:      onRuntimeReady?.()\n62:    }).catch(() => emitToast('ゲーム本体を読み込めなかった。回線を確認して再読込してください。', 'error'))\n63:  }\n64:  const continueGame = () => {\n65:    void import('../core/store').then(({ useGame }) => {\n66:      useGame.getState().continueGame()\n67:      onRuntimeReady?.()\n68:    }).catch(() => emitToast('一族の記を開けなかった。回線を確認して再読込してください。', 'error'))\n69:  }\n70:\n71:  return (\n72:    <div className=\"screen title-screen\">\n73:      <img\n74:        className=\"title-art-img\"\n75:        src={`${import.meta.env.BASE_URL}img/title_key.jpg`}\n76:        alt=\"\"\n77:        aria-hidden\n78:      />\n79:      <div className=\"embers\" aria-hidden>\n80:        {Array.from({ length: 14 }, (_, i) => (\n81:          <span key={i} className=\"ember\" style={{ left: `${(i * 7.3) % 100}%`, animationDelay: `${i * 0.9}s` }} />\n82:        ))}\n83:      </div>\n84:      <div className=\"title-main\">\n85:        <p className=\"title-kicker\">常夜千年・一族継承譚</p>\n86:        <h1 className=\"game-title\">\n87:          <span className=\"title-hi\">灯</span>\n88:          <span className=\"title-tsugi\">継ぎ</span>\n89:        </h1>\n90:        <p className=\"title-sub\">- HITSUGI -</p>\n91:        <p className=\"title-copy\">八季の命を、継いでゆけ。</p>\n92:      </div>\n93:\n94:      {confirmNew ? (\n95:        <div className=\"title-menu\">\n96:          <p className=\"mode-ask\">既に一族の記がある。新たに始めれば、それは失われる。よいか?</p>\n97:          <button className=\"btn btn-main\" onClick={() => { setConfirmNew(false); setMode('normal') }}>\n98:            承知の上で、始める\n99:          </button>\n100:          <button className=\"btn btn-ghost\" onClick={() => setConfirmNew(false)}>\n101:            やめておく\n102:          </button>\n103:        </div>\n104:      ) : mode === 'data' ? (\n105:        <div className=\"title-menu\">\n106:          <p className=\"mode-ask\">セーブの管理</p>\n107:          <p className=\"title-save-state\" data-state={saveStatus}>\n108:            {saveStatus === 'ready' && <>端末の記 <strong>読取可能</strong></>}\n109:            {saveStatus === 'recoverable' && <>端末の記 <strong>控えから復旧可能</strong></>}\n110:            {saveStatus === 'damaged' && <>端末の記 <strong>破損を検出</strong><span>ファイルから正常な控えを読み込むか、この記を消してください。</span></>}\n111:            {saveStatus === 'unavailable' && <>端末の記 <strong>保存できない</strong><span>ブラウザの保存許可を確認してください。許可がなくても、この場では遊べます。</span></>}\n112:            {saveStatus === 'none' && <>端末の記 <strong>まだない</strong></>}\n113:            {saveStatus === 'checking' && <>端末の記 <strong>確認中</strong></>}\n114:          </p>\n115:          <button className=\"btn\" disabled={!canExport} onClick={() => {\n116:            void import('../core/save').then(({ downloadSave }) => {\n117:              if (!downloadSave()) emitToast('書き出せる正常なセーブが無い。', 'error')\n118:            })\n119:          }}>\n120:            セーブを書き出す(バックアップ)\n121:          </button>\n122:          <button className=\"btn\" onClick={() => fileRef.current?.click()}>\n123:            セーブを読み込む(ファイルから)\n124:          </button>\n125:          <button className=\"btn btn-ghost\" disabled={!saveExists} onClick={() => {\n126:            if (!confirm('この端末のセーブを完全に消す。取り消せない。よいか?')) return\n127:            void import('../core/save').then(({ clearSave }) => {\n128:              clearSave()\n129:              refreshSaveStatus()\n130:              emitToast('セーブを消した。', 'info')\n131:              setMode(null)\n132:            })\n133:          }}>\n134:            セーブを消す\n135:          </button>\n136:          <button className=\"btn btn-ghost\" onClick={() => setMode(null)}>\n137:            戻る\n138:          </button>\n139:          <input ref={fileRef} type=\"file\" accept=\"application/json,.json\" style={{ display: 'none' }}\n140:            onChange={(e) => { const f = e.target.files?.[0]; if (f) onImportFile(f); e.target.value = '' }} />\n141:        </div>\n142:      ) : mode === null ? (\n143:        <div className=\"title-menu\">\n144:          <p className=\"title-save-state\" data-state={saveStatus} aria-live=\"polite\">\n145:            {saveStatus === 'ready' && <>端末の記 <strong>続きあり</strong></>}\n146:            {saveStatus === 'recoverable' && <>端末の記 <strong>控えから復せる</strong></>}\n147:            {saveStatus === 'damaged' && <>端末の記 <strong>読めない</strong><span>「セーブの管理」で復旧してください。</span></>}\n148:            {saveStatus === 'unavailable' && <>端末の記 <strong>保存できない</strong><span>この場では遊べますが、再読込すると進行は残りません。</span></>}\n149:            {saveStatus === 'none' && <>端末の記 <strong>まだない</strong></>}\n150:            {saveStatus === 'checking' && <>端末の記 <strong>確認中</strong></>}\n151:          </p>\n152:          <button className=\"btn btn-main\" disabled={saveStatus === 'checking'} onClick={onNewGame}>\n153:            はじめから\n154:          </button>\n155:          {canContinue && (\n156:            <button className=\"btn\" onClick={() => continueGame()}>\n157:              {saveStatus === 'recoverable' ? '控えからつづける' : 'つづきから'}\n158:            </button>\n159:          )}\n160:          <button className=\"btn btn-ghost\" onClick={() => setMode('data')}>\n161:            セーブの管理\n162:          </button>\n163:        </div>\n164:      ) : (\n165:        <div className=\"title-menu\">\n166:          <p className=\"mode-ask\">語り部の問い — いかに歩む?</p>\n167:          <button className=\"btn btn-main\" onClick={() => startGame(false)}>\n168:            宿命(標準) — 夜は深く、灯は重い\n169:          </button>\n170:          <button className=\"btn\" onClick={() => startGame(true)}>\n171:            語り部(易しめ) — 物語を味わう歩み\n172:          </button>\n173:          <button className=\"btn btn-ghost\" onClick={() => setMode(null)}>\n174:            戻る\n175:          </button>\n176:        </div>\n177:      )}\n178:      <p className=\"title-ver\">ver {APP_BUILD_LABEL} — 燈ノ郷にて</p>\n179:    </div>\n180:  )\n181:}\n182:\n183:const INTRO_BEATS = [\n184:  '千年前、この郷から太陽が消えた。',\n185:  '星喰いの神・玄冬(げんとう)が、空を喰らったのだ。',\n186:  '旅の楽士は、己の寿命を薪として大燈籠に火を点し、郷を常夜から守った。',\n187:  'だが火は完全ではなかった。その楽士の血族には、二つの呪いが残った。',\n188:  '一つ。生まれて八つの季節で、体の内の灯が燃え尽きること — 「八季の命」。',\n189:  '一つ。人と子を成せぬこと — 「結ばれぬ身」。',\n190:  'ゆえに一族は、夜空の星神と契りて子を授かり、代を継いで戦い続けてきた。',\n191:  '目指すは夜藪の最深部、灯ノ御山の頂。玄冬の御座。',\n192:  '……さて。千年目の当主よ。あんたの名は燈吾。残る命は、五季。',\n193:  '筆は持った。あんたら一族の生き様、この綴(つづり)が一字も漏らさず書き残す。',\n194:  '— ゆけ。灯を、継いでゆけ。',\n195:]\n196:\n197:export function IntroScreen({ onFinish }: { onFinish: () => void }) {\n198:  const [beat, setBeat] = useState(0)\n199:  const currentRef = useRef<HTMLParagraphElement>(null)\n200:  const done = beat >= INTRO_BEATS.length\n201:\n202:  useEffect(() => {\n203:    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches\n204:    currentRef.current?.scrollIntoView({ block: 'center', behavior: reducedMotion ? 'auto' : 'smooth' })\n205:  }, [beat])\n206:\n207:  const advance = () => {\n208:    if (done) return\n209:    if (beat === INTRO_BEATS.length - 1) {\n210:      onFinish()\n211:    } else {\n212:      setBeat(beat + 1)\n213:    }\n214:  }\n215:\n216:  return (\n217:    <div className=\"screen intro-screen\" onClick={advance} data-beat={beat + 1}>\n218:      <IntroSceneBg file=\"cg_prologue.png\" />\n219:      <div className=\"intro-spine\" aria-hidden><span>千年目の綴り</span></div>\n220:      <div className=\"intro-text\">\n221:        {INTRO_BEATS.slice(0, beat + 1).map((t, i) => (\n222:          <p key={i} ref={i === beat ? currentRef : undefined} className={i === beat ? 'intro-current' : 'intro-past'}>\n223:            {t}\n224:          </p>\n225:        ))}\n226:      </div>\n227:      <div className=\"scene-pager\" onClick={(e) => e.stopPropagation()}>\n228:        <span className=\"scene-page-mark\">頁 {beat + 1}／{INTRO_BEATS.length}</span>\n229:        <button className=\"btn scene-next\" onClick={advance}>{beat === INTRO_BEATS.length - 1 ? '郷へ進む' : '次の頁へ'}</button>\n230:      </div>\n231:      <button\n232:        className=\"btn btn-ghost intro-skip\"\n233:        onClick={(e) => {\n234:          e.stopPropagation()\n235:          onFinish()\n236:        }}\n237:      >\n238:        物語を飛ばす\n239:      </button>\n240:    </div>\n241:  )\n242:}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'rg -n \"''^|$\" '\"'src/ui/Chronicle.tsx'\"","aggregated_output":"1:// M18 P5: 家譜 — 独立作業画面(UI_UX_REDESIGN_PLAN §5.10)\n2:// 概要/称号/故人/年代記の4タブ。表示ロジック(computeRecords/ACHIEVEMENTS)は移動のみ・計算変更なし。\n3:// 契約: docs/UI_SHELL_API.md。store/core の変更はしない(表示専用の定数・絞り込みのみ追加)。\n4:import { useState } from 'react'\n5:import { useGame } from '../core/store'\n6:import { seasonLabel } from '../core/types'\n7:import type { ChronicleEntry, GameData } from '../core/types'\n8:import { godById, GODS } from '../core/data/gods'\n9:import { ENEMIES } from '../core/data/enemies'\n10:import { REGIONS } from '../core/data/regions'\n11:import { REGION_LORE } from '../core/data/lore'\n12:import { ITEM_SERIES_MANIFEST } from '../core/data/items'\n13:import { collectionDiscoveredCount, popcount15 } from '../core/collection'\n14:import { recordedPactGodIds } from '../core/pact_records'\n15:import { downloadChronicleCard, copyShareText } from './shareCard'\n16:import { MaybeImg, Panel } from './components'\n17:import { faceImg } from './img'\n18:import { FamilyTree } from './FamilyTree'\n19:import { ScreenShell, WorkspaceTabs, ActionDock, LifeThread } from './layout/shell'\n20:import './chronicle_m18.css'\n21:\n22:// 一族の記録 — 既存のdataから純粋関数で集計(新規storeフィールド不要)\n23:function computeRecords(data: GameData) {\n24:  const fam = data.family\n25:  const gens = fam.length > 0 ? Math.max(...fam.map((c) => c.gen)) : 0\n26:  const alive = fam.filter((c) => c.alive).length\n27:  const fallenN = fam.length - alive\n28:  const kills = fam.reduce((s, c) => s + (c.kills ?? 0), 0)\n29:  const exped = fam.reduce((s, c) => s + (c.expeditions ?? 0), 0)\n30:  const years = Math.floor(data.seasonIndex / 12) + 1\n31:  const towerBest = typeof data.flags?.towerBest === 'number' ? data.flags.towerBest : 0\n32:  // 収集(Codexと同じ基準)\n33:  const seenEnemies = new Set((data.codex?.enemies ?? []).map((id) => id.replace(/_[wo]$/, '')))\n34:  const knownGods = new Set([...(data.codex?.gods ?? []), ...Object.entries(data.godAffinity).filter(([, v]) => v > 0).map(([k]) => k)])\n35:  const cleared = new Set(data.regionsCleared)\n36:  const frags = data.loreFrags ?? {}\n37:  const baseEnemies = ENEMIES.filter((e) => !/_[wo]$/.test(e.id))\n38:  const loreRegions = REGIONS.filter((r) => REGION_LORE[r.id])\n39:  const enemySeen = baseEnemies.filter((e) => seenEnemies.has(e.id)).length\n40:  const godSeen = GODS.filter((g) => knownGods.has(g.id)).length\n41:  const loreDone = loreRegions.filter((r) => cleared.has(r.id) && (frags[r.id] ?? 0) >= 3).length\n42:  const collTotal = baseEnemies.length + GODS.length + loreRegions.length\n43:  const collDone = enemySeen + godSeen + loreDone\n44:  // 四捨五入で未収集の項目が残るのに100%・全収集称号を出さない。\n45:  const collPct = collTotal > 0 ? Math.floor((collDone / collTotal) * 100) : 0\n46:  const itemSeen = collectionDiscoveredCount(data.collectionV2)\n47:  const itemSeriesStarted = ITEM_SERIES_MANIFEST.filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) > 0).length\n48:  const itemSeriesComplete = ITEM_SERIES_MANIFEST.filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) === 15).length\n49:  const itemAlmost = ITEM_SERIES_MANIFEST\n50:    .filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) === 14)\n51:    .slice(0, 3)\n52:    .map((series) => series.name)\n53:  return {\n54:    gens, alive, fallenN, kills, exped, years, towerBest, fame: data.fame,\n55:    godsPacted: recordedPactGodIds(data).size, familiars: data.familiars?.length ?? 0,\n56:    regionsCleared: data.regionsCleared.length, regionsTotal: REGIONS.length,\n57:    enemySeen, enemyTotal: baseEnemies.length, godSeen, godTotal: GODS.length,\n58:    loreDone, loreTotal: loreRegions.length, collPct,\n59:    itemSeen, itemTotal: 810, itemSeriesStarted, itemSeriesComplete, itemAlmost,\n60:  }\n61:}\n62:\n63:// 称号 — 記録から純粋に導出(読み取り専用・コアループ非改変)。達成/未達を一覧表示。\n64:type RecordSummary = ReturnType<typeof computeRecords>\n65:const ACHIEVEMENTS: { name: string; hint: string; test: (r: RecordSummary) => boolean }[] = [\n66:  { name: '初めての看取り', hint: '一族の誰かを看取る', test: (r) => r.fallenN >= 1 },\n67:  { name: '五代の家', hint: '五代まで血を継ぐ', test: (r) => r.gens >= 5 },\n68:  { name: '十代の家', hint: '十代まで血を継ぐ', test: (r) => r.gens >= 10 },\n69:  { name: '長寿の一族', hint: '二十年を生き延びる', test: (r) => r.years >= 20 },\n70:  { name: '大家族', hint: '一族の総数が三十に至る', test: (r) => r.alive + r.fallenN >= 30 },\n71:  { name: '百の魔性を討つ', hint: '討伐数100', test: (r) => r.kills >= 100 },\n72:  // M19 B3: 図鑑コンプの節目称号 — 収集率に到達の褒美を与える\n73:  { name: '見聞の徒', hint: '魔性図鑑を半分(50%)まで埋める', test: (r) => r.enemyTotal > 0 && r.enemySeen / r.enemyTotal >= 0.5 },\n74:  { name: '夜藪の博士', hint: '魔性図鑑を全て(100%)埋める', test: (r) => r.enemyTotal > 0 && r.enemySeen >= r.enemyTotal },\n75:  { name: '星に親しむ家', hint: '星神の半分(50%)と契る', test: (r) => r.godTotal > 0 && r.godsPacted / r.godTotal >= 0.5 },\n76:  { name: '星霊の盟家', hint: '全ての星神(100%)と契る', test: (r) => r.godTotal > 0 && r.godsPacted >= r.godTotal },\n77:  { name: '千年の識者', hint: '総合収集率100%に至る', test: (r) => r.collPct >= 100 },\n78:  { name: '千の魔性を討つ', hint: '討伐数1000', test: (r) => r.kills >= 1000 },\n79:  { name: '千年の武', hint: '武功500', test: (r) => r.fame >= 500 },\n80:  { name: '眷属を率いる者', hint: '眷属を六体懐かせる', test: (r) => r.familiars >= 6 },\n81:  { name: '常夜百層・踏破', hint: '常夜百層を制す', test: (r) => r.towerBest >= 100 },\n82:  { name: '常夜を鎮む', hint: '全ての地の主を鎮める', test: (r) => r.regionsCleared >= r.regionsTotal && r.regionsTotal > 0 },\n83:  { name: '魔性図鑑・完', hint: '全ての魔性を見る', test: (r) => r.enemySeen >= r.enemyTotal && r.enemyTotal > 0 },\n84:  { name: '星神図鑑・完', hint: '全ての星神を識る', test: (r) => r.godSeen >= r.godTotal && r.godTotal > 0 },\n85:  { name: '土地の記・完', hint: '全ての土地の記を綴る', test: (r) => r.loreDone >= r.loreTotal && r.loreTotal > 0 },\n86:  { name: '総べてを蒐む', hint: '総合収集率100%', test: (r) => r.collPct >= 100 },\n87:]\n88:\n89:// 年代記の種別絞り込み(M18 P5: 表示専用の定数・store/coreは変更しない)\n90:const KIND_LABEL: Record<ChronicleEntry['kind'], string> = {\n91:  birth: '誕生', death: '死', pact: '契り', triumph: '勝鬨', event: '出来事', era: '節目',\n92:}\n93:type KindFilter = 'all' | ChronicleEntry['kind']\n94:const KIND_FILTERS: KindFilter[] = ['all', 'birth', 'death', 'pact', 'triumph', 'event', 'era']\n95:const CHRON_PAGE = 200 // 大量一覧対策(§7契約): 直近200件+さらに繰る(200件刻み)\n96:\n97:type Tab = 'overview' | 'titles' | 'fallen' | 'chronicle'\n98:const TABS: { key: Tab; label: string }[] = [\n99:  { key: 'overview', label: '概要' },\n100:  { key: 'titles', label: '称号' },\n101:  { key: 'fallen', label: '故人' },\n102:  { key: 'chronicle', label: '年代記' },\n103:]\n104:\n105:export function ChronicleScreen() {\n106:  const data = useGame((s) => s.data)!\n107:  const setScreen = useGame((s) => s.setScreen)\n108:  const [tab, setTab] = useState<Tab>('overview')\n109:  const [copied, setCopied] = useState(false)\n110:  const [showTree, setShowTree] = useState(false)\n111:  const [kindFilter, setKindFilter] = useState<KindFilter>('all')\n112:  const [chronShown, setChronShown] = useState(CHRON_PAGE)\n113:\n114:  const fallen = data.family.filter((c) => !c.alive)\n115:  const rec = computeRecords(data)\n116:  const achieved = ACHIEVEMENTS.filter((a) => a.test(rec))\n117:  const head = data.family.find((c) => c.isHead)\n118:\n119:  const chronAll = [...data.chronicle].reverse()\n120:  const chronFiltered = kindFilter === 'all' ? chronAll : chronAll.filter((e) => e.kind === kindFilter)\n121:\n122:  const changeKindFilter = (k: KindFilter) => {\n123:    setKindFilter(k)\n124:    setChronShown(CHRON_PAGE)\n125:  }\n126:\n127:  return (\n128:    <ScreenShell\n129:      title=\"家譜 — 燈守家千年紀\"\n130:      onBack={() => setScreen({ id: 'home' })}\n131:      resources={head ? <>当主 <b>{head.name}</b>(第{head.gen}代)</> : undefined}\n132:      tabs={<WorkspaceTabs tabs={TABS} active={tab} onChange={setTab} />}\n133:      activeTab={tab}\n134:      dock={\n135:        <ActionDock>\n136:          <button className=\"btn btn-main\" onClick={() => setShowTree(true)}>\n137:            家系図を見る\n138:          </button>\n139:          <span className=\"chron-keep-group\">\n140:            <span className=\"chron-keep-label\">残す</span>\n141:            <button className=\"btn\" onClick={() => downloadChronicleCard(data)}>\n142:              画像保存\n143:            </button>\n144:            <button\n145:              className=\"btn\"\n146:              onClick={async () => {\n147:                const ok = await copyShareText(data)\n148:                setCopied(ok)\n149:                setTimeout(() => setCopied(false), 2000)\n150:              }}\n151:            >\n152:              {copied ? '写した!' : '共有文コピー'}\n153:            </button>\n154:          </span>\n155:        </ActionDock>\n156:      }\n157:    >\n158:      <section className={`chronicle-book chronicle-book--${tab}`} aria-label=\"燈守家の綴じた年代記\">\n159:        <span className=\"chronicle-book-spine\" aria-hidden=\"true\" />\n160:        <header className=\"chronicle-folio-head\">\n161:          <span className=\"chronicle-folio-mark\" aria-hidden=\"true\">燈</span>\n162:          <div>\n163:            <span className=\"chronicle-kicker\">燈守家・第{Math.max(1, rec.gens)}代蔵</span>\n164:            <p>{tab === 'overview' ? '継いだ歳月と、まだ継げる灯。' : tab === 'titles' ? '家に刻まれた呼び名。' : tab === 'fallen' ? '欠けた席と、遺された言葉。' : '季節の順に綴られた出来事。'}</p>\n165:          </div>\n166:          <span className=\"chronicle-page-no\">{TABS.findIndex((t) => t.key === tab) + 1} / {TABS.length}</span>\n167:        </header>\n168:\n169:      {tab === 'overview' && (\n170:        <Panel title={`一族の記録 — 総合収集率 ${rec.collPct}%`} className=\"chron-folio chron-overview-folio\">\n171:          {/* 命脈 — 継がれた世代を灯る節で、次代をまだ点らぬ節で結ぶ(A案署名要素) */}\n172:          <div className=\"chron-thread\" title={`第${rec.gens}代まで継承`}>\n173:            <LifeThread nodes={[...Array.from({ length: Math.max(1, rec.gens) }, () => ({ lit: true })), { lit: false }]} />\n174:          </div>\n175:          <div className=\"chronicle-hero-records\" aria-label=\"一族の主要な記録\">\n176:            <div><span>{rec.gens}</span><small>紡いだ世代</small></div>\n177:            <div><span>{rec.alive}</span><small>いま灯る命</small></div>\n178:            <div><span>{rec.collPct}<i>%</i></span><small>見聞の満ち</small></div>\n179:          </div>\n180:          <p className=\"chronicle-margin-note\">余白には、まだ名のない次代のための一行が残されている。</p>\n181:          <div className=\"collection-portals\" aria-label=\"収集の記録へ進む\">\n182:            <button className=\"btn collection-portal\" onClick={() => setScreen({ id: 'codex', tab: 'lore' })}>\n183:              <span>土地の記</span><b>{rec.loreDone}/{rec.loreTotal}</b><small>石碑と鎮魂を見返す</small>\n184:            </button>\n185:            <button className=\"btn collection-portal\" onClick={() => setScreen({ id: 'codex', tab: 'enemies' })}>\n186:              <span>魔性の拓影</span><b>{rec.enemySeen}/{rec.enemyTotal}</b><small>遭遇した姿を見返す</small>\n187:            </button>\n188:            <button className=\"btn collection-portal\" onClick={() => setScreen({ id: 'codex', tab: 'gods' })}>\n189:              <span>星神の御影</span><b>{rec.godSeen}/{rec.godTotal}</b><small>識った神を見返す</small>\n190:            </button>\n191:            <button className=\"btn collection-portal collection-portal-items\" onClick={() => setScreen({ id: 'forge', tab: 'collection' })}>\n192:              <span>宝具系譜録</span><b>{rec.itemSeen}/{rec.itemTotal}</b><small>{rec.itemSeriesStarted}系譜を開始・{rec.itemSeriesComplete}棚完成</small>\n193:            </button>\n194:          </div>\n195:          {rec.itemAlmost.length > 0 && (\n196:            <p className=\"collection-almost\"><b>あと一段で揃う棚</b>{rec.itemAlmost.join('・')}</p>\n197:          )}\n198:          <div className=\"records-grid\">\n199:            <div className=\"rec-cell\"><span className=\"rec-num\">{rec.years}</span><span className