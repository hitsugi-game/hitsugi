  reader.onload = () => {\n47:      void import('../core/save').then(({ importSaveStringResult }) => {\n48:        const result = importSaveStringResult(String(reader.result))\n49:        const failure = result.ok ? '' : result.previousSavePreserved\n50:          ? '読み込めなかった。既存の記は保持した。ファイルまたは端末の保存設定を確認してください。'\n51:          : '読み込みの検証に失敗した。再読込せず、復旧頁から控えを書き出してください。'\n52:        emitToast(result.ok ? 'セーブを読み込んだ。「つづきから」で再開できる。' : failure, result.ok ? 'info' : 'error')\n53:        refreshSaveStatus()\n54:      }).catch(() => emitToast('セーブ検証部を読み込めなかった。再読込してください。', 'error'))\n55:    }\n56:    reader.readAsText(file)\n57:  }\n58:  const startGame = (narrative: boolean) => {\n59:    void import('../core/store').then(({ useGame }) => {\n60:      useGame.getState().newGame(narrative)\n61:      onRuntimeReady?.()\n62:    }).catch(() => emitToast('ゲーム本体を読み込めなかった。回線を確認して再読込してください。', 'error'))\n63:  }\n64:  const continueGame = () => {\n65:    void import('../core/store').then(({ useGame }) => {\n66:      useGame.getState().continueGame()\n67:      onRuntimeReady?.()\n68:    }).catch(() => emitToast('一族の記を開けなかった。回線を確認して再読込してください。', 'error'))\n69:  }\n70:\n71:  return (\n72:    <div className=\"screen title-screen\">\n73:      <img\n74:        className=\"title-art-img\"\n75:        src={`${import.meta.env.BASE_URL}img/title_key.jpg`}\n76:        alt=\"\"\n77:        aria-hidden\n78:      />\n79:      <div className=\"embers\" aria-hidden>\n80:        {Array.from({ length: 14 }, (_, i) => (\n81:          <span key={i} className=\"ember\" style={{ left: `${(i * 7.3) % 100}%`, animationDelay: `${i * 0.9}s` }} />\n82:        ))}\n83:      </div>\n84:      <div className=\"title-main\">\n85:        <p className=\"title-kicker\">常夜千年・一族継承譚</p>\n86:        <h1 className=\"game-title\">\n87:          <span className=\"title-hi\">灯</span>\n88:          <span className=\"title-tsugi\">継ぎ</span>\n89:        </h1>\n90:        <p className=\"title-sub\">- HITSUGI -</p>\n91:        <p className=\"title-copy\">八季の命を、継いでゆけ。</p>\n92:      </div>\n93:\n94:      {confirmNew ? (\n95:        <div className=\"title-menu\">\n96:          <p className=\"mode-ask\">既に一族の記がある。新たに始めれば、それは失われる。よいか?</p>\n97:          <button className=\"btn btn-main\" onClick={() => { setConfirmNew(false); setMode('normal') }}>\n98:            承知の上で、始める\n99:          </button>\n100:          <button className=\"btn btn-ghost\" onClick={() => setConfirmNew(false)}>\n101:            やめておく\n102:          </button>\n103:        </div>\n104:      ) : mode === 'data' ? (\n105:        <div className=\"title-menu\">\n106:          <p className=\"mode-ask\">セーブの管理</p>\n107:          <p className=\"title-save-state\" data-state={saveStatus}>\n108:            {saveStatus === 'ready' && <>端末の記 <strong>読取可能</strong></>}\n109:            {saveStatus === 'recoverable' && <>端末の記 <strong>控えから復旧可能</strong></>}\n110:            {saveStatus === 'damaged' && <>端末の記 <strong>破損を検出</strong><span>ファイルから正常な控えを読み込むか、この記を消してください。</span></>}\n111:            {saveStatus === 'unavailable' && <>端末の記 <strong>保存できない</strong><span>ブラウザの保存許可を確認してください。許可がなくても、この場では遊べます。</span></>}\n112:            {saveStatus === 'none' && <>端末の記 <strong>まだない</strong></>}\n113:            {saveStatus === 'checking' && <>端末の記 <strong>確認中</strong></>}\n114:          </p>\n115:          <button className=\"btn\" disabled={!canExport} onClick={() => {\n116:            void import('../core/save').then(({ downloadSave }) => {\n117:              if (!downloadSave()) emitToast('書き出せる正常なセーブが無い。', 'error')\n118:            })\n119:          }}>\n120:            セーブを書き出す(バックアップ)\n121:          </button>\n122:          <button className=\"btn\" onClick={() => fileRef.current?.click()}>\n123:            セーブを読み込む(ファイルから)\n124:          </button>\n125:          <button className=\"btn btn-ghost\" disabled={!saveExists} onClick={() => {\n126:            if (!confirm('この端末のセーブを完全に消す。取り消せない。よいか?')) return\n127:            void import('../core/save').then