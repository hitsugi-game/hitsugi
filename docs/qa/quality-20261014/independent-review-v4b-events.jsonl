Node(nodeId)\n46:  }\n47:  expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_gentou')\n48:  expect(useGame.getState().battleRewardSettlement?.plan.nextPhase).toBe('shiori_duel')\n49:}\n50:\n51:function finishAs(phase: 'won' | 'lost' | 'fled'): void {\n52:  const battle = useGame.getState().battle!\n53:  useGame.setState({ battle: { ...battle, phase } })\n54:  useGame.getState().finishBattle()\n55:}\n56:\n57:beforeEach(() => {\n58:  storage.clear()\n59:  useGame.getState().newGame(false)\n60:  const data = useGame.getState().data!\n61:  useGame.setState({\n62:    screen: { id: 'home' },\n63:    data: {\n64:      ...data,\n65:      fame: 3000,\n66:      flags: {\n67:        ...data.flags, reveal_shiori_name: true, dreamSeen: true,\n68:        ch1: true, ch2: true, ch3: true, ch4: true, ch5: true,\n69:        ch1_completed: true, ch2_completed: true, ch3_completed: true,\n70:        ch4_completed: true, ch5_completed: true,\n71:      },\n72:    },\n73:  })\n74:})\n75:\n76:describe.each<Route>(['dungeon', 'node'])('最終戦の進行回帰: %s', (route) => {\n77:  it('第二相への遭遇を魔性図鑑へ記録し、敗北後の再挑戦でも重複させない', () => {\n78:    enterGentou(route)\n79:    const previousCodex = useGame.getState().data!.codex!\n80:    finishAs('won')\n81:    const encountered = useGame.getState().data!.codex!\n82:    expect(encountered.enemies).toEqual([...previousCodex.enemies, 'boss_shiori'])\n83:    expect(encountered.gods).toEqual(previousCodex.gods)\n84:    finishAs('lost')\n85:    useGame.getState().continueGame()\n86:    expect(useGame.getState().data!.codex!.enemies).toContain('boss_shiori')\n87:\n88:    enterGentou(route)\n89:    finishAs('won')\n90:    expect(useGame.getState().data!.codex!.enemies.filter((id) => id === 'boss_shiori')).toHaveLength(1)\n91:  })\n92:\n93:  it('汐里戦で敗北して保存・再開しても、玄冬の再討伐から第二相へ進める', () => {\n94:    enterGentou(route)\n95:    finishAs('won')\n96:    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\n97:    finishAs('lost')\n98:    expect(useGame.getState().data!.flags.shioriPhase).toBe(true)\n99:    expect(useGame.getState().continueGame()).toBe(true)\n100:\n101:    enterGentou(route)\n102:    finishAs('won')\n103:    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\n104:    expect(useGame.getState().battleRewardSettlement?.plan.nextPhase).toBe('finale')\n105:    finishAs('won')\n106:    expect(useGame.getState().screen.id).toBe('finale')\n107:  })\n108:\n109:  it('第二相から逃走しても、再遠征の玄冬戦から第二相へ進める', () => {\n110:    enterGentou(route)\n111:    finishAs('won')\n112:    finishAs('fled')\n113:    if (route === 'dungeon') useGame.getState().dungeonReturn()\n114:    else useGame.getState().useReturnFire()\n115:\n116:    enterGentou(route)\n117:    finishAs('won')\n118:    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\n119:  })\n120:\n121:  it.each([0, 1, 2])('選択前は岐路、結末%dの未読時は本文、読了後は郷へ再開する', (choice) => {\n122:    enterGentou(route)\n123:    finishAs('won')\n124:    finishAs('won')\n125:    const finale = useGame.getState()\n126:    expect(finale.screen.id).toBe('finale')\n127:    expect(finale.data!.flags.endingType).toBeUndefined()\n128:\n129:    expect(finale.continueGame()).toBe(true)\n130:    expect(useGame.getState().screen.id).toBe('finale')\n131:    expect(useGame.getState().data!.flags.endingType).toBeUndefined()\n132:    useGame.getState().resolveFinale(choice)\n133:    expect(useGame.getState().screen.id).toBe('ending')\n134:    expect(useGame.getState().data!.flags.endingType).toBe(choice)\n135:    expect(useGame.getState().data!.flags.finalePending).toBe(false)\n136:\n137:    expect(useGame.getState().continueGame()).toBe(true)\n138:    expect(useGame.getState().screen.id).toBe('ending')\n139:    expect(useGame.getState().data!.flags.endingType).toBe(choice)\n140:    useGame.getState().completeEnding()\n141:    expect(useGame.getState().continueGame()).toBe(true)\n142:    expect(useGame.getState().screen.id).toBe('home')\n143:    expect(useGame.getState().data!.flags.endingType).toBe(choice)\n144:  })\n145:\n146:  it('過去に結末を選んだ後の再戦も、今回の岐路が保留中ならその場面へ再開する', () => {\n147:    enterGentou(route)\n148:    finishAs('won')\n149:    finishAs('won')\n150:    useGame.getState().resolveFinale(1)\n151:    useGame.getState().continueGame()\n152:    enterGentou(route)\n153:    finishAs('won')\n154:    finishAs('won')\n155:\n156:    expect(useGame.getState().data!.flags.finalePending).toBe(true)\n157:    expect(useGame.getState().continueGame()).toBe(true)\n158:    expect(useGame.getState().screen.id).toBe('finale')\n159:  })\n160:\n161:  it('旧クリアsaveから第二相へ進んだだけでは、敗北後の再開を岐路へ飛ばさない', () => {\n162:    const data = useGame.getState().data!\n163:    useGame.setState({ data: { ...data, flags: { ...data.flags, cleared: true } } })\n164:    enterGentou(route)\n165:    finishAs('won')\n166:    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\n167:    finishAs('lost')\n168:\n169:    expect(useGame.getState().continueGame()).toBe(true)\n170:    expect(useGame.getState().screen.id).toBe('home')\n171:    expect(useGame.getState().data!.flags.endingType).toBeUndefined()\n172:  })\n173:})\n174:\n175:it('結末の読了状態を持たない旧saveは、既読か推測せず従来どおり郷へ再開する', () => {\n176:  const data = useGame.getState().data!\n177:  saveGame({ ...data, flags: { ...data.flags, cleared: true, endingType: 1, finalePending: false } })\n178:  expect(useGame.getState().continueGame()).toBe(true)\n179:  expect(useGame.getState().screen.id).toBe('home')\n180:})\n181:\n182:it('クリア後の寿命断絶は今回の断絶へ再開し、過去のclearと結末選択を消さない', () => {\n183:  const data = useGame.getState().data!\n184:  useGame.setState({\n185:    data: {\n186:      ...data, seasonIndex: 23,\n187:      family: data.family.map((character) => ({ ...character, bornSeason: 0 })),\n188:      flags: { ...data.flags, cleared: true, endingType: 1, endingPending: false },\n189:    },\n190:  })\n191:  useGame.getState().doRest()\n192:  expect(useGame.getState().screen.id).toBe('ending')\n193:  expect(useGame.getState().data!.flags.extinct).toBe(true)\n194:  expect(useGame.getState().continueGame()).toBe(true)\n195:  expect(useGame.getState().screen.id).toBe('ending')\n196:  expect(useGame.getState().data!.flags.cleared).toBe(true)\n197:  expect(useGame.getState().data!.flags.endingType).toBe(1)\n198:})\n199:\n200:it('結末読了後の再読で未読へ戻さず、新周回へ読了保留を持ち越さない', () => {\n201:  useGame.getState().resolveFinale(2)\n202:  useGame.getState().completeEnding()\n203:  const finished = useGame.getState().data!\n204:  useGame.getState().setScreen({ id: 'ending' })\n205:  useGame.getState().completeEnding()\n206:  expect(useGame.getState().data!.flags).toEqual(finished.flags)\n207:  useGame.getState().newLegacyGame()\n208:  expect(useGame.getState().data!.flags.endingPending).toBeUndefined()\n209:  expect(useGame.getState().data!.flags.endingType).toBeUndefined()\n210:})\n211:\n212:it.each([false, true])('武功だけ先行しても第三・第四章より第五章を先に発火しない: narrative=%s', (narrativeMode) => {\n213:  const base = useGame.getState().data!\n214:  const data = migrateM34Narrative({\n215:    ...base, narrativeMode, fame: 520, seasonIndex: 2, regionsCleared: ['yoi_forest'], loreFrags: {},\n216:    flags: { m34_narrative_schema: 1, ch1: true, ch2: true, dreamSeen: true },\n217:    narrative: { ...base.narrative!, completed: ['ch1', 'ch2'], active: undefined, deferred: [], queued: [] },\n218:  })\n219:  saveGame(data)\n220:  expect(useGame.getState().continueGame()).toBe(true)\n221:  useGame.getState().doRest()\n222:  expect(useGame.getState().data!.flags.ch3).toBeUndefined()\n223:  expect(useGame.getState().data!.flags.ch5).toBeUndefined()\n224:  useGame.getState().deferCurrentScene()\n225:\n226:  useGame.setState({ data: { ...useGame.getState().data!, regionsCleared: REGIONS.slice(0, 5).map((region) => region.id) } })\n227:  useGame.getState().doRest()\n228:  expect(useGame.getState().data!.flags.ch3).toBe(true)\n229:  expect(useGame.getState().data!.flags.ch5).toBeUndefined()\n230:  useGame.getState().skipCurrentScene(