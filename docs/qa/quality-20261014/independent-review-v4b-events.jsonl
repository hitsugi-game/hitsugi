ngify(saved))\n273:  storage.delete('hitsugi_save_v4_bak')\n274:\n275:  expect(useGame.getState().continueGame()).toBe(true)\n276:  expect(useGame.getState().screen.id).toBe('finale')\n277:})\n278:\n279:it('第二相の記録も保留flagもない旧クリアsaveは、従来どおり郷へ戻る', () => {\n280:  const saved = JSON.parse(storage.get('hitsugi_save_v4')!)\n281:  saved.flags.cleared = true\n282:  delete saved.flags.shioriPhase\n283:  delete saved.flags.finalePending\n284:  delete saved.flags.endingType\n285:  storage.set('hitsugi_save_v4', JSON.stringify(saved))\n286:  storage.delete('hitsugi_save_v4_bak')\n287:\n288:  expect(useGame.getState().continueGame()).toBe(true)\n289:  expect(useGame.getState().screen.id).toBe('home')\n290:})\n291:\n292:describe.each(['ceremony', 'jobrite'] as const)('後回しの儀の対象確認: %s', (kind) => {\n293:  it.each(['dead', 'missing'] as const)('%sの人物を儀へ立たせず、未実施の記録を一度だけ残す', (condition) => {\n294:    const data = migrateM34Narrative(useGame.getState().data!)\n295:    const charId = data.family[0].id\n296:    const scene: NarrativeScene = { kind, charId }\n297:    const id = narrativeSceneId(scene)\n298:    const beforeFamily = condition === 'dead'\n299:      ? data.family.map((c) => ({ ...c, alive: false }))\n300:      : data.family.map((c) => ({ ...c, id: 'unrelated-survivor' }))\n301:    useGame.setState({\n302:      data: {\n303:        ...data, family: beforeFamily,\n304:        narrative: { ...data.narrative!, deferred: [scene], queued: [id], deferredSince: { [id]: 1 } },\n305:      },\n306:    })\n307:\n308:    useGame.getState().openDeferredScene(id)\n309:    const after = useGame.getState()\n310:    expect(after.screen.id).toBe('home')\n311:    expect(after.data!.family).toEqual(beforeFamily)\n312:    expect(after.data!.narrative!.deferred).toEqual([])\n313:    expect(after.data!.narrative!.queued).not.toContain(id)\n314:    expect(after.data!.narrative!.deferredSince[id]).toBeUndefined()\n315:    expect(after.data!.narrative!.completed).not.toContain(id)\n316:    const chronicle = after.data!.chronicle\n317:    expect(chronicle.at(-1)?.text).toContain('執り行わず')\n318:    after.openDeferredScene(id)\n319:    expect(useGame.getState().data!.chronicle).toEqual(chronicle)\n320:  })\n321:\n322:  it('存命人物の儀は、従来どおり選択を確定せず開く', () => {\n323:    const data = migrateM34Narrative(useGame.getState().data!)\n324:    const charId = data.family[0].id\n325:    const scene: NarrativeScene = { kind, charId }\n326:    const id = narrativeSceneId(scene)\n327:    useGame.setState({ data: { ...data, narrative: { ...data.narrative!, deferred: [scene] } } })\n328:\n329:    useGame.getState().openDeferredScene(id)\n330:    expect(useGame.getState().screen).toEqual({ id: kind, charId })\n331:    expect(useGame.getState().data!.family).toEqual(data.family)\n332:    expect(useGame.getState().data!.narrative!.active).toEqual(scene)\n333:  })\n334:})\n335:\n336:it.each(['birth', 'life'] as const)('故人の%s場面は回想として消さずに開ける', (kind) => {\n337:  const data = migrateM34Narrative(useGame.getState().data!)\n338:  const charId = data.family[0].id\n339:  const scene: NarrativeScene = kind === 'birth' ? { kind, charId } : {\n340:    kind, narrativeId: 'life:past', title: '生前の一夜', lines: [{ speaker: '', text: '生前の記録。' }],\n341:  }\n342:  const id = narrativeSceneId(scene)\n343:  useGame.setState({\n344:    data: {\n345:      ...data, family: data.family.map((c) => ({ ...c, alive: false })),\n346:      narrative: { ...data.narrative!, deferred: [scene] },\n347:    },\n348:  })\n349:\n350:  useGame.getState().openDeferredScene(id)\n351:  expect(useGame.getState().screen.id).toBe(kind)\n352:  expect(useGame.getState().data!.narrative!.active).toEqual(scene)\n353:})\n354:\n355:const summaryScenes: NarrativeScene[] = [\n356:  ...CHAPTERS.map((chapter): NarrativeScene => ({\n357:    kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: chapter.lines,\n358:  })),\n359:  { kind: 'dream' },\n360:  ...DREAM_EPISODES.map((episode): NarrativeScene => ({ kind: 'dreamEp', epId: episode.id })),\n361:]\n362:\n363:it.each(summaryScenes.map((scene) => [narrativeSceneId(scene), scene] as const))(\n364:  '%sのskipは実要約を一度だけ家譜へ保存し、再読skipで重複させない', (_id, scene) => {\n365:    const base = useGame.getState().data!\n366:    const data = migrateM34Narrative({\n367:      ...base, flags: { m34_narrative_schema: 1 },\n368:      narrative: {\n369:        ...base.narrative!, completed: [], seen: [], archive: [],\n370:        active: scene, activeReplay: false,\n371:      },\n372:    })\n373:    useGame.setState({ data })\n374:    const summary = narrativeSceneSummary(scene)\n375:    expect(typeof summary).toBe('string')\n376:\n377:    useGame.getState().skipCurrentScene()\n378:    const after = useGame.getState().data!\n379:    expect(after.chronicle.filter((entry) => entry.kind === 'event' && entry.text.includes(summary!))).toHaveLength(1)\n380:    expect(after.chronicle.some((entry) => entry.text.includes('家譜の要約で受け取った'))).toBe(false)\n381:    if (narrativeSceneId(scene) === 'ch4') expect(after.flags.reveal_shiori_name).toBe(true)\n382:\n383:    useGame.getState().skipCurrentScene()\n384:    expect(useGame.getState().data!.chronicle).toEqual(after.chronicle)\n385:    useGame.getState().replayNarrativeScene(narrativeSceneId(scene))\n386:    useGame.getState().skipCurrentScene()\n387:    expect(useGame.getState().data!.chronicle).toEqual(after.chronicle)\n388:    useGame.getState().continueGame()\n389:    expect(useGame.getState().data!.chronicle).toEqual(after.chronicle)\n390:  },\n391:)\n","exit_code":0,"status":"completed"}}
