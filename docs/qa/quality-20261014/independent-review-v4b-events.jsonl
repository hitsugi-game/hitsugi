r\n306:             </div>\r\n307:           )}\r\n308:           {archivedStories.length > 0 && (\r\n309:             <section className=\"story-archive\" aria-labelledby=\"story-archive-title\">\r\n310:               <h3 id=\"story-archive-title\">家譜に綴じた物語</h3>\r\n311:               <p>選択や進行を変えず、章と夢を読み返す。</p>\r\n312:               <div className=\"story-margin-list\">\r\n313:                 {archivedStories.slice(0, showAllArchive ? archivedStories.length : 6).map((scene) => (\r\n314:                   <button\r\n315:                     key={`archive-${narrativeSceneId(scene)}`}\r\n316:                     className=\"btn story-margin-item\"\r\n317:                     onClick={() => { setShowStoryMargin(false); replayNarrativeScene(narrativeSceneId(scene)) }}\r\n318:                   >\r\n319:                     <b>{sceneLabel(scene)}</b>\r\n320:                     <span>家譜から読み返す</span>\r\n321:                   </button>\r\n322:                 ))}\r\n323:               </div>\r\n324:               {archivedStories.length > 6 && (\r\n325:                 <button type=\"button\" className=\"btn btn-ghost story-archive-more\" onClick={() => setShowAllArchive((shown) => !shown)}>\r\n326:                   {showAllArchive ? '最初の6件に戻す' : `残り${archivedStories.length - 6}件を表示`}\r\n327:                 </button>\r\n328:               )}\r\n727: type Obj = { text: string; go?: 'pact' | 'depart' | 'chronicle' | 'codex'; goLabel?: string; progress?: [number, number]; done?: boolean }\r\n728: function computeObjectives(data: ReturnType<typeof useGame.getState>['data'] & object, adultCount: number): { short: Obj[]; mid: Obj[]; long: Obj[] } {\r\n729:   const alive = data.family.filter((c) => c.alive)\r\n730:   const head = alive.find((c) => c.isHead)\r\n731:   const gens = data.family.length > 0 ? Math.max(...data.family.map((c) => c.gen)) : 0\r\n732:   const baseEnemies = ENEMIES.filter((e) => !/_[wo]$/.test(e.id))\r\n733:   const enemySeen = new Set((data.codex?.enemies ?? []).map((id) => id.replace(/_[wo]$/, ''))).size\r\n734:   const bossRegions = REGIONS.filter((r) => r.bossId && r.id !== 'tokoyo_tou')\r\n735:   const clearedSet = new Set(data.regionsCleared)\r\n736: \r\n737:   // 短期(今すぐ〜この代)\r\n738:   const short: Obj[] = []\r\n739:   if (head && seasonsLeft(head, data.seasonIndex) <= 3 && data.pendingBirths.length === 0) {\r\n740:     short.push({ text: `当主 ${head.name} の灯が細い。次代を残す`, go: 'pact', goLabel: '星契りへ' })\r\n741:   }\r\n742:   if (alive.length <= 2 && data.pendingBirths.length === 0 && adultCount > 0) {\r\n743:     short.push({ text: '血が細い。星と契り、子を授かる', go: 'pact', goLabel: '星契りへ' })\r\n744:   }\r\n745:   if (adultCount > 0) short.push({ text: '夜藪へ出立し、奉燈と血珠を持ち帰る', go: 'depart', goLabel: '出立へ' })\r\n746:   if (short.length === 0) short.push({ text: '子が育つのを待ち、次の一手を練る' })\r\n747: \r\n748:   // 中期(この周回)\r\n749:   const mid: Obj[] = []\r\n750:   const nextLocked = REGIONS.filter((r) => r.unlockFame > data.fame && r.id !== 'tokoyo_tou').sort((a, b) => a.unlockFame - b.unlockFame)[0]\r\n751:   if (nextLocked) mid.push({ text: `「${nextLocked.name}」への道を開く`, progress: [data.fame, nextLocked.unlockFame], go: 'depart', goLabel: '出立へ' })\r\n752:   const nextBoss = bossRegions.filter((r) => r.unlockFame <= data.fame && !clearedSet.has(r.id)).sort((a, b) => a.tier - b.tier)[0]\r\n753:   if (nextBoss) mid.push({ text: `「${nextBoss.name}」の主を鎮める`, go: 'depart', goLabel: '出立へ' })\r\n754:   mid.push({ text: '血を継ぎ、代を重ねる', progress: [gens, 10] })\r\n755:   mid.push({ text: '魔性を見聞し、図鑑を埋める', progress: [enemySeen, baseEnemies.length], go: 'codex', goLabel: '図鑑へ' })\r\n756: \r\n757:   // 長期(千年紀)\r\n758:   const long: Obj[] = []\r\n759:   long.push({ text: '玄冬を討ち、常夜に朝を還す', done: !!data.flags.cleared })\r\n760:   long.push({ text: '全ての地の主を鎮める', progress: [data.regionsCleared.filter((id) => bossRegions.some((r) => r.id === id)).length, bossRegions.length] })\r\n761:   if (data.flags.cleared) {\r\n762:     const tower = typeof data.flags.towerBest === 'number' ? data.flags.towerBest : 0\r\n763:     long.push({ text: '常夜百層を、深く制す', progress: [tower, 100] })\r\n764:   }\r\n765:   return { short, mid, long }\r\n766: }\r\n767: \r\n768: function ObjectivesModal({ onClose }: { onClose: () => void }) {\r\n769:   const data = useGame((s) => s.data)!\r\n770:   const setScreen = useGame((s) => s.setScreen)\r\n","exit_code":0,"status":"completed"}}
