{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'src/core/narrative.ts' | ForEach-Object { \"'$n++; '\"'{0}: {1}' -f \"'$n, $_ }'","aggregated_output":"1: import type {\r\n2:   Character, GameData, NarrativeProgress, NarrativeScene, NarrativeStage,\r\n3: } from './types'\r\n4: import { CHAPTERS } from './data/story'\r\n5: import { DREAM_EPISODES } from './data/dreams'\r\n6: import { REGIONS } from './data/regions'\r\n7: import { CHAPTER_SUMMARIES, DREAM_EPISODE_SUMMARIES, INTRO_DREAM_SUMMARY } from './data/narrative_summaries'\r\n8: \r\n9: export type NarrativeChannel = 'ambient' | 'discovery' | 'scene'\r\n10: export type NarrativeTrigger =\r\n11:   | { kind: 'home' }\r\n12:   | { kind: 'depart'; regionId: string }\r\n13:   | { kind: 'dungeonEnter'; regionId: string; firstVisit: boolean }\r\n14:   | { kind: 'monument'; regionId: string; fragment: number }\r\n15:   | { kind: 'boss'; regionId: string; phase: 'before' | 'victory' }\r\n16:   | { kind: 'return'; regionId: string; bossDown: boolean }\r\n17:   | { kind: 'villageTalk'; villagerId: string }\r\n18:   | { kind: 'inherit'; generation: number }\r\n19: \r\n20: export interface NarrativeBeat {\r\n21:   id: string\r\n22:   stage: NarrativeStage\r\n23:   channel: NarrativeChannel\r\n24:   trigger: NarrativeTrigger\r\n25:   text: string\r\n26:   speaker?: string\r\n27:   once?: boolean\r\n28:   priority: number\r\n29:   requires?: string[]\r\n30:   blocks?: string[]\r\n31:   recap?: string\r\n32: }\r\n33: \r\n34: const EMPTY_RESONANCE = { cut: 0, save: 0, inherit: 0 }\r\n35: const EMPTY_METRICS = {\r\n36:   scenesOpened: 0,\r\n37:   scenesCompleted: 0,\r\n38:   scenesSkipped: 0,\r\n39:   scenesDeferred: 0,\r\n40:   totalSceneMs: 0,\r\n41:   maxDeferred: 0,\r\n42:   monthsAdvanced: 0,\r\n43:   interruptedAfterMonth: 0,\r\n44: }\r\n45: \r\n46: export function narrativeSceneId(scene: NarrativeScene): string {\r\n47:   switch (scene.kind) {\r\n48:     case 'birth': return `birth:${scene.charId}`\r\n49:     case 'death': return `death:${scene.charId}`\r\n50:     case 'ceremony': return `ceremony:${scene.charId}`\r\n51:     case 'jobrite': return `jobrite:${scene.charId}`\r\n52:     case 'dream': return 'dream:intro'\r\n53:     case 'dreamEp': return `dream:${scene.epId}`\r\n54:     case 'life': return scene.narrativeId ?? `life:${scene.title}`\r\n55:   }\r\n56: }\r\n57: \r\n58: export function narrativeScenePriority(scene: NarrativeScene): number {\r\n59:   if (scene.kind === 'death') return 0\r\n60:   if (scene.kind === 'birth' || scene.kind === 'ceremony' || scene.kind === 'jobrite') return 1\r\n61:   if (scene.kind === 'life' && scene.narrativeId?.startsWith('ch')) return 2\r\n62:   if (scene.kind === 'dream' || scene.kind === 'dreamEp') return 3\r\n63:   return 4\r\n64: }\r\n65: \r\n66: export function narrativeStageOf(data: Pick<GameData, 'flags'>): NarrativeStage {\r\n67:   const f = data.flags\r\n68:   if (f.ch5_completed || f.dreamEp_yume_itadaki) return 'summit'\r\n69:   if (f.ch4_completed || f.dreamEp_yume_maki) return 'fire_vow'\r\n70:   if (f.ch3_completed || f.dreamEp_yume_futari || f.dreamEp_yume_ue || f.dreamEp_yume_taiyou) return 'duet_hunger'\r\n71:   if (f.ch2_completed || f.dreamEp_yume_tabibito || f.dreamEp_yume_sora_no_ko) return 'name'\r\n72:   return 'one_light'\r\n73: }\r\n74: \r\n75: function completedFromFlags(data: GameData, legacy: boolean): string[] {\r\n76:   const ids: string[] = []\r\n77:   for (const chapter of CHAPTERS) {\r\n78:     if (data.flags[`${chapter.id}_completed`] || (legacy && data.flags[chapter.id])) ids.push(chapter.id)\r\n79:   }\r\n80:   if (data.flags.dreamSeen) ids.push('dream:intro')\r\n81:   for (const ep of DREAM_EPISODES) {\r\n82:     if (data.flags[`dreamEp_${ep.id}`]) ids.push(`dream:${ep.id}`)\r\n83:   }\r\n84:   return ids\r\n85: }\r\n86: \r\n87: function replayableSceneForId(id: string): NarrativeScene | undefined {\r\n88:   if (id === 'dream:intro') return { kind: 'dream' }\r\n89:   if (id.startsWith('dream:')) {\r\n90:     const epId = id.slice('dream:'.length)\r\n91:     return DREAM_EPISODES.some((episode) => episode.id === epId) ? { kind: 'dreamEp', epId } : undefined\r\n92:   }\r\n93:   const chapter = CHAPTERS.find((candidate) => candidate.id === id)\r\n94:   return chapter\r\n95:     ? { kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: chapter.lines }\r\n96:     : undefined\r\n97: }\r\n98: \r\n99: export function isReplayableNarrativeScene(scene: NarrativeScene): boolean {\r\n100:   return scene.kind === 'dream' || scene.kind === 'dreamEp' || (scene.kind === 'life' && !!scene.narrativeId?.startsWith('ch'))\r\n101: }\r\n102: \r\n103: /**\r\n104:  * M34 save migration. Sentinelが無い旧saveだけ実名開示を保守的に導出する。\r\n105:  * 現行saveへlegacy ORを再適用しないことが、ch4途中reloadの必須条件。\r\n106:  */\r\n107: export function migrateM34Narrative(data: GameData): GameData {\r\n108:   const legacy = data.flags?.m34_narrative_schema !== 1\r\n109:   const flags = { ...(data.flags ?? {}) }\r\n110:   if (legacy) {\r\n111:     const legacyReveal = Boolean(\r\n112:       flags.ch4 ||\r\n113:       (data.gossipIndex ?? 0) >= 12 ||\r\n114:       flags.shioriPhase ||\r\n115:       flags.endingType !== undefined ||\r\n116:       flags.cleared,\r\n117:     )\r\n118:     flags.m34_narrative_schema = 1\r\n119:     flags.reveal_shiori_name = legacyReveal\r\n120:     flags.legacy_shiori_recap_pending = legacyReveal\r\n121:     if (legacyReveal) flags.ch4_completed = true\r\n122:   }\r\n123: \r\n124:   const completed = [...new Set([\r\n125:     ...(data.narrative?.completed ?? []),\r\n126:     ...completedFromFlags({ ...data, flags }, legacy),\r\n127:   ])]\r\n128:   const seen = [...new Set([...(data.narrative?.seen ?? []), ...completed])]\r\n129:   const archive = uniqueScenes([\r\n130:     ...(data.narrative?.archive ?? []),\r\n131:     ...completed.map(replayableSceneForId).filter((scene): scene is NarrativeScene => !!scene),\r\n132:   ]).filter(isReplayableNarrativeScene)\r\n133:   const deferred = [...(data.narrative?.deferred ?? [])]\r\n134:   const fallbackDeferredAt = data.lastPlayedAt ?? Date.now()\r\n135:   const deferredSince = Object.fromEntries(deferred.map((scene) => {\r\n136:     const id = narrativeSceneId(scene)\r\n137:     return [id, data.narrative?.deferredSince?.[id] ?? fallbackDeferredAt]\r\n138:   }))\r\n139:   const narrative: NarrativeProgress = {\r\n140:     stage: narrativeStageOf({ flags }),\r\n141:     seen,\r\n142:     queued: [...new Set(data.narrative?.queued ?? [])],\r\n143:     completed,\r\n144:     deferred,\r\n145:     archive,\r\n146:     deferredSince,\r\n147:     deferredReminderShown: [...new Set(data.narrative?.deferredReminderShown ?? [])],\r\n148:     active: data.narrative?.active,\r\n149:     activeOpenedAt: data.narrative?.activeOpenedAt,\r\n150:     activeReplay: data.narrative?.activeReplay,\r\n151:     monthTransitionPending: data.narrative?.monthTransitionPending,\r\n152:     resonance: { ...EMPTY_RESONANCE, ...(data.narrative?.resonance ?? {}) },\r\n153:     metrics: { ...EMPTY_METRICS, ...(data.narrative?.metrics ?? {}) },\r\n154:     generationQuestion: data.narrative?.generationQuestion,\r\n155:     lastReturn: data.narrative?.lastReturn,\r\n156:   }\r\n157:   return { ...data, flags, narrative }\r\n158: }\r\n159: \r\n160: /** crash/閉じるで表示中だった場面は読了にせず「灯の余白」へ戻す。 */\r\n161: export function recoverNarrativeOnLoad(data: GameData): GameData {\r\n162:   const migrated = migrateM34Narrative(data)\r\n163:   const n = migrated.narrative!\r\n164:   const deferred = [...n.deferred]\r\n165:   if (n.active && !n.activeReplay) deferred.unshift(n.active)\r\n166:   const interrupted = !!n.monthTransitionPending\r\n167: \r\n168:   // post-M34のch4 queue済みsaveを、legacy扱いせず匿名のまま再開可能にする。\r\n169:   const ch4Pending = migrated.flags.ch4 && !migrated.flags.ch4_completed\r\n170:   if (ch4Pending && !deferred.some((s) => narrativeSceneId(s) === 'ch4')) {\r\n171:     const ch4 = CHAPTERS.find((c) => c.id === 'ch4')\r\n172:     if (ch4) deferred.unshift({ kind: 'life', narrativeId: ch4.id, title: ch4.title, lines: ch4.lines })\r\n173:   }\r\n174:   const recoveredAt = Date.now()\r\n175:   const deferredSince = Object.fromEntries(uniqueScenes(deferred).map((scene) => {\r\n176:     const id = narrativeSceneId(scene)\r\n177:     return [id, n.deferredSince[id] ?? (n.active && narrativeSceneId(n.active) === id ? n.activeOpenedAt : undefined) ?? recoveredAt]\r\n178:   }))\r\n179:   return {\r\n180:     ...migrated,\r\n181:     narrative: {\r\n182:       ...n,\r\n183:       active: undefined,\r\n184:       activeOpenedAt: undefined,\r\n185:       activeReplay: undefined,\r\n186:       monthTransitionPending: false,\r\n187:       deferred: uniqueScenes(deferred),\r\n188:       deferredSince,\r\n189:       metrics: {\r\n190:         ...n.metrics,\r\n191:         interruptedAfterMonth: n.metrics.interruptedAfterMonth + (interrupted ? 1 : 0),\r\n192:         maxDeferred: Math.max(n.metrics.maxDeferred, deferred.length),\r\n193:       },\r\n194:     },\r\n195:   }\r\n196: }\r\n197: \r\n198: export function narrativeMetricSummary(data: GameData): {\r\n199:   averageSceneMs: number\r\n200:   skipRate: number\r\n201:   maxDeferred: number\r\n202:   interruptedAfterMonth: number\r\n203: } {\r\n204:   const metrics = migrateM34Narrative(data).narrative!.metrics\r\n205:   const closed = metrics.scenesCompleted + metrics.scenesSkipped + metrics.scenesDeferred\r\n206:   const resolved = metrics.scenesCompleted + metrics.scenesSkipped\r\n207:   return {\r\n208:     averageSceneMs: closed > 0 ? Math.round(metrics.totalSceneMs / closed) : 0,\r\n209:     skipRate: resolved > 0 ? metrics.scenesSkipped / resolved : 0,\r\n210:     maxDeferred: metrics.maxDeferred,\r\n211:     interruptedAfterMonth: metrics.interruptedAfterMonth,\r\n212:   }\r\n213: }\r\n214: \r\n215: export function uniqueScenes(scenes: NarrativeScene[]): NarrativeScene[] {\r\n216:   const ids = new Set<string>()\r\n217:   return scenes.filter((scene) => {\r\n218:     const id = narrativeSceneId(scene)\r\n219:     if (ids.has(id)) return false\r\n220:     ids.add(id)\r\n221:     return true\r\n222:   })\r\n223: }\r\n224: \r\n225: export function partitionNarrativeScenes(\r\n226:   progress: NarrativeProgress,\r\n227:   candidates: NarrativeScene[],\r\n228: ): { primary: NarrativeScene | null; deferred: NarrativeScene[]; queued: string[] } {\r\n229:   const existing = new Set([\r\n230:     ...progress.completed,\r\n231:     ...progress.deferred.map(narrativeSceneId),\r\n232:     ...(progress.active ? [narrativeSceneId(progress.active)] : []),\r\n233:   ])\r\n234:   const fresh = uniqueScenes(candidates)\r\n235:     .filter((scene) => !existing.has(narrativeSceneId(scene)))\r\n236:     .sort((a, b) => narrativeScenePriority(a) - narrativeScenePriority(b))\r\n237:   return {\r\n238:     primary: fresh[0] ?? null,\r\n239:     deferred: uniqueScenes([...progress.deferred, ...fresh.slice(1)]),\r\n240:     queued: [...new Set([...progress.queued, ...fresh.map(narrativeSceneId)])],\r\n241:   }\r\n242: }\r\n243: \r\n244: export function chapterIdByTitle(title: string): string | undefined {\r\n245:   return CHAPTERS.find((chapter) => chapter.title === title)?.id\r\n246: }\r\n247: \r\n248: /** スキップした章・夢の本文要約。未知の場面へ別の物語を補わない。 */\r\n249: export function narrativeSceneSummary(scene: NarrativeScene): string | null {\r\n250:   if (scene.kind === 'dream') return INTRO_DREAM_SUMMARY\r\n251:   if (scene.kind === 'dreamEp') {\r\n252:     return DREAM_EPISODES.some((episode) => episode.id === scene.epId)\r\n253:       ? DREAM_EPISODE_SUMMARIES[scene.epId] ?? null\r\n254:       : null\r\n255:   }\r\n256:   if (scene.kind !== 'life') return null\r\n257:   const chapter = scene.narrativeId !== undefined\r\n258:     ? CHAPTERS.find((candidate) => candidate.id === scene.narrativeId)\r\n259:     : CHAPTERS.find((candidate) => candidate.title === scene.title)\r\n260:   return chapter ? CHAPTER_SUMMARIES[chapter.id] ?? null : null\r\n261: }\r\n262: \r\n263: export function generationQuestion(data: GameData): string {\r\n264:   const items = [\r\n265:     ...data.inventory,\r\n266:     ...data.family.flatMap((c) => Object.values(c.equipment).filter((x): x is NonNullable<typeof x> => !!x)),\r\n267:   ]\r\n268:   const inherited = items.some((item) => item.generation >= 2)\r\n269:   const completedLore = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n270:   const pacts = Object.values(data.godAffinity).filter((n) => n > 0).length\r\n271:   const bossDeeds = data.family.flatMap((c) => c.deeds).filter((x) => x.includes('討った')).length\r\n272:   if (inherited) return '受け継ぐことは、持ち主の役目まで背負うことか。'\r\n273:   if (completedLore >= 3) return '事情を知った刃は、知らぬ刃より優しいか。'\r\n274:   if (bossDeeds >= 2) return '終わらせることで救えるものは、本当にあるか。'\r\n275:   if (pacts >= 3) return '血を繋ぐことは、誰の願いなのか。'\r\n276:   return '短い命を誰かと分けるとき、何を次代へ残したいか。'\r\n277: }\r\n278: \r\n279: export function addResonance(\r\n280:   data: GameData,\r\n281:   kind: keyof NarrativeProgress['resonance'],\r\n282:   amount = 1,\r\n283: ): GameData {\r\n284:   const migrated = migrateM34Narrative(data)\r\n285:   const n = migrated.narrative!\r\n286:   return {\r\n287:     ...migrated,\r\n288:     narrative: {\r\n289:       ...n,\r\n290:       resonance: { ...n.resonance, [kind]: n.resonance[kind] + Math.max(0, amount) },\r\n291:     },\r\n292:   }\r\n293: }\r\n294: \r\n295: export function resonanceLine(data: GameData): string {\r\n296:   const r = migrateM34Narrative(data).narrative!.resonance\r\n297:   const max = Math.max(r.cut, r.save, r.inherit)\r\n298:   if (max <= 0) return 'この家は、答えを決めつけず、ここまで灯を運んできた。'\r\n299:   const leaders = (['cut', 'save', 'inherit'] as const).filter((key) => r[key] === max)\r\n300:   if (leaders.length !== 1) return 'この家は、終えることも、分けることも、継ぐことも重ねてきた。'\r\n301:   if (r.cut === max) return 'この家は、終われぬ主へ何度も幕を引いてきた。'\r\n302:   if (r.save === max) return 'この家は、傷ついた者を置いて行かない夜を重ねてきた。'\r\n303:   return 'この家は、名と道具と役目を、形を変えて渡してきた。'\r\n304: }\r\n305: \r\n306: export interface FamilyEcho {\r\n307:   label: string\r\n308:   text: string\r\n309: }\r\n310: \r\n311: // 表示用の文章と結末用の文型が、同じ元データを参照する。\r\n312: function familyFinaleContext(data: GameData) {\r\n313:   const firstDead = data.family\r\n314:     .filter((c) => !c.alive)\r\n315:     .sort((a, b) => (a.deathSeason ?? Number.MAX_SAFE_INTEGER) - (b.deathSeason ?? Number.MAX_SAFE_INTEGER))[0]\r\n316:   const ownership = new Map<string, { item: GameData['inventory'][number]; owner?: Character }>()\r\n317:   for (const item of data.inventory) ownership.set(item.id, { item })\r\n318:   for (const char of data.family) {\r\n319:     for (const item of Object.values(char.equipment)) if (item) ownership.set(item.id, { item, owner: char })\r\n320:   }\r\n321:   const oldestItem = [...ownership.values()].sort((a, b) => b.item.generation - a.item.generation)[0]\r\n322:   const heirloom = oldestItem && oldestItem.item.generation > 0 ? oldestItem : undefined\r\n323:   const completedLoreCount = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n324:   const nemesis = [...(data.nemeses ?? [])].sort((a, b) => b.level - a.level)[0]\r\n325:   const head = data.family.find((c) => c.alive && c.isHead) ?? data.family[0]\r\n326:   return { firstDead, heirloom, completedLoreCount, nemesis, head }\r\n327: }\r\n328: \r\n329: export function familyFinaleEchoes(data: GameData): FamilyEcho[] {\r\n330:   const out: FamilyEcho[] = []\r\n331:   const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n332:   if (firstDead) {\r\n333:     out.push({ label: '最初に見送った灯', text: `${firstDead.name}${firstDead.lastWords ? `「${firstDead.lastWords.slice(0, 24)}」` : ` — ${firstDead.epitaph}`}` })\r\n334:   }\r\n335:   if (heirloom) {\r\n336:     out.push({\r\n337:       label: '最も長く継いだ形見',\r\n338:       text: `${heirloom.item.name} — ${heirloom.item.legacyFirstOwner ? `${heirloom.item.legacyFirstOwner}から` : ''}${heirloom.item.generation}代${heirloom.owner ? `、${heirloom.owner.name}の手にある` : ''}`,\r\n339:     })\r\n340:   }\r\n341: \r\n342:   if (nemesis) out.push({ label: '因縁を結んだ名', text: `${nemesis.name} — ${nemesis.victim}の仇` })\r\n343:   else if (completedLoreCount > 0) out.push({ label: '真相まで読んだ土地', text: `${completedLoreCount}つの土地の縁起を、最後まで記した` })\r\n344: \r\n345:   if (out.length === 0) {\r\n346:     out.push({ label: 'ここへ運んだ灯', text: `${head?.name ?? '名もなき当主'}が、家の最初の答えを選ぶ` })\r\n347:   }\r\n348:   return out.slice(0, 3)\r\n349: }\r\n350: \r\n351: export function personalizedEndingBeat(data: GameData, ending: 'cut' | 'save' | 'inherit'): string {\r\n352:   const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n353:   const family = firstDead ? `${firstDead.name}から続く一族` : head ? `${head.name}の一族` : '名もなき一族'\r\n354:   const memories: string[] = []\r\n355:   if (heirloom) memories.push(`${heirloom.item.name}は${heirloom.item.generation}代、手を渡ってきた。`)\r\n356:   if (nemesis) memories.push(`${nemesis.name}と${nemesis.victim}の因縁も、家譜に残っている。`)\r\n357:   else if (completedLoreCount > 0) memories.push(`${completedLoreCount}つの土地の縁起を、最後まで家譜に記した。`)\r\n358:   if (ending === 'cut') memories.push(`${family}の名を読み上げ、二人を独りにしないまま、千年の夜を送った。`)\r\n359:   else if (ending === 'save') memories.push(`${family}が運んだ灯も封印へ重なった。今度の錠前は、誰か一人の犠牲ではない。`)\r\n360:   else memories.push(`${family}が継いだ名と役目は、頂と郷を往き来する新しい家譜になった。`)\r\n361:   return memories.join('')\r\n362: }\r\n363: \r\n364: export function regionQuestion(regionName: string, loreFragments: number, cleared: boolean): string {\r\n365:   if (cleared) return `${regionName}で終われた想いを、次の夜へどう渡す。`\r\n366:   if (loreFragments >= 3) return `事情を知った今、${regionName}の主へどんな終わりを渡す。`\r\n367:   if (loreFragments > 0) return `${regionName}に残る声は、何を守り続けている。`\r\n368:   return `${regionName}の闇で、終われずにいるのは誰だ。`\r\n369: }\r\n370: \r\n371: export function bossEmotion(regionName: string, loreFragments: number): string {\r\n372:   if (loreFragments >= 3) return `${regionName}の主は、忘れまいとして立ちはだかる。`\r\n373:   if (loreFragments > 0) return `${regionName}の主は、待ち焦がれるようにこちらを見る。`\r\n374:   return `${regionName}の主は、名もない願いを守り抜こうとしている。`\r\n375: }\r\n376: \r\n377: export interface ReturnTrace {\r\n378:   kind: 'human' | 'land' | 'myth'\r\n379:   text: string\r\n380: }\r\n381: \r\n382: export function returnTraces(data: GameData): ReturnTrace[] {\r\n383:   const last = data.narrative?.lastReturn\r\n384:   if (!last) return []\r\n385:   const region = REGIONS.find((candidate) => candidate.id === last.regionId)\r\n386:   const party = last.partyIds\r\n387:     .map((id) => data.family.find((character) => character.id === id)?.name)\r\n388:     .filter((name): name is string => !!name)\r\n389:   const injured = last.injuredIds\r\n390:     .map((id) => data.family.find((character) => character.id === id)?.name)\r\n391:     .filter((name): name is string => !!name)\r\n392:   return [\r\n393:     {\r\n394:       kind: 'human',\r\n395:       text: injured.length > 0\r\n396:         ? `${injured.join('、')}は傷を負ったが、全員で家へ戻った。`\r\n397:         : `${party.join('、') || '一族'}は灯を携え、家へ戻った。`,\r\n398:     },\r\n399:     { kind: 'land', text: `${region?.name ?? last.regionId}の土と夜の匂いが、装束に残っている。` },\r\n400:     {\r\n401:       kind: 'myth',\r\n402:       text: last.bossDown\r\n403:         ? '終われなかった主へ幕を渡した。その静けさが、家譜に一行増えた。'\r\n404:         : 'まだ終われない声を背にした。次に会う時、何を知っているだろう。',\r\n405:     },\r\n406:   ]\r\n407: }\r\n408: \r\n409: export function legacyShioriRecap(data: GameData): string | null {\r\n410:   return data.flags.legacy_shiori_recap_pending\r\n411:     ? '家譜の初代の名は、汐里。千年前に御山へ登った楽士である。'\r\n412:     : null\r\n413: }\r\n","exit_code":0,"status":"completed"}}
