Selector<HTMLButtonElement>('.action-cards button:not(:disabled)')?.focus({ preventScroll: true })\n103:    }, 0)\n104:    decisionAttentionTimer.current = window.setTimeout(() => setDecisionAttention(false), 1600)\n105:  }\n106:  useEffect(() => () => {\n107:    if (decisionAttentionTimer.current !== null) window.clearTimeout(decisionAttentionTimer.current)\n108:  }, [])\n109:  const crisis = !cen.hasHeir || cen.dying.length > 0\n110:  const crisisTitle = [\r\n111:    cen.alive.length <= 1 && !cen.hasHeir ? '後継なし' : '',\r\n112:    cen.dying.length > 0 ? `${cen.dying.map((c) => c.name).join('・')} 瀕死` : '',\n113:  ].filter(Boolean).join(' / ')\r\n114:  // 日参り — 郷に戻った初回(実日付が変わっていれば)綴が控えめに迎える。streakなし・煽らない。\r\n115:  // StrictModeの二重effectで2回目がnullを返しバナーを打ち消すのを、ref一度きりガードで防ぐ。\r\n116:  const visitCheckedRef = useRef(false)\n117:  const legacyCheckedRef = useRef(false)\n118:  const reminderCheckedRef = useRef(false)\n119:  const hasReturned = Boolean(data.narrative?.lastReturn)\n120:    || data.family.some((character) => character.expeditions > 0)\n121:    || data.regionsCleared.length > 0\n122:  useEffect(() => {\n123:    // 新しい家の第一声を報酬にしない。最初の帰還を果たした家だけ日参りを受け取る。\n124:    if (visitCheckedRef.current || !hasReturned) return\n125:    visitCheckedRef.current = true\n126:    setVisitGift(dailyVisit())\n127:  }, [dailyVisit, hasReturned])\n128:  useEffect(() => {\n129:    if (legacyCheckedRef.current) return\n130:    legacyCheckedRef.current = true\n131:    setLegacyRecap(consumeLegacyShioriRecap())\n132:  }, [consumeLegacyShioriRecap])\n133:  useEffect(() => {\n134:    if (reminderCheckedRef.current) return\n135:    reminderCheckedRef.current = true\n136:    setDeferredReminder(consumeDeferredReminder())\n137:  }, [consumeDeferredReminder])\n138:\n139:  const deferredStories = (data.narrative?.deferred ?? []).filter((scene) =>\r\n140:    (scene.kind !== 'ceremony' && scene.kind !== 'jobrite')\r\n141:    || data.family.some((c) => c.id === scene.charId && c.alive),\r\n142:  )\r\n143:  const archivedStories = data.narrative?.archive ?? []\n144:  const currentQuestion = data.narrative?.generationQuestion ?? generationQuestion(data)\n145:  const latestReturnTraces = returnTraces(data)\n146:\r\n147:  return (\r\n148:    <div className=\"screen home-screen\">\r\n149:      <NightBackdrop bg={gameImg(HOME_BG_SEASONS[Math.floor((data.seasonIndex % 12) / 3)] ?? HOME_BG)} />\r\n150:\r\n151:      <header className=\"home-header\">\r\n152:        <span className=\"season-label\">{seasonLabel(data.seasonIndex)}</span>\r\n153:        <div className=\"resource-strip\">\r\n154:          <span className=\"resource\"><Ico name=\"ic_hoto\" fb=\"燈\" size={18} /><span className=\"res-label\">奉燈</span><b>{data.hoto}</b></span>\r\n155:          <span className=\"resource\"><Ico name=\"ic_ketsu\" fb=\"珠\" size={18} /><span className=\"res-label\">血珠</span><b>{data.ketsu}</b></span>\r\n156:          <span className=\"resource\"><Ico name=\"ic_buko\" fb=\"功\" size={18} /><span className=\"res-label\">武功</span><b>{data.fame}</b></span>\r\n157:        </div>\r\n158:      </header>\r\n159:\r\n160:      {visitGift && (\n161:        <div className=\"daily-visit\">\r\n162:          <span className=\"daily-visit-mark\">参</span>\r\n163:          <span className=\"daily-visit-body\">\r\n164:            <b>綴</b>「{visitGift.text}」\r\n165:            <span className=\"daily-visit-reward\">\r\n166:              日参りの授かり — 奉燈 {visitGift.hoto}{visitGift.ketsu ? ` ・ 血珠 ${visitGift.ketsu}` : ''}\r\n167:            </span>\r\n168:          </span>\r\n169:          <button\r\n170:            type=\"button\"\r\n171:            className=\"daily-visit-close\"\r\n172:            onClick={() => setVisitGift(null)}\r\n173:            data-testid=\"nippari-close\"\r\n174:          >\r\n175:            閉じる\r\n176:          </button>\r\n177:        </div>\r\n178:      )}\n179:\n180:      {legacyRecap && (\n181:        <div className=\"daily-visit narrative-recap\" role=\"status\">\n182:          <span className=\"daily-visit-mark\">記</span>\n183:          <span className=\"daily-visit-body\"><b>家譜の補記</b><span className=\"daily-visit-reward\">{legacyRecap}</span></span>\n184:          <button type=\"button\" className=\"daily-visit-close\" onClick={() => setLegacyRecap(null)}>閉じる</button>\n185:        </div>\n186:      )}\n187:\n188:      {deferredReminder && (\n189:        <div className=\"daily-visit narrative-recap\" role=\"status\" data-testid=\"narrative-overdue-reminder\">\n190:          <span className=\"daily-visit-mark\">灯</span>\n191:          <span className=\"daily-visit-body\"><b>灯の余白</b><span className=\"daily-visit-reward\">「{sceneLabel(deferredReminder)}」は、急がずここから続きを読める。</span></span>\n192:          <button type=\"button\" className=\"daily-visit-close\" onClick={() => setDeferredReminder(null)}>閉じる</button>\n193:        </div>\n194:      )}\n195:\r\n196:      <StatusCallout\n197:        kind={crisis ? 'crisis' : 'info'}\n198:        title={crisis ? `今月の最優先 — ${crisisTitle}` : `今月の最優先 — ${ACTION_LABEL[priorityRec.action]}`}\n199:        action={<button type=\"button\" className=\"btn\" data-testid=\"decision-jump\" aria-controls=\"monthly-decisions\" onClick={jumpToDecisions}>決断を見る</button>}\n200:      >\n201:        {priorityRec.reason}　次月候補: {nextCandidate}\n202:      </StatusCallout>\n203:\n204:      <section className=\"narrative-now\" aria-labelledby=\"narrative-now-title\">\n205:        <div>\n206:          <span className=\"narrative-kicker\">今月の物語</span>\n207:          <h2 id=\"narrative-now-title\">{deferredStories.length > 0 ? sceneLabel(deferredStories[0]) : latestReturnTraces[0]?.text ?? '灯は、歩いた先で物語になる'}</h2>\n208:          <p>{deferredStories.length > 0 ? `${deferredStories.length}件を後で読める。` : currentQuestion}</p>\n209:        </div>\n210:        <button className=\"btn btn-ghost\" onClick={() => setShowStoryMargin(true)}>\n211:          灯の余白{deferredStories.length > 0 ? ` (${deferredStories.length})` : ''}\n212:        </button>\n213:      </section>\n214:\r\n215:      <div className=\"home-core-grid\">\n216:      <div ref={famRef} className=\"home-core-family\">\n217:        <Panel title=\"燈守家の一族\">\n218:          <FamilyBoard data={data} onTendLantern={tendLantern} />\n219:        </Panel>\n220:      </div>\n221:\n222:      <div\n223:        ref={actRef}\n224:        id=\"monthly-decisions\"\n225:        className={`home-core-actions ${decisionAttention ? 'is-jump-target' : ''}`}\n226:        aria-label=\"今月の決断\"\n227:      >\n228:      <Panel title=\"今月の決断 — 一つ選べば月が替わる\">\n229:        <p className=\"rec-reason\"><span className=\"rec-mark\">薦</span>綴の見立て — {priorityRec.reason}</p>\n230:        <div className=\"action-cards\">\n231:          <ActionCard\n232:            primary={priorityRec.action === 'depart'} rec={priorityRec.action === 'depart'}\n233:            iconName=\"ic_expedition\" iconFb=\"出\" title=\"出立 — 夜藪へ\"\r\n234:            desc=\"夜藪へ潜り、奉燈と血珠を得る。深いほど実り多い。\"\r\n235:            disabled={adults.length === 0}\r\n236:            note={adults.length === 0 ? '出立できる大人がいない' : undefined}\r\n237:            onClick={() => setScreen({ id: 'depart' })}\r\n238:          />\r\n239:          <ActionCard\r\n240:            rec={priorityRec.action === 'pact'}\n241:            iconName=\"ic_pact\" iconFb=\"契\" title=\"星契り — 次代を授かる\"\r\n242:            desc=\"星神と契り、翌月に子を授かる。血を絶やすな。\"\r\n243:            disabled={!canPact}\r\n244:            note={\r\n245:              adults.length === 0 ? '契れる大人がいない'\r\n246:                : data.hoto < cheapestPact ? `奉燈があと${cheapestPact - data.hoto}要る`\r\n247:                  : undefined\r\n248:            }\r\n249:            onClick={() => setScreen({ id: 'pact' })}\r\n250:          />\r\n251:          <ActionCard\r\n252:            rec={priorityRec.action === 'festival'}\n253:            iconName={`fes_${['haru', 'natsu', 'aki', 'fuyu'][Math.floor((data.seasonIndex % 12) / 3)]}`} iconFb=\"祭\" title=\"祭 — 郷を潤す\"\r\n254:            desc={isFestivalMonth(data.seasonIndex)\r\n255:              ? '奉燈30を捧げ、一族の傷と心労を癒す。星との縁も深まる。'\r\n256:              : '祭は季の変わり目(弥生・水無月・長月・師走)だけ開ける。'}\r\n257:            disabled={data.hoto < 30 || !isFestivalMonth(data.seasonIndex)}\r\n258:            note={\r\n259:              !isFestivalMonth(data.seasonIndex) ? '今は祭月でない'\r\n260:                : data.hoto < 30 ? '奉燈が足りない'\r\n261:                  : undefined\r\n262:            }\r\n263:            onClick={() => setConfirm('festival')}\r\n264:          />\r\n265:          <ActionCard\r\n266:            rec={priorityRec.action === 'rest'}\n267:            iconName=\"ic_rest\" iconFb=\"憩\" title=\"静養 — 傷を癒す\"\r\n268:            desc=\"隊の傷と心労を癒す。何もない月も、月は替わる。\"\r\n269:            onClick={() => setConfirm('rest')}\r\n270:          />\r\n271:        </div>\r\n272:        <p className=\"action-note\">月が替わるたび、一族は歳を取る。八季(廿四月)で灯は尽きる — 時を無駄にするな。</p>\r\n273:      </Panel>\n274:      </div>\n275:      </div>\n276:\r\n277:      {confirm && (\n278:        <MonthConfirmSheet kind={confirm} data={data} onClose={() => setConfirm(null)}\r\n279:          onDo={() => { const k = confirm; setConfirm(null); if (k === 'festival') doFestival(); else doRest() }} />\r\n280:      )}\n281:\n282:\n283:      {showStoryMargin && (\n284:        <Sheet title=\"灯の余白 — 物語の記録\" onClose={() => setShowStoryMargin(false)}>\n285:          <p className=\"story-question\"><span>今代の問い</span>{currentQuestion}</p>\n286:          {latestReturnTraces.length > 0 && (\n287:            <div className=\"return-traces\" aria-label=\"前回の帰還に残った三つの痕\">\n288:              {latestReturnTraces.map((trace) => <p key={trace.kind}><span>{trace.kind === 'human' ? '人' : trace.kind === 'land' ? '土地' : '千年'}</span>{trace.text}</p>)}\n289:            </div>\n290:          )}\n291:          {deferredStories.length === 0 ? (\n292:            <p style={{ color: 'var(--text-dim)' }}>未読の場面はない。読み終えた記は、下からいつでも読み返せる。</p>\n293:          ) : (\n294:            <div className=\"story-margin-list\">\n295:              {deferredStories.slice(0, 5).map((scene) => (\n296:                <button\n297:                  key={narrativeSceneId(scene)}\n298:                  className=\"btn story-margin-item\"\n299:                  onClick={() => { setShowStoryMargin(false); openDeferredScene(narrativeSceneId(scene)) }}\n300:                >\n301:                  <b>{sceneLabel(scene)}</b>\n302:                  <span>{sceneHint(scene)}</span>\n303:                </button>\n304:              ))}\n305:              {deferredStories.length > 5 && <p className=\"story-margin-more\">ほか {deferredStories.length - 5}件。読み終えると次の記が現れる。</p>}\n306:            </div>\n307:          )}\n308:          {archivedStories.length > 0 && (\n309:            <section className=\"story-archive\" aria-labelledby=\"story-archive-title\">\n310:              <h3 id=\"story-archive-title\">家譜に綴じた物語</h3>\n311:              <p>選択や進行を変えず、章と夢を読み返す。</p>\n312:              <div className=\"story-margin-list\">\n313:                {archivedStories.slice(0, showAllArchive ? archivedStories.length : 6).map((scene) => (\n314:                  <button\n315:                    key={`archive-${narrativeSceneId(scene)}`}\n316:                    className=\"btn story-margin-item\"\n317:                    onClick={() => { setShowStoryMargin(false); replayNarrativeScene(narrativeSceneId(scene)) }}\n318:                  >\n319:                    <b>{sceneLabel(scene)}</b>\n320:                    <span>家譜から読み返す</span>\n321:                  </button>\n322:                ))}\n323:              </div>\n324:              {archivedStories.length > 6 && (\n325:                <button type=\"button\" className=\"btn btn-ghost story-archive-more\" onClick={() => setShowAllArchive((shown) => !shown)}>\n326:                  {showAllArchive ? '最初の6件に戻す' : `残り${archivedStories.length - 6}件を表示`}\n327:                </button>\n328:              )}\n329:            </section>\n330:          )}\n331:        </Sheet>\n332:      )}\n333:\r\n334:      <div ref={ledRef}>\r\n335:        <Panel title=\"郷の帳\">\r\n336:          <HomeLedger\r\n337:            data={data}\r\n338:            onOpen={(key) => {\r\n339:              if (key === 'forge') setScreen({ id: 'forge' })\r\n340:              else if (key === 'facilities') setScreen({ id: 'facilities' })\r\n341:              else if (key === 'village') setScreen({ id: 'village' })\r\n342:              else if (key === 'familiars') setShowFamiliars(true)\r\n343:              else if (key === 'chronicle') setScreen({ id: 'chronicle' })\r\n344:              else if (key === 'codex') setScreen({ id: 'codex' })\r\n345:              else if (key === 'tree') setShowTree(true)\r\n346:              else if (key === 'gossip') { markGossipSeen(); setShowGossip(true) }\n347:              else if (key === 'objectives') setShowObjectives(true)\n348:              else if (key === 'succession') setShowSuccessionPlan(true)\n349:              else if (key === 'starLottery') setScreen({ id: 'starLottery' })\n350:              else if (key === 'motto') setShowMotto(true)\n351:              else if (key === 'help') setShowHelp(true)\r\n352:              else if (key === 'tower') {\r\n353:                const party = data.family.filter((c) => c.alive && isAdult(c, data.seasonIndex)).slice(0, 4)\r\n354:                if (party.length > 0) departDungeon('tokoyo_tou', party.map((c) => c.id))\r\n355:              }\r\n356:            }}\r\n357:          />\r\n358:        </Panel>\r\n359:      </div>\r\n360:\r\n361:      <nav className=\"home-anchors\" aria-label=\"ホーム内の節へ移動\">\r\n362:        <button className=\"btn btn-ghost\" onClick={() => window.scrollTo({ top: 0, behavior: 'smooth' })}>郷</button>\r\n363:        <button className=\"btn btn-ghost\" onClick={() => famRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' })}>一族</button>\r\n364:        <button className=\"btn btn-ghost\" onClick={() => actRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' })}>今月</button>\r\n365:        <button className=\"btn btn-ghost\" onClick={() => ledRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' })}>帳</button>\r\n366:      </nav>\r\n367:\r\n368:      {showMotto && <MottoModal onClose={() => setShowMotto(false)} />}\r\n369:      {showHelp && <HelpModal onClose={() => setShowHelp(false)} />}\r\n370:      {showTree && <FamilyTree onClose={() => setShowTree(false)} />}\r\n371:      {showGossip && <GossipModal onClose={() => setShowGossip(false)} />}\r\n372:      {showFamiliars && <FamiliarsModal onClose={() => setShowFamiliars(false)} />}\n373:      {showObjectives && <ObjectivesModal onClose={() => setShowObjectives(false)} />}\n374:      {showSuccessionPlan && (\n375:        <SuccessionPlanSheet\n376:          data={data}\n377:          onDesignate={designateHeir}\n378:          onSetVow={setGenerationVow}\n379:          onClose={() => setShowSuccessionPlan(false)}\n380:        />\n381:      )}\n382:    </div>\r\n383:  )\r\n384:}\r\n385:\r\n386:const ACTION_LABEL: Record<ActionKind, string> = { depart: '出立', pact: '星契り', festival: '祭', rest: '静養' }\r\n387:\r\n388:// 郷の行動カード — 図像・見出し・一言でわかりやすく。無効時は理由を添える。rec=綴の推奨(命火の縁+「薦」印)。\r\n389:function ActionCard({\r\n390:  iconName, iconFb, title, desc, note, disabled, primary, rec, onClick,\r\n391:}: {\r\n392:  iconName: string\r\n393:  iconFb: string\r\n394:  title: string\r\n395:  desc: string\r\n396:  note?: string\r\n397:  disabled?: boolean\r\n398:  primary?: boolean\r\n399:  rec?: boolean\r\n400:  onClick: () => void\r\n401:}) {\r\n402:  return (\r\n403:    <button\r\n404:      className={`action-card ${primary ? 'primary' : ''} ${rec ? 'rec' : ''}`}\r\n405:      disabled={disabled}\r\n406:      onClick={onClick}\r\n407:      title={note ?? ''}\r\n408:    >\r\n409:      {rec && <span className=\"rec-tag\">薦</span>}\r\n410:      <span className=\"action-card-icon\"><Ico name={iconName} fb={iconFb} size={32} /></span>\r\n411:      <span className=\"action-card-text\">\r\n412:        <span className=\"action-card-title\">{title}</span>\r\n413:        <span className={`action-card-desc ${disabled && note ? 'is-note' : ''}`}>{disabled && note ? note : desc}</span>\r\n414:      </span>\r\n415:    </button>\r\n416:  )\r\n417:}\r\n418:\r\n419:// ---- M18 P2: 一族欄の二面化 — 大札(選択人物)+小札+血脈診断 ----\r\n420:function FamilyBoard({ data, onTendLantern }: { data: GameData; onTendLantern: (charId: string) => void }) {\n421:  const [selId, setSelId] = useState<string | null>(null)\r\n422:  const c = census(data)\r\n423:  if (c.alive.length === 0) {\r\n424:    return <p>いま生きている者はいない。{c.pregnant > 0 ? '腹の子の誕生を待つ……' : '一族の灯は、ここで潰えた。'}</p>\r\n425:  }\r\n426:  const head = c.alive.find((x) => x.isHead) ?? c.alive[0]\r\n427:  const sel = c.alive.find((x) => x.id === selId) ?? head\n428:  const missingMp = sel.maxMp - sel.mp\n429:  const tendingAmount = Math.min(missingMp, Math.max(1, Math.ceil(sel.maxMp * LANTERN_TENDING_RATIO)))\n430:  const canTend = missingMp > 0 && data.hoto >= LANTERN_TENDING_COST\n431:  // 小札は詳細表示の選択後も同じDOMを残す。選択した札を配列から外すと、\n432:  // キーボードフォーカスが失われ「次の人物」へ続けて移れなくなるため。\n433:  const smalls = c.alive\n434:  return (\r\n435:    <div className=\"family-board\">\n436:      <div className=\"family-detail\">\n437:        <div className=\"family-folio-heading\"><span>当代の記</span><small>選んだ一人の資質と現在</small></div>\n438:        <CharCard char={sel} seasonIndex={data.seasonIndex} progressionMode=\"detail\" />\n439:        <div className=\"family-mp-care\" data-ready={canTend ? 'true' : 'false'}>\n440:          <div>\n441:            <span>月を送らない手当て</span>\n442:            <b>灯芯手入れ — {sel.name}の灯力を{tendingAmount > 0 ? `${tendingAmount}回復` : '満ちたまま保つ'}</b>\n443:            <small>奉燈{LANTERN_TENDING_COST}。静養せず、選択中の一人だけを整える。</small>\n444:          </div>\n445:          <button\n446:            type=\"button\"\n447:            className=\"btn family-mp-care-action\"\n448:            disabled={!canTend}\n449:            onClick={() => onTendLantern(sel.id)}\n450:          >\n451:            {missingMp <= 0 ? '灯力は満ちている' : data.hoto < LANTERN_TENDING_COST ? `奉燈があと${LANTERN_TENDING_COST - data.hoto}` : `手入れする −${LANTERN_TENDING_COST}`}\n452:          </button>\n453:        </div>\n454:      </div>\n455:      <div className=\"family-register\">\n456:        {smalls.length > 1 && (\n457:          <>\n458:          <div className=\"family-folio-heading\"><span>家譜札</span><small>札を選ぶと左の記が替わる</small></div>\n459:          <div className=\"family-smalls\" data-family-count={smalls.length}>\n460:            {smalls.map((ch) => (\n461:              <CharCard\n462:                key={ch.id}\n463:                char={ch}\n464:                seasonIndex={data.seasonIndex}\n465:                compact\n466:                progressionMode=\"summary\"\n467:                selected={sel.id === ch.id}\n468:                onClick={() => setSelId(ch.id)}\n469:              >\n470:                <span className=\"family-selected-status\" aria-hidden={sel.id !== ch.id}>\n471:                  <b>{ch.name}</b>\n472:                  <span>当代の記に表示中</span>\n473:                </span>\n474:              </CharCard>\n475:            ))}\n476:          </div>\n477:          </>\n478:        )}\n479:        <BloodlineDiagnosis data={data} />\n480:      </div>\n481:    </div>\n482:  )\r\n483:}\r\n484:\r\n485:// 血脈診断 — 1人でも空疎に見えない「状態を説明できる空白」(設計 §3.3/§4.2)\r\n486:function BloodlineDiagnosis({ data }: { data: GameData }) {\n487:  const c = census(data)\n488:  const lifeCrisis = c.minLife && c.minLife.months <= 3\r\n489:  return (\r\n490:    <div className=\"blood-diag\">\r\n491:      <div className=\"blood-diag-title\">血脈診断</div>\r\n492:      {/* 命脈 — 存命を灯る節、懐妊をまだ点らぬ節として一本の火の線で結ぶ(A案署名要素) */}\r\n493:      <div className=\"blood-diag-thread\" title={`存命${c.alive.length}・懐妊${c.pregnant}`}>\r\n494:        <LifeThread\r\n495:          nodes={[\r\n496:            ...c.alive.map(() => ({ lit: true })),\r\n497:            ...Array.from({ length: c.pregnant }, () => ({ lit: false })),\r\n498:          ]}\r\n499:          dim={c.alive.length === 0}\r\n500:        />\r\n501:      </div>\r\n502:      <div className=\"blood-diag-counts\">\r\n503:        存命<b>{c.alive.length}</b> ／ 成人<b>{c.adults.length}</b> ／ 幼子<b>{c.children.length}</b>\r\n504:        {c.pregnant > 0 && <> ／ 懐妊<b>{c.pregnant}</b></>}\r\n505:      </div>\r\n506:      <ul className=\"blood-diag-list\">\r\n507:        <li className={c.hasHeir ? '' : 'is-bad'}>後継 — {c.hasHeir ? 'あり' : 'なし'}</li>\r\n508:        {c.minLife && (\r\n509:          <li className={lifeCrisis ? 'is-bad' : ''}>\r\n510:            最短の灯 — {c.minLife.ch.name} あと{c.minLife.months}月\r\n511:          </li>\r\n512:        )}\r\n513:        {c.dying.length > 0 && (\r\n514:          <li className=\"is-bad\">瀕死 — {c.dying.map((x) => `${x.name}(${x.hp}/${x.maxHp})`).join('・')}</li>\r\n515:        )}\r\n516:        {c.mpDry.length > 0 && <li>技力枯渇 — {c.mpDry.map((x) => x.name).join('・')}</li>}\r\n517:        {c.adults.length === 0 && c.monthsToAdult !== null && (\r\n518:          <li>成人待ち — あと{c.monthsToAdult}月</li>\r\n519:        )}\r\n520:      </ul>\r\n521:      <div className=\"blood-diag-next\">\n522:        <span className=\"blood-diag-next-label\">次の一手</span>\n523:        <span>今月の決断に一つだけ示す</span>\n524:      </div>\n525:    </div>\r\n526:  )\r\n527:}\r\n528:\r\n529:// 郷の帳 — 名前+現在値+新着badgeの帳面(設計 §4.5)\r\n530:function HomeLedger({ data, onOpen }: { data: GameData; onOpen: (key: string) => void }) {\r\n531:  const now = new Date()\r\n532:  const odaiKey = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate()\r\n533:  const odaiClaimable = data.flags.odaiClaimedDay !== odaiKey && todaysOdai(odaiKey).check(data)\n534:  const { work, record, mind } = ledgerStats(data, odaiClaimable)\n535:  const living = data.family.filter((character) => character.alive)\n536:  const designated = living.find((character) => character.id === data.designatedHeirId)\n537:  const currentVow = data.generationVow ? GENERATION_VOWS[data.generationVow.id] : undefined\n538:  mind.unshift({\n539:    key: 'succession',\n540:    label: '次代の約束',\n541:    value: designated ? `後継 ${designated.name}` : currentVow?.name ?? 'まだ定めない',\n542:  })\n543:  if (isStarLotteryUnlocked(data)) {\n544:    const remaining = remainingStarLotteryDraws(data)\n545:    record.push({ key: 'starLottery', label: '星籤', value: remaining > 0 ? `引ける籤 ${remaining}` : `星札 ${data.starLottery?.cards.length ?? 0}`, badge: remaining })\n546:  }\n547:  if (data.flags.cleared) work.push({ key: 'tower', label: '常夜百層', value: `深さ${typeof data.flags.towerBest === 'number' ? data.flags.towerBest : 0}` })\n548:  const books: [string, typeof work][] = [['営み', work], ['記録', record], ['心得', mind]]\r\n549:  return (\r\n550:    <div className=\"ledger\">\r\n551:      {books.map(([name, entries]) => (\r\n552:        <div key={name} className=\"ledger-book\">\r\n553:          <div className=\"ledger-book-title\">{name}</div>\r\n554:          {entries.map((e) => (\r\n555:            <button key={e.key} className=\"btn ledger-entry\" onClick={() => onOpen(e.key)}>\r\n556:              <span className=\"ledger-label\">{e.label}</span>\r\n557:              <span className=\"ledger-value\">{e.value}<LiveBadge count={e.badge} /></span>\r\n558:            </button>\r\n559:          ))}\r\n560:        </div>\r\n561:      ))}\r\n562:    </div>\r\n563:  )\n564:}\n565:\n566:const VOW_IDS = Object.keys(GENERATION_VOWS) as GenerationVowId[]\n567:\n568:function SuccessionPlanSheet({ data, onDesignate, onSetVow, onClose }: {\n569:  data: GameData\n570:  onDesignate: (charId: string | null) => void\n571:  onSetVow: (vowId: GenerationVowId) => void\n572:  onClose: () => void\n573:}) {\n574:  const head = data.family.find((character) => character.alive && character.isHead)\n575:  const candidates = data.family.filter((character) => character.alive && !character.isHead)\n576:  const generationVow = data.generationVow\n577:  const selectedVow = generationVow && generationVow.madeById === head?.id ? generationVow.id : undefined\n578:  return (\n579:    <Sheet title=\"次代の約束\" onClose={onClose} closeLabel=\"郷へ戻る\">\n580:      <p className=\"confirm-lead\">戦力を増やす仕組みではない。誰へ灯を渡し、何を残すかを、生きているうちに定める。</p>\n581:      <section className=\"succession-plan-section\" aria-labelledby=\"heir-plan-title\">\n582:        <h3 id=\"heir-plan-title\">後継を指名する</h3>\n583:        {candidates.length > 0 ? (\n584:          <div className=\"succession-plan-options\">\n585:            <button type=\"button\" className={`btn ${!data.designatedHeirId ? 'selected' : ''}`} aria-pressed={!data.designatedHeirId} onClick={() => onDesignate(null)}>\n586:              定めない <small>その時の最年長へ</small>\n587:            </button>\n588:            {candidates.map((candidate) => (\n589:              <button\n590:                type=\"button\"\n591:                key={candidate.id}\n592:                className={`btn ${data.designatedHeirId === candidate.id ? 'selected' : ''}`}\n593:                aria-pressed={data.designatedHeirId === candidate.id}\n594:                onClick={() => onDesignate(candidate.id)}\n595:              >\n596:                {candidate.name} <small>第{candidate.gen}代・残り{seasonsLeft(candidate, data.seasonIndex)}月</small>\n597:              </button>\n598:            ))}\n599:          </div>\n600:        ) : <p className=\"confirm-list-empty\">いまは候補がいない。無指定でも家は止まらず、存命者が増えればここで選べる。</p>}\n601:      </section>\n602:      <section className=\"succession-plan-section\" aria-labelledby=\"vow-plan-title\">\n603:        <h3 id=\"vow-plan-title\">今代に残す約束</h3>\n604:        <div className=\"succession-plan-options\">\n605:          {VOW_IDS.map((id) => {\n606:            const vow = GENERATION_VOWS[id]\n607:            const selected = selectedVow === id\n608:            return (\n609:              <button type=\"button\" key={id} className={`btn succession-vow ${selected ? 'selected' : ''}`} aria-pressed={selected} onClick={() => onSetVow(id)}>\n610:                <strong>{vow.name}</strong><span>{vow.promise}</span>\n611:              </button>\n612:            )\n613:          })}\n614:        </div>\n615:      </section>\n616:      <p className=\"confirm-age\">指名も約束も月を消費せず、次の継承場面で先代の生涯の事実とともに返される。</p>\n617:    </Sheet>\n618:  )\n619:}\n620:\n621:// 月送り確認 — 祭/静養は効果と次月を見てから実行(設計 §4.4)\n622:function MonthConfirmSheet({ kind, data, onClose, onDo }: {\r\n623:  kind: 'festival' | 'rest'\r\n624:  data: GameData\r\n625:  onClose: () => void\r\n626:  onDo: () => void\r\n627:}) {\r\n628:  const alive = data.family.filter((c) => c.alive)\r\n629:  const notes = nextMonthNotes(data)\r\n630:  const healed = alive.filter((c) => c.hp < c.maxHp || c.mp < c.maxMp)\r\n631:  return (\r\n632:    <Sheet title={kind === 'festival' ? '祭を開く' : '静養する'} onClose={onClose} closeLabel=\"やめる\">\r\n633:      <p className=\"confirm-lead\">\r\n634:        {kind === 'festival'\r\n635:          ? '奉燈30を捧げて郷に祭を開き、月を一つ進める。一族の傷と心労が癒え、星との縁が深まる。'\r\n636:          : '家で傷と心労を癒し、月を一つ進める。'}\r\n637:      </p>\r\n638:      {healed.length > 0 ? (\r\n639:        <ul className=\"confirm-list\">\r\n640:          {healed.slice(0, 6).map((c) => (\r\n641:            <li key={c.id}>{c.name} — 体 {c.hp}/{c.maxHp} → {c.maxHp}/{c.maxHp}</li>\r\n642:          ))}\r\n643:          {healed.length > 6 && <li>ほか{healed.length - 6}名も癒える</li>}\r\n644:        </ul>\r\n645:      ) : (\r\n646:        <p className=\"confirm-list-empty\">いま傷んでいる者はいない。</p>\r\n647:      )}\r\n648:      <p className=\"confirm-age\">月が替わり、一族は皆ひと月ぶん歳を取る。</p>\r\n649:      {notes.length > 0 && (\r\n650:        <div className=\"confirm-notes\">\r\n651:          {notes.map((n, i) => <p key={i}>◆ {n}</p>)}\r\n652:        </div>\r\n653:      )}\r\n654:      <div className=\"confirm-actions\">\r\n655:        <button className=\"btn btn-ghost\" onClick={onClose}>やめる</button>\r\n656:        <button className=\"btn btn-main\" onClick={onDo}>\r\n657:          {kind === 'festival' ? '祭を開いて月を進める' : '静養して月を進める'}\r\n658:        </button>\r\n659:      </div>\r\n660:    </Sheet>\r\n661:  )\r\n662:}\r\n663:\r\n664:const HELP_TABS = [\r\n665:  {\r\n666:    key: 'basic', label: '基本',\r\n667:    items: [\r\n668:      ['命は八季。', '生まれて八つの季節で、一族は必ず灯が尽きる。名前の下の炎が残り寿命だ。'],\r\n669:      ['星契りを絶やすな。', '子は翌月に生まれ、六月(半年)で成人する。親の血潮と星神の血潮を継ぐ — 高い位の星ほど濃い血をくれる。'],\r\n670:      ['今月の行い。', '出立・星契り・祭のいずれか一つを選べば、月が一つ進む。行いを選ぶたび、誰かの寿命が削れてゆく。'],\r\n671:      ['敗北は終わりじゃない。', '主に敗れても、次の世代がいる。血を濃くして、装備を継いで、雪辱しろ。それが灯継ぎだ。'],\r\n672:    ],\r\n673:  },\r\n674:  {\r\n675:    key: 'grow', label: '育つ',\r\n676:    items: [\r\n677:      ['灯座(とうざ)。', '成人の儀で「灯型×星脈」から灯座が決まる。灯座は星から継いだ〈術〉で、その子の戦い方の芯になる。'],\r\n678:      ['家業(なりわい)。', '生業の儀で郷の家業を選ぶ。灯座が星の術なら、家業は郷で修める〈技〉。年季とともに八段の奥伝へ深まる。'],\r\n679:      ['形見は強くなる。', '死者の装備は「形見」として蔵に還り、代を継ぐごとに強まる。祖母の簪は、孫の代で名刀に劣らん。'],\r\n680:      ['普請(ふしん)。', '奉燈で郷の施設を建て、育てられる。産屋・鍛冶場・道場など、代を跨いで一族全体を底上げする。'],\r\n681:    ],\r\n682:  },\r\n683:  {\r\n684:    key: 'explore', label: '夜藪',\r\n685:    items: [\r\n686:      ['灯が命綱。', '夜藪では灯が尽きると魔性が狂暴化する。「帰り火」はいつでも焚ける — 欲と命を天秤にかけろ。灯が15%を切ると警告が出る。'],\r\n687:      ['継足(つぎたし)。', '戦いで家族が同じ敵を続けて狙うと、連撃の倍率が上がる。血の繋がりは技になる。'],\r\n688:      ['眷属(けんぞく)。', '倒した魔性が稀に懐き、随行する式神になる。属性ごとに固有の恩恵(月=夜目で敵影が見える等)を授ける。'],\r\n689:      ['加護(かご)。', '遠征中に「灯の加護」を授かることがある。その遠征の間だけ効く一時の力。最大三つまで。'],\r\n690:      ['石碑と土地の記。', 'ダンジョンの石碑(ミニマップでダイヤ印)で縁起の欠片を拾い、主を鎮めると、その地の物語が図鑑に綴られる。'],\r\n691:    ],\r\n692:  },\r\n693:  {\r\n694:    key: 'star', label: '星と記録',\r\n695:    items: [\r\n696:      ['交神(星契り)。', '星神と縁を重ねるほど、授かる子の血が濃くなり、契りの奉燈も安くなる。縁がMAXに至ると、神は第二の姿を見せる。'],\r\n697:      ['宿敵。', '一族の誰かを殺した魔性は「名」を得て成長し、再来する。仇を討てば、その骸から特別な実りを得る。'],\r\n698:      ['図鑑と記録。', '遭った魔性・契った星神・鎮めた地は図鑑に残る。家譜画面の「一族の記録」で総合収集率や討伐数を振り返れる。'],\r\n699:      ['NG+(継承周回)。', '物語を見届けたあと、血と記録を継いで新たな千年紀を始められる。'],\r\n700:    ],\r\n701:  },\r\n702:] as const\r\n703:\r\n704:function HelpModal({ onClose }: { onClose: () => void }) {\r\n705:  const [tab, setTab] = useState<string>('basic')\r\n706:  const active = HELP_TABS.find((t) => t.key === tab) ?? HELP_TABS[0]\r\n707:  return (\r\n708:    <Sheet title=\"綴の手引き — 千年ぶん、要点だけな\" onClose={onClose}>\r\n709:      <div className=\"god-filter-row\" style={{ marginBottom: 12 }}>\r\n710:        {HELP_TABS.map((t) => (\r\n711:          <button key={t.key} className={`btn btn-ghost filter-tab ${tab === t.key ? 'active' : ''}`} onClick={() => setTab(t.key)}>\r\n712:            {t.label}\r\n713:          </button>\r\n714:        ))}\r\n715:      </div>\r\n716:      <div style={{ fontSize: 14, lineHeight: 1.9, minHeight: 220 }}>\r\n717:        {active.items.map(([head, body], i) => (\r\n718:          <p key={i}><b style={{ color: 'var(--amber)' }}>{head}</b>{body}</p>\r\n719:        ))}\r\n720:      </div>\r\n721:    </Sheet>\r\n722:  )\r\n723:}\r\n724:\r\n725:// ---- 務め(目標階層) — 研究の density of goals / 短期・中期・長期の重ね合わせ ----\r\n726:// 全て現在の state から純粋導出(store非改変)。新規〜中盤の「次に何を目指すか」を常に明示する。\r\n727:type Obj = { text: string; go?: 'pact' | 'depart' | 'chronicle' | 'codex'; goLabel?: string; progress?: [number, number]; done?: boolean }\r\n728:function computeObjectives(data: ReturnType<typeof useGame.getState>['data'] & object, adultCount: number): { short: Obj[]; mid: Obj[]; long: Obj[] } {\r\n729:  const alive = data.family.filter((c) => c.alive)\r\n730:  const head = alive.find((c) => c.isHead)\r\n731:  const gens = data.family.length > 0 ? Math.max(...data.family.map((c) => c.gen)) : 0\r\n732:  const baseEnemies = ENEMIES.filter((e) => !/_[wo]$/.test(e.id))\r\n733:  const enemySeen = new Set((data.codex?.enemies ?? []).map((id) => id.replace(/_[wo]$/, ''))).size\r\n734:  const bossRegions = REGIONS.filter((r) => r.bossId && r.id !== 'tokoyo_tou')\r\n735:  const clearedSet = new Set(data.regionsCleared)\r\n736:\r\n737:  // 短期(今すぐ〜この代)\r\n738:  const short: Obj[] = []\r\n739:  if (head && seasonsLeft(head, data.seasonIndex) <= 3 && data.pendingBirths.length === 0) {\r\n740:    short.push({ text: `当主 ${head.name} の灯が細い。次代を残す`, go: 'pact', goLabel: '星契りへ' })\r\n741:  }\r\n742:  if (alive.length <= 2 && data.pendingBirths.length === 0 && adultCount > 0) {\r\n743:    short.push({ text: '血が細い。星と契り、子を授かる', go: 'pact', goLabel: '星契りへ' })\r\n744:  }\r\n745:  if (adultCount > 0) short.push({ text: '夜藪へ出立し、奉燈と血珠を持ち帰る', go: 'depart', goLabel: '出立へ' })\r\n746:  if (short.length === 0) short.push({ text: '子が育つのを待ち、次の一手を練る' })\r\n747:\r\n748:  // 中期(この周回)\r\n749:  const mid: Obj[] = []\r\n750:  const nextLocked = REGIONS.filter((r) => r.unlockFame > data.fame && r.id !== 'tokoyo_tou').sort((a, b) => a.unlockFame - b.unlockFame)[0]\r\n751:  if (nextLocked) mid.push({ text: `「${nextLocked.name}」への道を開く`, progress: [data.fame, nextLocked.unlockFame], go: 'depart', goLabel: '出立へ' })\r\n752:  const nextBoss = bossRegions.filter((r) => r.unlockFame <= data.fame && !clearedSet.has(r.id)).sort((a, b) => a.tier - b.tier)[0]\r\n753:  if (nextBoss) mid.push({ text: `「${nextBoss.name}」の主を鎮める`, go: 'depart', goLabel: '出立へ' })\r\n754:  mid.push({ text: '血を継ぎ、代を重ねる', progress: [gens, 10] })\r\n755:  mid.push({ text: '魔性を見聞し、図鑑を埋める', progress: [enemySeen, baseEnemies.length], go: 'codex', goLabel: '図鑑へ' })\r\n756:\r\n757:  // 長期(千年紀)\r\n758:  const long: Obj[] = []\r\n759:  long.push({ text: '玄冬を討ち、常夜に朝を還す', done: !!data.flags.cleared })\r\n760:  long.push({ text: '全ての地の主を鎮める', progress: [data.regionsCleared.filter((id) => bossRegions.some((r) => r.id === id)).length, bossRegions.length] })\r\n761:  if (data.flags.cleared) {\r\n762:    const tower = typeof data.flags.towerBest === 'number' ? data.flags.towerBest : 0\r\n763:    long.push({ text: '常夜百層を、深く制す', progress: [tower, 100] })\r\n764:  }\r\n765:  return { short, mid, long }\r\n766:}\r\n767:\r\n768:function ObjectivesModal({ onClose }: { onClose: () => void }) {\r\n769:  const data = useGame((s) => s.data)!\r\n770:  const setScreen = useGame((s) => s.setScreen)\r\n771:  const claimOdai = useGame((s) => s.claimOdai)\r\n772:  const [odaiDone, setOdaiDone] = useState(false)\r\n773:  const adults = data.family.filter((c) => c.alive && isAdult(c, data.seasonIndex)).length\r\n774:  const { short, mid, long } = computeObjectives(data, adults)\r\n775:\r\n776:  // 今日の御題 — 実日付でローテ。達成済みかつ本日未受領なら褒賞を受けられる(務めの一枠)。\r\n777:  const now = new Date()\r\n778:  const odaiKey = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate()\r\n779:  const odai = todaysOdai(odaiKey)\r\n780:  const odaiMet = odai.check(data)\r\n781:  const odaiClaimed = data.flags.odaiClaimedDay === odaiKey || odaiDone\r\n782:  const odaiReward = [odai.reward.hoto ? `奉燈${odai.reward.hoto}` : '', odai.reward.ketsu ? `血珠${odai.reward.ketsu}` : ''].filter(Boolean).join('・')\r\n783:  const tiers: [string, string, Obj[]][] = [\r\n784:    ['今', '今すぐの務め', short],\r\n785:    ['代', 'この代の務め', mid],\r\n786:    ['紀', '千年紀の務め', long],\r\n787:  ]\r\n788:  const go = (id: Obj['go']) => { if (id) { onClose(); setScreen({ id }) } }\r\n789:  return (\r\n790:    <Sheet title=\"務め — 一族の目標\" onClose={onClose}>\r\n791:        <p style={{ fontSize: 12, color: 'var(--text-dim)', marginBottom: 10 }}>\r\n792:          今すぐ・この代・千年紀 — 三つの時の尺で、進むべき道を映す。\r\n793:        </p>\r\n794:\r\n795:        <div className={`odai-card ${odaiMet ? 'met' : ''} ${odaiClaimed ? 'claimed' : ''}`}>\r\n796:          <div className=\"odai-head\"><span className=\"odai-mark\">題</span>今日の御題</div>\r\n797:          <div className=\"odai-text\">{odai.text}</div>\r\n798:          <div className=\"odai-foot\">\r\n799:            <span className=\"odai-state\">\r\n800:              {odaiClaimed ? '受領済み — また明日' : odaiMet ? `達成 — 褒賞 ${odaiReward}` : `未達 — ${odai.hint}`}\r\n801:            </span>\r\n802:            {odaiMet && !odaiClaimed && (\r\n803:              <button className=\"btn btn-main odai-claim\" onClick={() => { if (claimOdai()) setOdaiDone(true) }}>\r\n804:                褒賞を受ける\r\n805:              </button>\r\n806:            )}\r\n807:          </div>\r\n808:        </div>\r\n809:        {tiers.map(([icon, label, objs]) => (\r\n810:          <div key={label} className=\"obj-tier\">\r\n811:            <div className=\"obj-tier-head\">{icon} {label}</div>\r\n812:            {objs.map((o, i) => (\r\n813:              <div key={i} className={`obj-row ${o.done ? 'done' : ''}`}>\r\n814:                <span className=\"obj-mark\">{o.done ? '✔' : '◇'}</span>\r\n815:                <span className=\"obj-text\">{o.text}</span>\r\n816:                {o.progress && (\r\n817:                  <span className=\"obj-prog\">\r\n818:                    <span className=\"obj-bar\"><span className=\"obj-bar-fill\" style={{ width: `${Math.min(100, Math.round((o.progress[0] / Math.max(1, o.progress[1])) * 100))}%` }} /></span>\r\n819:                    {o.progress[0]}/{o.progress[1]}\r\n820:                  </span>\r\n821:                )}\r\n822:                {o.go && !o.done && <button className=\"btn btn-ghost obj-go\" onClick={() => go(o.go)}>→ {o.goLabel}</button>}\r\n823:              </div>\r\n824:            ))}\r\n825:          </div>\r\n826:        ))}\r\n827:    </Sheet>\r\n828:  )\r\n829:}\r\n830:\r\n831:// 家訓(v3.1 M12-8) — 当主が家風を定める。一族全体への小さな加護\r\n832:function MottoModal({ onClose }: { onClose: () => void }) {\r\n833:  const data = useGame((s) => s.data)!\r\n834:  const setMotto = useGame((s) => s.setMotto)\r\n835:  const head = data.family.find((c) => c.alive && c.isHead)\r\n836:  return (\r\n837:    <Sheet title={`家訓 — ${head?.name ?? '当主'}が掲げる家風`} onClose={onClose} closeLabel=\"やめる\">\r\n838:      <p style={{ fontSize: 13, color: 'var(--text-dim)', marginBottom: 10 }}>\r\n839:        家訓は一族の生き方を定め、静かな加護をもたらす。掲げ直すのも当主の器量。\r\n840:      </p>\r\n841:      {(Object.keys(MOTTOS) as MottoId[]).map((id) => (\r\n842:        <button\r\n843:          key={id}\r\n844:          className={`btn ${data.motto === id ? 'btn-main' : ''}`}\r\n845:          style={{ display: 'block', width: '100%', textAlign: 'left', marginBottom: 6 }}\r\n846:          onClick={() => {\r\n847:            setMotto(id)\r\n848:            onClose()\r\n849:          }}\r\n850:        >\r\n851:          <b>{MOTTOS[id].name}</b>\r\n852:          <span style={{ fontSize: 12, color: 'var(--text-dim)', marginLeft: 8 }}>{MOTTOS[id].desc}</span>\r\n853:        </button>\r\n854:      ))}\r\n855:    </Sheet>\r\n856:  )\r\n857:}\r\n858:\r\n859:// 郷の声(v3.1 M16-3) — 解禁済みの会話キューを読み返す。未解禁は「？？？」で伏せる\r\n860:function GossipModal({ onClose }: { onClose: () => void }) {\n861:  const data = useGame((s) => s.data)!\n862:  const unlocked = data.flags.reveal_shiori_name\n863:    ? (data.gossipIndex ?? 0)\n864:    : Math.min(data.gossipIndex ?? 0, 11)\n865:\r\n866:  return (\r\n867:    <Sheet title=\"郷の声 — 聞こえてきた話\" onClose={onClose}>\r\n868:      <p style={{ fontSize: 13, color: 'var(--text-dim)', marginBottom: 10 }}>\r\n869:        死や代替わり、夜藪からの帰還のたび、郷の誰かの一言がひとつずつ届く。\r\n870:      </p>\r\n871:      <div className=\"chronicle-scroll\">\r\n872:        {GOSSIP.map((g, i) => (\r\n873:          <div key={g.id} className=\"chron-entry\">\r\n874:            {i < unlocked ? (\r\n875:              <>\r\n876:                <b style={{ color: 'var(--amber)' }}>{g.speaker}</b>\r\n877:                <span className=\"chron-era\" style={{ fontWeight: 400, marginLeft: 6 }}>「{g.text}」</span>\r\n878:              </>\r\n879:            ) : (\r\n880:              <span style={{ color: 'var(--text-dim)' }}>？？？</span>\r\n881:            )}\r\n882:          </div>\r\n883:        ))}\r\n884:      </div>\r\n885:    </Sheet>\r\n886:  )\r\n887:}\r\n888:\r\n889:// 眷属(式神) v3.1 M16-5 — 討った魔性が稀に懐く。一体だけ随行させ、夜藪で共に働く\r\n890:function FamiliarsModal({ onClose }: { onClose: () => void }) {\r\n891:  const data = useGame((s) => s.data)!\r\n892:  const setActiveFamiliar = useGame((s) => s.setActiveFamiliar)\r\n893:  const familiars = data.familiars ?? []\r\n894:\r\n895:  return (\r\n896:    <Sheet title=\"眷属 — 懐いた魔性たち\" onClose={onClose}>\r\n897:        <p style={{ fontSize: 13, color: 'var(--text-dim)', marginBottom: 10 }}>\r\n898:          討った魔性は、ごく稀に懐いて眷属となる。一体だけを随行させられる — 夜藪で小さな助けになる。\r\n899:        </p>\r\n900:        {familiars.length === 0 ? (\r\n901:          <p style={{ fontSize: 13 }}>\r\n902:            まだ懐いた者はいない。夜藪で魔性を討ち続ければ、いつか気まぐれに懐くだろう。\r\n903:          </p>\r\n904:        ) : (\r\n905:          familiars.map((f) => {\r\n906:            const kind = FAMILIAR_KINDS[f.element as Element]\r\n907:            const active = data.activeFamiliar === f.enemyId\r\n908:            return (\r\n909:              <button\r\n910:                key={f.enemyId}\r\n911:                className={`btn ${active ? 'btn-main' : ''}`}\r\n912:                style={{ display: 'block', width: '100%', textAlign: 'left', marginBottom: 6 }}\r\n913:                onClick={() => setActiveFamiliar(f.enemyId)}\r\n914:              >\r\n915:                <b>{f.name}</b>\r\n916:                <span style={{ fontSize: 11, color: 'var(--text-dim)', marginLeft: 8 }}>\r\n917:                  {kind?.label ?? f.element}\r\n918:                </span>\r\n919:                {active && <span style={{ fontSize: 11, color: 'var(--amber)', marginLeft: 8 }}>随行中</span>}\r\n920:                <span style={{ display: 'block', fontSize: 12, color: 'var(--text-dim)' }}>\r\n921:                  {kind?.perk ?? ''}\r\n922:                </span>\r\n923:              </button>\r\n924:            )\r\n925:          })\r\n926:        )}\r\n927:    </Sheet>\r\n928:  )\r\n929:}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'rg -n \"''^|$\" '\"'src/ui/Scenes.tsx'\"","aggregated_output":"1:import { useCallback, useEffect, useRef, useState } from 'react'\n2:import type { MouseEvent as ReactMouseEvent } from 'react'\n3:import { useGame } from '../core/store'\n4:import { audio } from '../core/audio'\n5:\n6:// M26 §14.3: 場面送りの誤タップ防止。\n7:// - 250msデバウンス: 前の進行から250ms以内の入力を捨てる(誤連打・誤タップ)。\n8:// - 背景クリックのみ進行: 本文/選択/入力/CTA上のクリックは対象外(e.target===e.currentTargetで判定)。\n9:// - Space/Enterで進行、Escapeは進行に使わない。\n10:// 進行の順序・分岐ロジックは一切変えない — 入力の受理条件だけを安全化する。\n11:function useSceneAdvance(canAdvance: boolean, doAdvance: () => void) {\n12:  const lastRef = useRef(0)\n13:  const advance = useCallback(() => {\n14:    if (!canAdvance) return\n15:    const now = performance.now()\n16:    if (now - lastRef.current < 250) return\n17:    lastRef.current = now\n18:    audio.se('page')\n19:    doAdvance()\n20:  }, [canAdvance, doAdvance])\n21:  useEffect(() => {\n22:    const onKey = (e: KeyboardEvent) => {\n23:      if (e.key !== ' ' && e.key !== 'Enter') return // Escape等は進行に使わない(§14.3)\n24:      const el = e.target as HTMLElement | null\n25:      // 入力欄(辞世の言葉等)やbutton上のキーは奪わない — Space入力/ボタン既定動作を壊さない\n26:      if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'BUTTON' || el.isContentEditable)) return\n27:      if (!canAdvance) return\n28:      e.preventDefault()\n29:      advance()\n30:    }\n31:    window.addEventListener('keydown', onKey)\n32:    return () => window.removeEventListener('keydown', onKey)\n33:  }, [advance, canAdvance])\n34:  // 背景(bare screen)クリックのみ進行 — 子要素(本文/CTA/入力)は e.target !== currentTarget で除外\n35:  const onBgClick = (e: ReactMouseEvent) => { if (e.target === e.currentTarget) advance() }\n36:  return { advance, onBgClick }\n37:}\n38:import { STAT_LABELS, yearOfMonth } from '../core/types'\n39:import type { StatKey } from '../core/types'\n40:import { godById, MOURNING } from '../core/data/gods'\n41:import { personalityById } from '../core/data/personalities'\n42:import { TOMOSHIGATA, tozaOf } from '../core/data/toza'\n43:import type { Tomoshigata, JobClassId } from '../core/types'\n44:import { JOB_CLASSES, JOB_ROLE_LABELS, JOB_SCHOOL_LABELS, recommendJob, jobById } from '../core/data/jobs'\n45:import type { JobRole } from '../core/data/jobs'\n46:import { skillById } from '../core/data/skills'\n47:import { MALE_NAMES, FEMALE_NAMES } from '../core/data/names'\n48:import { ENDINGS, FINALE_CHOICES } from '../core/data/story'\n49:import { DREAM_EPISODES, dreamEpisodeById } from '../core/data/dreams'\n50:import type { DreamEpisode } from '../core/data/dreams'\n51:import { familyFinaleEchoes, generationQuestion, personalizedEndingBeat, resonanceLine } from '../core/narrative'\n52:import { clearSave } from '../core/save'\n53:import { downloadChronicleCard } from './shareCard'\n54:import { MaybeImg, SceneBg } from './components'\n55:import { dreamImg, gameImg, prefetchGameImg } from './img'\n56:import './m17_scenes.css'\n57:import './scenes_vc3b.css'\n58:\n59:type SceneSurface = 'life-thread' | 'dream-edge' | 'flame-crossroads'\n60:\n61:const SCENE_SURFACE_LABEL: Record<SceneSurface, string> = {\n62:  'life-thread': '命の綴り',\n63:  'dream-edge': '夢の縁',\n64:  'flame-crossroads': '灯の岐路',\n65:}\n66:\n67:function SceneSurfaceHeader({\n68:  surface,\n69:  route,\n70:  title,\n71:  context,\n72:  titleClassName = '',\n73:}: {\n74:  surface: SceneSurface\n75:  route: string\n76:  title: string\n77:  context: string\n78:  titleClassName?: string\n79:}) {\n80:  return (\n81:    <header className=\"vc3b-surface-header\" data-scene-group=\"identity\" data-zone=\"scene-hero\">\n82:      <div className=\"vc3b-surface-signature\" data-surface-mark={surface} aria-hidden=\"true\">\n83:        <i key=\"thread-a\" /><i key=\"thread-b\" /><i key=\"thread-c\" />\n84:      </div>\n85:      <p className=\"vc3b-surface-kicker\">{SCENE_SURFACE_LABEL[surface]}<span>{route}</span></p>\n86:      <h1 className={`scene-title ${titleClassName}`.trim()}>{title}</h1>\n87:      <p className=\"vc3b-surface-context\">{context}</p>\n88:    </header>\n89:  )\n90:}\n91:\n92:// 章タイトル→cg_ch{n}.png の対応(CHAPTERSのtitleは固定文字列 — data/story.tsのid順と一致)\n93:const CHAPTER_BG: Record<string, string> = {\n94:  '第一章 常夜': 'cg_ch1.png',\n95:  '第二章 主たちの無念': 'cg_ch2.png',\n96:  '第三章 星喰いの影': 'cg_ch3.png',\n97:  '第四章 楽士の秘密': 'cg_ch4.png',\n98:  '第五章 頂へ': 'cg_ch5.png',\n99:}\n100:\n101:// 同じ場面(タイトル+台詞)なら常に同じ life_daily_*.png を引く簡易ハッシュ\n102:function stableDailyIndex(title: string, lines: { speaker: string; text: string }[]): number {\n103:  const s = title + lines.map((l) => l.speaker + l.text).join('')\n104:  let sum = 0\n105:  for (let i = 0; i < s.length; i++) sum += s.charCodeAt(i)\n106:  return sum % 20\n107:}\n108:\n109:// statBias上位2ステータス(灯型/家業カードの選択材料)\n110:function topStatBias(bias: Partial<Record<StatKey, number>>): [StatKey, number][] {\n111:  return (Object.entries(bias) as [StatKey, number][])\n112:    .filter(([, v]) => v > 0)\n113:    .sort((a, b) => b[1] - a[1])\n114:    .slice(0, 2)\n115:}\n116:function StatBiasChips({ bias }: { bias: Partial<Record<StatKey, number>> }) {\n117:  const top = topStatBias(bias)\n118:  if (top.length === 0) return null\n119:  return (\n120:    <span className=\"card-bias\">\n121:      {top.map(([k, v]) => (\n122:        <span key={k} className=\"bias-chip\">{STAT_LABELS[k]}+{v}</span>\n123:      ))}\n124:    </span>\n125:  )\n126:}\n127:\n128:function RiteReturnControl({ onReturn }: { onReturn: () => void }) {\n129:  return (\n130:    <nav className=\"vc3b-rite-return\" data-zone=\"rite-return\" aria-label=\"儀を中断する\">\n131:      <button type=\"button\" className=\"btn btn-ghost\" onClick={onReturn}>← 郷へ戻る</button>\n132:      <span>未決定の儀は「灯の余白」に残り、後から再開できる</span>\n133:    </nav>\n134:  )\n135:}\n136:\n137:// 誕生の兆し — 神の属性ごとに、生まれた刹那の星のしるしを彩る(bornSeasonで選ぶ)。\n138:const BIRTH_OMENS: Record<string, string[]> = {\n139:  fire: [\n140:    '産声の刹那、郷の大燈籠がひときわ強く燃え上がったという。',\n141:    '囲炉裏の火が、招くように子のほうへ揺れた。熱を宿す血の子だ。',\n142:    '赤子の掌は、生まれながらに温かかった。灯を絶やさぬ者になろう。',\n143:  ],\n144:  water: [\n145:    '生まれた子の頬に、どこからか雫がひとつ落ちた。星の涙か、恵みか。',\n146:    '産湯はいらぬほど、その子は静かに濡れて生まれてきた。',\n147:    '遠くの涸れ沢に、その夜だけ水音が戻ったと、年寄りは言う。',\n148:  ],\n149:  wind: [\n150:    '夜藪を渡る風が、赤子の産声を遠くの峰まで運んでいった。',\n151:    '窓もないのに、産屋の灯がふわりと一度だけ揺れた。風の子の証。',\n152:    'その子が生まれた朝、郷に久方ぶりの涼風が吹いたという。',\n153:  ],\n154:  earth: [\n155:    '踏みしめた郷の土が、ほんの少し温もった。根を張る者が来た。',\n156:    '産声とともに、庭の枯れ石がひとつ、ことりと落ち着いた。',\n157:    'その子の生まれた年は、痩せた畑にも実がよく成ったと伝わる。',\n158:  ],\n159:  moon: [\n160:    '欠けた月が、雲間から一瞬だけ、その子を照らして去った。',\n161:    '常夜のはずの空に、うっすらと月の輪郭が滲んだ夜だった。',\n162:    '赤子は、闇のほうをじっと見て泣かなかった。夜目の子だ。',\n163:  ],\n164:  star: [\n165:    '空のどこかで、名もなき星がひとつ、静かに瞬いたという。',\n166:    '玄冬に喰われ残った星の光が、その子の額に一点、宿った気がした。',\n167:    '産声の瞬間、夜藪の露がいっせいに、星の色に光ったと語られる。',\n168:  ],\n169:}\n170:function birthOmen(element: string, bornSeason: number): string {\n171:  const bank = BIRTH_OMENS[element] ?? BIRTH_OMENS.star\n172:  return bank[Math.abs(bornSeason) % bank.length]\n173:}\n174:\n175:export function BirthScene({ charId }: { charId: string }) {\n176:  const data = useGame((s) => s.data)!\n177:  const processNextScene = useGame((s) => s.processNextScene)\n178:  const renameCharacter = useGame((s) => s.renameCharacter)\n179:  const char = data.family.find((c) => c.id === charId)\n180:  const [name, setName] = useState('')\n181:  const [candidates, setCandidates] = useState<string[]>([])\n182:  useEffect(() => {\n183:    audio.se('birth')\n184:  }, [])\n185:  // 命名候補(生まれた子の性別プールから、家中で未使用の名を3つ)\n186:  useEffect(() => {\n187:    if (!char) return\n188:    setName(char.name)\n189:    const pool = char.sex === 'm' ? MALE_NAMES : FEMALE_NAMES\n190:    const used = new Set(data.family.map((c) => c.name))\n191:    const free = pool.filter((n) => !used.has(n))\n192:    const picks: string[] = []\n193:    for (let i = 0; i < free.length && picks.length < 3; i++) {\n194:      // bornSeason は初代などで負になり得る。JS の負の剰余をそのまま配列添字へ\n195:      // 使うと undefined が候補へ混ざり、空の命名札と React key 警告を生む。\n196:      const index = ((i * 7 + char.bornSeason) % free.length + free.length) % free.length\n197:      const candidate = free[index]\n198:      if (candidate && !picks.includes(candidate)) picks.push(candidate)\n199:    }\n200:    setCandidates(picks)\n201:    // eslint-disable-next-line react-hooks/exhaustive-deps\n202:  }, [charId])\n203:  if (!char) return null\n204:  const god = godById(char.godParentId)\n205:  const parent = data.family.find((c) => c.id === char.humanParentId)\n206:  const p = personalityById(char.personalityId)\n207:\n208:  const confirm = () => {\n209:    if (name.trim() && name.trim() !== char.name) renameCharacter(char.id, name)\n210:    processNextScene()\n211:  }\n212:\n213:  return (\n214:    <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"birth\">\n215:      <SceneBg file=\"cg2_birth.png\" />\n216:      <SceneSurfaceHeader surface=\"life-thread\" route=\"名付け\" title=\"誕生\" context={`${char.name}の産声を、家譜の最初の一行へ。`} />\n217:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\n218:        <p>\n219:          {parent?.name}と{god.name}の子、生まれる。\n220:        </p>\n221:        <p className=\"birth-omen\">{birthOmen(char.element, char.bornSeason)}</p>\n222:        {/* 命名(v3.1 M16-2): 候補から選ぶか、自由に授ける */}\n223:        <div className=\"naming-box\">\n224:          <input\n225:            className=\"naming-input\"\n226:            value={name}\n227:            maxLength={8}\n228:            onChange={(e) => setName(e.target.value)}\n229:            aria-label=\"子の名\"\n230:          />\n231:          <div className=\"naming-candidates\">\n232:            {[char.name, ...candidates].filter((n, i, a) => a.indexOf(n) === i).slice(0, 4).map((n) => (\n233:              <button key={n} className={`btn btn-ghost naming-pick ${name === n ? 'active' : ''}`} onClick={() => setName(n)}>\n234:                {n}\n235:              </button>\n236:            ))}\n237:          </div>\n238:        </div>\n239:        <p style={{ color: 'var(--text-dim)' }}>\n240:          第{char.gen}代 — {p.label}な子。{p.desc}\n241:        </p>\n242:        <div className=\"stat-grid\" style={{ maxWidth: 360, margin: '14px auto' }}>\n243:          {(Object.keys(STAT_LABELS) as StatKey[]).map((k) => (\n244:            <span key={k} className=\"stat-cell\">\n245:              <em>{STAT_LABELS[k]}</em>\n246:              {char.potential[k]}\n247:            </span>\n248:          ))}\n249:        </div>\n250:        <p style={{ fontSize: 13, color: 'var(--text-dim)' }}>\n251:          与えられた命は八季(廿四月)。六月で成人し、隊に加われる。\n252:        </p>\n253:      </div>\n254:      <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={confirm} disabled={!name.trim()}>\n255:        名を家譜に記す\n256:      </button>\n257:    </div>\n258:  )\n259:}\n260:\n261:export function DeathScene({ charId }: { charId: string }) {\n262:  const data = useGame((s) => s.data)!\n263:  const processNextScene = useGame((s) => s.processNextScene)\n264:  const setLastWords = useGame((s) => s.setLastWords)\n265:  const char = data.family.find((c) => c.id === charId)\n266:  const [beat, setBeat] = useState(0) // 生涯の巻物を一行ずつ手繰る(M15-2)\n267:  const [words, setWords] = useState('')\n268:  useEffect(() => {\n269:    audio.se('death')\n270:  }, [])\n271:  // 生涯ダイジェスト(M15-2): この人の八季を、巻物のように振り返る\n272:  const digest = (() => {\n273:    if (!char) return []\n274:    const lines: string[] = []\n275:    const born = data.chronicle.find((e) => e.kind === 'birth' && e.charId === char.id)\n276:    if (born) lines.push(born.text)\n277:    if (char.expeditions > 0) lines.push(`夜藪への遠征、${char.expeditions}たび。`)\n278:    if (char.kills > 0) lines.push(`討った魔性、${char.kills}。`)\n279:    const children = data.family.filter((c) => c.humanParentId === char.id)\n280:    if (children.length > 0) lines.push(`残した子、${children.length}人 — ${children.map((c) => c.name).join('、')}。`)\n281:    for (const d of char.deeds.slice(0, 3)) lines.push(`${d}。`)\n282:    return lines\n283:  })()\n284:  const digestDone = beat >= digest.length\n285:  // フックは早期return前に無条件呼び出し(Rules of Hooks)\n286:  const { advance, onBgClick } = useSceneAdvance(!digestDone, () => setBeat((b) => b + 1))\n287:  if (!char) return null\n288:\n289:  const confirm = () => {\n290:    if (words.trim()) setLastWords(char.id, words)\n291:    processNextScene()\n292:  }\n293:\n294:  return (\n295:    <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"death\" onClick={onBgClick}>\n296:      <SceneBg file=\"cg2_mitori.png\" />\n297:      <SceneSurfaceHeader surface=\"life-thread\" route=\"看取り\" title=\"看取り\" context={`${char.name}が遺す灯を、次の頁へ。`} />\n298:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\n299:        <p>\n300:          {char.name}、第{char.gen}代。八つの季節を生き、灯が尽きた。\n301:        </p>\n302:        {digest.length > 0 && (\n303:          <div className=\"life-scroll\">\n304:            {digest.slice(0, Math.max(1, beat)).map((l, i) => (\n305:              <p key={i} className=\"life-scroll-line\">{l}</p>\n306:            ))}\n307:            {!digestDone && <ScenePager page={Math.min(beat + 1, digest.length)} total={digest.length} onNext={advance} />}\n308:          </div>\n309:        )}\n310:        {digestDone && (\n311:          <div className=\"naming-box\" onClick={(e) => e.stopPropagation()}>\n312:            <p style={{ fontSize: 12, color: 'var(--text-dim)', marginBottom: 4 }}>最期に、遺す言葉があれば(任意)</p>\n313:            <input\n314:              className=\"naming-input\"\n315:              style={{ fontSize: 16, letterSpacing: '0.1em' }}\n316:              value={words}\n317:              maxLength={40}\n318:              placeholder=\"……\"\n319:              onChange={(e) => setWords(e.target.value)}\n320:            />\n321:          </div>\n322:        )}\n323:        <div className=\"scene-epitaph\">「{char.epitaph}」</div>\n324:        {MOURNING[char.godParentId] && (\n325:          <div style={{ margin: '4px 0 16px', padding: '10px 14px', borderLeft: '3px solid var(--el-star)', textAlign: 'left' }}>\n326:            <p style={{ fontSize: 12, color: 'var(--text-dim)', marginBottom: 4 }}>\n327:              星より、文が届いている — {godById(char.godParentId).name}\n328:            </p>\n329:            <p style={{ fontSize: 14, color: 'var(--el-star)' }}>{MOURNING[char.godParentId]}</p>\n330:          </div>\n331:        )}\n332:        <p style={{ fontSize: 14, color: 'var(--text-dim)' }}>\n333:          綴「……よう生きた。あんたの八季、確かに書き留めたぞ」\n334:        </p>\n335:      </div>\n336:      {digestDone && (\n337:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={(e) => { e.stopPropagation(); confirm() }}>\n338:          灯を、継ぐ\n339:        </button>\n340:      )}\n341:    </div>\n342:  )\n343:}\n344:\n345:// ライフイベント — 家族の人生の一場面(初陣・絆・灯細りの夜・本編の章・日常)\n346:// bgが payload から来ていれば最優先(初陣=cg_hatsujin/灯細り=cg_hosori)。\n347:// 章語りは bg 無しで来るため title(固定文字列)から cg_ch{n}.png を引く。\n348:// それ以外(絆・日常)は bg 無しなので、場面文からの安定ハッシュで life_daily_* を割り当てる。\n349:export function LifeScene({ title, lines, bg, narrativeId }: { title: string; lines: { speaker: string; text: string }[]; bg?: string; narrativeId?: string }) {\n350:  const processNextScene = useGame((s) => s.processNextScene)\n351:  const skipCurrentScene = useGame((s) => s.skipCurrentScene)\n352:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\n353:  const revealShioriName = useGame((s) => s.revealShioriName)\n354:  const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\n355:  const [beat, setBeat] = useState(0)\n356:  const done = beat >= lines.length - 1\n357:  // SceneBg はファイル名(拡張子付き)を受け取り内部でgameImg()解決するため、\n358:  // dailyIndexは素のファイル名(life_daily_NN.png)として組み立てる(dailyImg()は使わない)。\n359:  const resolvedBg = bg ?? CHAPTER_BG[title] ?? `life_daily_${String(stableDailyIndex(title, lines)).padStart(2, '0')}.png`\n360:  const advanceBeat = useCallback(() => {\n361:    const next = Math.min(lines.length - 1, beat + 1)\n362:    if (narrativeId === 'ch4' && next === lines.length - 1) revealShioriName(false)\n363:    setBeat(next)\n364:  }, [beat, lines.length, narrativeId, revealShioriName])\n365:  const { advance, onBgClick } = useSceneAdvance(!done, advanceBeat)\n366:  return (\n367:    <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"life\" onClick={onBgClick}>\n368:      <SceneBg file={resolvedBg} />\n369:      <SceneSurfaceHeader surface=\"life-thread\" route={narrativeId ? '章語り' : '生涯'} title={title} context=\"この夜の一行を、家の記憶へ綴じる。\" />\n370:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\" style={{ textAlign: 'left' }}>\n371:        {lines.slice(0, beat + 1).map((l, i) => (\n372:          <p key={i} className={i === beat ? 'intro-current' : 'intro-past'}>\n373:            {l.speaker ? (\n374:              <>\n375:                <b style={{ color: 'var(--amber)' }}>{l.speaker}</b>\n376:                <span style={{ color: 'var(--text-dim)' }}> — </span>\n377:                {l.text}\n378:              </>\n379:            ) : (\n380:              <span style={{ color: 'var(--text-dim)' }}>{l.text}</span>\n381:            )}\n382:          </p>\n383:        ))}\n384:      </div>\n385:      {done ? (\n386:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\n387:          この夜を憶えておく\n388:        </button>\n389:      ) : (\n390:        <ScenePager page={beat + 1} total={lines.length} onNext={advance} />\n391:      )}\n392:      {narrativeId && !done && !replaying && (\n393:        <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />\n394:      )}\n395:    </div>\n396:  )\n397:}\n398:\n399:// 成人の儀 — 生後六月、灯型を授ける。血潮から推奨を示す\n400:export function CeremonyScene({ charId }: { charId: string }) {\n401:  const data = useGame((s) => s.data)!\n402:  const assignTomoshigata = useGame((s) => s.assignTomoshigata)\n403:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\n404:  const [chosen, setChosen] = useState<Tomoshigata | null>(null)\n405:  const char = data.family.find((c) => c.id === charId)\n406:  if (!char) return null\n407:  const p = personalityById(char.personalityId)\n408:\n409:  // 血潮による推奨灯型\n410:  const rec: Tomoshigata =\n411:    char.potential.mnd >= Math.max(char.potential.str, char.potential.vit, char.potential.agi)\n412:      ? 'sumi'\n413:      : char.potential.vit >= Math.max(char.potential.str, char.potential.agi)\n414:        ? 'iwao'\n415:        : char.potential.agi >= char.potential.str\n416:          ? 'nagi'\n417:          : 'homura'\n418:\n419:  if (chosen) {\n420:    const gataDef = TOMOSHIGATA.find((t) => t.id === chosen)!\n421:    const toza = tozaOf(chosen, char.element)\n422:    return (\n423:      <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"ceremony-result\">\n424:        <SceneBg file=\"cg2_seijin.png\" />\n425:        <RiteReturnControl onReturn={deferCurrentScene} />\n426:        <SceneSurfaceHeader surface=\"life-thread\" route=\"灯型\" title=\"成人の儀\" context={`${char.name}が選んだ灯を、身体へ結ぶ。`} />\n427:        <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\n428:          <p style={{ fontSize: 18, color: 'var(--amber)' }}>{gataDef.ritual}</p>\n429:          <p style={{ margin: '18px 0' }}>\n430:            {char.name}は灯を受け取り、静かに頷いた。\n431:          </p>\n432:          <p style={{ fontSize: 24, fontWeight: 700, letterSpacing: '0.2em' }}>\n433:            灯座「{toza.name}」— {toza.title}\n434:          </p>\n435:          <p style={{ fontSize: 13, color: 'var(--text-dim)', marginTop: 10 }}>\n436:            初伝「{toza.skills[0].name}」を習得。灯は月齢とともに深まり、やがて奥義に至る。\n437:          </p>\n438:        </div>\n439:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => assignTomoshigata(char.id, chosen)}>\n440:          家譜に記す\n441:        </button>\n442:      </div>\n443:    )\n444:  }\n445:\n446:  return (\n447:    <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"ceremony\">\n448:      <RiteReturnControl onReturn={deferCurrentScene} />\n449:      <SceneSurfaceHeader surface=\"life-thread\" route=\"灯型\" title=\"成人の儀\" context={`${char.name}の血潮に、ひとつの灯型を結ぶ。`} />\n450:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"context\">\n451:        <p>\n452:          {char.name}(第{char.gen}代・{p.label})、生後六月。大燈籠の前に立ち、灯型を授かる時が来た。\n453:        </p>\n454:        <p style={{ fontSize: 13, color: 'var(--text-dim)' }}>\n455:          灯型×星脈({char.element === 'fire' ? '火' : char.element === 'water' ? '水' : char.element === 'wind' ? '風' : char.element === 'earth' ? '土' : char.element === 'moon' ? '月' : '星'}\n456:          の脈)で、この子だけの灯座が決まる。\n457:        </p>\n458:      </div>\n459:      <div className=\"god-grid vc3b-choice-ledger\" data-scene-group=\"decision\" aria-label=\"灯型の候補\" style={{ maxWidth: 720, marginTop: 16 }}>\n460:        {TOMOSHIGATA.map((t) => {\n461:          const toza = tozaOf(t.id, char.element)\n462:          return (\n463:            <div\n464:              key={t.id}\n465:              className={`god-card ${t.id === rec ? 'recommended' : ''}`}\n466:              role=\"button\"\n467:              tabIndex={0}\n468:              aria-label={`灯型「${t.label}」を選ぶ${t.id === rec ? '(血潮の勧め)' : ''}`}\n469:              onClick={() => setChosen(t.id)}\n470:              onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setChosen(t.id) } }}\n471:            >\n472:              <MaybeImg src={gameImg(`emb_${t.id}_${char.element}.png`)} className=\"card-emblem\" />\n473:              <div className=\"god-name\">\n474:                {t.label}({t.kana}){t.id === rec ? ' ★血潮の勧め' : ''}\n475:              </div>\n476:              <div className=\"god-person\">→ 灯座「{toza.name}」{toza.title}</div>\n477:              <StatBiasChips bias={t.statBias} />\n478:              <div className=\"god-desc\">{t.desc}</div>\n479:            </div>\n480:          )\n481:        })}\n482:      </div>\n483:    </div>\n484:  )\n485:}\n486:\n487:// 生業の儀 — 生後十二月、郷の生業から家業を選ぶ(GDD_v3 §2)\n488:// 灯座=星から継いだ「術」、家業=郷で修める「技」。二段目の成人。\n489:export function JobRiteScene({ charId }: { charId: string }) {\n490:  const data = useGame((s) => s.data)!\n491:  const assignJobClass = useGame((s) => s.assignJobClass)\n492:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\n493:  const [chosen, setChosen] = useState<JobClassId | null>(null)\n494:  const char = data.family.find((c) => c.id === charId)\n495:  if (!char) return null\n496:\n497:  const rec = recommendJob(char.potential)\n498:  const roles: JobRole[] = ['atk', 'tank', 'swift', 'heal', 'hex', 'sup']\n499:\n500:  if (chosen) {\n501:    const job = jobById(chosen)\n502:    return (\n503:      <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"jobrite-result\">\n504:        <SceneBg file=\"cg2_nariwai.png\" />\n505:        <RiteReturnControl onReturn={deferCurrentScene} />\n506:        <SceneSurfaceHeader surface=\"life-thread\" route=\"家業\" title=\"生業の儀\" context={`${char.name}が選んだ技を、暮らしへ結ぶ。`} />\n507:        <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\n508:          <p style={{ fontSize: 18, color: 'var(--amber)' }}>{job.ritual}</p>\n509:          <p style={{ margin: '18px 0' }}>\n510:            {char.name}は道具を受け取り、深く頭を下げた。今日から{job.name}の見習いである。\n511:          </p>\n512:          <p style={{ fontSize: 24, fontWeight: 700, letterSpacing: '0.2em' }}>\n513:            家業「{job.name}」— {JOB_SCHOOL_LABELS[job.school]}の{JOB_ROLE_LABELS[job.role]}\n514:          </p>\n515:          <p style={{ fontSize: 13, color: 'var(--text-dim)', marginTop: 10 }}>\n516:            初伝「{skillById(job.skillIds[0]).name}」を習得。技は年季とともに深まり、八段の奥伝に至る。\n517:          </p>\n518:        </div>\n519:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => assignJobClass(char.id, chosen)}>\n520:          家譜に記す\n521:        </button>\n522:      </div>\n523:    )\n524:  }\n525:\n526:  return (\n527:    <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"jobrite\">\n528:      <RiteReturnControl onReturn={deferCurrentScene} />\n529:      <SceneSurfaceHeader surface=\"life-thread\" route=\"家業\" title=\"生業の儀\" context={`${char.name}の手に、郷で生きる技をひとつ。`} />\n530:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"context\">\n531:        <p>\n532:          {char.name}(第{char.gen}代)、生後十二月。郷の親方衆が居並ぶ前で、家業を選ぶ時が来た。\n533:        </p>\n534:        <p style={{ fontSize: 13, color: 'var(--text-dim)' }}>\n535:          灯座は星から継いだ術、家業は郷で修める技。夜藪の外にも、この子の生きる場所ができる。\n536:        </p>\n537:      </div>\n538:      <div className=\"vc3b-choice-ledger vc3b-job-ledger\" data-scene-group=\"decision\" aria-label=\"家業の候補\" style={{ maxWidth: 860, width: '100%', textAlign: 'left', maxHeight: '52vh', overflowY: 'auto', padding: '0 4px' }}>\n539:        {roles.map((role) => (\n540:          <div key={role} style={{ marginBottom: 10 }}>\n541:            <div style={{ fontSize: 13, color: 'var(--gold)', letterSpacing: '0.3em', margin: '8px 0 6px' }}>\n542:              {JOB_ROLE_LABELS[role]}の生業{role === rec ? ' ★血潮の勧め' : ''}\n543:            </div>\n544:            <div className=\"god-grid\">\n545:              {JOB_CLASSES.filter((j) => j.role === role).map((j) => (\n546:                <div\n547:                  key={j.id}\n548:                  className={`god-card ${role === rec ? 'recommended' : ''}`}\n549:                  role=\"button\"\n550:                  tabIndex={0}\n551:                  aria-label={`家業「${j.name}」を選ぶ${role === rec ? '(血潮の勧め)' : ''}`}\n552:                  onClick={() => setChosen(j.id)}\n553:                  onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setChosen(j.id) } }}\n554:                >\n555:                  <MaybeImg src={gameImg(`job_${j.id}.png`)} className=\"card-emblem\" />\n556:                  <div className=\"god-name\">\n557:                    {j.name}({j.kana}){role === rec ? ' ★' : ''}\n558:                  </div>\n559:                  <div className=\"god-person\">{JOB_SCHOOL_LABELS[j.school]} / {JOB_ROLE_LABELS[j.role]}</div>\n560:                  <StatBiasChips bias={j.statBias} />\n561:                  <div className=\"god-desc\">{j.desc}</div>\n562:                </div>\n563:              ))}\n564:            </div>\n565:          </div>\n566:        ))}\n567:      </div>\n568:    </div>\n569:  )\n570:}\n571:\n572:const DREAM_BEATS = [\n573:  '……唄が、聴こえる。',\n574:  '夢の中。見知らぬ山の頂に、楽士がひとり座っている。黒い月を背に、琵琶を抱いて。',\n575:  '「あら。夢を渡って来たのね。……血は争えないわ」',\n576:  '彼女の顔は、名の擦れた家譜の最初の頁に描かれた似姿と同じだった。家祖らしき、名のない楽士。',\n577:  '「名乗らなくていいの。あなたたちの名は、全部、風に聞いてる。産声も、辞世も、ぜんぶ」',\n578:  '「山頂で待ってるわ。……ああ、でも、急がないで」',\n579:  '「あなたたちの季節は短いのだから。道草も、お食べなさい。祭も、恋も、昼寝もね」',\n580:  '「それでいつか、ここへ届いたら——そのときは」',\n581:  '唄が途切れた。彼女は少しだけ笑って、囁いた。「……看取って、ちょうだいね」',\n582:  '目が覚める。頬に涙の痕。綴は何も聞かず、黙って墨を磨っていた。',\n583:]\n584:\n585:// M19 A4: 頁印+明示的「次へ」— 画面全体クリック進行は維持しつつ、確実な操作面を下部に置く。\n586:// stopPropagationで背景クリックと二重発火しない。選択UI表示後は各シーンのguard(!done)が背景進行を止める。\n587:function ScenePager({ page, total, onNext }: { page: number; total: number; onNext: () => void }) {\n588:  return (\n589:    <div className=\"scene-pager\" onClick={(e) => e.stopPropagation()}>\n590:      <span className=\"scene-page-mark\">頁 {page}／{total}</span>\n591:      <button className=\"btn scene-next vc3b-primary-action\" data-scene-primary=\"true\" onClick={onNext}>次へ ▸</button>\n592:    </div>\n593:  )\n594:}\n595:\n596:function SceneComfortControls({ onDefer, onSkip }: { onDefer: () => void; onSkip: () => void }) {\n597:  return (\n598:    <div className=\"scene-comfort-controls\" data-zone=\"scene-comfort-controls\">\n599:      <button className=\"btn btn-ghost\" onClick={(e) => { e.stopPropagation(); onDefer() }}>後で読む</button>\n600:      <button className=\"btn btn-ghost\" onClick={(e) => { e.stopPropagation(); onSkip() }}>要約して飛ばす</button>\n601:    </div>\n602:  )\n603:}\n604:\n605:function DreamVisual({ episode }: { episode: DreamEpisode }) {\n606:  const primarySrc = dreamImg(episode.bg)\n607:  const fallbackSrc = dreamImg()\n608:  const [src, setSrc] = useState(primarySrc)\n609:  const [unavailable, setUnavailable] = useState(false)\n610:  const description = episode.visualDescription ?? '夢の頂で、名のない楽士が琵琶を抱き、子孫へ千年前の記憶を語っている。'\n611:\n612:  useEffect(() => {\n613:    setSrc(primarySrc)\n614:    setUnavailable(false)\n615:  }, [primarySrc])\n616:\n617:  return (\n618:    <div className=\"dream-visual-block\">\n619:      <figure\n620:        className=\"dream-visual\"\n621:        data-zone=\"dream-visual\"\n622:        data-visual-id={episode.visualId ?? episode.id}\n623:      >\n624:        {!unavailable && (\n625:          <img\n626:            className=\"dream-visual-img\"\n627:            src={src}\n628:            alt={description}\n629:            loading=\"lazy\"\n630:            decoding=\"async\"\n631:            data-fallback={src === fallbackSrc ? 'true' : 'false'}\n632:            onError={() => {\n633:              if (src !== fallbackSrc) setSrc(fallbackSrc)\n634:              else setUnavailable(true)\n635:            }}\n636:          />\n637:        )}\n638:      </figure>\n639:      <p className=\"dream-visual-description\" aria-hidden=\"true\">\n640:        <span>夢に映る景色</span>{description}\n641:      </p>\n642:    </div>\n643:  )\n644:}\n645:\n646:export function DreamScene() {\n647:  const processNextScene = useGame((s) => s.processNextScene)\n648:  const skipCurrentScene = useGame((s) => s.skipCurrentScene)\n649:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\n650:  const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\n651:  const [beat, setBeat] = useState(0)\n652:  const done = beat >= DREAM_BEATS.length - 1\n653:  const { advance, onBgClick } = useSceneAdvance(!done, () => setBeat((b) => b + 1))\n654:  return (\n655:    <div className=\"scene-screen screen vc3b-scene vc3b-dream-scene\" data-scene-surface=\"dream-edge\" data-scene-route=\"dream\" onClick={onBgClick}>\n656:      <SceneBg file=\"cg_kiro.png\" />\n657:      <SceneSurfaceHeader surface=\"dream-edge\" route=\"夢渡り\" title=\"夢渡り\" context=\"名のない楽士の声が、家譜の外から届く。\" />\n658:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\n659:        {DREAM_BEATS.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\n660:          <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\n661:            {t}\n662:          </p>\n663:        ))}\n664:      </div>\n665:      {done ? (\n666:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\n667:          目を覚ます\n668:        </button>\n669:      ) : (\n670:        <ScenePager page={beat + 1} total={DREAM_BEATS.length} onNext={advance} />\n671:      )}\n672:      {!done && !replaying && <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />}\n673:    </div>\n674:  )\n675:}\n676:\n677:// 夢渡りの連作(data/dreams.ts) — 看取りの数だけ深く見る、千年前の記憶。\n678:// 横長CGは背景coverにせず前面の16:9全景として示し、台詞と操作を通常フローで分離する。\n679:export function DreamEpScene({ epId }: { epId: string }) {\n680:  const processNextScene = useGame((s) => s.processNextScene)\n681:  const skipCurrentScene = useGame((s) => s.skipCurrentScene)\n682:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\n683:  const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\n684:  const [beat, setBeat] = useState(0)\n685:  const [lastEp, setLastEp] = useState(epId)\n686:  if (epId !== lastEp) {\n687:    setLastEp(epId)\n688:    setBeat(0)\n689:  }\n690:  const ep = dreamEpisodeById(epId)\n691:  const epIndex = ep ? DREAM_EPISODES.indexOf(ep) : -1\n692:  const nextVisual = epIndex >= 0 ? DREAM_EPISODES[epIndex + 1]?.bg : undefined\n693:  const done = !ep || beat >= ep.beats.length - 1\n694:  const { advance, onBgClick } = useSceneAdvance(!done, () => setBeat((b) => b + 1))\n695:  useEffect(() => {\n696:    if (!ep) processNextScene()\n697:  }, [ep, processNextScene])\n698:  useEffect(() => {\n699:    if (!nextVisual) return\n700:    return prefetchGameImg(nextVisual)\n701:  }, [nextVisual])\n702:  if (!ep) {\n703:    // 未知のepId(将来のセーブ互換等) — 詰まらせず静かに次へ\n704:    return null\n705:  }\n706:  return (\n707:    <div className=\"scene-screen screen dream-episode-screen vc3b-scene vc3b-dream-scene\" data-scene-surface=\"dream-edge\" data-scene-route=\"dreamEp\" onClick={onBgClick}>\n708:      <div className=\"dream-episode-shell\">\n709:        <SceneSurfaceHeader surface=\"dream-edge\" route={`夢渡り ${epIndex + 2}`} title={ep.title} context=\"千年前の記憶を、今代の夢の縁で受け取る。\" titleClassName=\"dream-episode-title\" />\n710:        <DreamVisual episode={ep} />\n711:        <div className=\"scene-body dream-episode-body vc3b-scene-panel\" data-scene-group=\"decision\">\n712:          {ep.beats.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\n713:            <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\n714:              {t}\n715:            </p>\n716:          ))}\n717:        </div>\n718:        <div className=\"dream-episode-controls\" data-zone=\"dream-episode-controls\">\n719:          {done ? (\n720:            <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\n721:              目を覚ます\n722:            </button>\n723:          ) : (\n724:            <ScenePager page={beat + 1} total={ep.beats.length} onNext={advance} />\n725:          )}\n726:          {!done && !replaying && <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />}\n727:        </div>\n728:      </div>\n729:    </div>\n730:  )\n731:}\n732:\n733:// cut(送る=夜明け)の後日談。クライマックス(ENDINGS.cut.beats=看取り・面砕け)と重複させず、\n734:// その「あと」だけを描く — 夜が明け、太陽が昇り、八季で死なぬ子が生まれ、家譜が閉じられる。\n735:const ENDING_CLEARED = [\n736:  '夜が、明けてゆく。最初の朝日が大燈籠の天辺に触れ、郷中の灯が一斉に消えた——もう、要らないから。',\n737:  '細っていた大燈籠の火は、朝焼けの色に染まった。千年ぶりの太陽が、燈ノ郷に昇る。',\n738:  'その春、燈守家に子が生まれた。八季では死なない、初めての子が。',\n739:  '一族の家譜の、最後の頁に、こう記された。「我ら、夜を継ぎ、朝を残す」',\n740:  '汝の屍を越え、灯は継がれた。',\n741:  '— 完 —',\n742:]\n743:\n744:const ENDING_EXTINCT = [\n745:  '最後の灯が、消えた。',\n746:  '燈守家の血脈は、ここに絶えた。',\n747:  '大燈籠の火は細り、常夜が郷を呑んでいく。',\n748:  '……だが、家譜だけは残った。',\n749:  '綴「いつか誰かが、この記を読む。ならばこれは敗北ではない。……中断だ」',\n750:]\n751:\n752:// v3.2 M18: 結末別エピローグ。cut(送る=夜明け)は ENDING_CLEARED を流用。\n753:// save(救う)/inherit(継ぐ)は「夜は残る」帰結のため、太陽・夜明けを断言しない専用の結びを用意する。\n754:const ENDING_SAVE = [\n755:  '当主は家譜を開き、千年分の名を、汐里と二人で読み上げていく。',\n756:  '一つ、また一つ。産声と、辞世と。汐里は初めて、独りでなくその名を聴いた。',\n757:  '「……ぜんぶ、憶えてる。あなたたちのこと、ぜんぶ」汐里は泣いて、そして、笑った。',\n758:  '夜は、明けない。それでも大燈籠の火は、もう二度と消えぬだろう。支え合う錠前が、二つになったのだから。',\n759:  '汝の屍を越え、灯は継がれた。次は誰が、あの頂の隣に、座るのだろうか。',\n760:  '— 完 —',\n761:]\n762:\n763:const ENDING_INHERIT = [\n764:  '山を降りた汐里は、綴の隣で、家譜の続きを綴る側になった。今度は、頂に座る者を、憶えておくために。',\n765:  '綴は筆を渡しながら言った。「錠前は代わる。だが家譜は続く。名を書き継ぐ者がいる限り、頂の誰も、独りにはならん」',\n766:  '汐里はときおり、頂へ文を送る。産声を、祭を、恋を、昼寝を——山の下の、短くて眩しい日々を。',\n767:  '夜は、明けない。だが頂の座は、もう永遠の牢ではない。八季ごとに、次の灯が、交代しに登ってゆく。',\n768:  '汝の屍を越え、灯は継がれた。頂へ、頂へと。今度は、誰も独りにはさせずに。',\n769:  '— 完 —',\n770:]\n771:\n772:// 最終決戦後の選択(v3.1 M15-4) — 千年の結末を、一族が選ぶ\n773:export function FinaleScene() {\n774:  const data = useGame((s) => s.data)!\n775:  const resolveFinale = useGame((s) => s.resolveFinale)\n776:  const [pendingChoice, setPendingChoice] = useState<number | null>(null)\n777:  const memories = familyFinaleEchoes(data)\n778:  return (\n779:    <div className=\"scene-screen screen finale-screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"finale\">\n780:      <SceneBg file=\"cg_kiro.png\" />\n781:      <SceneSurfaceHeader surface=\"flame-crossroads\" route=\"千年の答え\" title=\"千年の岐路\" context=\"三つの灯は同格。一族が遺す答えだけを選ぶ。\" />\n782:      <section className=\"finale-memory\" data-scene-group=\"context\" aria-label=\"一族がここまで運んだもの\">\n783:        <div className=\"scene-body finale-intro\">\n784:          <p>汐里は楽を置き、静かにこちらを見ている。</p>\n785:          <p>「……ここから先は、生きている者が決めることよ」</p>\n786:        </div>\n787:        <p className=\"finale-question\">今代の問い<span>{data.narrative?.generationQuestion ?? generationQuestion(data)}</span></p>\n788:        <div className=\"finale-echoes\">\n789:          {memories.map((memory) => (\n790:            <p key={`${memory.label}:${memory.text}`}>\n791:              <span>{memory.label}</span>{memory.text}\n792:            </p>\n793:          ))}\n794:        </div>\n795:        <p className=\"finale-resonance\">{resonanceLine(data)}</p>\n796:      </section>\n797:      <p className=\"finale-prompt\">この選択が、一族の千年の答えになる。</p>\n798:      <div className=\"finale-choices\" data-zone=\"finale-choices\" data-scene-group=\"decision\">\n799:        {FINALE_CHOICES.map((c, i) => (\n800:          <button\n801:            key={c.id}\n802:            className={`btn finale-choice${pendingChoice === i ? ' selected' : ''}`}\n803:            aria-pressed={pendingChoice === i}\n804:            onClick={() => setPendingChoice(i)}\n805:          >\n806:            <b>{c.label}</b>\n807:            <span>{c.desc}</span>\n808:          </button>\n809:        ))}\n810:        {pendingChoice !== null && (\n811:          <div className=\"finale-confirm\" role=\"group\" aria-label={`${FINALE_CHOICES[pendingChoice].label}の確認`}>\n812:            <p>「{FINALE_CHOICES[pendingChoice].label}」を、一族の答えとして家譜に閉じますか。</p>\n813:            <div>\n814:              <button className=\"btn btn-ghost\" onClick={() => setPendingChoice(null)}>選び直す</button>\n815:              <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => resolveFinale(pendingChoice)}>\n816:                この答えを綴じる\n817:              </button>\n818:            </div>\n819:          </div>\n820:        )}\n821:      </div>\n822:    </div>\n823:  )\n824:}\n825:\n826:export function EndingScene() {\n827:  const data = useGame((s) => s.data)!\n828:  const setScreen = useGame((s) => s.setScreen)\n829:  const newLegacyGame = useGame((s) => s.newLegacyGame)\n830:  const completeEnding = useGame((s) => s.completeEnding)\n831:  const [beat, setBeat] = useState(0)\n832:  const cleared = !!data.flags.cleared && !data.flags.extinct\n833:  // v3.1 M15-4: 最終選択に応じた結末分岐(選択がなければ従来の夜明け)\n834:  const endType = (typeof data.flags.endingType === 'number'\n835:    ? (['cut', 'save', 'inherit'] as const)[data.flags.endingType]\n836:    : 'cut')\n837:  const climaxBeats = ENDINGS[endType].beats\n838:  // v3.2 M18: 結末別エピローグ。cut=夜明け(ENDING_CLEARED)、save/inherit=夜が残る帰結へ整合。\n839:  const epilogue = endType === 'save' ? ENDING_SAVE : endType === 'inherit' ? ENDING_INHERIT : ENDING_CLEARED\n840:  // M34: 山場の直後に、このsaveの固有名・形見・土地から導いた一文だけを差し込む。\n841:  const beats = cleared ? [...climaxBeats, personalizedEndingBeat(data, endType), ...epilogue] : ENDING_EXTINCT\n842:  const done = beat >= beats.length - 1\n843:  // 未読の結末は再開時に冒頭から戻る。最終頁を見た時だけ読了を即保存する。\n844:  useEffect(() => { if (done && cleared) completeEnding() }, [done, cleared, completeEnding])\n845:  // 山場(cut/save/inherit別)→_a、その後の共通エピローグ(ENDING_CLEARED)→_b。断絶(未clear)は画無し。\n846:  const endingBg = cleared ? (beat < climaxBeats.length ? `cg_end_${endType}_a.png` : `cg_end_${endType}_b.png`) : null\n847:\n848:  const gens = Math.max(...data.family.map((c) => c.gen))\n849:  const fallenCount = data.family.filter((c) => !c.alive).length\n850:  const years = yearOfMonth(data.seasonIndex)\n851:\n852:  return (\n853:    <div className=\"scene-screen screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"ending\" onClick={() => { if (!done) { audio.se('page'); setBeat(beat + 1) } }}>\n854:      {endingBg && <SceneBg file={endingBg} />}\n855:      <SceneSurfaceHeader surface=\"flame-crossroads\" route={cleared ? ENDINGS[endType].title : '断絶'} title={cleared ? '灯継ぎ' : '断絶'} context={cleared ? '選んだ灯の行方を見届け、次の家譜へ。' : '途切れた家譜にも、読まれる日を待つ頁が残る。'} />\n856:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"context\">\n857:        {beats.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\n858:          <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\n859:            {t}\n860:          </p>\n861:        ))}\n862:      </div>\n863:      {done && (\n864:        <div className=\"ending-actions\" data-scene-group=\"decision\">\n865:          <div className=\"ending-stats\">\n866:            紡がれた世代<b>{gens}</b>代 / 逝った者<b>{fallenCount}</b>人 / 費やした歳月<b>{years}</b>年\n867:          </div>\n868:          <button className=\"btn\" onClick={() => downloadChronicleCard(data)}>\n869:            この千年紀を一枚絵に残す(画像保存)\n870:          </button>\n871:          {data.flags.cleared && (\n872:            <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => newLegacyGame()}>\n873:              新たな千年紀へ — 継承新周回(形見と血の濃さを持ち越す)\n874:            </button>\n875:          )}\n876:          <button\n877:            className={`btn ${cleared ? 'btn-ghost' : 'btn-main vc3b-primary-action'}`}\n878:            data-scene-primary={cleared ? undefined : 'true'}\n879:            onClick={() => {\n880:              if (!data.flags.cleared) clearSave()\n881:              setScreen({ id: 'title' })\n882:            }}\n883:          >\n884:            題目へ戻る\n885:          </button>\n886:        </div>\n887:      )}\n888:      {!done && <ScenePager page={beat + 1} total={beats.length} onNext={() => { audio.se('page'); setBeat(beat + 1) }} />}\n889:    </div>\n890:  )\n891:}\n","exit_code":0,"status":"completed"}}
