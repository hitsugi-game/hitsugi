before={data.hoto} after={data.hoto - cost} />\r\n433:      <p className=\"confirm-lead\">\r\n434:        子は{seasonLabel(data.seasonIndex + 1)}に生まれる。{predictionSummary(prediction)}\r\n435:      </p>\r\n436:      <p className=\"confirm-lead\">この月の行いとして確定し、月が進む。</p>\r\n437:      <div className=\"confirm-actions\">\r\n438:        <button className=\"btn btn-ghost\" onClick={onClose}>やめる</button>\r\n439:        <button className=\"btn btn-main\" data-testid=\"pact-confirm\" onClick={onConfirm}>契る</button>\r\n20:import './chronicle_m18.css'\r\n21:\r\n22:// 一族の記録 — 既存のdataから純粋関数で集計(新規storeフィールド不要)\r\n23:function computeRecords(data: GameData) {\r\n24:  const fam = data.family\r\n25:  const gens = fam.length > 0 ? Math.max(...fam.map((c) => c.gen)) : 0\r\n26:  const alive = fam.filter((c) => c.alive).length\r\n27:  const fallenN = fam.length - alive\r\n28:  const kills = fam.reduce((s, c) => s + (c.kills ?? 0), 0)\r\n29:  const exped = fam.reduce((s, c) => s + (c.expeditions ?? 0), 0)\r\n30:  const years = Math.floor(data.seasonIndex / 12) + 1\r\n31:  const towerBest = typeof data.flags?.towerBest === 'number' ? data.flags.towerBest : 0\r\n32:  // 収集(Codexと同じ基準)\r\n33:  const seenEnemies = new Set((data.codex?.enemies ?? []).map((id) => id.replace(/_[wo]$/, '')))\r\n34:  const knownGods = new Set([...(data.codex?.gods ?? []), ...Object.entries(data.godAffinity).filter(([, v]) => v > 0).map(([k]) => k)])\r\n35:  const cleared = new Set(data.regionsCleared)\r\n36:  const frags = data.loreFrags ?? {}\r\n37:  const baseEnemies = ENEMIES.filter((e) => !/_[wo]$/.test(e.id))\r\n38:  const loreRegions = REGIONS.filter((r) => REGION_LORE[r.id])\r\n39:  const enemySeen = baseEnemies.filter((e) => seenEnemies.has(e.id)).length\r\n40:  const godSeen = GODS.filter((g) => knownGods.has(g.id)).length\r\n41:  const loreDone = loreRegions.filter((r) => cleared.has(r.id) && (frags[r.id] ?? 0) >= 3).length\r\n42:  const collTotal = baseEnemies.length + GODS.length + loreRegions.length\r\n43:  const collDone = enemySeen + godSeen + loreDone\r\n44:  // 四捨五入で未収集の項目が残るのに100%・全収集称号を出さない。\r\n45:  const collPct = collTotal > 0 ? Math.floor((collDone / collTotal) * 100) : 0\r\n46:  const itemSeen = collectionDiscoveredCount(data.collectionV2)\r\n47:  const itemSeriesStarted = ITEM_SERIES_MANIFEST.filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) > 0).length\r\n48:  const itemSeriesComplete = ITEM_SERIES_MANIFEST.filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) === 15).length\r\n49:  const itemAlmost = ITEM_SERIES_MANIFEST\r\n50:    .filter((series) => popcount15(data.collectionV2?.itemSeriesBits[series.seriesId] ?? 0) === 14)\r\n51:    .slice(0, 3)\r\n52:    .map((series) => series.name)\r\n53:  return {\r\n54:    gens, alive, fallenN, kills, exped, years, towerBest, fame: data.fame,\r\n55:    godsPacted: recordedPactGodIds(data).size, familiars: data.familiars?.length ?? 0,\r\n56:    regionsCleared: data.regionsCleared.length, regionsTotal: REGIONS.length,\r\n57:    enemySeen, enemyTotal: baseEnemies.length, godSeen, godTotal: GODS.length,\r\n58:    loreDone, loreTotal: loreRegions.length, collPct,\r\n59:    itemSeen, itemTotal: 810, itemSeriesStarted, itemSeriesComplete, itemAlmost,\r\n60:  }\r\n61:}\r\n62:\r\n63:// 称号 — 記録から純粋に導出(読み取り専用・コアループ非改変)。達成/未達を一覧表示。\r\n64:type RecordSummary = ReturnType<typeof computeRecords>\r\n65:const ACHIEVEMENTS: { name: string; hint: string; test: (r: RecordSummary) => boolean }[] = [\r\n66:  { name: '初めての看取り', hint: '一族の誰かを看取る', test: (r) => r.fallenN >= 1 },\r\n67:  { name: '五代の家', hint: '五代まで血を継ぐ', test: (r) => r.gens >= 5 },\r\n68:  { name: '十代の家', hint: '十代まで血を継ぐ', test: (r) => r.gens >= 10 },\r\n69:  { name: '長寿の一族', hint: '二十年を生き延びる', test: (r) => r.years >= 20 },\r\n70:  { name: '大家族', hint: '一族の総数が三十に至る', test: (r) => r.alive + r.fallenN >= 30 },\r\n71:  { name: '百の魔性を討つ', hint: '討伐数100', test: (r) => r.kills >= 100 },\r\n72:  // M19 B3: 図鑑コンプの節目称号 — 収集率に到達の褒美を与える\r\n73:  { name: '見聞の徒', hint: '魔性図鑑を半分(50%)まで埋める', test: (r) => r.enemyTotal > 0 && r.enemySeen / r.enemyTotal >= 0.5 },\r\n74:  { name: '夜藪の博士', hint: '魔性図鑑を全て(100%)埋める', test: (r) => r.enemyTotal > 0 && r.enemySeen >= r.enemyTotal },\r\n75:  { name: '星に親しむ家', hint: '星神の半分(50%)と契る', test: (r) => r.godTotal > 0 && r.godsPacted / r.godTotal >= 0.5 },\r\n76:  { name: '星霊の盟家', hint: '全ての星神(100%)と契る', test: (r) => r.godTotal > 0 && r.godsPacted >= r.godTotal },\r\n77:  { name: '千年の識者', hint: '総合収集率100%に至る', test: (r) => r.collPct >= 100 },\r\n78:  { name: '千の魔性を討つ', hint: '討伐数1000', test: (r) => r.kills >= 1000 },\r\n79:  { name: '千年の武', hint: '武功500', test: (r) => r.fame >= 500 },\r\n80:  { name: '眷属を率いる者', hint: '眷属を六体懐かせる', test: (r) => r.familiars >= 6 },\r\n81:  { name: '常夜百層・踏破', hint: '常夜百層を制す', test: (r) => r.towerBest >= 100 },\r\n82:  { name: '常夜を鎮む', hint: '全ての地の主を鎮める', test: (r) => r.regionsCleared >= r.regionsTotal && r.regionsTotal > 0 },\r\n83:  { name: '魔性図鑑・完', hint: '全ての魔性を見る', test: (r) => r.enemySeen >= r.enemyTotal && r.enemyTotal > 0 },\r\n84:  { name: '星神図鑑・完', hint: '全ての星神を識る', test: (r) => r.godSeen >= r.godTotal && r.godTotal > 0 },\r\n85:  { name: '土地の記・完', hint: '全ての土地の記を綴る', test: (r) => r.loreDone >= r.loreTotal && r.loreTotal > 0 },\r\n","exit_code":0,"status":"completed"}}
