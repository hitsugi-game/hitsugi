    id: 'gentou_zentei', name: '玄冬前庭', tier: 4, depth: 12, unlockFame: 490, bossId: 'boss_maeburenokage',\nsrc/core/data/regions.ts:187:    id: 'todome_no_kaidan', name: '止めの階段', tier: 4, depth: 12, unlockFame: 505, bossId: 'boss_todomenomono',\nsrc/core/data/regions.ts:192:    id: 'gentou_no_zenya', name: '玄冬の前夜', tier: 4, depth: 12, unlockFame: 515, bossId: 'boss_zenyanoutage',\nsrc/core/data/regions.ts:197:    id: 'akashi_miyama', name: '灯ノ御山', tier: 4, depth: 12, unlockFame: FAME_SEAL_THRESHOLD, bossId: 'boss_gentou',\nsrc/core/data/regions.ts:203:    id: 'tokoyo_tou', name: '常夜百層', tier: 4, depth: 100, unlockFame: 999999,\nsrc/core/store.ts:830:        regionsCleared: [],\r\nsrc/core/store.ts:1840:          fame: node.type === 'boss' && !!region.bossId ? 60 : undefined,\r\nsrc/core/store.ts:2135:        ? [region.bossId ?? 'kubinashi_andon'] // 地域の主(未設定地域は首無し行灯が主代わり)\r\nsrc/core/store.ts:2147:      const standInBoss = boss && !region.bossId\r\nsrc/core/store.ts:2169:            const line = bossMikiriLine(region.bossId)\r\nsrc/core/store.ts:2275:        if (region.bossId && !run.bossDown) {\r\nsrc/core/store.ts:2363:      const towerBonus = run.regionId === 'tokoyo_tou' ? (run.floor + 1) * 2 : 0\r\nsrc/core/store.ts:2390:      if (run.regionId === 'tokoyo_tou') {\r\nsrc/core/store.ts:2793:              regionsCleared: [...new Set([...d.regionsCleared, run.regionId])],\r\nsrc/core/store.ts:2868:              regionsCleared: [...new Set([...nd.regionsCleared, run.regionId])],\r\nsrc/core/store.ts:3069:            regionsCleared: [...new Set([...d.regionsCleared, region.id])],\r\nsrc/core/store.ts:3105:        if (node.type === 'boss' && region.bossId) {\r\nsrc/core/store.ts:3106:          const bossName = enemyById(region.bossId).name\r\nsrc/core/store.ts:3109:            regionsCleared: [...new Set([...nd.regionsCleared, region.id])],\r\n310:\r\n311:// 表示用の文章と結末用の文型が、同じ元データを参照する。\r\n312:function familyFinaleContext(data: GameData) {\r\n313:  const firstDead = data.family\r\n314:    .filter((c) => !c.alive)\r\n315:    .sort((a, b) => (a.deathSeason ?? Number.MAX_SAFE_INTEGER) - (b.deathSeason ?? Number.MAX_SAFE_INTEGER))[0]\r\n316:  const ownership = new Map<string, { item: GameData['inventory'][number]; owner?: Character }>()\r\n317:  for (const item of data.inventory) ownership.set(item.id, { item })\r\n318:  for (const char of data.family) {\r\n319:    for (const item of Object.values(char.equipment)) if (item) ownership.set(item.id, { item, owner: char })\r\n320:  }\r\n321:  const oldestItem = [...ownership.values()].sort((a, b) => b.item.generation - a.item.generation)[0]\r\n322:  const heirloom = oldestItem && oldestItem.item.generation > 0 ? oldestItem : undefined\r\n323:  const completedLoreCount = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n324:  const nemesis = [...(data.nemeses ?? [])].sort((a, b) => b.level - a.level)[0]\r\n325:  const head = data.family.find((c) => c.alive && c.isHead) ?? data.family[0]\r\n326:  return { firstDead, heirloom, completedLoreCount, nemesis, head }\r\n327:}\r\n328:\r\n329:export function familyFinaleEchoes(data: GameData): FamilyEcho[] {\r\n330:  const out: FamilyEcho[] = []\r\n331:  const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n332:  if (firstDead) {\r\n333:    out.push({ label: '最初に見送った灯', text: `${firstDead.name}${firstDead.lastWords ? `「${firstDead.lastWords.slice(0, 24)}」` : ` — ${firstDead.epitaph}`}` })\r\n334:  }\r\n335:  if (heirloom) {\r\n336:    out.push({\r\n337:      label: '最も長く継いだ形見',\r\n338:      text: `${heirloom.item.name} — ${heirloom.item.legacyFirstOwner ? `${heirloom.item.legacyFirstOwner}から` : ''}${heirloom.item.generation}代${heirloom.owner ? `、${heirloom.owner.name}の手にある` : ''}`,\r\n339:    })\r\n340:  }\r\n341:\r\n342:  if (nemesis) out.push({ label: '因縁を結んだ名', text: `${nemesis.name} — ${nemesis.victim}の仇` })\r\n343:  else if (completedLoreCount > 0) out.push({ label: '真相まで読んだ土地', text: `${completedLoreCount}つの土地の縁起を、最後まで記した` })\r\n344:\r\n345:  if (out.length === 0) {\r\n346:    out.push({ label: 'ここへ運んだ灯', text: `${head?.name ?? '名もなき当主'}が、家の最初の答えを選ぶ` })\r\n347:  }\r\n348:  return out.slice(0, 3)\r\n349:}\r\n350:\r\n351:export function personalizedEndingBeat(data: GameData, ending: 'cut' | 'save' | 'inherit'): string {\r\n352:  const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n353:  const family = firstDead ? `${firstDead.name}から続く一族` : head ? `${head.name}の一族` : '名もなき一族'\r\n354:  const memories: string[] = []\r\n355:  if (heirloom) memories.push(`${heirloom.item.name}は${heirloom.item.generation}代、手を渡ってきた。`)\r\n356:  if (nemesis) memories.push(`${nemesis.name}と${nemesis.victim}の因縁も、家譜に残っている。`)\r\n357:  else if (completedLoreCount > 0) memories.push(`${completedLoreCount}つの土地の縁起を、最後まで家譜に記した。`)\r\n358:  if (ending === 'cut') memories.push(`${family}の名を読み上げ、二人を独りにしないまま、千年の夜を送った。`)\r\n359:  else if (ending === 'save') memories.push(`${family}が運んだ灯も封印へ重なった。今度の錠前は、誰か一人の犠牲ではない。`)\r\n360:  else memories.push(`${family}が継いだ名と役目は、頂と郷を往き来する新しい家譜になった。`)\r\n361:  return memories.join('')\r\n362:}\r\n363:\r\n364:export function regionQuestion(regionName: string, loreFragments: number, cleared: boolean): string {\r\n365:  if (cleared) return `${regionName}で終われた想いを、次の夜へどう渡す。`\r\n366:  if (loreFragments >= 3) return `事情を知った今、${regionName}の主へどんな終わりを渡す。`\r\n367:  if (loreFragments > 0) return `${regionName}に残る声は、何を守り続けている。`\r\n368:  return `${regionName}の闇で、終われずにいるのは誰だ。`\r\n369:}\r\n370:\r\n371:export function bossEmotion(regionName: string, loreFragments: number): string {\r\n372:  if (loreFragments >= 3) return `${regionName}の主は、忘れまいとして立ちはだかる。`\r\n373:  if (loreFragments > 0) return `${regionName}の主は、待ち焦がれるようにこちらを見る。`\r\n374:  return `${regionName}の主は、名もない願いを守り抜こうとしている。`\r\n375:}\r\n376:\r\n377:export interface ReturnTrace {\r\n378:  kind: 'human' | 'land' | 'myth'\r\n379:  text: string\r\n380:}\r\n381:\r\n382:export function returnTraces(data: GameData): ReturnTrace[] {\r\n383:  const last = data.narrative?.lastReturn\r\n384:  if (!last) return []\r\n385:  const region = REGIONS.find((candidate) => candidate.id === last.regionId)\r\n386:  const party = last.partyIds\r\n387:    .map((id) => data.family.find((character) => character.id === id)?.name)\r\n388:    .filter((name): name is string => !!name)\r\n389:  const injured = last.injuredIds\r\n390:    .map((id) => data.family.find((character) => character.id === id)?.name)\r\n391:    .filter((name): name is string => !!name)\r\n392:  return [\r\n393:    {\r\n394:      kind: 'human',\r\n395:      text: injured.length > 0\r\n396:        ? `${injured.join('、')}は傷を負ったが、全員で家へ戻った。`\r\n397:        : `${party.join('、') || '一族'}は灯を携え、家へ戻った。`,\r\n398:    },\r\n399:    { kind: 'land', text: `${region?.name ?? last.regionId}の土と夜の匂いが、装束に残っている。` },\r\n400:    {\r\n401:      kind: 'myth',\r\n402:      text: last.bossDown\r\n403:        ? '終われなかった主へ幕を渡した。その静けさが、家譜に一行増えた。'\r\n404:        : 'まだ終われない声を背にした。次に会う時、何を知っているだろう。',\r\n405:    },\r\n406:  ]\r\n407:}\r\n408:\r\n409:export function legacyShioriRecap(data: GameData): string | null {\r\n410:  return data.flags.legacy_shiori_recap_pending\r\n411:    ? '家譜の初代の名は、汐里。千年前に御山へ登った楽士である。'\r\n412:    : null\r\n413:}\r\nsrc/core/data/gossip.ts:3:// 死・代替わり・討伐が進むたび、郷人/綴/汐里からの一言が一つずつ解禁される。\nsrc/core/data/gossip.ts:7:// unlock: gen(到達世代)/deaths(一族の死者数)/cleared(討伐した地域数)のいずれか一つでも\nsrc/core/data/gossip.ts:8:// 満たせば解禁(OR)。複数指定時もOR(「代が浅くても死が多ければ聞ける」を許すため)。\nsrc/core/data/gossip.ts:43:  // ---- 中盤: 郷人の愛惜が深まり、綴が汐里や玄冬の影をちらつかせ始める ----\nsrc/core/data/gossip.ts:46:    text: '大燈籠のお社には、誰の位牌もないんです。……不思議じゃありませんか? 千年、誰かを祀ってきたはずなのに。',\nsrc/core/data/gossip.ts:51:    text: '「儂は千年、家譜を書いてきた。……書くたびに思う。この命の短さは、罰なのか、務めなのか、とな」',\nsrc/core/data/gossip.ts:61:    text: '「玄冬。……常夜の名を、あんたらは覚えておいた方がいい。あれは千年前、太陽ごと空を喰った」',\nsrc/core/data/gossip.ts:74:  // ---- 中盤後半: 汐里という名が輪郭を持ち始める ----\nsrc/core/data/gossip.ts:82:    text: '「汐里——初代の名だ。口にすると、擦れた家譜の墨が戻るようだ」',\nsrc/core/data/gossip.ts:95:  // ---- 終盤: 汐里自身の、細い声 ----\nsrc/core/data/gossip.ts:97:    id: 'gsp_15', speaker: '汐里(夢のような声)',\nsrc/core/data/gossip.ts:98:    text: '……誰か、いるの。ねえ、誰か。千年、独りで数えてきた指が、もう何本目かも分からない。',\nsrc/core/data/gossip.ts:102:    id: 'gsp_16', speaker: '汐里(夢のような声)',\nsrc/core/data/gossip.ts:107:    id: 'gsp_17', speaker: '汐里(夢のような声)',\nsrc/core/data/gossip.ts:108:    text: '燈守の家……ああ、あなたたちは私の血だ。千年前、御山に登る前に置いてきた、小さな家族の。……大きくなったのね。何代分も。',\nsrc/core/data/gossip.ts:112:    id: 'gsp_18', speaker: '汐里(夢のような声)',\nsrc/core/data/lore.ts:5:// 【梯子の設計】ティアを登るほど、頂(玄冬・汐里)の気配が濃くなるよう配列している。\nsrc/core/data/lore.ts:9://   肆(御山)= 頂そのもの — 玄冬へ届けようとする衝動、汐里の楽。ここで千年の答えに会う。\nsrc/core/data/lore.ts:35:      '森は千年、主を持たぬまま常夜を耐えてきた。誰にも縋らず、ただ在り続けた。',\nsrc/core/data/lore.ts:48:      '「千年、晴れを待つ者がいる。辻が湿るのは、その人の袖が乾かぬせいだ」',\nsrc/core/data/lore.ts:56:      '濡れ女は、常夜が来る前、この辻で人を待っていた。「晴れたら帰る」と言い残した、あの人を。',\nsrc/core/data/lore.ts:57:      '常夜に、晴れはない。だから彼女は、千年、濡れたまま待ち続けている。乾くことは、諦めることだから。',\nsrc/core/data/lore.ts:78:      '烏丸太夫は、かつて里の舞手だった。常夜が来た夜、里の者を逃がすため、自ら囮となって残った。',\nsrc/core/data/lore.ts:79:      '千年舞ううちに、守るべき里はとうに消えた。それでも太夫は、誰もいない里の空を、舞い続けている。',\nsrc/core/data/lore.ts:82:      '黒羽根が最後にひとひら、静かに地へ落ちた。誰も見ぬ里で千年舞い続けた囮の舞に、ようやく、幕が下りた。',\nsrc/core/data/lore.ts:100:      '灯篭守は千年前、この道を旅人のために整えた、小さな社の下男だった。社は失われ、彼だけが残った。',\nsrc/core/data/lore.ts:104:      '灯篭の火が、初めて自分の意思で、静かに消えた。千年抱えてきた火を、明けぬ夜がそっと、両手で受け取ってくれたのだ。',\nsrc/core/data/lore.ts:122:      '苔ノ主は、道しるべとして里に恵みを与え続けた古木の精だった。常夜の重みに幹が裂け、そこへ苔と羽虫が入り込んだ。',\nsrc/core/data/lore.ts:135:      '「あの田の持ち主は、稲を刈り終えた晩に常夜を迎えたという」',\nsrc/core/data/lore.ts:144:      '案山子武者は、田の持ち主が最後に立てた案山子だった。「刈り終えるまで田を頼む」その一言を受けて、常夜が来た。',\nsrc/core/data/lore.ts:145:      '刈り終えた田は、もう誰のものでもない。それでも武者は、頼まれごとを果たすため、藁の身のまま千年、立ち続けている。',\nsrc/core/data/lore.ts:166:      '傘婆は千年前、この山道の茶屋で雨宿りの客を待ち続けた女将だった。常夜が来て客足は絶え、婆は独り取り残された。',\nsrc/core/data/lore.ts:179:      '「嚢主は常夜の初めの嵐の晩、幼い蓑虫たちを己の蓑の内に包んで庇ったという」',\nsrc/core/data/lore.ts:188:      '蓑虫嚢主は、常夜の初めの嵐から、幼い蓑虫たちを己の内に包んで守った一匹だった。嵐は、千年、止まなかった。',\nsrc/core/data/lore.ts:192:      '大きな蓑が、ふわりとほどけた。中から、小さな羽虫の群れが、無事に、静かに舞い上がった。守れていたのだ。千年、ずっと。',\nsrc/core/data/lore.ts:193:      '嚢主の蓑は軽くなって崩れ落ちた。もう、抱え込むものはない。ただ、千年ぶりの安堵だけが、羽音となって廻廊を満たした。',\nsrc/core/data/lore.ts:203:      '「常夜の晩、迷い子は多すぎた。姫は数え終える前に、常夜そのものに、数えられてしまった」',\nsrc/core/data/lore.ts:211:      '蛍火姫は、迷い子を家へ帰すため、窪地で灯の数を数え続けた巫女だった。常夜の晩、迷い子はかつてなく多かった。',\nsrc/core/data/lore.ts:212:      '姫は数え切れなかった。以来千年、己の灯した蛍を迷い子の身代わりに数え続けている。今度こそ、一人も取りこぼさぬために。',\nsrc/core/data/lore.ts:233:      '地蔵追いは、旅人の無事を祈って地蔵を彫り続けた石工だった。常夜が来ても、彫る手を止められなかった。',\nsrc/core/data/lore.ts:258:      '常夜が来て祭りが絶え、行き場を失った百の灯は寄り集まり、百の目で坂を見張り続けている。誰も来ぬ祭りを、待って。',\nsrc/core/data/lore.ts:271:      '「対岸は、千年前に沈んだ。舟幽鬼だけが、それを知らずに漕ぎ続けている」',\nsrc/core/data/lore.ts:279:      '朧舟幽鬼は、常夜の来る前からこの川で人を渡し続けた舟守だった。対岸の郷は千年前、常夜に沈んで消えた。',\nsrc/core/data/lore.ts:280:      '幽鬼は、それを知らない。今も客を乗せては、もうどこにもない対岸へと櫂を入れる。決して着かぬ舟の、千年の航海だ。',\nsrc/core/data/lore.ts:302:      '常夜が来て、多くの文は届かぬまま、書き手ごと失われた。硯は届かなかった想いを墨として抱え、今も坂に居座っている。',\nsrc/core/data/lore.ts:323:      '塗壁親方は千年前、郷の家々を守るため頑丈な壁を塗り続けた左官だった。常夜が来ても、彼は仕事を辞めなかった。',\nsrc/core/data/lore.ts:328:      '幾重もの壁の消えた小路の先に、朽ちた家々の輪郭が覗いた。親方が千年、守ろうとし続けた——もう、誰もいない家々だ。',\nsrc/core/data/lore.ts:340:      '千年前に涸れたはずの沼。畔に立つと、今も地中で、水の音がする。',\nsrc/core/data/lore.ts:343:    stir: ['ひび割れの奥から、饐えた水の匂いが這い出てくる。沼はまだ、死に切ってはいない。'],\nsrc/core/data/lore.ts:345:      '沼主蛭姫は、この沼を治めていた女王だった。常夜の乾きが沼を涸らし、多くの生き物が、沼を去った。',\nsrc/core/data/lore.ts:368:      '一本では声にもならぬ想いが、千年かけて溶け合い、ひとつの渇きとなった。鬼は今、灯されることを、狂おしく求めている。',\nsrc/core/data/lore.ts:380:      '「淵は昔、旅立つ前の若者が身支度に覗く鏡だったという。皆、笑って発ち、常夜の外の夜明けを目指した」',\nsrc/core/data/lore.ts:390:      '発った者は、死んだのではない。ただ、二度と戻らなかった。淵は千年、覗くすべての顔を映し取り、あの日別れた顔が帰ってきはしないかと、待ち続けている。',\nsrc/core/data/lore.ts:414:      '幽霊殿は、この御殿でもてなしを生業とした主だった。客を迎えることに誇りを持ち、常夜の夜にも、灯りを絶やさなかった。',\nsrc/core/data/lore.ts:415:      '常夜が深まり、訪れる客はいなくなった。それでも障子の奥では、今も膳が整えられ、香が焚かれている。いつか来る、たった一人の客のために。',\nsrc/core/data/lore.ts:421:    bossPrelude: ['障子が、すっと開いた。「ようこそ、お越しくださいました。……どうぞ、ごゆるりと」', '丁寧な声の底に、千年分の渇きが、滲んでいた。'],\nsrc/core/data/lore.ts:438:      '封じるべきものは、千年前に消えている。それでも縄は、役目を解かれたと知らぬまま、うねりながら道を塞ぎ続けている。',\nsrc/core/data/lore.ts:450:      '「渡し守は千年、対岸の見えぬ霧の中を漕ぎ続けているという。誰を乗せているつもりなのかは、分からぬ」',\nsrc/core/data/lore.ts:455:      '舟べりに、幾つもの爪痕のような跡が残る。誰かが、必死に縋った跡のように見える。',\nsrc/core/data/lore.ts:459:      '渡し守は、常夜の霧が濃くなった夜、乗せるはずだった客を一人、対岸で見失った船頭だった。',\nsrc/core/data/lore.ts:460:      '見失った客がどこへ消えたのか、渡し守にはついぞ分からなかった。以来千年、霧の中を漕いでは、その一人の姿を捜し続けている。',\nsrc/core/data/lore.ts:484:      '喰い残された半身が谷へ墜ち、骸星の大熊となった。彼が暴れるのは——弟の名を、千年、呼び続けているからだ。',\nsrc/core/data/lore.ts:488:      '郷の星読みは言う。常夜の空の隅で、小さな星がひとつ、応えるように瞬いたと。兄の声が、ついに届いたのだ。',\nsrc/core/data/lore.ts:490:    bossPrelude: ['骸星の大熊が、谷を揺らして吼えた。', 'それは威嚇ではない。千年繰り返してきた、たったひとつの——弟の名だ。'],\nsrc/core/data/lore.ts:505:      '影法師長は、常夜が濃くなる過程で持ち主を失った無数の影の中から、最も濃く残ったひとつだった。',\nsrc/core/data/lore.ts:522:      '常夜に沈んだ古い鍛冶場の廃墟。今も鎚の音が、絶えないという。',\nsrc/core/data/lore.ts:528:      'だが太刀を託した勇者は、頂で敗れ、還らなかった。完璧な一振りは、届かなかったのだ。神王は千年、あの日の太刀を打ち直し続けている。今度こそ、と。もう、託す相手もいないのに。',\nsrc/core/data/lore.ts:550:      '主自身も、かつて棚から下ろされ、値なしと見捨てられた品だった。だから彼は、坂を訪れる者の値踏みの目を恐れ、仲間の品がまた選ばれず捨てられる前にと、庇って千年、睨みを利かせている。',\nsrc/core/data/lore.ts:571:      '百鬼夜行の先達は、常夜の中で行き場を失った魔性たちを束ね、どこかへ導こうとした案内人だった。',\nsrc/core/data/lore.ts:593:      '千年前の戦で、この地の兵は勝敗も知らされぬまま、全滅した。誰にも、看取られずに。',\nsrc/core/data/lore.ts:598:      '以来、林は静かだ。郷では毎年、名も知らぬ千の兵に、灯を流す。千年遅れの、弔いとして。',\nsrc/core/data/lore.ts:618:      '常闇の番人は、灯ノ御山へ至る最後の関を、千年守り続けた古い魔性だった。頂の玄冬の気配を、常に間近に感じている。',\nsrc/core/data/lore.ts:632:      '「翡翠主は元、沢の底に沈んだ勾玉の精だという。持ち主の一族は、常夜の晩に散り散りとなった」',\nsrc/core/data/lore.ts:641:      '翡翠沢主は、ある一族が代々受け継いだ勾玉の精だった。常夜の晩、一族は散り散りとなり、宝玉は沢の底へと沈んだ。',\nsrc/core/data/lore.ts:663:      '泣き男は、原で妻子のために猟をしていた男だった。常夜の晩、獲物を担いで帰る道すがら、家族の元へたどり着けなかった。',\nsrc/core/data/lore.ts:664:      '届けるはずだった獲物は、今も男の背にある。それでも男は、届け先を見失ったまま、千年、原をさまよい泣き続けている。',\nsrc/core/data/lore.ts:676:      '「もののふは千年前の戦の生き残りだという。仲間を全て埋めてから、己だけが刀を握ったまま立ち尽くした」',\nsrc/core/data/lore.ts:685:      'もののふは、千年前の戦で唯一生き残った兵だった。仲間の亡骸を一人ずつ埋め、その数だけ刀を突き立てた。',\nsrc/core/data/lore.ts:708:      '常夜が来て客が絶えても、夢幻は誇りを捨てられなかった。今も館の間取りを変え続け、迷い込む者を新しい客と信じて、もてなそうとしている。',\nsrc/core/data/lore.ts:717:  // ───────────────────── 肆の圏 : 灯ノ御山(頂そのもの・千年の答え) ─────────────────────\nsrc/core/data/lore.ts:732:      '集めた欠片を、頂の玄冬へ届けねばならぬ——その衝動だけが、千年、彼らを野に縛りつけている。まるで、面の下の誰かへの、供物のように。',\nsrc/core/data/lore.ts:744:      '「先達坊は御山への道を、生涯かけて拓いた行者だという。参道を作り終える前に、常夜が来た」',\nsrc/core/data/lore.ts:756:      '幻の参道の先達坊は、御山へ至る道を拓こうとした行者だった。常夜が来た時、道はまだ、御山の麓にすら届いていなかった。',\nsrc/core/data/lore.ts:757:      '未完のまま行者は倒れたが、参道への執着だけが残った。以来千年、彼は自ら鳥居を立て足しては、届かぬ道を伸ばし続けている。',\nsrc/core/data/lore.ts:770:      '「約束は、千年守られている。帰り着く者は、もう一人もいないというのに」',\nsrc/core/data/lore.ts:773:      '千年前に滅んだはずの町の跡。夜ごと、誰もいない家々に、ひとつ残らず灯りが点る。',\nsrc/core/data/lore.ts:778:      '町長の骸は、常夜が町を呑んだ晩、逃げる住人全員に「灯を点けて待つ」と誓った長だった。帰る家が暗くては、心細かろうと。',\nsrc/core/data/lore.ts:779:      '住人は、誰ひとり帰らなかった。それでも町長は千年、一軒残らず灯を継いで回っている。いつか誰かが辿り着いた時、我が家の窓が、明るいように。',\nsrc/core/data/lore.ts:796:      '常夜に閉ざされた峰。頂近くで、龍の啼く声のような風音が絶え間なく響く。',\nsrc/core/data/lore.ts:805:      '飛べぬ身のまま千年、龍は風だけを喉から絞り出し続けている。己が届けられなかった伝言を、せめて風にだけでも、頂へ運ばせようと。',\nsrc/core/data/lore.ts:821:      '灯ノ御山の麓、頂への最後の庭。ここに立つと、常夜の重みが、はっきりと肩にのしかかる。',\nsrc/core/data/lore.ts:826:      '影の底から、絶えず楽の音が響いている。哀しい旋律だ。誰かが千年、同じ一曲を、弾き続けている。',\nsrc/core/data/lore.ts:829:      '前触れの影は、実体を持たない。玄冬が頂に座して千年、その気配だけがここまで滲み出て、影として庭に落ち続けている。',\nsrc/core/data/lore.ts:854:      '止めの関守は、頂へ至る最後の段を、千年ただ一人で守り続けた番人だった。彼より先に、頂へ進んだ者はいない。',\nsrc/core/data/lore.ts:868:      '「宴の席は、千年前から誰も座っていない。それでも杯だけは、絶えず注がれ続けている」',\nsrc/core/data/lore.ts:879:      '前夜の宴主は、頂で何かを祝われるはずだった者の残り香だった。祝いの中身も、当人の名も、常夜の中でとうに失われている。',\nsrc/core/data/lore.ts:880:      '祝われるはずの宴は、開かれることのないまま、千年、支度だけが繰り返されてきた。杯を満たし続けることだけが、宴主に残された、たった一つの形だ。',\nsrc/core/data/lore.ts:893:      '「千年前、山へ登った楽士がひとり。降りてきた者は、いない。だが楽の音は、今も止まぬ」',\nsrc/core/data/lore.ts:896:      '常夜の中心。頂は雲に沈み、山肌の灯はすべて、こちらを向いている。',\nsrc/core/data/lore.ts:901:      '玄冬は星を喰らう神。だがその面の下で、誰かが内側から、喰らう力を千年、抑え続けている。',\nsrc/core/data/lore.ts:902:      '千年前に登った、家祖の楽士。勝てぬと悟った彼女は、己を錠前にして夜を封じた。あの哀しい楽の音は、独りで抱え続けた、千年の音だ。',\nsrc/core/data/lore.ts:905:      '千年、ただ独りで続いた演目に、ようやく聴き手が辿り着いた。もう、汐里は独りではない。',\nsrc/core/data/lore.ts:908:    bossPrelude: ['面の奥から、押し殺した声がする。「……来るな。後生だから、来て、くれるな」', 'それでも足は止めない。この千年は、この一族は、すべてこの時のためにあった。'],\n","exit_code":0,"status":"completed"}}
