    scenesSkipped: n.metrics.scenesSkipped + (skipped ? 1 : 0),\r\n373:                scenesCompleted: n.metrics.scenesCompleted + (skipped ? 0 : 1),\r\n374:              }\r\n375:            : n.metrics,\r\n376:        },\r\n377:      }\r\n378:    }\r\n379:    const flags = { ...d.flags }\r\n380:    if (scene.kind === 'dream') {\r\n381:      flags.dreamSeen = true\r\n382:    } else if (scene.kind === 'dreamEp') {\r\n383:      flags[`dreamEp_${scene.epId}`] = true\r\n384:    } else if (scene.kind === 'life' && scene.narrativeId?.startsWith('ch')) {\r\n385:      flags[`${scene.narrativeId}_completed`] = true\r\n386:    }\r\n387:    d = {\r\n388:      ...d,\r\n389:      flags,\r\n390:      narrative: {\r\n480:    const settlementId = `${encounterId}:${battleSequence}`\r\n481:    const plan = createBattleRewardPlan({\r\n482:      settlementId,\r\n483:      enemies,\r\n484:      ownedFamiliarEnemyIds: current.data?.familiars?.map((f) => f.enemyId) ?? [],\r\n485:      ...context,\r\n486:    })\r\n487:    return { battleSequence, battleRewardSettlement: { status: 'planned', plan } }\r\n488:  }\r\n489:\r\n490:  // 季節を進める — 誕生と死(寿命)をここで処理\r\n491:  const advanceSeason = (): void => {\r\n492:    const rng = get().rng\r\n493:    const scenes: PendingScene[] = [...get().pendingScenes]\r\n494:    let d = withNarrative(get().data!)\r\n495:    d = { ...d, seasonIndex: d.seasonIndex + 1 }\r\n496:    d = markJourneyMilestone(d, 'next_month')\r\n497:\r\n498:    // 誕生 — v3.1 M12: 縁の加護(下振れ緩和)/隔世遺伝/稀に双子\r\n499:    const due = d.pendingBirths.filter((b) => b.dueSeason <= d.seasonIndex)\r\n500:    d = { ...d, pendingBirths: d.pendingBirths.filter((b) => b.dueSeason > d.seasonIndex) }\r\n501:    for (const b of due) {\r\n502:      const god = godById(b.godId)\r\n503:      const parent = d.family.find((c) => c.id === b.parentId)\r\n504:      if (!parent) continue\r\n505:      const gen = parent.gen + 1\r\n506:      const affinity = d.godAffinity[b.godId] ?? 0\r\n507:      const twins = rng.chance(0.06)\r\n508:      const count = twins ? 2 : 1\r\n509:      for (let i = 0; i < count; i++) {\r\n510:        let child = conceiveChild(\r\n511:          parent, god, gen, d.seasonIndex, rng,\r\n512:          d.family.map((c) => c.name),\r\n513:          affinity, d.family,\r\n514:        )\r\n515:        // 書庫(M16-6): 先達の知恵が、子の血潮に僅かな伸びしろを残す(上限120は維持)\r\n516:        const shokoBonus = shokoPotentialBonus(facilityLevel(d.facilities, 'shoko'))\r\n517:        if (shokoBonus > 0) {\r\n518:          const boosted = { ...child.potential }\r\n519:          for (const k of Object.keys(boosted) as (keyof typeof boosted)[]) {\r\n520:            boosted[k] = Math.min(120, Math.round(boosted[k] * (1 + shokoBonus)))\r\n521:          }\r\n522:          const withStats = recalcStats({ ...child, potential: boosted }, d.seasonIndex)\r\n523:          child = { ...withStats, hp: withStats.maxHp, mp: withStats.maxMp }\r\n524:        }\r\n525:        d = { ...d, family: [...d.family, child] }\r\n526:        d = markJourneyMilestone(d, 'birth')\r\n527:        d = chronicle(d, 'birth', birthLine(child.name, god.name, rng), child.id)\r\n528:        if (child.deeds.some((x) => x.includes('隔世遺伝'))) {\r\n529:          d = chronicle(d, 'event', `${child.name}に、祖の血が強く顕れている。`, child.id)\r\n530:        }\r\n531:        if (child.deeds.some((x) => x.includes('神童'))) {\r\n532:          d = chronicle(d, 'era', `${child.name}、神童の相を持って生まれる — 郷がどよめいた。`, child.id)\r\n533:        }\r\n534:        scenes.push({ kind: 'birth', charId: child.id })\r\n535:      }\r\n536:      if (twins) d = chronicle(d, 'event', `${parent.name}に双子が生まれた — 郷は二重の産声に沸いた。`)\r\n537:    }\r\n538:\r\n539:    // 寿命 — 八季の命\r\n540:    for (const c of d.family) {\r\n541:      if (!c.alive) continue\r\n542:      if (ageOf(c, d.seasonIndex) >= LIFESPAN_MONTHS) {\r\n543:        const epitaph = generateEpitaph(c, 'lifespan', rng)\r\n544:        // 形見: 装備は継承品として蔵へ\r\n545:        const keepsakes: Item[] = []\r\n546:        for (const slot of ['weapon', 'armor', 'charm'] as const) {\r\n547:          const it = c.equipment[slot]\r\n548:          if (it) keepsakes.push(inheritItem(it, c.name, c.kills))\r\n549:        }\r\n550:        d = {\r\n551:          ...d,\r\n552:          inventory: [...d.inventory, ...keepsakes],\r\n553:          successionPending: c.isHead\r\n554:            ? { predecessorId: c.id, heirloomIds: keepsakes.map((item) => item.id) }\r\n555:            : d.successionPending,\r\n556:          family: d.family.map((x) =>\r\n557:            x.id === c.id\r\n558:              ? { ...x, alive: false, deathSeason: d.seasonIndex, deathCause: deathCauseLabel('lifespan'), epitaph, equipment: {}, isHead: false }\r\n559:              : x,\r\n560:          ),\r\n561:        }\r\n562:        d = chronicle(d, 'death', `${c.name}、${deathCauseLabel('lifespan')}。享年八季。「${epitaph}」`, c.id)\r\n563:        d = markJourneyMilestone(d, 'first_death')\r\n564:        d = tryUnlockGossip(d)\r\n565:        scenes.push({ kind: 'death', charId: c.id })\r\n566:      }\r\n567:    }\r\n568:\r\n569:    // 当主継承\r\n570:    if (!d.family.some((c) => c.alive && c.isHead)) {\r\n571:      const successor = chooseSuccessor(d)\r\n572:      if (successor) {\r\n573:        const question = generationQuestion(d)\r\n574:        const predecessor = d.family.find((char) => char.id === d.successionPending?.predecessorId)\r\n575:          ?? [...d.family].filter((char) => !char.alive).sort((a, b) => (b.deathSeason ?? -1) - (a.deathSeason ?? -1))[0]\r\n576:        const keepsakes = (d.successionPending?.heirloomIds ?? [])\r\n577:          .map((id) => d.inventory.find((item) => item.id === id))\r\n578:          .filter((item): item is Item => !!item)\r\n579:        d = {\r\n580:          ...d,\r\n581:          family: d.family.map((x) => (x.id === successor.id ? { ...x, isHead: true, deeds: [...x.deeds, '当主を継いだ'] } : x)),\r\n582:        }\r\n583:        d = addResonance(d, 'inherit')\r\n584:        d = { ...d, narrative: { ...d.narrative!, generationQuestion: question } }\r\n585:        d = chronicle(d, 'era', `${successor.name}、第${successor.gen}代当主を継ぐ。`)\r\n586:        d = chronicle(d, 'era', `今代の問い — ${question}`)\r\n587:        d = tryUnlockGossip(d)\r\n588:        if (predecessor) {\r\n589:          const succession = buildSuccessionScene(d, predecessor, successor, keepsakes, question)\r\n590:          d = { ...d, lastSuccession: succession.record, successionPending: undefined, designatedHeirId: undefined, generationVow: undefined }\r\n591:          scenes.push(succession.scene)\r\n592:        } else {\r\n593:          d = { ...d, successionPending: undefined, designatedHeirId: undefined, generationVow: undefined }\r\n594:          scenes.push({\r\n595:            kind: 'life', bg: 'cg2_succession.jpg', title: '当主継承',\r\n596:            lines: [\r\n597:              { speaker: '綴', text: `「先代の灯が、汝の掌へ落ちた。${successor.name} — 第${successor.gen}代当主である」` },\r\n598:              { speaker: successor.name, text: '形のない灯まで、私が受け取る。' },\r\n599:            ],\r\n600:          })\r\n601:        }\r\n602:        d = markJourneyMilestone(d, 'first_inherit')\r\n603:      }\r\n604:    }\r\n605:\r\n606:    // 成人の儀 — 生後6月を迎えた子は灯型を授かる\r\n607:    for (const c of d.family) {\r\n608:      if (c.alive && !c.tomoshigata && ageOf(c, d.seasonIndex) >= 6) {\r\n609:        scenes.push({ kind: 'ceremony', charId: c.id })\r\n610:      }\r\n611:    }\r\n612:\r\n613:    // 生業の儀 — 生後12月、灯座を持つ者は家業を選ぶ(GDD_v3 §2)\r\n614:    for (const c of d.family) {\r\n615:      if (c.alive && c.tomoshigata && !c.jobClass && ageOf(c, d.seasonIndex) >= 12) {\r\n616:        scenes.push({ kind: 'jobrite', charId: c.id })\r\n617:      }\r\n618:    }\r\n619:\r\n620:    // 灯細りの夜 — 死のひと月前、最後の対話\r\n621:    for (const c of d.family) {\r\n622:      if (c.alive && ageOf(c, d.seasonIndex) === 23 && !c.deeds.includes('灯細りの夜を過ごした')) {\r\n623:        const witness = d.family.find((x) => x.alive && x.isHead && x.id !== c.id)\r\n624:          ?? d.family.find((x) => x.alive && x.id !== c.id)\r\n625:          ?? null\r\n626:        scenes.push({ kind: 'life', ...hosoriScene(c, witness) })\r\n627:        d = {\r\n628:          ...d,\r\n629:          family: d.family.map((x) =>\r\n630:            x.id === c.id ? { ...x, deeds: [...x.deeds, '灯細りの夜を過ごした'] } : x,\r\n631:          ),\r\n632:        }\r\n633:      }\r\n634:    }\r\n635:\r\n636:    // 絆と日常 — 静かな月には、家族の暮らしの一場面がある(v3.1 M15-3で日常を追加)\r\n637:    if (scenes.length === 0 && rng.chance(0.3)) {\r\n638:      if (rng.chance(0.5)) {\r\n639:        const daily = dailyScene(d.family, d.seasonIndex, rng)\r\n640:        if (daily) scenes.push({ kind: 'life', ...daily })\r\n641:      }\r\n642:      if (scenes.length === 0) {\r\n643:        const adults = d.family.filter((c) => c.alive && ageOf(c, d.seasonIndex) >= 6)\r\n644:        if (adults.length >= 2) {\r\n645:          const pair = rng.shuffle(adults).slice(0, 2)\r\n646:          scenes.push({ kind: 'life', ...kizunaScene(pair[0], pair[1], rng) })\r\n647:        }\r\n648:      }\r\n649:    }\r\n650:\r\n651:    // 本編の章(v3.1 M15-4) — 条件を満たした月に一度だけ語られる\r\n652:    const chapterDue = CHAPTERS.find((ch) => {\r\n653:      if (d.flags[ch.id]) return false\r\n654:      switch (ch.id) {\r\n655:        case 'ch1': return d.seasonIndex >= 2\r\n656:        case 'ch2': return d.regionsCleared.length >= 1\r\n657:        case 'ch3': return d.regionsCleared.length >= 5\r\n658:        case 'ch4': return (d.loreFrags?.['akashi_miyama'] ?? 0) >= 3 || d.regionsCleared.length >= 10\r\n659:        case 'ch5': return d.fame >= FAME_SEAL_THRESHOLD\r\n660:        default: return false\r\n661:      }\r\n662:    })\r\n663:    if (chapterDue) {\r\n664:      d = { ...d, flags: { ...d.flags, [chapterDue.id]: true } }\r\n665:      d = chronicle(d, 'era', `【${chapterDue.title}】語り継がれる千年の真実が、一つ明らかになった。`)\r\n666:      scenes.push({ kind: 'life', narrativeId: chapterDue.id, title: chapterDue.title, lines: chapterDue.lines })\r\n667:    }\r\n668:\r\n669:    // 灯座の深まり — 月齢で固有技が開く(10月・14月・18月=奥義)\r\n670:    d = {\r\n671:      ...d,\r\n672:      family: d.family.map((c) => {\r\n673:        if (!c.alive || !c.tomoshigata) return c\r\n674:        const toza = tozaOf(c.tomoshigata, c.element)\r\n675:        const age = ageOf(c, d.seasonIndex)\r\n676:        const learned = [...c.skills]\r\n677:        let awakened = false\r\n678:        if (age >= 10 && !learned.includes(toza.skills[1].id)) learned.push(toza.skills[1].id)\r\n679:        if (age >= 14 && !learned.includes(toza.skills[2].id)) learned.push(toza.skills[2].id)\r\n680:        if (age >= 18 && !learned.includes(toza.ougi.id)) {\r\n681:          learned.push(toza.ougi.id)\r\n682:          awakened = true\r\n683:        }\r\n684:        if (learned.length === c.skills.length) return c\r\n685:        if (awakened) {\r\n686:          d = chronicle(d, 'event', `${c.name}、灯座「${toza.name}」の奥義に開眼す。`)\r\n687:        }\r\n688:        return { ...c, skills: learned }\r\n689:      }),\r\n690:    }\r\n691:\r\n692:    // 家業の年季 — 月齢で家業技が開く(GDD_v3 §2)\r\n693:    d = {\r\n694:      ...d,\r\n695:      family: d.family.map((c) => {\r\n696:        if (!c.alive || !c.jobClass) return c\r\n697:        const job = jobById(c.jobClass)\r\n698:        const age = ageOf(c, d.seasonIndex)\r\n699:        const learned = [...c.skills]\r\n700:        job.skillIds.forEach((sid, i) => {\r\n701:          if (age >= JOB_SKILL_UNLOCK_AGES[i] && !learned.includes(sid)) learned.push(sid)\r\n702:        })\r\n703:        if (learned.length === c.skills.length) return c\r\n704:        return { ...c, skills: learned }\r\n705:      }),\r\n706:    }\r\n707:\r\n708:    // 成長(全員再計算)\r\n709:    d = { ...d, family: d.family.map((c) => (c.alive ? recalcStats(c, d.seasonIndex) : c)) }\r\n710:\r\n711:    // 郷の営み — 郷人たちが大燈籠に捧げる奉燈(月次・討伐が進むほど郷が潤う)\r\n712:    d = { ...d, hoto: d.hoto + 3 + d.regionsCleared.length * 2 }\r\n713:\r\n714:    // 社(M16-6): 月送りごと、既に契った星々(縁>0)への縁を篤くする\r\n715:    const yashiroGain = yashiroAffinityGain(facilityLevel(d.facilities, 'yashiro'))\r\n716:    if (yashiroGain > 0) {\r\n717:      d = {\r\n718:        ...d,\r\n719:        godAffinity: Object.fromEntries(\r\n720:          Object.entries(d.godAffinity).map(([gid, aff]) => [gid, aff > 0 ? aff + yashiroGain : aff]),\r\n721:        ),\r\n722:      }\r\n723:    }\r\n724:\r\n725:    // 夢渡り — 最初の看取り、または星骸の谷を制した早い方で入口が開く。\r\n726:    // 既読flagはqueue時でなく完読/skip時に立てるため、途中離脱でも失わない。\r\n727:    const deaths = d.family.filter((c) => !c.alive).length\r\n728:    if ((deaths >= 1 || d.regionsCleared.includes('hoshimukuro_tani')) && !d.flags.dreamSeen) {\r\n729:      const intro: PendingScene = { kind: 'dream' }\r\n730:      if (!isResolvedScene(d, intro)) scenes.push(intro)\r\n731:    } else {\r\n732:      // 夢渡りの連作 — 看取りの数だけ、千年前の記憶へ深く招かれる(1季に一篇まで)\r\n733:      const ep = nextDreamEpisode(d)\r\n734:      if (ep) {\r\n735:        scenes.push({ kind: 'dreamEp', epId: ep.id })\r\n736:      }\r\n737:    }\r\n738:\r\n739:    // 血脈断絶チェック\r\n740:    const extinct = !d.family.some((c) => c.alive) && d.pendingBirths.length === 0\r\n741:    const partitioned = partitionScenes({ ...d, seed: rng.state() }, scenes)\r\n742:    d = partitioned.data\r\n743:    saveGame(d)\r\n744:    set({ data: d, pendingScenes: partitioned.primary ? [partitioned.primary] : [] })\r\n745:\r\n746:    if (extinct) {\r\n747:      const ended: GameData = {\r\n748:        ...d,\r\n749:        flags: { ...d.flags, extinct: true },\r\n750:        narrative: { ...d.narrative!, monthTransitionPending: false },\r\n751:      }\r\n752:      set({ screen: { id: 'ending' }, data: ended, pendingScenes: [] })\r\n753:      saveGame(ended)\r\n754:      return\r\n755:    }\r\n756:    get().processNextScene()\r\n757:  }\r\n758:\r\n759:  // finishBattle remains the simulator/test compatibility entry point. This flag lets the\r\n760:  // settlement actions reuse its established route-specific transition code without\r\n761:  // re-entering the public settle -> continue wrapper.\r\n762:  let internalFinishBattle = false\r\n763:\r\n764:  return {\r\n765:    screen: { id: 'title' },\r\n766:    data: null,\r\n767:    battle: null,\r\n768:    battleSequence: 0,\r\n769:    battleRewardSettlement: null,\r\n770:    battleDefeatContinuation: null,\r\n883:    continueGame: () => {\r\n884:      const d = loadGame()\r\n885:      if (!d) return false\r\n886:      const restoredRun = d.dungeonRun ?? null\r\n887:      // v3.1 M16-8: 留守番内職 — 離れていた実時間ぶん、家族が内職をしていた(1時間4燈・上限24時間)\r\n888:      let nd: GameData = recoverNarrativeOnLoad({ ...d, expedition: undefined })\r\n889:      // 結末をまだ選んでいない頂のsaveは、郷でなく同じ岐路へ戻す。\r\n890:      // 修正前saveは第二相勝利時の家譜から復旧する。shioriPhaseは開始記録であり勝利証拠ではない。\r\n891:      const finalePending = nd.flags.finalePending === true || (\r\n892:        nd.flags.finalePending === undefined && nd.flags.cleared === true && nd.flags.endingType === undefined &&\r\n893:        nd.chronicle.some((entry) => entry.kind === 'era' &&\r\n894:          entry.text === '灯ノ御山の頂にて、家祖・汐里と相まみえる。千年の答えを、選ぶ時。')\r\n895:      )\r\n896:      if (d.lastPlayedAt) {\r\n897:        const hours = Math.min(24, (Date.now() - d.lastPlayedAt) / 3_600_000)\r\n898:        if (hours >= 1) {\r\n899:          const earned = Math.floor(hours * 4)\r\n900:          const worker = d.family.filter((c) => c.alive)[0]\r\n901:          nd = { ...nd, hoto: nd.hoto + earned }\r\n902:          nd = {\r\n903:            ...nd,\r\n904:            chronicle: [...nd.chronicle, {\r\n905:              season: nd.seasonIndex, kind: 'event' as const,\r\n906:              text: `留守の間、${worker ? `${worker.name}たち` : '家の者'}が内職に励んでいた — 奉燈${earned}。文が添えてある。「おかえりなさい。夜は変わらずですが、家は息災です」`,\r\n907:            }],\r\n908:          }\r\n909:        }\r\n910:      }\r\n911:      set({\r\n912:        data: nd,\r\n913:        rng: new Rng(d.seed ^ (Date.now() >>> 0)),\r\n914:        screen: finalePending ? { id: 'finale' } : restoredRun ? { id: 'dungeon' } : { id: 'home' },\r\n915:        pendingScenes: [], battle: null, battleNodeId: null, pendingEvent: null, battleLogQueue: [],\r\n916:        battleSequence: 0, battleRewardSettlement: null, battleDefeatContinuation: null,\r\n917:        dungeonRun: restoredRun, battleSource: 'node', goldenBattle: false, rareEncounter: null,\r\n918:        nemesisBattleId: null, boonDraft: restoredRun?.boonDraft ?? null,\r\n919:      })\r\n920:      return true\r\n1010:\r\n1011:    processNextScene: () => {\r\n1012:      const currentData = get().data\r\n1013:      const active = currentData?.narrative?.active\r\n1014:      if (currentData && active) {\r\n1015:        const nd = markSceneResolved(currentData, active, false)\r\n1016:        set({ data: nd, pendingScenes: [], screen: { id: 'home' } })\r\n1017:        saveGame(nd)\r\n1018:        return\r\n1019:      }\r\n1020:      const scenes = get().pendingScenes\r\n1021:      if (scenes.length === 0) {\r\n1022:        const d = get().data\r\n1023:        if (d?.narrative?.monthTransitionPending) {\r\n1024:          const nd = { ...d, narrative: { ...d.narrative, monthTransitionPending: false } }\r\n1025:          set({ data: nd, screen: { id: 'home' } })\r\n1026:          saveGame(nd)\r\n1027:        } else set({ screen: { id: 'home' } })\r\n1028:        return\r\n1029:      }\r\n1030:      const [next, ...rest] = scenes\r\n1031:      const d = get().data\r\n1032:      if (!d) return\r\n1033:      const migrated = withNarrative(d)\r\n1034:      const id = narrativeSceneId(next)\r\n1035:      const n = migrated.narrative!\r\n1036:      const nd: GameData = {\r\n1037:        ...migrated,\r\n1038:        narrative: {\r\n1039:          ...n,\r\n1040:          active: next,\r\n1041:          activeOpenedAt: Date.now(),\r\n1042:          activeReplay: false,\r\n1043:          seen: [...new Set([...n.seen, id])],\r\n1044:          queued: [...new Set([...n.queued, id])],\r\n1045:          deferred: n.deferred.filter((scene) => narrativeSceneId(scene) !== id),\r\n1046:          metrics: 