aveGame(nd)\r\n1176:    },\r\n1177:\r\n1178:    consumeDeferredReminder: () => {\r\n1179:      const d = get().data\r\n1180:      if (!d) return null\r\n1181:      const migrated = withNarrative(d)\r\n1182:      const n = migrated.narrative!\r\n1183:      const now = Date.now()\r\n1184:      const sevenDays = 7 * 24 * 60 * 60 * 1000\r\n1185:      const scene = n.deferred.find((candidate) => {\r\n1186:        const id = narrativeSceneId(candidate)\r\n1187:        return !n.deferredReminderShown.includes(id) && now - (n.deferredSince[id] ?? now) >= sevenDays\r\n1188:      })\r\n1189:      if (!scene) return null\r\n1190:      const id = narrativeSceneId(scene)\r\n1191:      const nd: GameData = {\r\n1192:        ...migrated,\r\n1193:        narrative: { ...n, deferredReminderShown: [...n.deferredReminderShown, id] },\r\n1194:      }\r\n1195:      set({ data: nd })\r\n1196:      saveGame(nd)\r\n1197:      return scene\r\n1198:    },\r\n1199:\r\n1200:    revealShioriName: (skipped = false) => {\r\n1201:      const d = get().data\r\n1202:      if (!d || d.flags.reveal_shiori_name) return\r\n1203:      let nd: GameData = {\r\n1204:        ...d,\r\n1205:        flags: { ...d.flags, ch4_completed: true, reveal_shiori_name: true },\r\n1206:      }\r\n1207:      nd = migrateM34Narrative(nd)\r\n1208:      nd = chronicle(nd, 'era', '擦れていた墨が、夜露のように滲む。——汐里。これが、初代の名だ。')\r\n1209:      if (skipped) nd = chronicle(nd, 'event', '第四章の残りは要約として家譜へ綴じられた。')\r\n1210:      set({ data: nd })\r\n1211:      saveGame(nd)\r\n1212:    },\r\n1213:\r\n1214:    consumeLegacyShioriRecap: () => {\r\n1215:      const d = get().data\r\n1216:      if (!d) return null\r\n1217:      const recap = legacyShioriRecap(d)\r\n1218:      if (!recap) return null\r\n1219:      let nd: GameData = {\r\n1220:        ...d,\r\n1221:        flags: { ...d.flags, legacy_shiori_recap_pending: false },\r\n1222:      }\r\n1223:      nd = chronicle(nd, 'era', recap)\r\n1224:      set({ data: nd })\r\n1225:      saveGame(nd)\r\n