{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$i=0; Get-Content src/core/data/story.ts | ForEach-Object { '\"'{0,4}: {1}' -f (++\"'$i),$_ }; $i=0; Get-Content src/core/data/dreams.ts | ForEach-Object { '\"'{0,4}: {1}' -f (++\"'$i),$_ }'","aggregated_output":"   1: // 本編の章立てとマルチエンディング(v3.1 M15-4)\r\n   2: // 章は条件を満たした月に一度だけ語られる(綴りや夢の声)。結末は最終決戦後の選択で分岐。\r\n   3: export interface StoryChapter {\r\n   4:   id: string // flagsに記録するキー\r\n   5:   title: string\r\n   6:   lines: { speaker: string; text: string }[]\r\n   7: }\r\n   8: \r\n   9: export const CHAPTERS: StoryChapter[] = [\r\n  10:   {\r\n  11:     id: 'ch1',\r\n  12:     title: '第一章 常夜',\r\n  13:     lines: [\r\n  14:       { speaker: '綴', text: '……なあ、当主どの。なぜ夜が明けぬか、一度でも考えたことはあるか。' },\r\n  15:       { speaker: '綴', text: '千年前、空に「玄冬」が座った。星を喰らう神だ。太陽も、あれに呑まれたきり戻らぬ。' },\r\n  16:       { speaker: '綴', text: 'それでも郷が息をしているのは、大燈籠の火と、あんたら燈守の血——その二つきりのおかげだ。' },\r\n  17:       { speaker: '綴', text: 'あんたらの命は八季で燃え尽きる。短い。だがこの戦は、一代で勝つものではないのだ。' },\r\n  18:       { speaker: '綴', text: '親が半歩、子がまた半歩。灯を継いで、じわりと頂へ寄る。それを千年、繰り返してきた。' },\r\n  19:       { speaker: '', text: '——夜藪の奥で、何かが目を覚ます気配がした。' },\r\n  20:       { speaker: '綴', text: '……妙だな。飢えた獣の気配じゃない。あれはもっと——途方に暮れて、誰かを待つ者の気配だ。' },\r\n  21:     ],\r\n  22:   },\r\n  23:   {\r\n  24:     id: 'ch2',\r\n  25:     title: '第二章 主たちの無念',\r\n  26:     lines: [\r\n  27:       { speaker: '綴', text: '主を一つ、鎮めたな。……気づいたか? あれらは、ただの化け物ではない。' },\r\n  28:       { speaker: '綴', text: '待ち続ける者。守り続ける者。呼び続ける者。常夜は、千年分の「終われなかった想い」で満ちている。' },\r\n  29:       { speaker: '綴', text: '石碑を探せ。土地の縁起を知れば、なぜあれが終われぬのか——鎮め方も、見えてくる。' },\r\n  30:       { speaker: '綴', text: '想いが凝れば、化けて主となる。……ならば、と俺はときどき恐ろしくなる。' },\r\n  31:       { speaker: '綴', text: '頂に千年座す、あの「神」もまた——終われずにいる、ただの誰かではないのか、とな。' },\r\n  32:       { speaker: '', text: 'その一言は、口にした端から夜に吸われて消えた。綴はそれを、黙って家譜の隅に書き留めた。' },\r\n  33:     ],\r\n  34:   },\r\n  35:   {\r\n  36:     id: 'ch3',\r\n  37:     title: '第三章 星喰いの影',\r\n  38:     lines: [\r\n  39:       { speaker: '', text: '夢を見た。空の頂で、巨大な面が、ゆっくりとこちらを向く夢だ。' },\r\n  40:       { speaker: '玄冬(?)', text: '『……クルナ。……コレ以上、チカヨルナ』' },\r\n  41:       { speaker: '', text: '威嚇では、なかった。あれはむしろ——懇願に、聞こえた。' },\r\n  42:       { speaker: '綴', text: '玄冬が「言葉」を持つなど、千年、誰ひとり聞いたことがない。……何かが、おかしい。' },\r\n  43:       { speaker: '', text: '面の声の、さらに奥。糸のように細い楽の音がひとすじ。誰かが、宥めるように爪弾いていた。' },\r\n  44:       { speaker: '綴', text: 'この夢を見たあんたは、頂に届く前に逝くかもしれん。だから書いておく。次の代が、続きを見るために。' },\r\n  45:     ],\r\n  46:   },\r\n  47:   {\r\n  48:     id: 'ch4',\r\n  49:     title: '第四章 楽士の秘密',\r\n  50:     lines: [\r\n  51:       { speaker: '綴', text: '家譜の、いちばん最初の頁を開いた。名だけが擦れている。初代は、旅の楽士だったと、そこに在る。' },\r\n  52:       { speaker: '綴', text: '千年前、その楽士は単身で御山に登った。そして——降りて、こなかった。' },\r\n  53:       { speaker: '綴', text: 'ずっと解せなんだ。誰も止められぬ星喰いを前に、この郷はなぜ千年も保ったのか。' },\r\n  54:       { speaker: '綴', text: '……答えは、単純で、むごい。面の下で誰かが、内側から星喰いを抱き止めている。千年、たった独りで。' },\r\n  55:       { speaker: '', text: '御山の風が運ぶあの楽の音は——その、独りの音だ。' },\r\n  56:       { speaker: '綴', text: 'あんたらの産声を、辞世を、俺はこの手で書き留めてきた。……だが、な。' },\r\n  57:       { speaker: '綴', text: 'それを俺の肩ごしに、千年ずっと聴いていた者がいたとしたら。どんな心地で、聴いていたと思う。' },\r\n  58:       { speaker: '', text: '擦れていた墨が、夜露のように滲む。——汐里。これが、初代の名だ。' },\r\n  59:     ],\r\n  60:   },\r\n  61:   {\r\n  62:     id: 'ch5',\r\n  63:     title: '第五章 頂へ',\r\n  64:     lines: [\r\n  65:       { speaker: '綴', text: '武功は届いた。御山への道が、ついに開いている。' },\r\n  66:       { speaker: '綴', text: '行けば、千年の答えに会う。それが救いになるか、別れになるかは——あんたら次第だ。' },\r\n  67:       { speaker: '綴', text: '思えば、遠い道だった。数え切れぬ八季が、みな、この一歩のためにあったのだな。' },\r\n  68:       { speaker: '綴', text: '一つも、無駄ではなかった。逝った者の分まで、あんたらの灯は重くなっている。' },\r\n  69:       { speaker: '綴', text: '家譜は、ここまで俺が書いた。この先の頁を綴じるのは——生きている、あんたらだ。' },\r\n  70:       { speaker: '', text: '山の方から風が吹く。「急がないで」と、聞き覚えのある声が微かに混じった気がした。' },\r\n  71:       { speaker: '', text: '一族の灯を束ね、頂を目指す時が来た。' },\r\n  72:     ],\r\n  73:   },\r\n  74: ]\r\n  75: \r\n  76: // 結末3種 — 最終決戦(汐里)後の選択で分岐\r\n  77: export type EndingType = 'cut' | 'save' | 'inherit'\r\n  78: \r\n  79: export const FINALE_CHOICES: { id: EndingType; label: string; desc: string }[] = [\r\n  80:   { id: 'cut', label: '送る — 千年を終わらせる', desc: '一族の名を読み上げ、汐里と玄冬を看取り、常夜を終える。' },\r\n  81:   { id: 'save', label: '救う — 共に封じ直す', desc: '一族の灯を分かち、汐里と共に封印を編み直す。夜は残るが、独りにはさせない。' },\r\n  82:   { id: 'inherit', label: '継ぐ — 錠前を代わる', desc: '当主が汐里の座を継ぎ、汐里を千年ぶりに解放する。' },\r\n  83: ]\r\n  84: \r\n  85: export const ENDINGS: Record<EndingType, { title: string; beats: string[] }> = {\r\n  86:   cut: {\r\n  87:     title: '結 — 夜明け',\r\n  88:     beats: [\r\n  89:       '汐里は微笑んで、楽を置いた。「……ありがとう。もう、来てくれたのね。私の、遠い遠い子どもたち」',\r\n  90:       '当主は刃を納め、代わりに家譜を開いた。千年分の名を、一人ずつ、声に出して読み上げていく。',\r\n  91:       '汐里は聴いている。子守唄に耳を澄ますように、ひとつ頷くごとに、その身が透きとおってゆく。',\r\n  92:       '最後の名が読み終えられたとき、千年の演目が、終わった。星喰いは——眠るように、消えた。',\r\n  93:       '「もう、いいのね。もう、休んでいいのね」玄冬の面が砕け、空に、亀裂のような光が走った。',\r\n  94:     ],\r\n  95:   },\r\n  96:   save: {\r\n  97:     title: '結 — 二人の錠前',\r\n  98:     beats: [\r\n  99:       '「独りで千年は、長すぎた」当主はそう言って、汐里の隣に灯を置いた。',\r\n 100:       '一族の灯が御山に環をなし、封印は千年ぶりに編み直された。今度は、誰も独りではない。',\r\n 101:       '夜は残った。だが郷の者は言う——最近の夜は、どこか温かい、と。',\r\n 102:       '御山の頂からは時折、二重奏の楽の音が降りてくる。',\r\n 103:     ],\r\n 104:   },\r\n 105:   inherit: {\r\n 106:     title: '結 — 灯継ぎ',\r\n 107:     beats: [\r\n 108:       '「千年、ようやった。……あとは、うちの家系に任せろ」',\r\n 109:       '当主は面を受け取り、頂の座についた。汐里は千年ぶりに山を降りた。',\r\n 110:       '郷に戻った汐里を、家族たちが迎える。彼女は泣きながら、初めて温かい飯を食べた。',\r\n 111:       '頂の面の下で、新しい錠前が静かに歌っている。その歌は、代替わりのたびに引き継がれ、続いていく。',\r\n 112:     ],\r\n 113:   },\r\n 114: }\r\n   1: import type { GameData } from '../types'\r\n   2: \r\n   3: // ============================================================\r\n   4: // 夢渡りの連作 — 千年前の真実(汐里と玄冬の物語)を、看取りの数だけ深く見る\r\n   5: // 設計: docs/STORY_dreams/BEATS.md(/story 2026-07-06)\r\n   6: // 発火: 看取り(deathシーン)の直後、未読の解禁済み一篇だけを pendingScenes に積む。\r\n   7: // 解禁: deaths(一族の累計死者数) / gen(到達世代) の OR — gossipと同型。\r\n   8: // 既読: flags[`dreamEp_${id}`] = true(既存スキーマRecord<string,boolean|number>に適合)。\r\n   9: // 夢1(既存DreamScene: 星骸の谷討伐で発火)は無改変 — 本連作はその「続き」。\r\n  10: // ============================================================\r\n  11: \r\n  12: export interface DreamEpisode {\r\n  13:   id: string\r\n  14:   title: string\r\n  15:   unlock: { deaths?: number; gen?: number } // ORで判定\r\n  16:   requiresPrevious: 'dream:intro' | string\r\n  17:   visualId?: string\r\n  18:   bg?: string\r\n  19:   visualDescription?: string\r\n  20:   beats: string[]\r\n  21: }\r\n  22: \r\n  23: export const DREAM_EPISODES: DreamEpisode[] = [\r\n  24:   {\r\n  25:     id: 'yume_tabibito',\r\n  26:     title: '夢渡り・弐 — 旅の楽士',\r\n  27:     unlock: { deaths: 1 },\r\n  28:     requiresPrevious: 'dream:intro',\r\n  29:     visualId: 'STORY-DREAM-02',\r\n  30:     bg: 'cg_dream_02.jpg',\r\n  31:     visualDescription: '千年前の薄暮、濃藍の旅装で琵琶を背負う若い楽士が、星の音に足を止め、まだ火のない大燈籠の基壇と燈ノ郷を静かに見下ろしている。',\r\n  32:     beats: [\r\n  33:       '灯を、ひとつ見送った夜。——どこかで、唄が聴こえる。',\r\n  34:       '夢の頂。家譜の最初の頁と同じ顔をした楽士が、琵琶の絃を締め直しながら、こちらを見ずに言う。',\r\n  35:       '「見送ってきたのね。いい顔よ。……悲しみはね、ちゃんと悲しむと、灯になるの」',\r\n  36:       '「今夜は昔語りをしましょうか。千年前——私がまだ、ただの旅の楽士だったころの話」',\r\n  37:       '記憶が、絃の音にほどけていく。',\r\n  38:       '——若い楽士が、埃だらけの草鞋で峠を越えてくる。背には琵琶がひとつ。それが全財産。',\r\n  39:       '村々を巡り、死者の出た家の前で唄う。無念を鎮める唄。誰に習ったのでもない、生まれつきの唄。',\r\n  40:       '「報酬は一晩の飯と屋根。それで足りたわ。唄えば、死んだ人の顔がやわらぐ。……それが、好きだった」',\r\n  41:       'ある夕暮れ、楽士は小さな郷に辿り着く。燈ノ郷。郷を囲む古い燈籠たちが、名の由来だという。',\r\n  42:       '「あの郷はね、星がよく聴こえたの。……ええ、『聴こえた』のよ。星の音が」',\r\n  43:       '楽士は郷はずれの山の頂で琵琶を弾いた。星々が、すこし近づいた気がした。',\r\n  44:       '「それが、始まり。——続きは、また灯を見送った夜に」',\r\n  45:     ],\r\n  46:   },\r\n  47:   {\r\n  48:     id: 'yume_sora_no_ko',\r\n  49:     title: '夢渡り・参 — 空の子',\r\n  50:     unlock: { deaths: 3 },\r\n  51:     requiresPrevious: 'yume_tabibito',\r\n  52:     visualId: 'STORY-DREAM-03',\r\n  53:     bg: 'cg_dream_03.jpg',\r\n  54:     visualDescription: '星降る山頂で若い楽士が琵琶を奏で、名も面も持たない夜空の子が少し離れて聴く。二人の間の静かな空白に、最初の信頼が生まれる。',\r\n  55:     beats: [\r\n  56:       'また、ひとつ灯を見送った。……頂の夢が、近くなる。',\r\n  57:       '「来たわね。今夜は——あの子の話をしましょう」',\r\n  58:       '——楽士が頂で唄いはじめて、幾夜目か。ふと、気配がした。',\r\n  59:       '星々の間から、するりと、何かが降りてきた。形は子どものよう。体は夜空を切り抜いたように昏く、その中で星屑がまたたいている。',\r\n  60:       '声はなかった。ただ、じっと唄を聴いている。楽士も、弾く手を止めなかった。',\r\n  61:       '「怖くなかったのか、ですって? ……怖いものですか。音楽を聴く顔に、悪いものはいないわ」',\r\n  62:       '夜ごと、それは降りてきた。唄が終わると、名残惜しそうに空へ帰ってゆく。',\r\n  63:       '「名前を訊いたら、首をかしげたの。星々の間に生まれて、名前をくれる人が、いなかったのね」',\r\n  64:       '「だから私がつけたわ。——玄冬(げんとう)。冬の夜空がいちばん、透きとおって綺麗だから」',\r\n  65:       '玄冬は、その名を何度も口の中で転がして——笑った、ように見えた。',\r\n  66:       '「……ええ。あの子は、笑うのよ。あなたたちが討とうとしている、あの玄冬はね」',\r\n  67:     ],\r\n  68:   },\r\n  69:   {\r\n  70:     id: 'yume_futari',\r\n  71:     title: '夢渡り・肆 — ふたりの演目',\r\n  72:     unlock: { deaths: 5 },\r\n  73:     requiresPrevious: 'yume_sora_no_ko',\r\n  74:     visualId: 'STORY-DREAM-04',\r\n  75:     bg: 'cg_dream_04.jpg',\r\n  76:     visualDescription: '夢の中で季節を重ねて成長した玄冬が、楽士の琵琶へ星の明滅で拍子を返す。二人の手と金の星の弧が、秘密の二重奏を夜空へ広げる。',\r\n  77:     beats: [\r\n  78:       '灯がまた、ひとつ。……夢は、もう待っている。',\r\n  79:       '「今夜はいちばん、いい話。いちばん短くて、いちばん、いい話よ」',\r\n  80:       '夢の中で季節が巡る。玄冬は一夜で姿を変えたのではなく、唄を聴きに通った長い時の中で、少しずつ成長していた。',\r\n  81:       '——玄冬は唄を覚えた。声ではなく、体の中の星屑を明滅させて、拍子をとることを。',\r\n  82:       '楽士が弾き、玄冬が瞬き、夜空の星々がそれに和す。',\r\n  83:       '頂だけの、誰も知らない演目。郷の人々は「近ごろ星がよく瞬く」と首をかしげるだけだった。',\r\n  84:       '「贅沢な観客だったわ。空ぜんぶが、私の楽団だった」',\r\n  85:       'ある夜、玄冬がはじめて声を出した。拙い、風の鳴るような声で、言った。',\r\n  86:       '「——あなたの唄は、星より、明るい」',\r\n  87:       '楽士は笑って、礼を言って、それから少しだけ、泣いた。',\r\n  88:       '「旅の楽士はね、褒められ慣れていないの。……あの言葉だけは、千年経っても、灯みたいに消えないわ」',\r\n  89:       '「覚えておいて。あの子は、私の唄を『明るい』と言った。——それが、ぜんぶの始まりで、ぜんぶの終わりの、種だった」',\r\n  90:     ],\r\n  91:   },\r\n  92:   {\r\n  93:     id: 'yume_ue',\r\n  94:     title: '夢渡り・伍 — 飢え',\r\n  95:     unlock: { deaths: 8 },\r\n  96:     requiresPrevious: 'yume_futari',\r\n  97:     visualId: 'STORY-DREAM-05',\r\n  98:     bg: 'cg_dream_05.jpg',\r\n  99:     visualDescription: '胸の星が薄れた玄冬は、小さな星を両手で抱いて震える。遅れて頂へ着いた楽士が遠くからその姿を見つめ、言えなかった飢えに気づく。',\r\n 100:     beats: [\r\n 101:       '見送った灯の数だけ、夢は深くなる。',\r\n 102:       '「……今夜の話は、すこし、つらいわ。それでも聴く? ——聴くわよね。あなたは、私の子だもの」',\r\n 103:       '——玄冬は、星の光を食べて生きるものだった。',\r\n 104:       '空にいれば、困らない。星は無数にあり、光は満ちている。',\r\n 105:       'けれど地上に降りて、唄を聴いている間——あの子は、何も食べていなかった。',\r\n 106:       '「気づいてやれなかった。あの子は言わなかったし、私は、ただの人間だったから」',\r\n 107:       '飢えは、静かに積もった。唄を愛するほど。地上にいる時間が、延びるほど。',\r\n 108:       'ある夜、玄冬はふらりと空へ戻り——小さな星を、ひとつ、呑んだ。',\r\n 109:       '頂へ戻ってきたあの子は、震えながら言った。「……ごめんなさい。でも、とても、あたたかかった」',\r\n 110:       '「私は『いいのよ』と言ったわ。星なんて、数えきれないほどあるもの。……そう言ってしまったのよ。私が」',\r\n 111:       '夜空の星が、ひとつ、欠けていた。誰も気づかない。私と、あの子のほかは。',\r\n 112:     ],\r\n 113:   },\r\n 114:   {\r\n 115:     id: 'yume_taiyou',\r\n 116:     title: '夢渡り・陸 — 太陽の日',\r\n 117:     unlock: { deaths: 12 },\r\n 118:     requiresPrevious: 'yume_ue',\r\n 119:     visualId: 'STORY-DREAM-06',\r\n 120:     bg: 'cg_dream_06.jpg',\r\n 121:     visualDescription: '藍夜へ沈む真昼、涙を流す玄冬が欠けゆく太陽へ手を伸ばす。凍る郷を背に、稜線の楽士は琵琶を下ろし、自分の唄が招いた破局を悟る。',\r\n 122:     beats: [\r\n 123:       '灯の数が、夢の深さになる。……もう、底が近い。',\r\n 124:       '「今夜は——あの日の話。心して聴きなさい」',\r\n 125:       '——ひとつが、ふたつになった。ふたつが、十になった。',\r\n 126:       '郷の年寄りだけが気づいた。「北の空の、あの星がない」——子どもらは、はじめから無かった顔で笑っていた。',\r\n 127:       '飢えは、食べるほどに深くなった。星の光では、もう足りない。地の唄を知った体は、もっとあたたかいものを欲しがった。',\r\n 128:       '「あの子は、泣きながら食べていたわ。泣きながら食べるものを、どうやって責めればいいの」',\r\n 129:       'そしてあの朝——玄冬は、いちばん大きな星に、手を伸ばした。',\r\n 130:       '太陽が、欠けていく。真昼の郷に夜が落ちる。鳥が鳴きやみ、井戸の水が凍りはじめる。',\r\n 131:       '人々の悲鳴の中で、楽士はひとり空を見上げて、悟った。',\r\n 132:       '「あの子を地上に引き留めたのは、私の唄。飢えさせたのも、私の唄。——常夜はね、私が招いたのよ」',\r\n 133:       '「郷の誰も、それを知らない。夢は、頂に立つべき血にしか渡れないの。……綴にも、内緒よ」',\r\n 134:       '世界から、朝が消えた。千年の夜の、最初の夜だった。',\r\n 135:     ],\r\n 136:   },\r\n 137:   {\r\n 138:     id: 'yume_maki',\r\n 139:     title: '夢渡り・漆 — 薪の契り',\r\n 140:     unlock: { deaths: 16, gen: 5 },\r\n 141:     requiresPrevious: 'yume_taiyou',\r\n 142:     visualId: 'STORY-DREAM-07',\r\n 143:     bg: 'cg_dream_07.jpg',\r\n 144:     visualDescription: '面を着けた玄冬を楽士が環の内側から抱き止め、傍らに琵琶を置く。胸から流れた金の寿命の火が山を明るく下り、大燈籠へ初めて灯る。',\r\n 145:     beats: [\r\n 146:       'ここまで灯を見送って、ようやく届く夢がある。',\r\n 147:       '「……今夜で、昔語りはおしまい。最後は、私の罪と、あなたたちの呪いの話」',\r\n 148:       '——郷人たちは楽士に縋った。あなたの唄は魔性さえ鎮める。どうか、あの星喰いを殺してくれ、と。',\r\n 149:       '楽士は頂に登った。琵琶を、構えた。玄冬は逃げもせず、泣き腫らした顔で、そこにいた。',\r\n 150:       '「殺せなかったわ。……当たり前でしょう。あの子は、私の唄を、星より明るいと言った子よ」',\r\n 151:       'だから楽士は、第三の道を選んだ。',\r\n 152:       '己の寿命を薪にして、大燈籠に千年の火を灯す。郷を、常夜の凍えから守る火を。',\r\n 153:       'そして玄冬に面をかぶせ、その体ごと、頂で抱きしめた。飢えが二度と星に届かぬように。内側から、千年、抱き続けるために。',\r\n 154:       '「寿命を薪にした報いは、血に残った。私の血を継ぐ子は、八つの季節しか生きられない。人と結ばれて、血を薄めることも、できない」',\r\n 155:       '「だからあなたたちは、星と契って生まれてくる。……ごめんなさい、とは言わないわ。あなたたちは、私の誇りだもの」',\r\n 156:       '「憎んでくれても、いいのよ。それでも私は——千年前のあの夜に戻っても、同じことをする」',\r\n 157:     ],\r\n 158:   },\r\n 159:   {\r\n 160:     id: 'yume_itadaki',\r\n 161:     title: '夢渡り・終 — 千年の頂で',\r\n 162:     unlock: { deaths: 22, gen: 8 },\r\n 163:     requiresPrevious: 'yume_maki',\r\n 164:     visualId: 'STORY-DREAM-08',\r\n 165:     bg: 'cg_dream_08.jpg',\r\n 166:     visualDescription: '千年後、疲れた楽士が初めて琵琶を石へ置き、見えない子孫へ手を伸ばす。背後の面を着けた玄冬と、歴代の灯が連なる登山路が頂へ続く。',\r\n 167:     beats: [\r\n 168:       'すべての昔語りが終わった夢の頂は、静かだった。',\r\n 169:       '楽士は琵琶を、そっと地面に置く。——はじめて見る仕草だった。',\r\n 170:       '「千年、弾き続けたの。あの子が眠っていられるように。……でもね。そろそろ、腕が疲れたわ」',\r\n 171:       '「面の下で、あの子はまだ飢えている。私の力が尽きれば、常夜は次の千年へ続く」',\r\n 172:       '「だから——頂へいらっしゃい。あなたたちの代で、終わらせるの」',\r\n 173:       '「着いたら、好きに選びなさい。二人を送るか、腕を貸すか、それとも——私の座を、継ぐか」',\r\n 174:       '「どれを選んでも、恨まないわ。千年ぶんの家譜が、あなたたちに、選ぶ資格をくれる」',\r\n 175:       '「ただ、ひとつだけ。どの道を選んでも——私たちを、看取って。憎んだままで、終わらせないで」',\r\n 176:       '楽士は立ち上がり、こちらへ歩いてきて——額に、そっと指を置いた。',\r\n 177:       '「あなたたちの灯は、私の唄より明るい。……あの子にも、聴かせてやりたいわ」',\r\n 178:       '目が覚める。頬に、涙のあとがあった。誰のものかは、わからなかった。',\r\n 179:     ],\r\n 180:   },\r\n 181: ]\r\n 182: \r\n 183: export function dreamEpisodeById(id: string): DreamEpisode | undefined {\r\n 184:   return DREAM_EPISODES.find((e) => e.id === id)\r\n 185: }\r\n 186: \r\n 187: // 未読かつ解禁済みの最初の一篇を返す(配列順=物語順に一篇ずつ)。\r\n 188: // 夢1(既存DreamScene)の完読後だけ連作を解禁し、未読の先行篇を飛ばさない。\r\n 189: export function nextDreamEpisode(data: GameData): DreamEpisode | null {\r\n 190:   if (!data.flags.dreamSeen) return null\r\n 191:   const deaths = data.family.filter((c) => !c.alive).length\r\n 192:   const gen = data.family.length > 0 ? Math.max(...data.family.map((c) => c.gen)) : 0\r\n 193:   const ep = DREAM_EPISODES.find((candidate) => !data.flags[`dreamEp_${candidate.id}`])\r\n 194:   if (!ep) return null\r\n 195:   const previousDone = ep.requiresPrevious === 'dream:intro'\r\n 196:     ? !!data.flags.dreamSeen\r\n 197:     : !!data.flags[`dreamEp_${ep.requiresPrevious}`]\r\n 198:   if (!previousDone) return null\r\n 199:   const byDeaths = ep.unlock.deaths !== undefined && deaths >= ep.unlock.deaths\r\n 200:   const byGen = ep.unlock.gen !== undefined && gen >= ep.unlock.gen\r\n 201:   return byDeaths || byGen ? ep : null\r\n 202: }\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$i=0; Get-Content src/core/narrative.ts | ForEach-Object { '\"'{0,4}: {1}' -f (++\"'$i),$_ }'","aggregated_output":"   1: import type {\r\n   2:   Character, GameData, NarrativeProgress, NarrativeScene, NarrativeStage,\r\n   3: } from './types'\r\n   4: import { CHAPTERS } from './data/story'\r\n   5: import { DREAM_EPISODES } from './data/dreams'\r\n   6: import { REGIONS } from './data/regions'\r\n   7: import { CHAPTER_SUMMARIES, DREAM_EPISODE_SUMMARIES, INTRO_DREAM_SUMMARY } from './data/narrative_summaries'\r\n   8: \r\n   9: export type NarrativeChannel = 'ambient' | 'discovery' | 'scene'\r\n  10: export type NarrativeTrigger =\r\n  11:   | { kind: 'home' }\r\n  12:   | { kind: 'depart'; regionId: string }\r\n  13:   | { kind: 'dungeonEnter'; regionId: string; firstVisit: boolean }\r\n  14:   | { kind: 'monument'; regionId: string; fragment: number }\r\n  15:   | { kind: 'boss'; regionId: string; phase: 'before' | 'victory' }\r\n  16:   | { kind: 'return'; regionId: string; bossDown: boolean }\r\n  17:   | { kind: 'villageTalk'; villagerId: string }\r\n  18:   | { kind: 'inherit'; generation: number }\r\n  19: \r\n  20: export interface NarrativeBeat {\r\n  21:   id: string\r\n  22:   stage: NarrativeStage\r\n  23:   channel: NarrativeChannel\r\n  24:   trigger: NarrativeTrigger\r\n  25:   text: string\r\n  26:   speaker?: string\r\n  27:   once?: boolean\r\n  28:   priority: number\r\n  29:   requires?: string[]\r\n  30:   blocks?: string[]\r\n  31:   recap?: string\r\n  32: }\r\n  33: \r\n  34: const EMPTY_RESONANCE = { cut: 0, save: 0, inherit: 0 }\r\n  35: const EMPTY_METRICS = {\r\n  36:   scenesOpened: 0,\r\n  37:   scenesCompleted: 0,\r\n  38:   scenesSkipped: 0,\r\n  39:   scenesDeferred: 0,\r\n  40:   totalSceneMs: 0,\r\n  41:   maxDeferred: 0,\r\n  42:   monthsAdvanced: 0,\r\n  43:   interruptedAfterMonth: 0,\r\n  44: }\r\n  45: \r\n  46: export function narrativeSceneId(scene: NarrativeScene): string {\r\n  47:   switch (scene.kind) {\r\n  48:     case 'birth': return `birth:${scene.charId}`\r\n  49:     case 'death': return `death:${scene.charId}`\r\n  50:     case 'ceremony': return `ceremony:${scene.charId}`\r\n  51:     case 'jobrite': return `jobrite:${scene.charId}`\r\n  52:     case 'dream': return 'dream:intro'\r\n  53:     case 'dreamEp': return `dream:${scene.epId}`\r\n  54:     case 'life': return scene.narrativeId ?? `life:${scene.title}`\r\n  55:   }\r\n  56: }\r\n  57: \r\n  58: export function narrativeScenePriority(scene: NarrativeScene): number {\r\n  59:   if (scene.kind === 'death') return 0\r\n  60:   if (scene.kind === 'birth' || scene.kind === 'ceremony' || scene.kind === 'jobrite') return 1\r\n  61:   if (scene.kind === 'life' && scene.narrativeId?.startsWith('ch')) return 2\r\n  62:   if (scene.kind === 'dream' || scene.kind === 'dreamEp') return 3\r\n  63:   return 4\r\n  64: }\r\n  65: \r\n  66: export function narrativeStageOf(data: Pick<GameData, 'flags'>): NarrativeStage {\r\n  67:   const f = data.flags\r\n  68:   if (f.ch5_completed || f.dreamEp_yume_itadaki) return 'summit'\r\n  69:   if (f.ch4_completed || f.dreamEp_yume_maki) return 'fire_vow'\r\n  70:   if (f.ch3_completed || f.dreamEp_yume_futari || f.dreamEp_yume_ue || f.dreamEp_yume_taiyou) return 'duet_hunger'\r\n  71:   if (f.ch2_completed || f.dreamEp_yume_tabibito || f.dreamEp_yume_sora_no_ko) return 'name'\r\n  72:   return 'one_light'\r\n  73: }\r\n  74: \r\n  75: function completedFromFlags(data: GameData, legacy: boolean): string[] {\r\n  76:   const ids: string[] = []\r\n  77:   for (const chapter of CHAPTERS) {\r\n  78:     if (data.flags[`${chapter.id}_completed`] || (legacy && data.flags[chapter.id])) ids.push(chapter.id)\r\n  79:   }\r\n  80:   if (data.flags.dreamSeen) ids.push('dream:intro')\r\n  81:   for (const ep of DREAM_EPISODES) {\r\n  82:     if (data.flags[`dreamEp_${ep.id}`]) ids.push(`dream:${ep.id}`)\r\n  83:   }\r\n  84:   return ids\r\n  85: }\r\n  86: \r\n  87: function replayableSceneForId(id: string): NarrativeScene | undefined {\r\n  88:   if (id === 'dream:intro') return { kind: 'dream' }\r\n  89:   if (id.startsWith('dream:')) {\r\n  90:     const epId = id.slice('dream:'.length)\r\n  91:     return DREAM_EPISODES.some((episode) => episode.id === epId) ? { kind: 'dreamEp', epId } : undefined\r\n  92:   }\r\n  93:   const chapter = CHAPTERS.find((candidate) => candidate.id === id)\r\n  94:   return chapter\r\n  95:     ? { kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: chapter.lines }\r\n  96:     : undefined\r\n  97: }\r\n  98: \r\n  99: export function isReplayableNarrativeScene(scene: NarrativeScene): boolean {\r\n 100:   return scene.kind === 'dream' || scene.kind === 'dreamEp' || (scene.kind === 'life' && !!scene.narrativeId?.startsWith('ch'))\r\n 101: }\r\n 102: \r\n 103: /**\r\n 104:  * M34 save migration. Sentinelが無い旧saveだけ実名開示を保守的に導出する。\r\n 105:  * 現行saveへlegacy ORを再適用しないことが、ch4途中reloadの必須条件。\r\n 106:  */\r\n 107: export function migrateM34Narrative(data: GameData): GameData {\r\n 108:   const legacy = data.flags?.m34_narrative_schema !== 1\r\n 109:   const flags = { ...(data.flags ?? {}) }\r\n 110:   if (legacy) {\r\n 111:     const legacyReveal = Boolean(\r\n 112:       flags.ch4 ||\r\n 113:       (data.gossipIndex ?? 0) >= 12 ||\r\n 114:       flags.shioriPhase ||\r\n 115:       flags.endingType !== undefined ||\r\n 116:       flags.cleared,\r\n 117:     )\r\n 118:     flags.m34_narrative_schema = 1\r\n 119:     flags.reveal_shiori_name = legacyReveal\r\n 120:     flags.legacy_shiori_recap_pending = legacyReveal\r\n 121:     if (legacyReveal) flags.ch4_completed = true\r\n 122:   }\r\n 123: \r\n 124:   const completed = [...new Set([\r\n 125:     ...(data.narrative?.completed ?? []),\r\n 126:     ...completedFromFlags({ ...data, flags }, legacy),\r\n 127:   ])]\r\n 128:   const seen = [...new Set([...(data.narrative?.seen ?? []), ...completed])]\r\n 129:   const archive = uniqueScenes([\r\n 130:     ...(data.narrative?.archive ?? []),\r\n 131:     ...completed.map(replayableSceneForId).filter((scene): scene is NarrativeScene => !!scene),\r\n 132:   ]).filter(isReplayableNarrativeScene)\r\n 133:   const deferred = [...(data.narrative?.deferred ?? [])]\r\n 134:   const fallbackDeferredAt = data.lastPlayedAt ?? Date.now()\r\n 135:   const deferredSince = Object.fromEntries(deferred.map((scene) => {\r\n 136:     const id = narrativeSceneId(scene)\r\n 137:     return [id, data.narrative?.deferredSince?.[id] ?? fallbackDeferredAt]\r\n 138:   }))\r\n 139:   const narrative: NarrativeProgress = {\r\n 140:     stage: narrativeStageOf({ flags }),\r\n 141:     seen,\r\n 142:     queued: [...new Set(data.narrative?.queued ?? [])],\r\n 143:     completed,\r\n 144:     deferred,\r\n 145:     archive,\r\n 146:     deferredSince,\r\n 147:     deferredReminderShown: [...new Set(data.narrative?.deferredReminderShown ?? [])],\r\n 148:     active: data.narrative?.active,\r\n 149:     activeOpenedAt: data.narrative?.activeOpenedAt,\r\n 150:     activeReplay: data.narrative?.activeReplay,\r\n 151:     monthTransitionPending: data.narrative?.monthTransitionPending,\r\n 152:     resonance: { ...EMPTY_RESONANCE, ...(data.narrative?.resonance ?? {}) },\r\n 153:     metrics: { ...EMPTY_METRICS, ...(data.narrative?.metrics ?? {}) },\r\n 154:     generationQuestion: data.narrative?.generationQuestion,\r\n 155:     lastReturn: data.narrative?.lastReturn,\r\n 156:   }\r\n 157:   return { ...data, flags, narrative }\r\n 158: }\r\n 159: \r\n 160: /** crash/閉じるで表示中だった場面は読了にせず「灯の余白」へ戻す。 */\r\n 161: export function recoverNarrativeOnLoad(data: GameData): GameData {\r\n 162:   const migrated = migrateM34Narrative(data)\r\n 163:   const n = migrated.narrative!\r\n 164:   const deferred = [...n.deferred]\r\n 165:   if (n.active && !n.activeReplay) deferred.unshift(n.active)\r\n 166:   const interrupted = !!n.monthTransitionPending\r\n 167: \r\n 168:   // post-M34のch4 queue済みsaveを、legacy扱いせず匿名のまま再開可能にする。\r\n 169:   const ch4Pending = migrated.flags.ch4 && !migrated.flags.ch4_completed\r\n 170:   if (ch4Pending && !deferred.some((s) => narrativeSceneId(s) === 'ch4')) {\r\n 171:     const ch4 = CHAPTERS.find((c) => c.id === 'ch4')\r\n 172:     if (ch4) deferred.unshift({ kind: 'life', narrativeId: ch4.id, title: ch4.title, lines: ch4.lines })\r\n 173:   }\r\n 174:   const recoveredAt = Date.now()\r\n 175:   const deferredSince = Object.fromEntries(uniqueScenes(deferred).map((scene) => {\r\n 176:     const id = narrativeSceneId(scene)\r\n 177:     return [id, n.deferredSince[id] ?? (n.active && narrativeSceneId(n.active) === id ? n.activeOpenedAt : undefined) ?? recoveredAt]\r\n 178:   }))\r\n 179:   return {\r\n 180:     ...migrated,\r\n 181:     narrative: {\r\n 182:       ...n,\r\n 183:       active: undefined,\r\n 184:       activeOpenedAt: undefined,\r\n 185:       activeReplay: undefined,\r\n 186:       monthTransitionPending: false,\r\n 187:       deferred: uniqueScenes(deferred),\r\n 188:       deferredSince,\r\n 189:       metrics: {\r\n 190:         ...n.metrics,\r\n 191:         interruptedAfterMonth: n.metrics.interruptedAfterMonth + (interrupted ? 1 : 0),\r\n 192:         maxDeferred: Math.max(n.metrics.maxDeferred, deferred.length),\r\n 193:       },\r\n 194:     },\r\n 195:   }\r\n 196: }\r\n 197: \r\n 198: export function narrativeMetricSummary(data: GameData): {\r\n 199:   averageSceneMs: number\r\n 200:   skipRate: number\r\n 201:   maxDeferred: number\r\n 202:   interruptedAfterMonth: number\r\n 203: } {\r\n 204:   const metrics = migrateM34Narrative(data).narrative!.metrics\r\n 205:   const closed = metrics.scenesCompleted + metrics.scenesSkipped + metrics.scenesDeferred\r\n 206:   const resolved = metrics.scenesCompleted + metrics.scenesSkipped\r\n 207:   return {\r\n 208:     averageSceneMs: closed > 0 ? Math.round(metrics.totalSceneMs / closed) : 0,\r\n 209:     skipRate: resolved > 0 ? metrics.scenesSkipped / resolved : 0,\r\n 210:     maxDeferred: metrics.maxDeferred,\r\n 211:     interruptedAfterMonth: metrics.interruptedAfterMonth,\r\n 212:   }\r\n 213: }\r\n 214: \r\n 215: export function uniqueScenes(scenes: NarrativeScene[]): NarrativeScene[] {\r\n 216:   const ids = new Set<string>()\r\n 217:   return scenes.filter((scene) => {\r\n 218:     const id = narrativeSceneId(scene)\r\n 219:     if (ids.has(id)) return false\r\n 220:     ids.add(id)\r\n 221:     return true\r\n 222:   })\r\n 223: }\r\n 224: \r\n 225: export function partitionNarrativeScenes(\r\n 226:   progress: NarrativeProgress,\r\n 227:   candidates: NarrativeScene[],\r\n 228: ): { primary: NarrativeScene | null; deferred: NarrativeScene[]; queued: string[] } {\r\n 229:   const existing = new Set([\r\n 230:     ...progress.completed,\r\n 231:     ...progress.deferred.map(narrativeSceneId),\r\n 232:     ...(progress.active ? [narrativeSceneId(progress.active)] : []),\r\n 233:   ])\r\n 234:   const fresh = uniqueScenes(candidates)\r\n 235:     .filter((scene) => !existing.has(narrativeSceneId(scene)))\r\n 236:     .sort((a, b) => narrativeScenePriority(a) - narrativeScenePriority(b))\r\n 237:   return {\r\n 238:     primary: fresh[0] ?? null,\r\n 239:     deferred: uniqueScenes([...progress.deferred, ...fresh.slice(1)]),\r\n 240:     queued: [...new Set([...progress.queued, ...fresh.map(narrativeSceneId)])],\r\n 241:   }\r\n 242: }\r\n 243: \r\n 244: export function chapterIdByTitle(title: string): string | undefined {\r\n 245:   return CHAPTERS.find((chapter) => chapter.title === title)?.id\r\n 246: }\r\n 247: \r\n 248: /** スキップした章・夢の本文要約。未知の場面へ別の物語を補わない。 */\r\n 249: export function narrativeSceneSummary(scene: NarrativeScene): string | null {\r\n 250:   if (scene.kind === 'dream') return INTRO_DREAM_SUMMARY\r\n 251:   if (scene.kind === 'dreamEp') {\r\n 252:     return DREAM_EPISODES.some((episode) => episode.id === scene.epId)\r\n 253:       ? DREAM_EPISODE_SUMMARIES[scene.epId] ?? null\r\n 254:       : null\r\n 255:   }\r\n 256:   if (scene.kind !== 'life') return null\r\n 257:   const chapter = scene.narrativeId !== undefined\r\n 258:     ? CHAPTERS.find((candidate) => candidate.id === scene.narrativeId)\r\n 259:     : CHAPTERS.find((candidate) => candidate.title === scene.title)\r\n 260:   return chapter ? CHAPTER_SUMMARIES[chapter.id] ?? null : null\r\n 261: }\r\n 262: \r\n 263: export function generationQuestion(data: GameData): string {\r\n 264:   const items = [\r\n 265:     ...data.inventory,\r\n 266:     ...data.family.flatMap((c) => Object.values(c.equipment).filter((x): x is NonNullable<typeof x> => !!x)),\r\n 267:   ]\r\n 268:   const inherited = items.some((item) => item.generation >= 2)\r\n 269:   const completedLore = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n 270:   const pacts = Object.values(data.godAffinity).filter((n) => n > 0).length\r\n 271:   const bossDeeds = data.family.flatMap((c) => c.deeds).filter((x) => x.includes('討った')).length\r\n 272:   if (inherited) return '受け継ぐことは、持ち主の役目まで背負うことか。'\r\n 273:   if (completedLore >= 3) return '事情を知った刃は、知らぬ刃より優しいか。'\r\n 274:   if (bossDeeds >= 2) return '終わらせることで救えるものは、本当にあるか。'\r\n 275:   if (pacts >= 3) return '血を繋ぐことは、誰の願いなのか。'\r\n 276:   return '短い命を誰かと分けるとき、何を次代へ残したいか。'\r\n 277: }\r\n 278: \r\n 279: export function addResonance(\r\n 280:   data: GameData,\r\n 281:   kind: keyof NarrativeProgress['resonance'],\r\n 282:   amount = 1,\r\n 283: ): GameData {\r\n 284:   const migrated = migrateM34Narrative(data)\r\n 285:   const n = migrated.narrative!\r\n 286:   return {\r\n 287:     ...migrated,\r\n 288:     narrative: {\r\n 289:       ...n,\r\n 290:       resonance: { ...n.resonance, [kind]: n.resonance[kind] + Math.max(0, amount) },\r\n 291:     },\r\n 292:   }\r\n 293: }\r\n 294: \r\n 295: export function resonanceLine(data: GameData): string {\r\n 296:   const r = migrateM34Narrative(data).narrative!.resonance\r\n 297:   const max = Math.max(r.cut, r.save, r.inherit)\r\n 298:   if (max <= 0) return 'この家は、答えを決めつけず、ここまで灯を運んできた。'\r\n 299:   const leaders = (['cut', 'save', 'inherit'] as const).filter((key) => r[key] === max)\r\n 300:   if (leaders.length !== 1) return 'この家は、終えることも、分けることも、継ぐことも重ねてきた。'\r\n 301:   if (r.cut === max) return 'この家は、終われぬ主へ何度も幕を引いてきた。'\r\n 302:   if (r.save === max) return 'この家は、傷ついた者を置いて行かない夜を重ねてきた。'\r\n 303:   return 'この家は、名と道具と役目を、形を変えて渡してきた。'\r\n 304: }\r\n 305: \r\n 306: export interface FamilyEcho {\r\n 307:   label: string\r\n 308:   text: string\r\n 309: }\r\n 310: \r\n 311: // 表示用の文章と結末用の文型が、同じ元データを参照する。\r\n 312: function familyFinaleContext(data: GameData) {\r\n 313:   const firstDead = data.family\r\n 314:     .filter((c) => !c.alive)\r\n 315:     .sort((a, b) => (a.deathSeason ?? Number.MAX_SAFE_INTEGER) - (b.deathSeason ?? Number.MAX_SAFE_INTEGER))[0]\r\n 316:   const ownership = new Map<string, { item: GameData['inventory'][number]; owner?: Character }>()\r\n 317:   for (const item of data.inventory) ownership.set(item.id, { item })\r\n 318:   for (const char of data.family) {\r\n 319:     for (const item of Object.values(char.equipment)) if (item) ownership.set(item.id, { item, owner: char })\r\n 320:   }\r\n 321:   const oldestItem = [...ownership.values()].sort((a, b) => b.item.generation - a.item.generation)[0]\r\n 322:   const heirloom = oldestItem && oldestItem.item.generation > 0 ? oldestItem : undefined\r\n 323:   const completedLoreCount = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n 324:   const nemesis = [...(data.nemeses ?? [])].sort((a, b) => b.level - a.level)[0]\r\n 325:   const head = data.family.find((c) => c.alive && c.isHead) ?? data.family[0]\r\n 326:   return { firstDead, heirloom, completedLoreCount, nemesis, head }\r\n 327: }\r\n 328: \r\n 329: export function familyFinaleEchoes(data: GameData): FamilyEcho[] {\r\n 330:   const out: FamilyEcho[] = []\r\n 331:   const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n 332:   if (firstDead) {\r\n 333:     out.push({ label: '最初に見送った灯', text: `${firstDead.name}${firstDead.lastWords ? `「${firstDead.lastWords.slice(0, 24)}」` : ` — ${firstDead.epitaph}`}` })\r\n 334:   }\r\n 335:   if (heirloom) {\r\n 336:     out.push({\r\n 337:       label: '最も長く継いだ形見',\r\n 338:       text: `${heirloom.item.name} — ${heirloom.item.legacyFirstOwner ? `${heirloom.item.legacyFirstOwner}から` : ''}${heirloom.item.generation}代${heirloom.owner ? `、${heirloom.owner.name}の手にある` : ''}`,\r\n 339:     })\r\n 340:   }\r\n 341: \r\n 342:   if (nemesis) out.push({ label: '因縁を結んだ名', text: `${nemesis.name} — ${nemesis.victim}の仇` })\r\n 343:   else if (completedLoreCount > 0) out.push({ label: '真相まで読んだ土地', text: `${completedLoreCount}つの土地の縁起を、最後まで記した` })\r\n 344: \r\n 345:   if (out.length === 0) {\r\n 346:     out.push({ label: 'ここへ運んだ灯', text: `${head?.name ?? '名もなき当主'}が、家の最初の答えを選ぶ` })\r\n 347:   }\r\n 348:   return out.slice(0, 3)\r\n 349: }\r\n 350: \r\n 351: export function personalizedEndingBeat(data: GameData, ending: 'cut' | 'save' | 'inherit'): string {\r\n 352:   const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n 353:   const family = firstDead ? `${firstDead.name}から続く一族` : head ? `${head.name}の一族` : '名もなき一族'\r\n 354:   const memories: string[] = []\r\n 355:   if (heirloom) memories.push(`${heirloom.item.name}は${heirloom.item.generation}代、手を渡ってきた。`)\r\n 356:   if (nemesis) memories.push(`${nemesis.name}と${nemesis.victim}の因縁も、家譜に残っている。`)\r\n 357:   else if (completedLoreCount > 0) memories.push(`${completedLoreCount}つの土地の縁起を、最後まで家譜に記した。`)\r\n 358:   if (ending === 'cut') memories.push(`${family}の名を読み上げ、二人を独りにしないまま、千年の夜を送った。`)\r\n 359:   else if (ending === 'save') memories.push(`${family}が運んだ灯も封印へ重なった。今度の錠前は、誰か一人の犠牲ではない。`)\r\n 360:   else memories.push(`${family}が継いだ名と役目は、頂と郷を往き来する新しい家譜になった。`)\r\n 361:   return memories.join('')\r\n 362: }\r\n 363: \r\n 364: export function regionQuestion(regionName: string, loreFragments: number, cleared: boolean): string {\r\n 365:   if (cleared) return `${regionName}で終われた想いを、次の夜へどう渡す。`\r\n 366:   if (loreFragments >= 3) return `事情を知った今、${regionName}の主へどんな終わりを渡す。`\r\n 367:   if (loreFragments > 0) return `${regionName}に残る声は、何を守り続けている。`\r\n 368:   return `${regionName}の闇で、終われずにいるのは誰だ。`\r\n 369: }\r\n 370: \r\n 371: export function bossEmotion(regionName: string, loreFragments: number): string {\r\n 372:   if (loreFragments >= 3) return `${regionName}の主は、忘れまいとして立ちはだかる。`\r\n 373:   if (loreFragments > 0) return `${regionName}の主は、待ち焦がれるようにこちらを見る。`\r\n 374:   return `${regionName}の主は、名もない願いを守り抜こうとしている。`\r\n 375: }\r\n 376: \r\n 377: export interface ReturnTrace {\r\n 378:   kind: 'human' | 'land' | 'myth'\r\n 379:   text: string\r\n 380: }\r\n 381: \r\n 382: export function returnTraces(data: GameData): ReturnTrace[] {\r\n 383:   const last = data.narrative?.lastReturn\r\n 384:   if (!last) return []\r\n 385:   const region = REGIONS.find((candidate) => candidate.id === last.regionId)\r\n 386:   const party = last.partyIds\r\n 387:     .map((id) => data.family.find((character) => character.id === id)?.name)\r\n 388:     .filter((name): name is string => !!name)\r\n 389:   const injured = last.injuredIds\r\n 390:     .map((id) => data.family.find((character) => character.id === id)?.name)\r\n 391:     .filter((name): name is string => !!name)\r\n 392:   return [\r\n 393:     {\r\n 394:       kind: 'human',\r\n 395:       text: injured.length > 0\r\n 396:         ? `${injured.join('、')}は傷を負ったが、全員で家へ戻った。`\r\n 397:         : `${party.join('、') || '一族'}は灯を携え、家へ戻った。`,\r\n 398:     },\r\n 399:     { kind: 'land', text: `${region?.name ?? last.regionId}の土と夜の匂いが、装束に残っている。` },\r\n 400:     {\r\n 401:       kind: 'myth',\r\n 402:       text: last.bossDown\r\n 403:         ? '終われなかった主へ幕を渡した。その静けさが、家譜に一行増えた。'\r\n 404:         : 'まだ終われない声を背にした。次に会う時、何を知っているだろう。',\r\n 405:     },\r\n 406:   ]\r\n 407: }\r\n 408: \r\n 409: export function legacyShioriRecap(data: GameData): string | null {\r\n 410:   return data.flags.legacy_shiori_recap_pending\r\n 411:     ? '家譜の初代の名は、汐里。千年前に御山へ登った楽士である。'\r\n 412:     : null\r\n 413: }\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'Get-Content evidence/*; Get-Content README.md; Get-Content tests/quality_story_20261014.test.ts; Get-Content tests/quality_pact_records_20261014.test.ts; Get-Content tests/quality_narrative_text_20261014.test.ts'","aggregated_output":"== validate_data ==\r\ngods: 180柱\r\nenemies: 219種\r\nitems: 15種\r\nregions: 40地域\r\nevents(expedition): 8件(≒事件+その他id)\r\nskills(全供給源): 185本\r\ngod rank分布: 下68/中51/上43/極18 (現行確定 68/51/43/18)\r\n\r\nOK: 0 errors, 0 warn(s)\r\n\r\n RUN  v4.1.10 C:/Users/junna/Documents/Claude/_fable5/hitsugi\r\n\r\n\r\n Test Files  5 passed (5)\r\n      Tests  79 passed (79)\r\n   Start at  11:38:09\r\n   Duration  8.46s (transform 3.61s, setup 0ms, import 4.75s, tests 7.81s, environment 2ms)\r\n\r\n# 灯継ぎ -HITSUGI-\r\n\r\n**八季の命を、継いでゆけ。**\r\n\r\n**▶ いますぐ遊ぶ: https://hitsugi-game.github.io/hitsugi/** (無料・インストール不要・スマホ対応)\r\n\r\n二年(八季)で燃え尽きる呪われた血族を率い、星神と契って子を授かり、世代を重ねて常夜の山の頂を目指す — 世代交代ダークファンタジーRPG。ブラウザでそのまま遊べます。\r\n\r\n『俺の屍を越えてゆけ』の「短命・世代交代・血脈」というゲームデザインに着想を得て、独自の世界観と物語を構成しています。夜藪を歩く探索、子の血潮の予測、途中で中断できるセーブ機能を備えています。\r\n\r\n## 遊び方\r\n\r\n```bash\r\nnpm install\r\nnpm run dev\r\n```\r\n\r\nブラウザで http://localhost:5173 を開く。スマホ表示にも対応。\r\n\r\n## 特徴\r\n\r\n- **八季の命** — 仲間は必ず2年で死ぬ。残り寿命は「炎の点」でいつも見えている\r\n- **星契り** — 星神180柱と契って子を授かる。子の血潮は予測レンジで確かめられる\r\n- **灯システム** — 探索は「灯」が尽きる前に帰るか、深部の宝を狙うかの賭け\r\n- **継足** — 家族で同じ敵を連続で狙うと連携倍率が上がる、血の絆バトル\r\n- **家譜** — 全キャラの生涯・辞世が自動記録される、あなただけの千年紀\r\n- **辞世の句** — 性根と死に様から自動生成される、その人だけの最期の言葉\r\n- **和風プロシージャルBGM** — Web Audioで箏・太鼓・鈴の音を合成。家祖にまつわる旋律が物語をつなぐ\r\n\r\n## 技術\r\n\r\nReact 19 + TypeScript + Vite + PixiJS + Zustand。画像はゲームに同梱し、音楽は実行時に合成します。セーブはlocalStorageを使い、保存ファイルの書き出し・読込みにも対応しています。\r\n\r\n## How OpenAI Codex & GPT-5.6 were used\r\n\r\nThis project was built with two AI coding agents working the same repository as independent contractors — OpenAI **Codex CLI** (running on **GPT-5.6**) alongside Claude Code — not as a single autocomplete tool.\r\n\r\n- **Division of labor**: major systems (e.g. the 40-region dungeon overhaul, the rare-encounter/rare-drop system in `src/core/rare_encounters.ts`) were scoped as self-contained \"missions\" for Codex: a written contract (definition of done, out-of-scope items, protected files), task breakdown, implementation, and a required independent audit before merge. See [`docs/CODEX_MISSION_STATE.md`](docs/CODEX_MISSION_STATE.md) for a live example of this protocol.\r\n- **Shared source of truth**: both agents read from the same design doc ([`docs/GDD_v3.md`](docs/GDD_v3.md)) and decision log ([`docs/WORKLOG.md`](docs/WORKLOG.md)) instead of relying on chat history, so work stayed consistent across sessions and across agents.\r\n- **Verification, not trust**: every Codex mission ends in machine checks (`tsc`, `oxlint`, `vitest`, `scripts/validate_data.mjs` for zero ID/text duplication) plus an independent audit pass before being considered done.\r\n\r\nNo OpenAI API calls happen at runtime. The game uses bundled artwork, procedural audio, and localStorage saves; no external AI service is required to play. GPT-5.6/Codex was used as part of the **build process**.\r\n\r\n## ドキュメント\r\n\r\n- [ゲームデザインドキュメント（現行正典）](docs/GDD_v3.md)\r\n\r\n## License\r\n\r\nMIT (code). ゲームテキスト・世界観・キャラクター設定 © 2026 燈守家プロジェクト\r\nimport { beforeEach, describe, expect, it } from 'vitest'\r\nimport { useGame } from '../src/core/store'\r\nimport type { NarrativeScene } from '../src/core/types'\r\nimport { migrateM34Narrative, narrativeSceneId, narrativeSceneSummary } from '../src/core/narrative'\r\nimport { CHAPTERS } from '../src/core/data/story'\r\nimport { DREAM_EPISODES } from '../src/core/data/dreams'\r\n\r\nconst storage = new Map<string, string>()\r\nObject.defineProperty(globalThis, 'localStorage', {\r\n  configurable: true,\r\n  value: {\r\n    getItem: (key: string) => storage.get(key) ?? null,\r\n    setItem: (key: string, value: string) => storage.set(key, String(value)),\r\n    removeItem: (key: string) => storage.delete(key),\r\n    clear: () => storage.clear(),\r\n  },\r\n})\r\n\r\ntype Route = 'dungeon' | 'node'\r\n\r\nfunction enterGentou(route: Route): void {\r\n  const state = useGame.getState()\r\n  const partyIds = [state.data!.family[0].id]\r\n  if (route === 'dungeon') {\r\n    state.departDungeon('akashi_miyama', partyIds)\r\n    useGame.getState().dungeonEncounter(true, false)\r\n  } else {\r\n    state.depart('akashi_miyama', partyIds)\r\n    const data = useGame.getState().data!\r\n    const nodeId = Object.keys(data.expedition!.nodes)[0]\r\n    useGame.setState({\r\n      data: {\r\n        ...data,\r\n        expedition: {\r\n          ...data.expedition!,\r\n          nodes: {\r\n            ...data.expedition!.nodes,\r\n            [nodeId]: { ...data.expedition!.nodes[nodeId], type: 'boss', enemyIds: ['boss_gentou'] },\r\n          },\r\n        },\r\n      },\r\n    })\r\n    useGame.getState().chooseNode(nodeId)\r\n  }\r\n  expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_gentou')\r\n  expect(useGame.getState().battleRewardSettlement?.plan.nextPhase).toBe('shiori_duel')\r\n}\r\n\r\nfunction finishAs(phase: 'won' | 'lost' | 'fled'): void {\r\n  const battle = useGame.getState().battle!\r\n  useGame.setState({ battle: { ...battle, phase } })\r\n  useGame.getState().finishBattle()\r\n}\r\n\r\nbeforeEach(() => {\r\n  storage.clear()\r\n  useGame.getState().newGame(false)\r\n  const data = useGame.getState().data!\r\n  useGame.setState({\r\n    screen: { id: 'home' },\r\n    data: {\r\n      ...data,\r\n      fame: 3000,\r\n      flags: {\r\n        ...data.flags, reveal_shiori_name: true, dreamSeen: true,\r\n        ch1: true, ch2: true, ch3: true, ch4: true, ch5: true,\r\n        ch1_completed: true, ch2_completed: true, ch3_completed: true,\r\n        ch4_completed: true, ch5_completed: true,\r\n      },\r\n    },\r\n  })\r\n})\r\n\r\ndescribe.each<Route>(['dungeon', 'node'])('最終戦の進行回帰: %s', (route) => {\r\n  it('第二相への遭遇を魔性図鑑へ記録し、敗北後の再挑戦でも重複させない', () => {\r\n    enterGentou(route)\r\n    const previousCodex = useGame.getState().data!.codex!\r\n    finishAs('won')\r\n    const encountered = useGame.getState().data!.codex!\r\n    expect(encountered.enemies).toEqual([...previousCodex.enemies, 'boss_shiori'])\r\n    expect(encountered.gods).toEqual(previousCodex.gods)\r\n    finishAs('lost')\r\n    useGame.getState().continueGame()\r\n    expect(useGame.getState().data!.codex!.enemies).toContain('boss_shiori')\r\n\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    expect(useGame.getState().data!.codex!.enemies.filter((id) => id === 'boss_shiori')).toHaveLength(1)\r\n  })\r\n\r\n  it('汐里戦で敗北して保存・再開しても、玄冬の再討伐から第二相へ進める', () => {\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\r\n    finishAs('lost')\r\n    expect(useGame.getState().data!.flags.shioriPhase).toBe(true)\r\n    expect(useGame.getState().continueGame()).toBe(true)\r\n\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\r\n    expect(useGame.getState().battleRewardSettlement?.plan.nextPhase).toBe('finale')\r\n    finishAs('won')\r\n    expect(useGame.getState().screen.id).toBe('finale')\r\n  })\r\n\r\n  it('第二相から逃走しても、再遠征の玄冬戦から第二相へ進める', () => {\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    finishAs('fled')\r\n    if (route === 'dungeon') useGame.getState().dungeonReturn()\r\n    else useGame.getState().useReturnFire()\r\n\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\r\n  })\r\n\r\n  it.each([0, 1, 2])('選択前の再開は岐路へ戻り、結末%dの選択済み再開では再選択させない', (choice) => {\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    finishAs('won')\r\n    const finale = useGame.getState()\r\n    expect(finale.screen.id).toBe('finale')\r\n    expect(finale.data!.flags.endingType).toBeUndefined()\r\n\r\n    expect(finale.continueGame()).toBe(true)\r\n    expect(useGame.getState().screen.id).toBe('finale')\r\n    expect(useGame.getState().data!.flags.endingType).toBeUndefined()\r\n    useGame.getState().resolveFinale(choice)\r\n    expect(useGame.getState().screen.id).toBe('ending')\r\n    expect(useGame.getState().data!.flags.endingType).toBe(choice)\r\n    expect(useGame.getState().data!.flags.finalePending).toBe(false)\r\n\r\n    expect(useGame.getState().continueGame()).toBe(true)\r\n    expect(useGame.getState().screen.id).toBe('home')\r\n    expect(useGame.getState().data!.flags.endingType).toBe(choice)\r\n  })\r\n\r\n  it('過去に結末を選んだ後の再戦も、今回の岐路が保留中ならその場面へ再開する', () => {\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    finishAs('won')\r\n    useGame.getState().resolveFinale(1)\r\n    useGame.getState().continueGame()\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    finishAs('won')\r\n\r\n    expect(useGame.getState().data!.flags.finalePending).toBe(true)\r\n    expect(useGame.getState().continueGame()).toBe(true)\r\n    expect(useGame.getState().screen.id).toBe('finale')\r\n  })\r\n\r\n  it('旧クリアsaveから第二相へ進んだだけでは、敗北後の再開を岐路へ飛ばさない', () => {\r\n    const data = useGame.getState().data!\r\n    useGame.setState({ data: { ...data, flags: { ...data.flags, cleared: true } } })\r\n    enterGentou(route)\r\n    finishAs('won')\r\n    expect(useGame.getState().battle?.enemies[0].enemyId).toBe('boss_shiori')\r\n    finishAs('lost')\r\n\r\n    expect(useGame.getState().continueGame()).toBe(true)\r\n    expect(useGame.getState().screen.id).toBe('home')\r\n    expect(useGame.getState().data!.flags.endingType).toBeUndefined()\r\n  })\r\n})\r\n\r\nit('修正前に選択前で保存されたsaveも、第二相勝利済み・結末未選択なら岐路へ復旧する', () => {\r\n  enterGentou('dungeon')\r\n  finishAs('won')\r\n  finishAs('won')\r\n  const saved = JSON.parse(storage.get('hitsugi_save_v4')!)\r\n  delete saved.flags.finalePending\r\n  storage.set('hitsugi_save_v4', JSON.stringify(saved))\r\n  storage.delete('hitsugi_save_v4_bak')\r\n\r\n  expect(useGame.getState().continueGame()).toBe(true)\r\n  expect(useGame.getState().screen.id).toBe('finale')\r\n})\r\n\r\nit('第二相の記録も保留flagもない旧クリアsaveは、従来どおり郷へ戻る', () => {\r\n  const saved = JSON.parse(storage.get('hitsugi_save_v4')!)\r\n  saved.flags.cleared = true\r\n  delete saved.flags.shioriPhase\r\n  delete saved.flags.finalePending\r\n  delete saved.flags.endingType\r\n  storage.set('hitsugi_save_v4', JSON.stringify(saved))\r\n  storage.delete('hitsugi_save_v4_bak')\r\n\r\n  expect(useGame.getState().continueGame()).toBe(true)\r\n  expect(useGame.getState().screen.id).toBe('home')\r\n})\r\n\r\ndescribe.each(['ceremony', 'jobrite'] as const)('後回しの儀の対象確認: %s', (kind) => {\r\n  it.each(['dead', 'missing'] as const)('%sの人物を儀へ立たせず、未実施の記録を一度だけ残す', (condition) => {\r\n    const data = migrateM34Narrative(useGame.getState().data!)\r\n    const charId = data.family[0].id\r\n    const scene: NarrativeScene = { kind, charId }\r\n    const id = narrativeSceneId(scene)\r\n    const beforeFamily = condition === 'dead'\r\n      ? data.family.map((c) => ({ ...c, alive: false }))\r\n      : data.family.map((c) => ({ ...c, id: 'unrelated-survivor' }))\r\n    useGame.setState({\r\n      data: {\r\n        ...data, family: beforeFamily,\r\n        narrative: { ...data.narrative!, deferred: [scene], queued: [id], deferredSince: { [id]: 1 } },\r\n      },\r\n    })\r\n\r\n    useGame.getState().openDeferredScene(id)\r\n    const after = useGame.getState()\r\n    expect(after.screen.id).toBe('home')\r\n    expect(after.data!.family).toEqual(beforeFamily)\r\n    expect(after.data!.narrative!.deferred).toEqual([])\r\n    expect(after.data!.narrative!.queued).not.toContain(id)\r\n    expect(after.data!.narrative!.deferredSince[id]).toBeUndefined()\r\n    expect(after.data!.narrative!.completed).not.toContain(id)\r\n    const chronicle = after.data!.chronicle\r\n    expect(chronicle.at(-1)?.text).toContain('執り行わず')\r\n    after.openDeferredScene(id)\r\n    expect(useGame.getState().data!.chronicle).toEqual(chronicle)\r\n  })\r\n\r\n  it('存命人物の儀は、従来どおり選択を確定せず開く', () => {\r\n    const data = migrateM34Narrative(useGame.getState().data!)\r\n    const charId = data.family[0].id\r\n    const scene: NarrativeScene = { kind, charId }\r\n    const id = narrativeSceneId(scene)\r\n    useGame.setState({ data: { ...data, narrative: { ...data.narrative!, deferred: [scene] } } })\r\n\r\n    useGame.getState().openDeferredScene(id)\r\n    expect(useGame.getState().screen).toEqual({ id: kind, charId })\r\n    expect(useGame.getState().data!.family).toEqual(data.family)\r\n    expect(useGame.getState().data!.narrative!.active).toEqual(scene)\r\n  })\r\n})\r\n\r\nit.each(['birth', 'life'] as const)('故人の%s場面は回想として消さずに開ける', (kind) => {\r\n  const data = migrateM34Narrative(useGame.getState().data!)\r\n  const charId = data.family[0].id\r\n  const scene: NarrativeScene = kind === 'birth' ? { kind, charId } : {\r\n    kind, narrativeId: 'life:past', title: '生前の一夜', lines: [{ speaker: '', text: '生前の記録。' }],\r\n  }\r\n  const id = narrativeSceneId(scene)\r\n  useGame.setState({\r\n    data: {\r\n      ...data, family: data.family.map((c) => ({ ...c, alive: false })),\r\n      narrative: { ...data.narrative!, deferred: [scene] },\r\n    },\r\n  })\r\n\r\n  useGame.getState().openDeferredScene(id)\r\n  expect(useGame.getState().screen.id).toBe(kind)\r\n  expect(useGame.getState().data!.narrative!.active).toEqual(scene)\r\n})\r\n\r\nconst summaryScenes: NarrativeScene[] = [\r\n  ...CHAPTERS.map((chapter): NarrativeScene => ({\r\n    kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: chapter.lines,\r\n  })),\r\n  { kind: 'dream' },\r\n  ...DREAM_EPISODES.map((episode): NarrativeScene => ({ kind: 'dreamEp', epId: episode.id })),\r\n]\r\n\r\nit.each(summaryScenes.map((scene) => [narrativeSceneId(scene), scene] as const))(\r\n  '%sのskipは実要約を一度だけ家譜へ保存し、再読skipで重複させない', (_id, scene) => {\r\n    const base = useGame.getState().data!\r\n    const data = migrateM34Narrative({\r\n      ...base, flags: { m34_narrative_schema: 1 },\r\n      narrative: {\r\n        ...base.narrative!, completed: [], seen: [], archive: [],\r\n        active: scene, activeReplay: false,\r\n      },\r\n    })\r\n    useGame.setState({ data })\r\n    const summary = narrativeSceneSummary(scene)\r\n    expect(typeof summary).toBe('string')\r\n\r\n    useGame.getState().skipCurrentScene()\r\n    const after = useGame.getState().data!\r\n    expect(after.chronicle.filter((entry) => entry.kind === 'event' && entry.text.includes(summary!))).toHaveLength(1)\r\n    expect(after.chronicle.some((entry) => entry.text.includes('家譜の要約で受け取った'))).toBe(false)\r\n    if (narrativeSceneId(scene) === 'ch4') expect(after.flags.reveal_shiori_name).toBe(true)\r\n\r\n    useGame.getState().skipCurrentScene()\r\n    expect(useGame.getState().data!.chronicle).toEqual(after.chronicle)\r\n    useGame.getState().replayNarrativeScene(narrativeSceneId(scene))\r\n    useGame.getState().skipCurrentScene()\r\n    expect(useGame.getState().data!.chronicle).toEqual(after.chronicle)\r\n    useGame.getState().continueGame()\r\n    expect(useGame.getState().data!.chronicle).toEqual(after.chronicle)\r\n  },\r\n)\r\nimport { describe, expect, it } from 'vitest'\r\nimport { GODS } from '../src/core/data/gods'\r\nimport { recordedPactGodIds } from '../src/core/pact_records'\r\nimport type { GameData } from '../src/core/types'\r\n\r\ndescribe('契った星神と識った星神を分ける', () => {\r\n  it('祭りで全ての縁が増えても契約数は増えない', () => {\r\n    const data = {\r\n      godAffinity: Object.fromEntries(GODS.map((god) => [god.id, 0.5])),\r\n      chronicle: [],\r\n    }\r\n    expect(recordedPactGodIds(data).size).toBe(0)\r\n  })\r\n\r\n  it('実際の契約IDだけを数え、重複や未知のIDを除く', () => {\r\n    expect([...recordedPactGodIds({\r\n      codex: { enemies: [], gods: [GODS[0].id, GODS[0].id, 'unknown'] }, chronicle: [],\r\n    })]).toEqual([GODS[0].id])\r\n  })\r\n\r\n  it('旧セーブの明示的な契りを年代記から復元する', () => {\r\n    const data: Pick<GameData, 'codex' | 'chronicle'> = {\r\n      chronicle: [\r\n        { season: 1, kind: 'pact', text: `燈吾、${GODS[0].name}と星契りを結ぶ。` },\r\n        { season: 2, kind: 'pact', text: `燈吾、${GODS[0].name}と星契りを結ぶ。` },\r\n        { season: 3, kind: 'event', text: `燈吾、${GODS[1].name}と星契りを結ぶ。` },\r\n        { season: 4, kind: 'pact', text: `${GODS[2].name}への縁が深まった。` },\r\n      ],\r\n    }\r\n    expect([...recordedPactGodIds(data)]).toEqual([GODS[0].id])\r\n  })\r\n\r\n  it('全180柱の契約記録がそろって初めて全契約になる', () => {\r\n    const data = { codex: { enemies: [], gods: GODS.map((god) => god.id) }, chronicle: [] }\r\n    expect(recordedPactGodIds(data).size).toBe(180)\r\n    data.codex.gods.pop()\r\n    expect(recordedPactGodIds(data).size).toBe(179)\r\n  })\r\n})\r\nimport { describe, expect, it } from 'vitest'\r\nimport type { GameData, NarrativeScene } from '../src/core/types'\r\nimport { CHAPTERS } from '../src/core/data/story'\r\nimport { DREAM_EPISODES } from '../src/core/data/dreams'\r\nimport { makeItem } from '../src/core/data/items'\r\nimport * as narrative from '../src/core/narrative'\r\n\r\nfunction data(over: Partial<GameData> = {}): GameData {\r\n  return {\r\n    family: [{ id: 'head', name: '燈吾', alive: false, deathSeason: 1, equipment: {}, epitaph: '灯は続く' }],\r\n    inventory: [], loreFrags: {}, nemeses: [], ...over,\r\n  } as unknown as GameData\r\n}\r\n\r\nconst endings = ['cut', 'save', 'inherit'] as const\r\n\r\ndescribe('結末の個人化は表示文を人名へ逆変換しない', () => {\r\n  it.each(endings)('%s: 故人と土地の記録を別の文として結ぶ', (ending) => {\r\n    const result = narrative.personalizedEndingBeat(data({ loreFrags: { yoi_forest: 3 } }), ending)\r\n    expect(result).toContain('燈吾')\r\n    expect(result).toContain('1つの土地の縁起')\r\n    expect(result).not.toMatch(/記したが|縁起を、最後まで記したから|燈吾と1つ/)\r\n  })\r\n\r\n  it.each(endings)('%s: 形見は一族の人物と混同しない', (ending) => {\r\n    const item = { ...makeItem('w_kodachi'), name: '受け継いだ小太刀', generation: 3, legacyFirstOwner: '燈吾' }\r\n    const result = narrative.personalizedEndingBeat(data({ inventory: [item] }), ending)\r\n    expect(result).toContain(item.name)\r\n    expect(result).toContain('3代')\r\n    expect(result).not.toMatch(/燈吾と受け継いだ小太刀|小太刀が運んだ|小太刀が継いだ/)\r\n  })\r\n\r\n  it.each(endings)('%s: 宿敵は一族の主体にしない', (ending) => {\r\n    const result = narrative.personalizedEndingBeat(data({ nemeses: [{\r\n      id: 'nem', enemyId: 'en', name: '黒牙の魔性', victim: '燈吾', level: 3, regionId: 'yoi_forest',\r\n    }] }), ending)\r\n    expect(result).toContain('黒牙の魔性')\r\n    expect(result).toContain('燈吾')\r\n    expect(result).not.toMatch(/燈吾と黒牙|黒牙の魔性が|黒牙の魔性から続く/)\r\n  })\r\n\r\n  it.each(endings)('%s: 空一族でも文が途切れない', (ending) => {\r\n    const result = narrative.personalizedEndingBeat(data({ family: [] }), ending)\r\n    expect(result).toContain('名もなき一族')\r\n    expect(result).not.toMatch(/undefined|が、家の最初の答えを選ぶが/)\r\n  })\r\n\r\n  it.each(endings)('%s: 故人も形見もない家では当主名を使う', (ending) => {\r\n    const d = data()\r\n    d.family[0].alive = true\r\n    d.family[0].isHead = true\r\n    expect(narrative.personalizedEndingBeat(d, ending)).toContain('燈吾の一族')\r\n    expect(narrative.personalizedEndingBeat(d, ending)).not.toContain('答えを選ぶが')\r\n  })\r\n\r\n  it('家族史の表示と個人化は同じ形見・宿敵を選び、元データを変更しない', () => {\r\n    const d = data({\r\n      inventory: [\r\n        { ...makeItem('w_kodachi'), name: '新しい刀', generation: 1 },\r\n        { ...makeItem('w_kodachi'), id: 'old', name: '古い刀', generation: 4 },\r\n      ],\r\n      nemeses: [\r\n        { id: 'nem1', enemyId: 'en', name: '若い魔性', victim: '燈吾', level: 1, regionId: 'yoi_forest' },\r\n        { id: 'nem2', enemyId: 'en', name: '黒牙の魔性', victim: '燈吾', level: 4, regionId: 'yoi_forest' },\r\n      ],\r\n      loreFrags: { yoi_forest: 3 },\r\n    })\r\n    const original = structuredClone(d)\r\n    const echoes = narrative.familyFinaleEchoes(d).map((echo) => echo.text).join('')\r\n    const ending = narrative.personalizedEndingBeat(d, 'save')\r\n    for (const text of [echoes, ending]) {\r\n      expect(text).toContain('古い刀')\r\n      expect(text).toContain('黒牙の魔性')\r\n      expect(text).not.toMatch(/新しい刀|若い魔性|土地の縁起/)\r\n    }\r\n    expect(d).toEqual(original)\r\n  })\r\n\r\n  it('人名中の引用符・ダッシュを表示区切りと誤認しない', () => {\r\n    const d = data()\r\n    d.family[0].name = '灯—「守」'\r\n    expect(narrative.personalizedEndingBeat(d, 'save')).toContain('灯—「守」')\r\n  })\r\n})\r\n\r\ndescribe('要約は既存の場面ごとに本文の内容を返す', () => {\r\n  it('全5章をIDと旧titleで引ける', () => {\r\n    expect(CHAPTERS).toHaveLength(5)\r\n    for (const chapter of CHAPTERS) {\r\n      const scene: NarrativeScene = { kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: chapter.lines }\r\n      const summary = narrative.narrativeSceneSummary(scene)\r\n      expect(summary).toBeTruthy()\r\n      expect(summary!.length).toBeLessThanOrEqual(160)\r\n      expect(summary).not.toBe(chapter.title)\r\n      expect(narrative.narrativeSceneSummary({ ...scene, narrativeId: undefined })).toBe(summary)\r\n    }\r\n  })\r\n\r\n  it('初夢と全7夢に個別の要約があり、実名を先出ししない', () => {\r\n    const scenes: NarrativeScene[] = [{ kind: 'dream' }, ...DREAM_EPISODES.map((ep) => ({ kind: 'dreamEp' as const, epId: ep.id }))]\r\n    expect(scenes).toHaveLength(8)\r\n    const summaries = scenes.map(narrative.narrativeSceneSummary)\r\n    expect(new Set(summaries).size).toBe(8)\r\n    for (const summary of summaries) {\r\n      expect(summary).toBeTruthy()\r\n      expect(summary!.length).toBeLessThanOrEqual(160)\r\n      expect(summary).not.toContain('汐里')\r\n    }\r\n  })\r\n\r\n  it('要約に各場面の出来事が残る', () => {\r\n    const chapterEvents = [\r\n      ['八季', '誰かを待つ'], ['石碑', '終われ'], ['近づくな', '楽の音'],\r\n      ['内側', '汐里'], ['御山への道', '生きている一族'],\r\n    ]\r\n    CHAPTERS.forEach((chapter, index) => {\r\n      const summary = narrative.narrativeSceneSummary({ kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: [] })!\r\n      for (const event of chapterEvents[index]) expect(summary).toContain(event)\r\n    })\r\n    const dreamEvents = [\r\n      ['無念', '星の音'], ['名をつけた', '笑っていた'], ['明滅', '星より明るい'],\r\n      ['何も食べていなかった', '謝った'], ['太陽', '常夜を招いた'],\r\n      ['寿命を薪', '八季'], ['二人を送る', '看取って'],\r\n    ]\r\n    DREAM_EPISODES.forEach((ep, index) => {\r\n      const summary = narrative.narrativeSceneSummary({ kind: 'dreamEp', epId: ep.id })!\r\n      for (const event of dreamEvents[index]) expect(summary).toContain(event)\r\n    })\r\n    expect(narrative.narrativeSceneSummary({ kind: 'dream' })).toContain('看取って')\r\n  })\r\n\r\n  it('前半の要約に後半の真相や結末を先出ししない', () => {\r\n    for (const chapter of CHAPTERS.slice(0, 3)) {\r\n      const summary = narrative.narrativeSceneSummary({ kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: [] })\r\n      expect(summary).not.toMatch(/汐里|寿命を薪|内側から|封印|座を継|二人を送/)\r\n    }\r\n    for (const ep of DREAM_EPISODES.slice(0, 3)) {\r\n      const summary = narrative.narrativeSceneSummary({ kind: 'dreamEp', epId: ep.id })\r\n      expect(summary).not.toMatch(/汐里|飢え|太陽|寿命|封印|八季|座を継/)\r\n    }\r\n  })\r\n\r\n  it('第四章の要約でのみ初代の名を開示する', () => {\r\n    const chapter = CHAPTERS[3]\r\n    expect(narrative.narrativeSceneSummary({ kind: 'life', narrativeId: chapter.id, title: chapter.title, lines: [] })).toContain('汐里')\r\n  })\r\n\r\n  it('日常・未知ID・別種場面に本文の要約を捏造しない', () => {\r\n    const scenes: NarrativeScene[] = [\r\n      { kind: 'life', title: '日常', lines: [] },\r\n      { kind: 'life', narrativeId: 'ch999', title: CHAPTERS[0].title, lines: [] },\r\n      { kind: 'dreamEp', epId: 'unknown' },\r\n      { kind: 'death', charId: 'head' },\r\n      { kind: 'birth', charId: 'child' },\r\n      { kind: 'ceremony', charId: 'child' },\r\n      { kind: 'jobrite', charId: 'head' },\r\n    ]\r\n    expect(scenes.map(narrative.narrativeSceneSummary)).toEqual(scenes.map(() => null))\r\n  })\r\n})\r\n","exit_code":0,"status":"completed"}}
