.humanParentId)\r\n206:  const p = personalityById(char.personalityId)\r\n207:\r\n208:  const confirm = () => {\r\n209:    if (name.trim() && name.trim() !== char.name) renameCharacter(char.id, name)\r\n210:    processNextScene()\r\n211:  }\r\n212:\r\n213:  return (\r\n261:export function DeathScene({ charId }: { charId: string }) {\r\n262:  const data = useGame((s) => s.data)!\r\n263:  const processNextScene = useGame((s) => s.processNextScene)\r\n264:  const setLastWords = useGame((s) => s.setLastWords)\r\n265:  const char = data.family.find((c) => c.id === charId)\r\n266:  const [beat, setBeat] = useState(0) // 生涯の巻物を一行ずつ手繰る(M15-2)\r\n267:  const [words, setWords] = useState('')\r\n268:  useEffect(() => {\r\n269:    audio.se('death')\r\n270:  }, [])\r\n271:  // 生涯ダイジェスト(M15-2): この人の八季を、巻物のように振り返る\r\n272:  const digest = (() => {\r\n273:    if (!char) return []\r\n274:    const lines: string[] = []\r\n275:    const born = data.chronicle.find((e) => e.kind === 'birth' && e.charId === char.id)\r\n276:    if (born) lines.push(born.text)\r\n277:    if (char.expeditions > 0) lines.push(`夜藪への遠征、${char.expeditions}たび。`)\r\n278:    if (char.kills > 0) lines.push(`討った魔性、${char.kills}。`)\r\n279:    const children = data.family.filter((c) => c.humanParentId === char.id)\r\n280:    if (children.length > 0) lines.push(`残した子、${children.length}人 — ${children.map((c) => c.name).join('、')}。`)\r\n281:    for (const d of char.deeds.slice(0, 3)) lines.push(`${d}。`)\r\n282:    return lines\r\n283:  })()\r\n284:  const digestDone = beat >= digest.length\r\n285:  // フックは早期return前に無条件呼び出し(Rules of Hooks)\r\n286:  const { advance, onBgClick } = useSceneAdvance(!digestDone, () => setBeat((b) => b + 1))\r\n287:  if (!char) return null\r\n288:\r\n289:  const confirm = () => {\r\n290:    if (words.trim()) setLastWords(char.id, words)\r\n349:export function LifeScene({ title, lines, bg, narrativeId }: { title: string; lines: { speaker: string; text: string }[]; bg?: string; narrativeId?: string }) {\r\n350:  const processNextScene = useGame((s) => s.processNextScene)\r\n351:  const skipCurrentScene = useGame((s) => s.skipCurrentScene)\r\n352:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n353:  const revealShioriName = useGame((s) => s.revealShioriName)\r\n354:  const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\r\n355:  const [beat, setBeat] = useState(0)\r\n356:  const done = beat >= lines.length - 1\r\n357:  // SceneBg はファイル名(拡張子付き)を受け取り内部でgameImg()解決するため、\r\n358:  // dailyIndexは素のファイル名(life_daily_NN.png)として組み立てる(dailyImg()は使わない)。\r\n359:  const resolvedBg = bg ?? CHAPTER_BG[title] ?? `life_daily_${String(stableDailyIndex(title, lines)).padStart(2, '0')}.png`\r\n360:  const advanceBeat = useCallback(() => {\r\n361:    const next = Math.min(lines.length - 1, beat + 1)\r\n362:    if (narrativeId === 'ch4' && next === lines.length - 1) revealShioriName(false)\r\n363:    setBeat(next)\r\n364:  }, [beat, lines.length, narrativeId, revealShioriName])\r\n365:  const { advance, onBgClick } = useSceneAdvance(!done, advanceBeat)\r\n366:  return (\r\n367:    <div className=\"scene-screen screen vc3b-scene vc3b-life-scene\" data-scene-surface=\"life-thread\" data-scene-route=\"life\" onClick={onBgClick}>\r\n368:      <SceneBg file={resolvedBg} />\r\n369:      <SceneSurfaceHeader surface=\"life-thread\" route={narrativeId ? '章語り' : '生涯'} title={title} context=\"この夜の一行を、家の記憶へ綴じる。\" />\r\n370:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\" style={{ textAlign: 'left' }}>\r\n371:        {lines.slice(0, beat + 1).map((l, i) => (\r\n372:          <p key={i} className={i === beat ? 'intro-current' : 'intro-past'}>\r\n373:            {l.speaker ? (\r\n374:              <>\r\n375:                <b style={{ color: 'var(--amber)' }}>{l.speaker}</b>\r\n376:                <span style={{ color: 'var(--text-dim)' }}> — </span>\r\n377:                {l.text}\r\n378:              </>\r\n379:            ) : (\r\n380:              <span style={{ color: 'var(--text-dim)' }}>{l.text}</span>\r\n381:            )}\r\n382:          </p>\r\n383:        ))}\r\n384:      </div>\r\n385:      {done ? (\r\n386:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\r\n387:          この夜を憶えておく\r\n388:        </button>\r\n389:      ) : (\r\n390:        <ScenePager page={beat + 1} total={lines.length} onNext={advance} />\r\n391:      )}\r\n392:      {narrativeId && !done && !replaying && (\r\n393:        <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />\r\n394:      )}\r\n395:    </div>\r\n396:  )\r\n397:}\r\n398:\r\n399:// 成人の儀 — 生後六月、灯型を授ける。血潮から推奨を示す\r\n400:export function CeremonyScene({ charId }: { charId: string }) {\r\n572:const DREAM_BEATS = [\r\n573:  '……唄が、聴こえる。',\r\n574:  '夢の中。見知らぬ山の頂に、楽士がひとり座っている。黒い月を背に、琵琶を抱いて。',\r\n575:  '「あら。夢を渡って来たのね。……血は争えないわ」',\r\n576:  '彼女の顔は、名の擦れた家譜の最初の頁に描かれた似姿と同じだった。家祖らしき、名のない楽士。',\r\n577:  '「名乗らなくていいの。あなたたちの名は、全部、風に聞いてる。産声も、辞世も、ぜんぶ」',\r\n578:  '「山頂で待ってるわ。……ああ、でも、急がないで」',\r\n579:  '「あなたたちの季節は短いのだから。道草も、お食べなさい。祭も、恋も、昼寝もね」',\r\n580:  '「それでいつか、ここへ届いたら——そのときは」',\r\n581:  '唄が途切れた。彼女は少しだけ笑って、囁いた。「……看取って、ちょうだいね」',\r\n582:  '目が覚める。頬に涙の痕。綴は何も聞かず、黙って墨を磨っていた。',\r\n583:]\r\n584:\r\n585:// M19 A4: 頁印+明示的「次へ」— 画面全体クリック進行は維持しつつ、確実な操作面を下部に置く。\r\n646:export function DreamScene() {\r\n647:  const processNextScene = useGame((s) => s.processNextScene)\r\n648:  const skipCurrentScene = useGame((s) => s.skipCurrentScene)\r\n649:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n650:  const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\r\n651:  const [beat, setBeat] = useState(0)\r\n652:  const done = beat >= DREAM_BEATS.length - 1\r\n653:  const { advance, onBgClick } = useSceneAdvance(!done, () => setBeat((b) => b + 1))\r\n654:  return (\r\n655:    <div className=\"scene-screen screen vc3b-scene vc3b-dream-scene\" data-scene-surface=\"dream-edge\" data-scene-route=\"dream\" onClick={onBgClick}>\r\n656:      <SceneBg file=\"cg_kiro.png\" />\r\n657:      <SceneSurfaceHeader surface=\"dream-edge\" route=\"夢渡り\" title=\"夢渡り\" context=\"名のない楽士の声が、家譜の外から届く。\" />\r\n658:      <div className=\"scene-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n659:        {DREAM_BEATS.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\r\n660:          <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\r\n661:            {t}\r\n662:          </p>\r\n663:        ))}\r\n664:      </div>\r\n665:      {done ? (\r\n666:        <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\r\n667:          目を覚ます\r\n668:        </button>\r\n669:      ) : (\r\n670:        <ScenePager page={beat + 1} total={DREAM_BEATS.length} onNext={advance} />\r\n671:      )}\r\n672:      {!done && !replaying && <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />}\r\n673:    </div>\r\n674:  )\r\n675:}\r\n676:\r\n677:// 夢渡りの連作(data/dreams.ts) — 看取りの数だけ深く見る、千年前の記憶。\r\n678:// 横長CGは背景coverにせず前面の16:9全景として示し、台詞と操作を通常フローで分離する。\r\n679:export function DreamEpScene({ epId }: { epId: string }) {\r\n680:  const processNextScene = useGame((s) => s.processNextScene)\r\n681:  const skipCurrentScene = useGame((s) => s.skipCurrentScene)\r\n682:  const deferCurrentScene = useGame((s) => s.deferCurrentScene)\r\n683:  const replaying = useGame((s) => !!s.data?.narrative?.activeReplay)\r\n684:  const [beat, setBeat] = useState(0)\r\n685:  const [lastEp, setLastEp] = useState(epId)\r\n686:  if (epId !== lastEp) {\r\n687:    setLastEp(epId)\r\n688:    setBeat(0)\r\n689:  }\r\n690:  const ep = dreamEpisodeById(epId)\r\n691:  const epIndex = ep ? DREAM_EPISODES.indexOf(ep) : -1\r\n692:  const nextVisual = epIndex >= 0 ? DREAM_EPISODES[epIndex + 1]?.bg : undefined\r\n693:  const done = !ep || beat >= ep.beats.length - 1\r\n694:  const { advance, onBgClick } = useSceneAdvance(!done, () => setBeat((b) => b + 1))\r\n695:  useEffect(() => {\r\n696:    if (!ep) processNextScene()\r\n697:  }, [ep, processNextScene])\r\n698:  useEffect(() => {\r\n699:    if (!nextVisual) return\r\n700:    return prefetchGameImg(nextVisual)\r\n701:  }, [nextVisual])\r\n702:  if (!ep) {\r\n703:    // 未知のepId(将来のセーブ互換等) — 詰まらせず静かに次へ\r\n704:    return null\r\n705:  }\r\n706:  return (\r\n707:    <div className=\"scene-screen screen dream-episode-screen vc3b-scene vc3b-dream-scene\" data-scene-surface=\"dream-edge\" data-scene-route=\"dreamEp\" onClick={onBgClick}>\r\n708:      <div className=\"dream-episode-shell\">\r\n709:        <SceneSurfaceHeader surface=\"dream-edge\" route={`夢渡り ${epIndex + 2}`} title={ep.title} context=\"千年前の記憶を、今代の夢の縁で受け取る。\" titleClassName=\"dream-episode-title\" />\r\n710:        <DreamVisual episode={ep} />\r\n711:        <div className=\"scene-body dream-episode-body vc3b-scene-panel\" data-scene-group=\"decision\">\r\n712:          {ep.beats.slice(Math.max(0, beat - 2), beat + 1).map((t, i, arr) => (\r\n713:            <p key={beat - arr.length + i} className={i === arr.length - 1 ? 'intro-current' : 'intro-past'}>\r\n714:              {t}\r\n715:            </p>\r\n716:          ))}\r\n717:        </div>\r\n718:        <div className=\"dream-episode-controls\" data-zone=\"dream-episode-controls\">\r\n719:          {done ? (\r\n720:            <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={processNextScene}>\r\n721:              目を覚ます\r\n722:            </button>\r\n723:          ) : (\r\n724:            <ScenePager page={beat + 1} total={ep.beats.length} onNext={advance} />\r\n725:          )}\r\n726:          {!done && !replaying && <SceneComfortControls onDefer={deferCurrentScene} onSkip={skipCurrentScene} />}\r\n727:        </div>\r\n728:      </div>\r\n729:    </div>\r\n730:  )\r\n731:}\r\n732:\r\n733:// cut(送る=夜明け)の後日談。クライマックス(ENDINGS.cut.beats=看取り・面砕け)と重複させず、\r\n734:// その「あと」だけを描く — 夜が明け、太陽が昇り、八季で死なぬ子が生まれ、家譜が閉じられる。\r\n735:const ENDING_CLEARED = [\r\n736:  '夜が、明けてゆく。最初の朝日が大燈籠の天辺に触れ、郷中の灯が一斉に消えた——もう、要らないから。',\r\n737:  '細っていた大燈籠の火は、朝焼けの色に染まった。千年ぶりの太陽が、燈ノ郷に昇る。',\r\n738:  'その春、燈守家に子が生まれた。八季では死なない、初めての子が。',\r\n739:  '一族の家譜の、最後の頁に、こう記された。「我ら、夜を継ぎ、朝を残す」',\r\n740:  '汝の屍を越え、灯は継がれた。',\r\n741:  '— 完 —',\r\n742:]\r\n743:\r\n744:const ENDING_EXTINCT = [\r\n745:  '最後の灯が、消えた。',\r\n746:  '燈守家の血脈は、ここに絶えた。',\r\n747:  '大燈籠の火は細り、常夜が郷を呑んでいく。',\r\n748:  '……だが、家譜だけは残った。',\r\n749:  '綴「いつか誰かが、この記を読む。ならばこれは敗北ではない。……中断だ」',\r\n750:]\r\n751:\r\n752:// v3.2 M18: 結末別エピローグ。cut(送る=夜明け)は ENDING_CLEARED を流用。\r\n753:// save(救う)/inherit(継ぐ)は「夜は残る」帰結のため、太陽・夜明けを断言しない専用の結びを用意する。\r\n754:const ENDING_SAVE = [\r\n755:  '当主は家譜を開き、千年分の名を、汐里と二人で読み上げていく。',\r\n756:  '一つ、また一つ。産声と、辞世と。汐里は初めて、独りでなくその名を聴いた。',\r\n757:  '「……ぜんぶ、憶えてる。あなたたちのこと、ぜんぶ」汐里は泣いて、そして、笑った。',\r\n758:  '夜は、明けない。それでも大燈籠の火は、もう二度と消えぬだろう。支え合う錠前が、二つになったのだから。',\r\n759:  '汝の屍を越え、灯は継がれた。次は誰が、あの頂の隣に、座るのだろうか。',\r\n760:  '— 完 —',\r\n761:]\r\n762:\r\n763:const ENDING_INHERIT = [\r\n764:  '山を降りた汐里は、綴の隣で、家譜の続きを綴る側になった。今度は、頂に座る者を、憶えておくために。',\r\n765:  '綴は筆を渡しながら言った。「錠前は代わる。だが家譜は続く。名を書き継ぐ者がいる限り、頂の誰も、独りにはならん」',\r\n766:  '汐里はときおり、頂へ文を送る。産声を、祭を、恋を、昼寝を——山の下の、短くて眩しい日々を。',\r\n767:  '夜は、明けない。だが頂の座は、もう永遠の牢ではない。八季ごとに、次の灯が、交代しに登ってゆく。',\r\n768:  '汝の屍を越え、灯は継がれた。頂へ、頂へと。今度は、誰も独りにはさせずに。',\r\n769:  '— 完 —',\r\n770:]\r\n771:\r\n772:// 最終決戦後の選択(v3.1 M15-4) — 千年の結末を、一族が選ぶ\r\n773:export function FinaleScene() {\r\n774:  const data = useGame((s) => s.data)!\r\n775:  const resolveFinale = useGame((s) => s.resolveFinale)\r\n776:  const [pendingChoice, setPendingChoice] = useState<number | null>(null)\r\n777:  const memories = familyFinaleEchoes(data)\r\n778:  return (\r\n779:    <div className=\"scene-screen screen finale-screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"finale\">\r\n780:      <SceneBg file=\"cg_kiro.png\" />\r\n781:      <SceneSurfaceHeader surface=\"flame-crossroads\" route=\"千年の答え\" title=\"千年の岐路\" context=\"三つの灯は同格。一族が遺す答えだけを選ぶ。\" />\r\n782:      <section className=\"finale-memory\" data-scene-group=\"context\" aria-label=\"一族がここまで運んだもの\">\r\n783:        <div className=\"scene-body finale-intro\">\r\n784:          <p>汐里は楽を置き、静かにこちらを見ている。</p>\r\n785:          <p>「……ここから先は、生きている者が決めることよ」</p>\r\n786:        </div>\r\n787:        <p className=\"finale-question\">今代の問い<span>{data.narrative?.generationQuestion ?? generationQuestion(data)}</span></p>\r\n788:        <div className=\"finale-echoes\">\r\n789:          {memories.map((memory) => (\r\n790:            <p key={`${memory.label}:${memory.text}`}>\r\n791:              <span>{memory.label}</span>{memory.text}\r\n792:            </p>\r\n793:          ))}\r\n794:        </div>\r\n795:        <p className=\"finale-resonance\">{resonanceLine(data)}</p>\r\n796:      </section>\r\n797:      <p className=\"finale-prompt\">この選択が、一族の千年の答えになる。</p>\r\n798:      <div className=\"finale-choices\" data-zone=\"finale-choices\" data-scene-group=\"decision\">\r\n799:        {FINALE_CHOICES.map((c, i) => (\r\n800:          <button\r\n801:            key={c.id}\r\n802:            className={`btn finale-choice${pendingChoice === i ? ' selected' : ''}`}\r\n803:            aria-pressed={pendingChoice === i}\r\n804:            onClick={() => setPendingChoice(i)}\r\n805:          >\r\n806:            <b>{c.label}</b>\r\n807:            <span>{c.desc}</span>\r\n808:          </button>\r\n809:        ))}\r\n810:        {pendingChoice !== null && (\r\n811:          <div className=\"finale-confirm\" role=\"group\" aria-label={`${FINALE_CHOICES[pendingChoice].label}の確認`}>\r\n812:            <p>「{FINALE_CHOICES[pendingChoice].label}」を、一族の答えとして家譜に閉じますか。</p>\r\n813:            <div>\r\n814:              <button className=\"btn btn-ghost\" onClick={() => setPendingChoice(null)}>選び直す</button>\r\n815:              <button className=\"btn btn-main vc3b-primary-action\" data-scene-primary=\"true\" onClick={() => resolveFinale(pendingChoice)}>\r\n816:                この答えを綴じる\r\n817:              </button>\r\n818:            </div>\r\n819:          </div>\r\n820:        )}\r\n821:      </div>\r\n822:    </div>\r\n823:  )\r\n824:}\r\n825:\r\n826:export function EndingScene() {\r\n827:  const data = useGame((s) => s.data)!\r\n828:  const setScreen = useGame((s) => s.setScreen)\r\n829:  const newLegacyGame = useGame((s) => s.newLegacyGame)\r\n830:  const [beat, setBeat] = useState(0)\r\n831:  const cleared = !!data.flags.cleared\r\n832:  // v3.1 M15-4: 最終選択に応じた結末分岐(選択がなければ従来の夜明け)\r\n833:  const endType = (typeof data.flags.endingType === 'number'\r\n834:    ? (['cut', 'save', 'inherit'] as const)[data.flags.endingType]\r\n835:    : 'cut')\r\n836:  const climaxBeats = ENDINGS[endType].beats\r\n837:  // v3.2 M18: 結末別エピローグ。cut=夜明け(ENDING_CLEARED)、save/inherit=夜が残る帰結へ整合。\r\n838:  const epilogue = endType === 'save' ? ENDING_SAVE : endType === 'inherit' ? ENDING_INHERIT : ENDING_CLEARED\r\n839:  // M34: 山場の直後に、このsaveの固有名・形見・土地から導いた一文だけを差し込む。\r\n840:  const beats = cleared ? [...climaxBeats, personalizedEndingBeat(data, endType), ...epilogue] : ENDING_EXTINCT\r\n841:  const done = beat >= beats.length - 1\r\n842:  // 山場(cut/save/inherit別)→_a、その後の共通エピローグ(ENDING_CLEARED)→_b。断絶(未clear)は画無し。\r\n843:  const endingBg = cleared ? (beat < climaxBeats.length ? `cg_end_${endType}_a.png` : `cg_end_${endType}_b.png`) : null\r\n844:\r\n845:  const gens = Math.max(...data.family.map((c) => c.gen))\r\n846:  const fallenCount = data.family.filter((c) => !c.alive).length\r\n847:  const years = yearOfMonth(data.seasonIndex)\r\n848:\r\n849:  return (\r\n850:    <div className=\"scene-screen screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"ending\" onClick={() => { if (!done) { audio.se('page'); setBeat(beat + 1) } }}>\r\n851:      {endingBg && <SceneBg file={endingBg} />}\r\n852:      <SceneSurfaceHeader surface=\"flame-crossroads\" route={cleared ? ENDINGS[end