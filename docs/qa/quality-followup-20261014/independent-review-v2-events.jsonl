{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command 'Get-Content tests/quality_pact_focus_20261014.test.ts; Get-Content tests/pact_policy.test.ts; Get-Content tests/quality_final_objective_20261014.test.ts'","aggregated_output":"import { describe, expect, it } from 'vitest'\r\nimport { GODS, godUnlocked } from '../src/core/data/gods'\r\nimport type { Character } from '../src/core/types'\r\nimport { inspectablePactGodIds, pactAvailability, pactFocusTarget, pactRovingFocusId } from '../src/ui/pactPolicy'\r\n\r\nconst data = { fame: 520, regionsCleared: [], family: [{ gen: 1 }] as Character[] }\r\nconst apex = GODS.filter((god) => god.rank === 4).sort((a, b) => a.cost - b.cost)\r\n\r\ndescribe('星契りの閲覧行だけで構成するroving focus', () => {\r\n  it('武功520/踏破なしの極ツ星2行を、封印行から分離して同じ表示順で返す', () => {\r\n    const ids = inspectablePactGodIds(apex, data, true)\r\n    expect(ids).toHaveLength(2)\r\n    expect(ids).toEqual(apex.filter((god) => godUnlocked(god, data)).map((god) => god.id))\r\n    expect(pactRovingFocusId(ids, apex[0].id)).toBe(ids[0])\r\n  })\r\n\r\n  it('既存の閲覧行を保持し、フィルタで失った行は先頭へ補正する', () => {\r\n    expect(pactRovingFocusId(['a', 'b'], 'b')).toBe('b')\r\n    expect(pactRovingFocusId(['c', 'd'], 'b')).toBe('c')\r\n    expect(pactRovingFocusId(['b', 'a'], 'b')).toBe('b')\r\n  })\r\n\r\n  it.each([\r\n    ['a', 'ArrowDown', 'b'], ['b', 'ArrowDown', 'a'],\r\n    ['a', 'ArrowUp', 'b'], ['b', 'ArrowUp', 'a'],\r\n    ['b', 'Home', 'a'], ['a', 'End', 'b'],\r\n  ])('%sから%sで%sへ移る', (from, key, target) => {\r\n    expect(pactFocusTarget(['a', 'b'], from, key)).toBe(target)\r\n  })\r\n\r\n  it('単独行・消えた焦点・無関係のキーを安全に扱う', () => {\r\n    expect(pactFocusTarget(['a'], 'a', 'ArrowDown')).toBe('a')\r\n    expect(pactFocusTarget(['a', 'b'], 'missing', 'ArrowDown')).toBe('a')\r\n    expect(pactFocusTarget(['a', 'b'], 'a', 'Tab')).toBeNull()\r\n  })\r\n\r\n  it('全封印・親なし・0件ではTab入口も矢印先も作らない', () => {\r\n    expect(inspectablePactGodIds(apex, { ...data, fame: 0 }, true)).toEqual([])\r\n    expect(inspectablePactGodIds(apex, data, false)).toEqual([])\r\n    expect(inspectablePactGodIds([], data, true)).toEqual([])\r\n    expect(pactRovingFocusId([], 'a')).toBeNull()\r\n    expect(pactFocusTarget([], 'a', 'Home')).toBeNull()\r\n  })\r\n\r\n  it('費用不足は契約だけを止め、閲覧とfocus候補を失わせない', () => {\r\n    const ids = inspectablePactGodIds(apex, data, true)\r\n    expect(ids).toHaveLength(2)\r\n    expect(pactAvailability(true, 0, 100)).toMatchObject({ inspectable: true, contractable: false })\r\n    expect(pactRovingFocusId(ids, null)).toBe(ids[0])\r\n  })\r\n})\r\nimport { describe, expect, it } from 'vitest'\r\nimport { cheapestUnlockedPactCost, pactAvailability } from '../src/ui/pactPolicy'\r\n\r\ndescribe('星契りの閲覧・契約可否', () => {\r\n  it.each([[0, 80], [0.5, 80], [1, 77], [5, 64], [9, 64]])('縁%sの最安費用を%s奉燈として入口と助言へ渡す', (affinity, expected) => {\r\n    expect(cheapestUnlockedPactCost({\r\n      fame: 0, regionsCleared: [], family: [], godAffinity: { ishiusu: affinity },\r\n    })).toBe(expected)\r\n  })\r\n\r\n  it('封印解除済みなら奉燈不足でも詳細を閲覧できる', () => {\r\n    expect(pactAvailability(true, 40, 100)).toEqual({\r\n      inspectable: true,\r\n      contractable: false,\r\n      reason: '奉燈があと60足りない',\r\n    })\r\n  })\r\n\r\n  it('奉燈が足りれば閲覧も契約もできる', () => {\r\n    expect(pactAvailability(true, 100, 100)).toEqual({ inspectable: true, contractable: true })\r\n  })\r\n\r\n  it('封印中は奉燈に関係なく閲覧できない', () => {\r\n    expect(pactAvailability(false, 999, 100)).toEqual({\r\n      inspectable: false,\r\n      contractable: false,\r\n      reason: 'この星はまだ封印されている',\r\n    })\r\n  })\r\n})\r\nimport { readFileSync } from 'node:fs'\r\nimport { beforeEach, expect, it } from 'vitest'\r\nimport { useGame } from '../src/core/store'\r\nimport { computeObjectives } from '../src/ui/homeObjectives'\r\nimport { ENDINGS } from '../src/core/data/story'\r\n\r\nbeforeEach(() => useGame.getState().newGame(false))\r\n\r\nit.each([0, 1, 2])('結末%dの達成は共通の選択を示し、夜明けを一律に断言しない', (endingType) => {\r\n  const base = useGame.getState().data!\r\n  const data = { ...base, flags: { ...base.flags, cleared: true, endingType } }\r\n  const before = JSON.stringify(data)\r\n  const objective = computeObjectives(data, 1).long[0]\r\n  expect(objective).toEqual({ text: '千年の答えを選ぶ', done: true })\r\n  expect(objective.text).not.toContain('朝を還す')\r\n  expect(JSON.stringify(data)).toBe(before)\r\n})\r\n\r\nit.each([{}, { cleared: true }, { cleared: true, finalePending: true },\r\n  { cleared: true, endingType: -1 }, { cleared: true, endingType: 3 },\r\n  { cleared: false, endingType: 1 }])('選択が確認できない状態では達成を付けない: %j', (flags) => {\r\n  const data = { ...useGame.getState().data!, flags }\r\n  expect(computeObjectives(data, 1).long[0]).toEqual({ text: '千年の答えを選ぶ', done: false })\r\n})\r\n\r\nit('再戦中も、以前の周回内で選んだ答えの達成を消さない', () => {\r\n  const data = { ...useGame.getState().data!, flags: { cleared: true, endingType: 2, finalePending: true } }\r\n  expect(computeObjectives(data, 1).long[0].done).toBe(true)\r\n})\r\n\r\nit('継ぐ後日談は既存本文と同じ代替わりを使い、就任後の八季を約束しない', () => {\r\n  const source = readFileSync(new URL('../src/ui/Scenes.tsx', import.meta.url), 'utf8')\r\n  const epilogue = source.match(/const ENDING_INHERIT = \\[([\\s\\S]*?)\\n\\]/)?.[1]\r\n  expect(epilogue).toBeTruthy()\r\n  expect(ENDINGS.inherit.beats.join('\\n')).toContain('代替わりのたびに')\r\n  expect(epilogue).toContain('代替わりのたびに')\r\n  expect(epilogue).not.toContain('八季ごと')\r\n  expect(epilogue).toContain('夜は、明けない')\r\n})\r\n","exit_code":0,"status":"completed"}}
