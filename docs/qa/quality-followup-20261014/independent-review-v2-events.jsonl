h = recommendStat != null && topBias(candidate.statBias)[0]?.[0] === recommendStat ? 500 : 0\r\n104:        const affordable = effectiveCost <= data.hoto ? 250 : 0\r\n105:        const newBond = contractedGodIds.includes(candidate.id) ? 0 : 30\r\n106:        return statMatch + affordable + newBond - effectiveCost\r\n107:      }\r\n108:      return score(b) - score(a) || a.cost - b.cost\r\n109:    })\r\n110:    .slice(0, 3)\r\n111:  const shownGods = showAllGods ? filteredGods : recommendedGods\r\n112:  const inspectableGodIds = inspectablePactGodIds(shownGods, data, parent !== null)\r\n113:  const tabStopGodId = pactRovingFocusId(inspectableGodIds, activeGodId)\r\n114:\r\n115:  const prediction = useMemo(\r\n116:    () => (parent && god ? predictChild(parent, god) : null),\r\n117:    [parent, god],\r\n118:  )\r\n119:\r\n120:  // 実ステップ(壱親/弐星/参見立て) — 選択状態から導出。ロジック非依存の表示専用(M18)\r\n121:  const pactStep: 1 | 2 | 3 = !parent ? 1 : !god ? 2 : 3\r\n122:\r\n123:  // M26 §9.5: 契るCTAは確認Sheetを開くだけ(M26-P0-01是正)。doPactは確認Sheetの実行CTAからのみ呼ぶ。\r\n124:  const openPactConfirm = () => {\r\n125:    if (!parent || !god || ritual || confirmOpen) return\r\n126:    setConfirmOpen(true)\r\n127:  }\r\n128:\r\n129:  // 確認Sheetの実行CTA(data-testid=\"pact-confirm\")専用。pactFiredRefで二重実行を防ぎ、\r\n130:  // 実行後は即Sheetを閉じて演出へ入る — 演出中はActionDockのCTAもritual状態で無効化される。\r\n131:  const confirmPact = () => {\r\n132:    if (!parent || !god || ritual || pactFiredRef.current) return\r\n133:    pactFiredRef.current = true\r\n134:    setConfirmOpen(false)\r\n135:    setRitual(true)\r\n136:    setTimeout(() => {\r\n137:      doPact(parent.id, god.id)\r\n138:      setRitual(false)\r\n139:      pactFiredRef.current = false\r\n140:    }, 1100)\r\n141:  }\r\n142:\r\n143:  // 画面下固定CTA(ActionDock)の状態 — 未達理由は1行のみ、優先順位: 親→星→奉燈(M18)\r\n144:  const dockCost = god ? pactCost(god, data.godAffinity[god.id] ?? 0) : 0\r\n145:  const dockShortfall = god ? Math.max(0, dockCost - data.hoto) : 0\r\n146:  const dockNote = !parent\r\n147:    ? '親を選べ'\r\n148:    : !god\r\n149:      ? '星神を選べ'\r\n150:      : dockShortfall > 0\r\n151:        ? `奉燈があと${dockShortfall}足りない`\r\n152:        : undefined\r\n153:  const dockReady = Boolean(parent && god && dockShortfall === 0 && !ritual)\r\n154:  const dockLabel = parent && god && dockShortfall === 0\r\n155:    ? `${parent.name} × ${god.name} ／ 奉燈${dockCost} ／ 契る`\r\n156:    : '契る'\r\n157:\r\n158:  return (\r\n159:    <div className=\"screen pact-screen pact-has-dock\">\r\n160:      <NightBackdrop bg={gameImg(HOME_BG)} />\r\n161:      <h1 className=\"season-label\" style={{ marginBottom: 14 }}>交神の儀</h1>\r\n162:      <TsuzuriLine text=\"星神と契れば、翌月に子が生まれる。血潮は親と神から流れ込む — 誰の血を、どの星に継がせる?\" />\r\n163:\r\n164:      <PactSteps step={pactStep} />\r\n165:\r\n166:      <Panel title=\"契る者を選ぶ\">\r\n167:        <div className=\"exp-party\">\r\n168:          {adults.map((c) => (\r\n169:            <CharCard\r\n170:              key={c.id}\r\n171:              char={c}\r\n172:              seasonIndex={data.seasonIndex}\r\n173:              compact\r\n174:              selected={parentId === c.id}\r\n175:              onClick={() => setParentId(c.id)}\r\n176:            />\r\n177:          ))}\r\n178:        </div>\r\n179:      </Panel>\r\n180:\r\n181:      <Panel title={`星神を選ぶ — 奉燈 ${data.hoto}`}>\r\n182:        <div className=\"pact-curation-head\">\r\n183:          <div>\r\n184:            <b>{showAllGods ? '全ての星' : '今夜、血に合う三柱'}</b>\r\n185:            <span>{showAllGods ? '位階・属性・費用から自由に探せる。' : parent ? `${parent.name}の強み・奉燈・未契約を読んだ薦め。どの星を選んでもよい。` : '先に親を選ぶと、血潮に合う理由を示す。'}</span>\r\n186:          </div>\r\n187:          <button\r\n188:            type=\"button\"\r\n189:            className=\"btn btn-ghost\"\r\n190:            aria-expanded={showAllGods}\r\n191:            onClick={() => setShowAllGods((shown) => !shown)}\r\n192:          >\r\n193:            {showAllGods ? '薦め三柱へ戻る' : '全ての星を見る'}\r\n194:          </button>\r\n195:        </div>\r\n196:        {showAllGods && <