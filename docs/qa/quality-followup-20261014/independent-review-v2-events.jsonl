== 'object' || cc.equipment === null) return false\r\n256:    // progression欠落は旧saveとして許容する。存在する値だけは、正規化可能な有限整数に限定する。\r\n257:    if (cc.level !== undefined && (\r\n258:      typeof cc.level !== 'number' || !Number.isFinite(cc.level) || !Number.isInteger(cc.level) || cc.level < 1\r\n259:    )) return false\r\n260:    if (cc.exp !== undefined && (\r\n261:      typeof cc.exp !== 'number' || !Number.isFinite(cc.exp) || !Number.isInteger(cc.exp) || cc.exp < 0\r\n262:    )) return false\r\n263:  }\r\n264:  if (typeof g.seasonIndex !== 'number' || !Number.isFinite(g.seasonIndex) || g.seasonIndex < 0) return false\r\n265:  // M32修正: 配列必須/optional配列の型を検証。非配列の inventory/consumables が通過すると\r\n266:  // store.ts の .map/.filter/.findIndex で初めて例外化する(BAKはロード失敗にしか効かない)。\r\n267:  if (!Array.isArray(g.inventory)) return false\r\n268:  if (g.consumables !== undefined && !Array.isArray(g.consumables)) return false\r\n269:  // M29修正: hotoだけでなくketsuも有限数を要求。ketsu欠落/NaNのセーブが通過すると\r\n270:  // `undefined < cost` でガードを素通りし、鍛錬/打ち直しでNaNが永久伝播する(devil C2の主要ベクタ)。\r\n271:  if (typeof g.hoto !== 'number' || !Number.isFinite(g.hoto)) return false\r\n272:  if (typeof g.ketsu !== 'number' || !Number.isFinite(g.ketsu)) return false\r\n273:  if (!Array.isArray(g.chronicle)) return false\r\n274:  // M34: optionalでも、存在する物語queueはload直後に展開/反復される。壊れた手動importを\r\n275:  // 保存して本体とBAKの両方を読めなくしないよう、入れ子のscene/配列/時刻まで境界で弾く。\r\n276:  if (g.narrative !== undefined && !isValidNarrative(g.narrative)) return false\r\n277:  if (g.collectionV2 !== undefined) {\r\n278:    if (!isRecord(g.collectionV2) || !isRecord(g.collectionV2.itemSeriesBits) || !isStringArray(g.collectionV2.foundingItemIds)) return false\r\n279:    if (Object.values(g.collectionV2.itemSeriesBits).some((bits) => (\r\n280:      typeof bits !== 'number' || !Number.isInteger(bits) || bits < 0 || bits > 0x7fff\r\n281:    ))) return false\r\n282:  }\r\n283:  if (g.designatedHeirId !== undefined && typeof g.designatedHeirId !== 'string') return false\r\n284:  if (g.successionPending !== undefined && (!isRecord(g.successionPending) ||\r\n285:    typeof g.successionPending.predecessorId !== 'string' || !isStringArray(g.successionPending.heirloomIds))) return false\r\n100:  return scene.kind === 'dream' || scene.kind === 'dreamEp' || (scene.kind === 'life' && !!scene.narrativeId?.startsWith('ch'))\r\n101:}\r\n102:\r\n103:/**\r\n104: * M34 save migration. Sentinelが無い旧saveだけ実名開示を保守的に導出する。\r\n105: * 現行saveへlegacy ORを再適用しないことが、ch4途中reloadの必須条件。\r\n106: */\r\n107:export function migrateM34Narrative(data: GameData): GameData {\r\n108:  const legacy = data.flags?.m34_narrative_schema !== 1\r\n109:  const flags = { ...(data.flags ?? {}) }\r\n110:  if (legacy) {\r\n111:    const legacyReveal = Boolean(\r\n112:      flags.ch4 ||\r\n113:      (data.gossipIndex ?? 0) >= 12 ||\r\n114:      flags.shioriPhase ||\r\n115:      flags.endingType !== undefined ||\r\n116:      flags.cleared,\r\n117:    )\r\n118:    flags.m34_narrative_schema = 1\r\n119:    flags.reveal_shiori_name = legacyReveal\r\n120:    flags.legacy_shiori_recap_pending = legacyReveal\r\n121:    if (legacyReveal) flags.ch4_completed = true\r\n122:  }\r\n123:\r\n124:  const completed = [...new Set([\r\n125:    ...(data.narrative?.completed ?? []),\r\n126:    ...completedFromFlags({ ...data, flags }, legacy),\r\n127:  ])]\r\n128:  const seen = [...new Set([...(data.narrative?.seen ?? []), ...completed])]\r\n129:  const archive = uniqueScenes([\r\n130:    ...(data.narrative?.archive ?? []),\r\n131:    ...completed.map(replayableSceneForId).filter((scene): scene is NarrativeScene => !!scene),\r\n132:  ]).filter(isReplayableNarrativeScene)\r\n133:  const deferred = [...(data.narrative?.deferred ?? [])]\r\n134:  const fallbackDeferredAt = data.lastPlayedAt ?? Date.now()\r\n135:  const deferredSince = Object.fromEntries(deferred.map((scene) => {\r\n136:    const id = narrativeSceneId(scene)\r\n137:    return [id, data.narrative?.deferredSince?.[id] ?? fallbackDeferredAt]\r\n","exit_