ndefined} />\r\n137:          {char.tomoshigata && (\r\n138:            <MaybeImg\r\n139:              src={gameImg(`emb_${char.tomoshigata}_${char.element}.png`)}\r\n140:              className=\"char-emb\"\r\n141:            />\r\n142:          )}\r\n143:        </div>\r\n144:        <div className=\"char-card-body\">\r\n145:          <div className=\"char-head\">\r\n146:            <span className={`element-badge el-${char.element}`}>{ELEMENT_LABELS[char.element]}</span>\r\n147:            <span className=\"char-name\">\r\n148:              {char.isHead && <span className=\"head-mark\">当主</span>}\r\n149:              {char.name}\r\n150:            </span>\r\n151:            <span className=\"char-gen\">{char.gen}代</span>\r\n152:          </div>\r\n153:          <LifeFlames char={char} seasonIndex={seasonIndex} />\r\n154:          {age < 6 && <div className=\"child-note\">幼子(あと{6 - age}月で成人)</div>}\r\n155:          {progressionMode && (\r\n156:            <CharacterProgression\r\n157:              char={char}\r\n158:              seasonIndex={seasonIndex}\r\n159:              detail={progressionMode === 'detail'}\r\n160:            />\r\n161:          )}\r\n162:          {!compact && (\r\n163:            <>\r\n164:              <div className=\"char-meta\">\r\n165:                {p.label} / {god.name}の子\r\n166:                {char.tomoshigata && ` / 灯座「${tozaOf(char.tomoshigata, char.element).name}」`}\r\n167:              </div>\r\n168:              <Bar value={char.hp} max={char.maxHp} kind=\"hp\" />\r\n169:              <Bar value={char.mp} max={char.maxMp} kind=\"mp\" />\r\n170:              <StatGrid stats={char.stats} />\r\n171:            </>\r\n172:          )}\r\n173:        </div>\r\n174:      </div>\r\n175:      {children}\r\n176:    </>\r\n177:  )\r\n178:  if (onClick) {\r\n179:    return (\r\n180:      <button\r\n181:        type=\"button\"\r\n182:        className={className}\r\n183:        aria-pressed={Boolean(selected)}\r\n184:        onClick={onClick}\r\n185:      >\r\n186:        {content}\r\n187:      </button>\r\n188:    )\r\n189:  }\r\n190:  return <div className={className}>{content}</div>\r\n191:}\r\n192:\r\n193:const M46_STAT_KEYS: readonly StatKey[] = ['str', 'vit', 'dex', 'agi', 'mnd', 'luk']\r\n194:\r\n195:function aptitudeLabel(value: number): string {\r\n315:    .sort((a, b) => (a.deathSeason ?? Number.MAX_SAFE_INTEGER) - (b.deathSeason ?? Number.MAX_SAFE_INTEGER))[0]\r\n316:  const ownership = new Map<string, { item: GameData['inventory'][number]; owner?: Character }>()\r\n317:  for (const item of data.inventory) ownership.set(item.id, { item })\r\n318:  for (const char of data.family) {\r\n319:    for (const item of Object.values(char.equipment)) if (item) ownership.set(item.id, { item, owner: char })\r\n320:  }\r\n321:  const oldestItem = [...ownership.values()].sort((a, b) => b.item.generation - a.item.generation)[0]\r\n322:  const heirloom = oldestItem && oldestItem.item.generation > 0 ? oldestItem : undefined\r\n323:  const completedLoreCount = Object.values(data.loreFrags ?? {}).filter((n) => n >= 3).length\r\n324:  const nemesis = [...(data.nemeses ?? [])].sort((a, b) => b.level - a.level)[0]\r\n325:  const head = data.family.find((c) => c.alive && c.isHead) ?? data.family[0]\r\n326:  return { firstDead, heirloom, completedLoreCount, nemesis, head }\r\n327:}\r\n328:\r\n329:export function familyFinaleEchoes(data: GameData): FamilyEcho[] {\r\n330:  const out: FamilyEcho[] = []\r\n331:  const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n332:  if (firstDead) {\r\n333:    out.push({ label: '最初に見送った灯', text: `${firstDead.name}${firstDead.lastWords ? `「${firstDead.lastWords.slice(0, 24)}」` : ` — ${firstDead.epitaph}`}` })\r\n334:  }\r\n335:  if (heirloom) {\r\n336:    out.push({\r\n337:      label: '最も長く継いだ形見',\r\n338:      text: `${heirloom.item.name} — ${heirloom.item.legacyFirstOwner ? `${heirloom.item.legacyFirstOwner}から` : ''}${heirloom.item.generation}代${heirloom.owner ? `、${heirloom.owner.name}の手にある` : ''}`,\r\n339:    })\r\n340:  }\r\n341:\r\n342:  if (nemesis) out.push({ label: '因縁を結んだ名', text: `${nemesis.name} — ${nemesis.victim}の仇` })\r\n343:  else if (completedLoreCount > 0) out.push({ label: '真相まで読んだ土地', text: `${completedLoreCount}つの土地の縁起を、最後まで記した` })\r\n344:\r\n345:  if (out.length === 0) {\r\n346:    out.push({ label: 'ここへ運んだ灯', text: `${head?.name ?? '名もなき当主'}が、家の最初の答えを選ぶ` })\r\n347:  }\r\n348:  return out.slice(0, 3)\r\n349:}\r\n350:\r\n351:export function personalizedEndingBeat(data: GameData, ending: 'cut' | 'save' | 'inherit'): string {\r\n352:  const { firstDead, heirloom, completedLoreCount, nemesis, head } = familyFinaleContext(data)\r\n353:  const family = firstDead ? `${firstDead.name}から続く一族` : head ? `${head.name}の一族` : '名もなき一族'\r\n354:  const memories: string[] = []\r\n355:  if (heirloom) memories.push(`${heirloom.item.name}は${heirloom.item.generation}代、手を渡ってきた。`)\r\n356:  if (nemesis) memories.push(`${nemesis.name}と${nemesis.victim}の因縁も、家譜に残っている。`)\r\n357:  else if (completedLoreCount > 0) memories.push(`${completedLoreCount}つの土地の縁起を、最後まで家譜に記した。`)\r\n358:  if (ending === 'cut') memories.push(`${family}の名を読み上げ、二人を独りにしないまま、千年の夜を送った。`)\r\n359:  else if (ending === 'save') memories.push(`${family}が運んだ灯も封印へ重なった。今度の錠前は、誰か一人の犠牲ではない。`)\r\n360:  else memories.push(`${family}が継いだ名と役目は、頂と郷を往き来する新しい家譜になった。`)\r\n361:  return memories.join('')\r\n362:}\r\n363:\r\n364:export function regionQuestion(regionName: string, loreFragments: number, cleared: boolean): string {\r\n365:  if (cleared) return `${regionName}で終われた想いを、次の夜へどう渡す。`\r\n366:  if (loreFragments >= 3) return `事情を知った今、${regionName}の主へどんな終わりを渡す。`\r\n367:  if (loreFragments > 0) return `${regionName}に残る声は、何を守り続けている。`\r\n368:  return `${regionName}の闇で、終われずにいるのは誰だ。`\r\n369:}\r\n370:\r\n371:export function bossEmotion(regionName: string, loreFragments: number): string {\r\n372:  if (loreFragments >= 3) return `${regionName}の主は、忘れまいとして立ちはだかる。`\r\n373:  if (loreFragments > 0) return `${regionName}の主は、待ち焦がれるようにこちらを見る。`\r\n374:  return `${regionName}の主は、名もない願いを守り抜こうとしている。`\r\n375:}\r\n376:\r\n377:export interface ReturnTrace {\r\n378:  kind: 'human' | 'land' | 'myth'\r\n379:  text: string\r\n380:}\r\n183:const INTRO_BEATS = [\r\n184:  '千年前、この郷から太陽が消えた。',\r\n185:  '星喰いの神・玄冬(げんとう)が、空を喰らったのだ。',\r\n186:  '旅の楽士は、己の寿命を薪として大燈籠に火を点し、郷を常夜から守った。',\r\n187:  'だが火は完全ではなかった。その楽士の血族には、二つの呪いが残った。',\r\n188:  '一つ。生まれて八つの季節で、体の内の灯が燃え尽きること — 「八季の命」。',\r\n189:  '一つ。人と子を成せぬこと — 「結ばれぬ身」。',\r\n190:  'ゆえに一族は、夜空の星神と契りて子を授かり、代を継いで戦い続けてきた。',\r\n191:  '目指すは夜藪の最深部、灯ノ御山の頂。玄冬の御座。',\r\n192:  '……さて。千年目の当主よ。あんたの名は燈吾。残る命は、五季。',\r\n193:  '筆は持った。あんたら一族の生き様、この綴(つづり)が一字も漏らさず書き残す。',\r\n194:  '— ゆけ。灯を、継いでゆけ。',\r\n195:]\r\n196:\r\n/* Pact.tsx 専用 M18 P3 追加分 — 契約: docs/UI_SHELL_API.md\r\n   既存 index.css の行は編集しない(このファイルのみで完結)。\r\n   .pact-screen 側のクラスは既存(index.css)を再利用し、ここでは新規要素のみ定義する。 */\r\n\r\n/* ActionDock ぶんの逃げ — shell.has-dock 相当(UI_SHELL_API §契約) */\r\n.pact-has-dock { padding-bottom: 96px; }\r\n\r\n/* 実ステップ表示(壱親/弐星/参見立て) — 現在=--sel、完了=金、未来=text-dim。色だけに頼らず▼現在印を併記 */\r\n.pact-steps {\r\n  display: flex; align-items: center; flex-wrap: wrap; gap: 6px;\r\n  margin: 4px 0 14px; padding: 8px 12px;\r\n  border: 1px solid var(--panel-border); border-radius: 6px;\r\n  background: rgba(10, 14, 30, 0.55);\r\n}\r\n.pact-step-wrap { display: flex; align-items: center; gap: 6px; }\r\n.pact-step { display: inline-flex; align-items: baseline; gap: 6px; font-size: 13px; letter-spacing: 0.04em; }\r\n.pact-step-numeral { font-weight: 700; }\r\n.pact-step-label { }\r\n.pact-step-mark { font-size: 11px; color: var(--sel); font-weight: 700; }\r\n.pact-step-sep { color: var(--text-dim); opacity: 0.5; margin: 0 2px; }\r\n\r\n.pact-step-done { color: var(--gold); }\r\n.pact-step-current { color: var(--sel); font-weight: 700; }\r\n.pact-step-future { color: var(--text-dim); }\r\n\r\n/* 子の見立て — 伸びる2能力・弱い1能力の一言(表示専用) */\r\n.gene-predict-summary { font-size: 12.5px; color: var(--text); margin-top: 6px; line-height: 1.6; }\r\n\r\n@media (max-width: 640px) {\r\n  .pact-steps { gap: 4px; padding: 6px 10px; }\r\n  .pact-step { font-size: 12px; }\r\n}\r\n\r\n/* 神絵欠落時は簡易立ち絵を描かず、属性印と状態説明だけを残す。 */\r\n.god-fallback {\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n.god-fallback-mark {\r\n  display: grid;\r\n  place-items: center;\r\n  width: 78px;\r\n  height: 78px;\r\n  z-index: 1;\r\n  border: 1px solid currentColor;\r\n  border-radius: 50%;\r\n  color: var(--gold);\r\n  background: rgba(10, 14, 29, .78);\r\n  box-shadow: 0 0 24px rgba(10, 14, 29, .9), inset 0 0 0 6px rgba(201, 168, 106, .04);\r\n  font: 600 24px/1 'Yu Mincho', 'Hiragino Mincho ProN', serif;\r\n  letter-spacing: 0;\r\n}\r\n.god-fallback-name {\r\n  z-index: 1;\r\n  font-size: 21px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.28em;\r\n  color: var(--text);\r\n  text-shadow: 0 0 10px rgba(0, 0, 0, 0.8);\r\n  margin-top: 4px;\r\n}\r\n.god-fallback-kana {\r\n  z-index: 1;\r\n  font-size: 12.5px;\r\n  color: var(--text-dim);\r\n  letter-spacing: 0.18em;\r\n  margin-top: 2px;\r\n}\r\n.god-fallback-note {\r\n  z-index: 1;\r\n  margin-top: 8px;\r\n  padding: 2px 10px;\r\n  border: 1px solid var(--panel-border);\r\n  border-radius: 10px;\r\n  font-size: 12.5px;\r\n  color: var(--text-dim);\r\n  background: rgba(10, 14, 29, 0.55);\r\n}\r\n/* 図鑑詳細・一覧などの小型枠(高さは転送されたclassName側が優先) */\r\n.god-fallback-sm {\r\n  min-height: 150px;\r\n}\r\n.god-fallback.is-fallback { overflow: hidden; }\r\n.god-fallback-sm .god-fallback-mark { width: 54px; height: 54px; font-size: 18px; }\r\n.god-fallback-sm .god-fallback-name { font-size: 15px; letter-spacing: 0.2em; }\r\n.god-fallback-sm .god-fallback-note { font-size: 11.5px; margin-top: 5px; }\r\n","exit_code":0,"status":"completed"}}
