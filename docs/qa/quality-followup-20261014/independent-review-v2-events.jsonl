{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$n=0; Get-Content src/core/data/story.ts | ForEach-Object { $n++; \"${n}:$_\" }'","aggregated_output":"1:// 本編の章立てとマルチエンディング(v3.1 M15-4)\r\n2:// 章は条件を満たした月に一度だけ語られる(綴りや夢の声)。結末は最終決戦後の選択で分岐。\r\n3:export interface StoryChapter {\r\n4:  id: string // flagsに記録するキー\r\n5:  title: string\r\n6:  lines: { speaker: string; text: string }[]\r\n7:}\r\n8:\r\n9:export const CHAPTERS: StoryChapter[] = [\r\n10:  {\r\n11:    id: 'ch1',\r\n12:    title: '第一章 常夜',\r\n13:    lines: [\r\n14:      { speaker: '綴', text: '……なあ、当主どの。なぜ夜が明けぬか、一度でも考えたことはあるか。' },\r\n15:      { speaker: '綴', text: '千年前、空に「玄冬」が座った。星を喰らう神だ。太陽も、あれに呑まれたきり戻らぬ。' },\r\n16:      { speaker: '綴', text: 'それでも郷が息をしているのは、大燈籠の火と、あんたら燈守の血——その二つきりのおかげだ。' },\r\n17:      { speaker: '綴', text: 'あんたらの命は八季で燃え尽きる。短い。だがこの戦は、一代で勝つものではないのだ。' },\r\n18:      { speaker: '綴', text: '親が半歩、子がまた半歩。灯を継いで、じわりと頂へ寄る。それを千年、繰り返してきた。' },\r\n19:      { speaker: '', text: '——夜藪の奥で、何かが目を覚ます気配がした。' },\r\n20:      { speaker: '綴', text: '……妙だな。飢えた獣の気配じゃない。あれはもっと——途方に暮れて、誰かを待つ者の気配だ。' },\r\n21:    ],\r\n22:  },\r\n23:  {\r\n24:    id: 'ch2',\r\n25:    title: '第二章 主たちの無念',\r\n26:    lines: [\r\n27:      { speaker: '綴', text: '主を一つ、鎮めたな。……気づいたか? あれらは、ただの化け物ではない。' },\r\n28:      { speaker: '綴', text: '待ち続ける者。守り続ける者。呼び続ける者。常夜は、千年分の「終われなかった想い」で満ちている。' },\r\n29:      { speaker: '綴', text: '石碑を探せ。土地の縁起を知れば、なぜあれが終われぬのか——鎮め方も、見えてくる。' },\r\n30:      { speaker: '綴', text: '想いが凝れば、化けて主となる。……ならば、と俺はときどき恐ろしくなる。' },\r\n31:      { speaker: '綴', text: '頂に千年座す、あの「神」もまた——終われずにいる、ただの誰かではないのか、とな。' },\r\n32:      { speaker: '', text: 'その一言は、口にした端から夜に吸われて消えた。綴はそれを、黙って家譜の隅に書き留めた。' },\r\n33:    ],\r\n34:  },\r\n35:  {\r\n36:    id: 'ch3',\r\n37:    title: '第三章 星喰いの影',\r\n38:    lines: [\r\n39:      { speaker: '', text: '夢を見た。空の頂で、巨大な面が、ゆっくりとこちらを向く夢だ。' },\r\n40:      { speaker: '玄冬(?)', text: '『……クルナ。……コレ以上、チカヨルナ』' },\r\n41:      { speaker: '', text: '威嚇では、なかった。あれはむしろ——懇願に、聞こえた。' },\r\n42:      { speaker: '綴', text: '玄冬が「言葉」を持つなど、千年、誰ひとり聞いたことがない。……何かが、おかしい。' },\r\n43:      { speaker: '', text: '面の声の、さらに奥。糸のように細い楽の音がひとすじ。誰かが、宥めるように爪弾いていた。' },\r\n44:      { speaker: '綴', text: 'この夢を見たあんたは、頂に届く前に逝くかもしれん。だから書いておく。次の代が、続きを見るために。' },\r\n45:    ],\r\n46:  },\r\n47:  {\r\n48:    id: 'ch4',\r\n49:    title: '第四章 楽士の秘密',\r\n50:    lines: [\r\n51:      { speaker: '綴', text: '家譜の、いちばん最初の頁を開いた。名だけが擦れている。初代は、旅の楽士だったと、そこに在る。' },\r\n52:      { speaker: '綴', text: '千年前、その楽士は単身で御山に登った。そして——降りて、こなかった。' },\r\n53:      { speaker: '綴', text: 'ずっと解せなんだ。誰も止められぬ星喰いを前に、この郷はなぜ千年も保ったのか。' },\r\n54:      { speaker: '綴', text: '……答えは、単純で、むごい。面の下で誰かが、内側から星喰いを抱き止めている。千年、たった独りで。' },\r\n55:      { speaker: '', text: '御山の風が運ぶあの楽の音は——その、独りの音だ。' },\r\n56:      { speaker: '綴', text: 'あんたらの産声を、辞世を、俺はこの手で書き留めてきた。……だが、な。' },\r\n57:      { speaker: '綴', text: 'それを俺の肩ごしに、千年ずっと聴いていた者がいたとしたら。どんな心地で、聴いていたと思う。' },\r\n58:      { speaker: '', text: '擦れていた墨が、夜露のように滲む。——汐里。これが、初代の名だ。' },\r\n59:    ],\r\n60:  },\r\n61:  {\r\n62:    id: 'ch5',\r\n63:    title: '第五章 頂へ',\r\n64:    lines: [\r\n65:      { speaker: '綴', text: '武功は届いた。御山への道が、ついに開いている。' },\r\n66:      { speaker: '綴', text: '行けば、千年の答えに会う。それが救いになるか、別れになるかは——あんたら次第だ。' },\r\n67:      { speaker: '綴', text: '思えば、遠い道だった。数え切れぬ八季が、みな、この一歩のためにあったのだな。' },\r\n68:      { speaker: '綴', text: '一つも、無駄ではなかった。逝った者の分まで、あんたらの灯は重くなっている。' },\r\n69:      { speaker: '綴', text: '家譜は、ここまで俺が書いた。この先の頁を綴じるのは——生きている、あんたらだ。' },\r\n70:      { speaker: '', text: '山の方から風が吹く。「急がないで」と、聞き覚えのある声が微かに混じった気がした。' },\r\n71:      { speaker: '', text: '一族の灯を束ね、頂を目指す時が来た。' },\r\n72:    ],\r\n73:  },\r\n74:]\r\n75:\r\n76:// 結末3種 — 最終決戦(汐里)後の選択で分岐\r\n77:export type EndingType = 'cut' | 'save' | 'inherit'\r\n78:\r\n79:export const FINALE_CHOICES: { id: EndingType; label: string; desc: string }[] = [\r\n80:  { id: 'cut', label: '送る — 千年を終わらせる', desc: '一族の名を読み上げ、汐里と玄冬を看取り、常夜を終える。' },\r\n81:  { id: 'save', label: '救う — 共に封じ直す', desc: '一族の灯を分かち、汐里と共に封印を編み直す。夜は残るが、独りにはさせない。' },\r\n82:  { id: 'inherit', label: '継ぐ — 錠前を代わる', desc: '当主が汐里の座を継ぎ、汐里を千年ぶりに解放する。' },\r\n83:]\r\n84:\r\n85:export const ENDINGS: Record<EndingType, { title: string; beats: string[] }> = {\r\n86:  cut: {\r\n87:    title: '結 — 夜明け',\r\n88:    beats: [\r\n89:      '汐里は微笑んで、楽を置いた。「……ありがとう。もう、来てくれたのね。私の、遠い遠い子どもたち」',\r\n90:      '当主は刃を納め、代わりに家譜を開いた。千年分の名を、一人ずつ、声に出して読み上げていく。',\r\n91:      '汐里は聴いている。子守唄に耳を澄ますように、ひとつ頷くごとに、その身が透きとおってゆく。',\r\n92:      '最後の名が読み終えられたとき、千年の演目が、終わった。星喰いは——眠るように、消えた。',\r\n93:      '「もう、いいのね。もう、休んでいいのね」玄冬の面が砕け、空に、亀裂のような光が走った。',\r\n94:    ],\r\n95:  },\r\n96:  save: {\r\n97:    title: '結 — 二人の錠前',\r\n98:    beats: [\r\n99:      '「独りで千年は、長すぎた」当主はそう言って、汐里の隣に灯を置いた。',\r\n100:      '一族の灯が御山に環をなし、封印は千年ぶりに編み直された。今度は、誰も独りではない。',\r\n101:      '夜は残った。だが郷の者は言う——最近の夜は、どこか温かい、と。',\r\n102:      '御山の頂からは時折、二重奏の楽の音が降りてくる。',\r\n103:    ],\r\n104:  },\r\n105:  inherit: {\r\n106:    title: '結 — 灯継ぎ',\r\n107:    beats: [\r\n108:      '「千年、ようやった。……あとは、うちの家系に任せろ」',\r\n109:      '当主は面を受け取り、頂の座についた。汐里は千年ぶりに山を降りた。',\r\n110:      '郷に戻った汐里を、家族たちが迎える。彼女は泣きながら、初めて温かい飯を食べた。',\r\n111:      '頂の面の下で、新しい錠前が静かに歌っている。その歌は、代替わりのたびに引き継がれ、続いていく。',\r\n112:    ],\r\n113:  },\r\n114:}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content src/ui/homeObjectives.ts; rg -n 'computeObjectives|objective|pact|ending|cleared|千年|朝を|長期' src/ui/Home.tsx; rg -n 'ENDING_|endingType|inherit|finale|ENDINGS|八季|代替わり' src/ui/Scenes.tsx\"","aggregated_output":"import { ENEMIES } from '../core/data/enemies'\r\nimport { REGIONS } from '../core/data/regions'\r\nimport { seasonsLeft } from '../core/inheritance'\r\nimport type { GameData } from '../core/types'\r\n\r\nexport type Objective = { text: string; go?: 'pact' | 'depart' | 'chronicle' | 'codex'; goLabel?: string; progress?: [number, number]; done?: boolean }\r\n\r\n// 現在の記録から導出する。目標の表示だけでゲーム状態は変更しない。\r\nexport function computeObjectives(data: GameData, adultCount: number): { short: Objective[]; mid: Objective[]; long: Objective[] } {\r\n  const alive = data.family.filter((c) => c.alive)\r\n  const head = alive.find((c) => c.isHead)\r\n  const gens = data.family.length > 0 ? Math.max(...data.family.map((c) => c.gen)) : 0\r\n  const baseEnemies = ENEMIES.filter((e) => !/_[wo]$/.test(e.id))\r\n  const enemySeen = new Set((data.codex?.enemies ?? []).map((id) => id.replace(/_[wo]$/, ''))).size\r\n  const bossRegions = REGIONS.filter((r) => r.bossId && r.id !== 'tokoyo_tou')\r\n  const clearedSet = new Set(data.regionsCleared)\r\n\r\n  // 短期(今すぐ〜この代)\r\n  const short: Objective[] = []\r\n  if (head && seasonsLeft(head, data.seasonIndex) <= 3 && data.pendingBirths.length === 0) {\r\n    short.push({ text: `当主 ${head.name} の灯が細い。次代を残す`, go: 'pact', goLabel: '星契りへ' })\r\n  }\r\n  if (alive.length <= 2 && data.pendingBirths.length === 0 && adultCount > 0) {\r\n    short.push({ text: '血が細い。星と契り、子を授かる', go: 'pact', goLabel: '星契りへ' })\r\n  }\r\n  if (adultCount > 0) short.push({ text: '夜藪へ出立し、奉燈と血珠を持ち帰る', go: 'depart', goLabel: '出立へ' })\r\n  if (short.length === 0) short.push({ text: '子が育つのを待ち、次の一手を練る' })\r\n\r\n  // 中期(この周回)\r\n  const mid: Objective[] = []\r\n  const nextLocked = REGIONS.filter((r) => r.unlockFame > data.fame && r.id !== 'tokoyo_tou').sort((a, b) => a.unlockFame - b.unlockFame)[0]\r\n  if (nextLocked) mid.push({ text: `「${nextLocked.name}」への道を開く`, progress: [data.fame, nextLocked.unlockFame], go: 'depart', goLabel: '出立へ' })\r\n  const nextBoss = bossRegions.filter((r) => r.unlockFame <= data.fame && !clearedSet.has(r.id)).sort((a, b) => a.tier - b.tier)[0]\r\n  if (nextBoss) mid.push({ text: `「${nextBoss.name}」の主を鎮める`, go: 'depart', goLabel: '出立へ' })\r\n  mid.push({ text: '血を継ぎ、代を重ねる', progress: [gens, 10] })\r\n  mid.push({ text: '魔性を見聞し、図鑑を埋める', progress: [enemySeen, baseEnemies.length], go: 'codex', goLabel: '図鑑へ' })\r\n\r\n  // 長期(千年紀)\r\n  const long: Objective[] = []\r\n  const chosenEnding = data.flags.endingType\r\n  const hasChosenEnding = data.flags.cleared === true && (chosenEnding === 0 || chosenEnding === 1 || chosenEnding === 2)\r\n  long.push({ text: '千年の答えを選ぶ', done: hasChosenEnding })\r\n  long.push({ text: '全ての地の主を鎮める', progress: [data.regionsCleared.filter((id) => bossRegions.some((r) => r.id === id)).length, bossRegions.length] })\r\n  if (data.flags.cleared) {\r\n    const tower = typeof data.flags.towerBest === 'number' ? data.flags.towerBest : 0\r\n    long.push({ text: '常夜百層を、深く制す', progress: [tower, 100] })\r\n  }\r\n  return { short, mid, long }\r\n}\r\n7:import { cheapestUnlockedPactCost } from './pactPolicy'\r\n8:import { computeObjectives, type Objective } from './homeObjectives'\r\n32:    case 'dreamEp': return '夢渡り — 千年前の記憶'\n86:    : priorityRec.action === 'pact' ? '子を授けたら出立' : !cen.hasHeir && canPact ? '実りを得たら星契り' : '帰還後に一族を見直す'\n239:            rec={priorityRec.action === 'pact'}\n240:            iconName=\"ic_pact\" iconFb=\"契\" title=\"星契り — 次代を授かる\"\r\n248:            onClick={() => setScreen({ id: 'pact' })}\r\n287:              {latestReturnTraces.map((trace) => <p key={trace.kind}><span>{trace.kind === 'human' ? '人' : trace.kind === 'land' ? '土地' : '千年'}</span>{trace.text}</p>)}\n346:              else if (key === 'objectives') setShowObjectives(true)\n385:const ACTION_LABEL: Record<ActionKind, string> = { depart: '出立', pact: '星契り', festival: '祭', rest: '静養' }\r\n428:  const tendingAmount = Math.min(missingMp, Math.max(1, Math.ceil(sel.maxMp * LANTERN_TENDING_RATIO)))\n441:            <b>灯芯手入れ — {sel.name}の灯力を{tendingAmount > 0 ? `${tendingAmount}回復` : '満ちたまま保つ'}</b>\n464:                compact\n546:  if (data.flags.cleared) work.push({ key: 'tower', label: '常夜百層', value: `深さ${typeof data.flags.towerBest === 'number' ? data.flags.towerBest : 0}` })\n698:      ['NG+(継承周回)。', '物語を見届けたあと、血と記録を継いで新たな千年紀を始められる。'],\r\n707:    <Sheet title=\"綴の手引き — 千年ぶん、要点だけな\" onClose={onClose}>\r\n724:// ---- 務め(目標階層) — 研究の density of goals / 短期・中期・長期の重ね合わせ ----\r\n732:  const { short, mid, long } = computeObjectives(data, adults)\r\n744:    ['紀', '千年紀の務め', long],\r\n750:          今すぐ・この代・千年紀 — 三つの時の尺で、進むべき道を映す。\r\n48:import { ENDINGS, FINALE_CHOICES } from '../core/data/story'\n251:          与えられた命は八季(廿四月)。六月で成人し、隊に加われる。\n271:  // 生涯ダイジェスト(M15-2): この人の八季を、巻物のように振り返る\n333:          綴「……よう生きた。あんたの八季、確かに書き留めたぞ」\n733:// cut(送る=夜明け)の後日談。クライマックス(ENDINGS.cut.beats=看取り・面砕け)と重複させず、\n734:// その「あと」だけを描く — 夜が明け、太陽が昇り、八季で死なぬ子が生まれ、家譜が閉じられる。\n735:const ENDING_CLEARED = [\n738:  'その春、燈守家に子が生まれた。八季では死なない、初めての子が。',\n744:const ENDING_EXTINCT = [\n752:// v3.2 M18: 結末別エピローグ。cut(送る=夜明け)は ENDING_CLEARED を流用。\n753:// save(救う)/inherit(継ぐ)は「夜は残る」帰結のため、太陽・夜明けを断言しない専用の結びを用意する。\n754:const ENDING_SAVE = [\n763:const ENDING_INHERIT = [\n767:  '夜は、明けない。だが頂の座は、もう永遠の牢ではない。代替わりのたびに、次の灯が、交代しに登ってゆく。',\n779:    <div className=\"scene-screen screen finale-screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"finale\">\n782:      <section className=\"finale-memory\" data-scene-group=\"context\" aria-label=\"一族がここまで運んだもの\">\n783:        <div className=\"scene-body finale-intro\">\n787:        <p className=\"finale-question\">今代の問い<span>{data.narrative?.generationQuestion ?? generationQuestion(data)}</span></p>\n788:        <div className=\"finale-echoes\">\n795:        <p className=\"finale-resonance\">{resonanceLine(data)}</p>\n797:      <p className=\"finale-prompt\">この選択が、一族の千年の答えになる。</p>\n798:      <div className=\"finale-choices\" data-zone=\"finale-choices\" data-scene-group=\"decision\">\n802:            className={`btn finale-choice${pendingChoice === i ? ' selected' : ''}`}\n811:          <div className=\"finale-confirm\" role=\"group\" aria-label={`${FINALE_CHOICES[pendingChoice].label}の確認`}>\n834:  const endType = (typeof data.flags.endingType === 'number'\n835:    ? (['cut', 'save', 'inherit'] as const)[data.flags.endingType]\n837:  const climaxBeats = ENDINGS[endType].beats\n838:  // v3.2 M18: 結末別エピローグ。cut=夜明け(ENDING_CLEARED)、save/inherit=夜が残る帰結へ整合。\n839:  const epilogue = endType === 'save' ? ENDING_SAVE : endType === 'inherit' ? ENDING_INHERIT : ENDING_CLEARED\n841:  const beats = cleared ? [...climaxBeats, personalizedEndingBeat(data, endType), ...epilogue] : ENDING_EXTINCT\n845:  // 山場(cut/save/inherit別)→_a、その後の共通エピローグ(ENDING_CLEARED)→_b。断絶(未clear)は画無し。\n853:    <div className=\"scene-screen screen vc3b-scene vc3b-finale-scene\" data-scene-surface=\"flame-crossroads\" data-scene-route=\"ending\" onClick={() => { if (!done) { audio.se('page'); setBeat(beat + 1) } }}>\n855:      <SceneSurfaceHeader surface=\"flame-crossroads\" route={cleared ? ENDINGS[endType].title : '断絶'} title={cleared ? '灯継ぎ' : '断絶'} context={cleared ? '選んだ灯の行方を見届け、次の家譜へ。' : '途切れた家譜にも、読まれる日を待つ頁が残る。'} />\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"星契りでは、封印中・親未選択・奉燈不足を別々に扱い、閲覧できる行だけにキーボードの移動先を絞っています。長期目標も三つの結末に共通する文言になっています。続いて、既存の記録を読み込む経路と、本文から後日談までのつながりを確認します。\n"}}
