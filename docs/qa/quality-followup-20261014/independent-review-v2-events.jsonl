} tone=\"god\" />\r\n332:              ))}\r\n333:            </div>\r\n334:            <div className=\"gene-col gene-col-wide\">\r\n335:              <div className=\"gene-col-title\">子の見立て(範囲)</div>\r\n336:              {(Object.keys(STAT_LABELS) as StatKey[]).map((k) => {\r\n337:                const [lo, hi] = prediction[k]\r\n338:                return (\r\n339:                  <div key={k} className=\"predict-row\">\r\n340:                    <span className=\"predict-label\">{STAT_LABELS[k]}</span>\r\n341:                    <span className=\"predict-track\">\r\n342:                      <span\r\n343:                        className=\"predict-range\"\r\n344:                        style={{ left: `${(lo / 120) * 100}%`, width: `${((hi - lo) / 120) * 100}%` }}\r\n345:                      />\r\n346:                    </span>\r\n347:                    <span className=\"predict-num\">{lo}〜{hi}</span>\r\n348:                  </div>\r\n349:                )\r\n350:              })}\r\n351:              <p className=\"gene-note\">\r\n352:                期待値: 親の脈×0.48+星の脈×0.55(上限120)。星脈は{ELEMENT_LABELS[god.element]}(七割)/\r\n353:                {ELEMENT_LABELS[parent.element]}(三割)で子の灯座の軸となる。\r\n354:              </p>\r\n355:              <p className=\"gene-predict-summary\">{predictionSummary(prediction)}</p>\r\n356:            </div>\r\n357:          </div>\r\n358:          {Math.floor(data.godAffinity[god.id] ?? 0) >= GOD_MAX_AFFINITY && (\r\n359:            <StatusCallout kind=\"boon\" title=\"縁が極まった\">\r\n360:              この星とはもはや相思相愛。契りは彩りを増すだろう。\r\n361:            </StatusCallout>\r\n362:          )}\r\n363:          <div className=\"pact-quote\">\r\n364:            「{god.pactLines[Math.min(Math.floor(data.godAffinity[god.id] ?? 0), god.pactLines.length - 1)]}」\r\n365:          </div>\r\n366:        </Panel>\r\n367:      )}\r\n368:\r\n369:      <button className=\"btn btn-ghost\" onClick={() => setScreen({ id: 'home' })}>\r\n370:        郷へ戻る\r\n371:      </button>\r\n372:\r\n373:      <ActionDock note={dockNote}>\r\n374:        <button className=\"btn btn-main\" onClick={openPactConfirm} disabled={!dockReady}>\r\n375:          {dockLabel}\r\n376:        </button>\r\n377:      </ActionDock>\r\n378:\r\n379:      {confirmOpen && parent && god && prediction && (\r\n380:        <PactConfirmSheet\r\n381:          parent={parent}\r\n382:          god={god}\r\n383:          data={data}\r\n384:          prediction={prediction}\r\n385:          cost={dockCost}\r\n386:          onClose={() => setConfirmOpen(false)}\r\n387:          onConfirm={confirmPact}\r\n388:        />\r\n389:      )}\r\n390:\r\n391:      {ritual && god && (\r\n392:        <div className=\"ritual-overlay\">\r\n393:          <div className=\"ritual-ring\" />\r\n394:          <div className=\"ritual-ring ritual-ring2\" />\r\n395:          <MaybeImg\r\n396:            src={godPresentationImg(god.portrait, (data.godAffinity[god.id] ?? 0) >= GOD_MAX_AFFINITY)}\r\n397:            className=\"ritual-cutin\"\r\n398:          />\r\n399:          <p className=\"ritual-text\">{god.name}との契り、結ばれる——</p>\r\n400:        </div>\r\n401:      )}\r\n402:    </div>\r\n403:  )\r\n404:}\r\n405:\r\n406:// M26 §9.5: 星契り最終確認 — 契るCTAはここでのみdoPactを呼ぶ(誤操作是正 M26-P0-01)。\r\n407:// 親の顔・名前・残り灯/神の立ち絵・名前・縁/奉燈の現在→残り/子が生まれる月/見立ての強み弱みを一望させ、\r\n408:// 「この月の行いとして確定し、月が進む」ことを最後に一文で示す。\r\n409:function PactConfirmSheet({\r\n410:  parent, god, data, prediction, cost, onClose, onConfirm,\r\n411:}: {\r\n412:  parent: Character\r\n413:  god: God\r\n414:  data: GameData\r\n415:  prediction: Record<StatKey, [number, number]>\r\n416:  cost: number\r\n417:  onClose: () => void\r\n418:  onConfirm: () => void\r\n419:}) {\r\n420:  const affinity = Math.floor(data.godAffinity[god.id] ?? 0)\r\n421:  const isMax = affinity >= GOD_MAX_AFFINITY\r\n422:  return (\r\n423:    <Sheet title=\"星契り、最後の確かめ\" onClose={onClose} closeLabel=\"やめる\">\r\n424:      <div className=\"pact-confirm-pair\">\r\n425:        <CharCard char={parent} seasonIndex={data.seasonIndex} compact />\r\n426:        <div className=\"pact-confirm-god\">\r\n427:          <MaybeImg\r\n428:            src={godPresentationImg(god.portrait, isMax)}\r\n429:            className=\"pact-confirm-god-img\"\r\n430:          />\r\n431:          <span className=\"pact-confirm-god-name\">{god.name}</span>\r\n432:          <span className=\"pact-confirm-god-aff\">縁 {affinity}</span>\r\n433:        </div>\r\n434:      </div>\r\n435:      <CompareRow label=\"奉燈\" before={data.hoto} after={data.hoto - cost} />\r\n436:      <p className=\"confirm-lead\">\r\n437:        子は{seasonLabel(data.seasonIndex + 1)}に生まれる。{predictionSummary(prediction)}\r\n438:      </p>\r\n439:      <p className=\"confirm-lead\">この月の行いとして確定し、月が進む。</p>\r\n440:      <div className=\"confirm-actions\">\r\n441:        <button className=\"btn btn-ghost\" onClick={onClose}>やめる</button>\r\n442:        <button className=\"btn btn-main\" data-testid=\"pact-confirm\" onClick={onConfirm}>契る</button>\r\n443:      </div>\r\n444:    </Sheet>\r\n445:  )\r\n446:}\r\n447:\r\n448:// 神の血潮の得意分野・上位2ステータス(神選びの比較材料)\r\n449:function topBias(statBias: Partial<Record<StatKey, number>>): [StatKey, number][] {\r\n450:  return (Object.entries(statBias) as [StatKey, number][])\r\n451:    .filter(([, v]) => v > 0)\r\n452:    .sort((a, b) => b[1] - a[1])\r\n453:    .slice(0, 2)\r\n454:}\r\n455:\r\n456:// M33: 当主の最も高い素質キー。交神の推奨★判定に使う — 成人の儀(灯型)/生業の儀(家業)と同じ\r\n457:// 「血潮の強みを伸ばす」思想で、神の得意(topBias先頭)が当主の最強素質と一致する神を勧める。\r\n458:function strongestPotential(potential: Partial<Record<StatKey, number>>): StatKey | null {\r\n459:  const entries = (Object.entries(potential) as [StatKey, number][]).filter(([, v]) => typeof v === 'number')\r\n460:  if (entries.length === 0) return null\r\n461:  return entries.sort((a, b) => b[1] - a[1])[0][0]\r\n462:}\r\n463:\r\n464:// 大立ち絵パネル — 縁MAXは同一性確認済みの第二立ち絵だけを採用する。\r\n465:// 未確認MAX候補は通常像＋runtimeの縁極frameへ退避し、別人化や疑似文字を表へ出さない。\r\n466:const GOD_MAX_AFFINITY = 5\r\n467:\r\n468:function GodPortraitPane({ godId, affinity }: { godId: string; sealedHint: string | null; affinity: number }) {\r\n469:  const g = GODS.find((x) => x.id === godId)!\r\n470:  const maxRite = affinity >= GOD_MAX_AFFINITY\r\n471:  // 退避連鎖: reviewed MAXまたは通常立ち絵 → (全滅)属性オーラ。\r\n472:  const candidates = [godPresentationImg(g.portrait, maxRite)]\r\n473:  const [idx, setIdx] = useState(0)\r\n474:  const artKey = `${godId}:${maxRite ? 'max' : 'normal'}`\r\n475:  const [lastArtKey, setLastArtKey] = useState(artKey)\r\n476:  if (artKey !== lastArtKey) {\r\n477:    setLastArtKey(artKey)\r\n478:    setIdx(0)\r\n479:  }\r\n480:  const src = idx < candidates.length ? candidates[idx] : null\r\n481:  return (\r\n482:    <div className=\"god-pane\" data-art-state={maxRite ? 'max-rite' : 'normal'}>\r\n483:      <div className={`god-pane-art el-bg-${g.element} ${maxRite ? 'max-rite' : ''}`}>\r\n484:        {src ? (\r\n485:          <img\r\n486:            className={`god-pane-img ${maxRite ? 'god-max' : ''}`}\r\n487:            src={src}\r\n488:            alt=\"\"\r\n489:            onError={() => setIdx((i) => i + 1)}\r\n490:          />\r\n491:        ) : (\r\n492:          // M22 §3: 共通✦を出さない — 属性別御影+神名焼き込み+「絵姿準備中」\r\n493:          <GodArtFallback g={g} />\r\n494:        )}\r\n495:      </div>\r\n496:      <div className=\"god-pane-info\">\r\n497:        <div className=\"god-pane-eyebrow\">{maxRite ? '縁極の御影' : '契りの御影'}</div>\r\n498:        <div className=\"god-pane-rank\">{GOD_RANK_LABELS[g.rank]} / {ELEMENT_LABELS[g.element]}の星</div>\r\n499:        <div className=\"god-pane-name\">{g.name}</div>\r\n500:        <div className=\"god-pane-kana\">{g.kana}</div>\r\n501:        <div className=\"god-pane-cost\">\r\n502:          奉納 <b>{g.cost}</b>\r\n503:          {affinity > 0 && <span className=\"god-pane-aff\"> ・縁 {affinity}</span>}\r\n504:        </div>\r\n505:        <div className=\"god-pane-person\">{g.personality}</div>\r\n506:        <p className=\"god-pane-desc\">{g.desc}</p>\r\n507:      </div>\r\n508:    </div>\r\n509:  )\r\n510:}\r\n511:\r\n512:function GeneBar({ label, value, tone }: { label: string; value: number; tone: 'human' | 'god' }) {\r\n513:  return (\r\n514:    <div className=\"gene-bar-row\">\r\n515:      <span className=\"gene-bar-label\">{label}</span>\r\n516:      <span className=\"gene-bar-track\">\r\n517:        <span className={`gene-bar-fill gene-${tone}`} style={{ width: `${Math.min(100, (value / 120) * 100)}%` }} />\r\n518:      </span>\r\n519:      <span className=\"gene-bar-num\">{value}</span>\r\n520:    </div>\r\n521:  )\r\n522:}\r\n1:import { GODS, godUnlocked } from '../core/data/gods'\r\n2:import { pactCost } from '../core/inheritance'\r\n3:import type { GameData, God } from '../core/types'\r\n4:\r\n5:/** 閲覧可能な表示行だけを、一覧と同じ順にキーボード経路へ残す。費用は閲覧を妨げない。 */\r\n6:export function inspectablePactGodIds(\r\n7:  shownGods: readonly God[],\r\n8:  data: Pick<GameData, 'fame' | 'regionsCleared' | 'family'>,\r\n9:  hasParent: boolean,\r\n10:): string[] {\r\n11:  return hasParent ? shownGods.filter((god) => godUnlocked(god, data)).map((god) => god.id) : []\r\n12:}\r\n13:\r\n14:/** フィルタや薦め切替で焦点の行が消えたら、閲覧可能な先頭をTab入口にする。 */\r\n15:export function pactRovingFocusId(ids: readonly string[], activeId: string | null): string | null {\r\n16:  return activeId !== null && ids.includes(activeId) ? activeId : ids[0] ?? null\r\n17:}\r\n18:\r\n19:export function pactFocusTarget(ids: readonly string[], currentId: string, key: string): string | null {\r\n20:  if (ids.length === 0) return null\r\n21:  if (key === 'Home') return ids[0]\r\n22:  if (key === 'End') return ids[ids.length - 1]\r\n23:  if (key !== 'ArrowDown' && key !== 'ArrowUp') return null\r\n24:  const index = ids.indexOf(currentId)\r\n25:  if (index < 0) return ids[0]\r\n26:  return ids[(index + (key === 'ArrowDown' ? 1 : -1) + ids.length) % ids.length]\r\n27:}\r\n28:\r\n29:/** 郷の入口と助言は、解禁済みの星神の割引後費用で揃える。 */\r\n30:export function cheapestUnlockedPactCost(data: Pick<GameData, 'fame' | 'regionsCleared' | 'family' | 'godAffinity'>): number {\r\n31:  return Math.min(...GODS.filter((god) => godUnlocked(god, data))\r\n32:    .map((god) => pactCost(god, data.godAffinity[god.id] ?? 0)))\r\n33:}\r\n34:\r\n35:export interface PactAvailability {\r\n36:  inspectable: boolean\r\n37:  contractable: boolean\r\n38:  reason?: string\r\n39:}\r\n40:\r\n41:/**\r\n42: * 星神の閲覧権と契約権を分離する。\r\n43: * 封印だけが詳細閲覧を妨げ、奉燈不足は契約CTAだけを止める。\r\n44: */\r\n45:export function pactAvailability(unlocked: boolean, hoto: number, cost: number): PactAvailability {\r\n46:  if (!unlocked) return { inspectable: false, contractable: false, reason: 'この星はまだ封印されている' }\r\n47:  const shortfall = Math.max(0, cost - hoto)\r\n48:  if (shortfall > 0) {\r\n49:    return {\r\n50:      inspectable: true,\r\n51:      contractable: false,\r\n52:      reason: `奉燈があと${shortfall}足りない`,\r\n53:    }\r\n54:  }\r\n55:  return { inspectable: true, contractable: true }\r\n56:}\r\n","exit_code":0,"status":"completed"}}
