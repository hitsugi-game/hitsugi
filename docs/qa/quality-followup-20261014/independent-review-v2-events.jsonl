div className=\"odai-foot\">\r\n757:            <span className=\"odai-state\">\r\n758:              {odaiClaimed ? '受領済み — また明日' : odaiMet ? `達成 — 褒賞 ${odaiReward}` : `未達 — ${odai.hint}`}\r\n759:            </span>\r\n760:            {odaiMet && !odaiClaimed && (\r\n761:              <button className=\"btn btn-main odai-claim\" onClick={() => { if (claimOdai()) setOdaiDone(true) }}>\r\n762:                褒賞を受ける\r\n763:              </button>\r\n764:            )}\r\n765:          </div>\r\n766:        </div>\r\n767:        {tiers.map(([icon, label, objs]) => (\r\n768:          <div key={label} className=\"obj-tier\">\r\n769:            <div className=\"obj-tier-head\">{icon} {label}</div>\r\n770:            {objs.map((o, i) => (\r\n771:              <div key={i} className={`obj-row ${o.done ? 'done' : ''}`}>\r\n772:                <span className=\"obj-mark\">{o.done ? '✔' : '◇'}</span>\r\n773:                <span className=\"obj-text\">{o.text}</span>\r\n774:                {o.progress && (\r\n775:                  <span className=\"obj-prog\">\r\n776:                    <span className=\"obj-bar\"><span className=\"obj-bar-fill\" style={{ width: `${Math.min(100, Math.round((o.progress[0] / Math.max(1, o.progress[1])) * 100))}%` }} /></span>\r\n777:                    {o.progress[0]}/{o.progress[1]}\r\n778:                  </span>\r\n779:                )}\r\n780:                {o.go && !o.done && <button className=\"btn btn-ghost obj-go\" onClick={() => go(o.go)}>→ {o.goLabel}</button>}\r\n","exit_code":0,"status":"completed"}}
