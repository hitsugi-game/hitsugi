{
  "name": "hitsugi",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:visual-closure": "node scripts/validate_visual_closure.mjs",
    "check:visual-manifest": "node scripts/validate_visual_recovery_manifest.mjs",
    "check:asset-bom": "node scripts/public_asset_bom.mjs",
    "check:asset-bom:dist": "node scripts/public_asset_bom.mjs --dist",
    "update:asset-bom": "node scripts/public_asset_bom.mjs --write",
    "check:performance": "node scripts/check_build_performance.mjs",
    "report:performance": "node scripts/check_build_performance.mjs --write-report",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:release-smoke": "playwright test --config=playwright.release.config.ts",
    "verify:deploy": "node scripts/verify_deployment.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.80.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
